# Trashtalk configuration. Uncomment a line to change a setting.
# Environment variables override this file. `@ Config list` shows effective values.
# Format: flat TOML. Strings are "quoted"; integers and true/false are bare.

# Harness for new Gusgus sessions. One of: jcode maki codex pi shell.
# Environment override: TRASHTALK_GUSGUS_PROFILE
gusgus.profile = "pi"

# Model for Pi sessions. The :low suffix pins the thinking level for these runs
# instead of inheriting whatever ~/.pi/agent/settings.json currently says.
# Environment override: TRASHTALK_PI_MODEL
pi.model = "omlx/Qwen3.6-35B-A3B-4bit:low"

# Model for Jcode sessions.
# Environment override: TRASHTALK_JCODE_MODEL
jcode.model = "Qwen3.6-35B-A3B-4bit"

# Model for Codex sessions.
# Environment override: TRASHTALK_CODEX_MODEL
# codex.model = "gpt-5.6-terra"

# Model for Maki sessions (an openai/ model).
# Environment override: TRASHTALK_MAKI_MODEL
# maki.model = "openai/gpt-5.6-terra"

# Seconds a stop or terminate waits behind a running agent tick.
# Environment override: TRASHTALK_CONTROL_WAIT
# agent.controlWait = 30

# Where typed decisions run. One of: jev clm-local clm-bc250 clm-prefer-bc250.
# Environment override: TRASHTALK_DECISION_TARGET
# decision.target = "jev"

# OpenRouter model for Jev decisions.
# Environment override: TRASHTALK_JEV_MODEL
# jev.model = "typesafe/jev-1.13"

# Local CLM endpoint.
# Environment override: CLM_BASE_URL
# clm.baseUrl = "http://127.0.0.1:8700"

# BC-250 CLM endpoint.
# Environment override: CLM_BC250_URL
# clm.bc250Url = ""

# CLM model name.
# Environment override: CLM_MODEL
# clm.model = "clm-latest"
jcode.provider = "omlx"
jcode.baseUrl = "http://127.0.0.1:8000/v1"
