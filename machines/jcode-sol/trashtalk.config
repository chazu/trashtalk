# Trashtalk configuration. Uncomment a line to change a setting.
# Environment variables override this file. `@ Config list` shows effective values.
# Format: flat TOML. Strings are "quoted"; integers and true/false are bare.

# Harness for new Gusgus sessions. One of: jcode maki codex pi shell.
# Environment override: TRASHTALK_GUSGUS_PROFILE
gusgus.profile = "jcode"

# Model for Jcode sessions.
# Environment override: TRASHTALK_JCODE_MODEL
jcode.model = "gpt-6.1-sol"

# Provider for Jcode sessions: openai (subscription login) or the name of a local OpenAI-compatible endpoint.
# Environment override: TRASHTALK_JCODE_PROVIDER
# jcode.provider = "openai"

# OpenAI-compatible base URL, required when jcode.provider is not openai.
# Environment override: TRASHTALK_JCODE_BASE_URL
# jcode.baseUrl = ""

# Context window in tokens for a local Jcode provider.
# Environment override: TRASHTALK_JCODE_CONTEXT_WINDOW
# jcode.contextWindow = 65536

# Model for Codex sessions.
# Environment override: TRASHTALK_CODEX_MODEL
# codex.model = "gpt-5.6-terra"

# Model for Maki sessions (an openai/ model).
# Environment override: TRASHTALK_MAKI_MODEL
# maki.model = "openai/gpt-5.6-terra"

# Model for pi sessions (provider/id); empty uses pi's own default.
# Environment override: TRASHTALK_PI_MODEL
# pi.model = ""

# Comma-separated pi tools to disable (the pi-background-tasks subagent tools by default).
# Environment override: TRASHTALK_PI_EXCLUDE_TOOLS
# pi.excludeTools = "bg_delegate,bg_result,bg_run,bg_run_pi_attested,bg_status,bg_logs,bg_kill"

# Comma-separated pi extension files to load instead of discovering all; empty discovers all.
# Environment override: TRASHTALK_PI_EXTENSION_PATHS
# pi.extensionPaths = ""

# Seconds a stop or terminate waits behind a running agent tick.
# Environment override: TRASHTALK_CONTROL_WAIT
# agent.controlWait = 30

# Turns an Assignment gets before it needs review; unfinished turns resume automatically.
# Environment override: TRASHTALK_ASSIGNMENT_ATTEMPTS
# assignment.attempts = 4

# Where typed decisions run. One of: jev decider.
# Environment override: TRASHTALK_DECISION_TARGET
# decision.target = "decider"

# OpenRouter model for Jev decisions.
# Environment override: TRASHTALK_JEV_MODEL
# jev.model = "typesafe/jev-1.13"

# Decider System 1 service (tailnet only).
# Environment override: TRASHTALK_DECIDER_URL
# decider.url = "https://decider.tail7fd374.ts.net"

# Decider model ID.
# Environment override: TRASHTALK_DECIDER_MODEL
# decider.model = "decider-2b-v11-Q4_K_M"

# Characters of message text an application sends to Decider (2,048-token context).
# Environment override: TRASHTALK_DECIDER_TEXT_LIMIT
# decider.textLimit = 4000
