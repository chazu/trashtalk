#!/usr/bin/env bash
# Compile every class with the compiler at REV (default HEAD) and with the
# working tree's compiler, then diff the generated Bash. Both builds use the
# working tree's .trash sources in throwaway checkouts, so the installed
# trash/.compiled and its caches are untouched. Exit status: 0 when the output
# is identical, 1 when it differs, 2 on error.
#
#   bin/trash-codegen-diff                # HEAD vs working tree, full diff
#   bin/trash-codegen-diff main~3 --stat  # changed classes and line counts
set -uo pipefail
shopt -s nullglob
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
rev=HEAD stat=0
for arg in "$@"; do
    case "$arg" in
        --stat) stat=1 ;;
        -h|--help) sed -n '2,9s/^# \{0,1\}//p' "$0"; exit 0 ;;
        -*) echo "trash-codegen-diff: unknown option $arg" >&2; exit 2 ;;
        *) rev=$arg ;;
    esac
done
git -C "$ROOT" rev-parse --verify --quiet "$rev^{commit}" >/dev/null ||
    { echo "trash-codegen-diff: unknown revision $rev" >&2; exit 2; }
jobs=$(sysctl -n hw.ncpu 2>/dev/null || nproc 2>/dev/null || echo 4)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# A checkout holds one compiler (lib/) and a copy of the current sources.
prepare() {
    local dir="$tmp/$1"
    mkdir -p "$dir"
    (cd "$ROOT" && tar -cf - --exclude=.compiled trash) | tar -xf - -C "$dir"
    if [[ "$1" == base ]]; then
        git -C "$ROOT" archive "$rev" lib | tar -xf - -C "$dir"
    else
        (cd "$ROOT" && tar -cf - lib) | tar -xf - -C "$dir"
    fi
}
build() {
    local dir="$tmp/$1"
    local -a sources=("$dir"/trash/*.trash "$dir"/trash/*/*.trash)
    mkdir -p "$dir/trash/.compiled/traits"
    (cd "$dir" && TRASHTALK_DIR="$dir" TRASHTALK_PROGRESS=0 \
        bash lib/jq-compiler/driver.bash compile-many "$dir/trash/.compiled" "$jobs" "${sources[@]}") \
        >"$tmp/$1.log" 2>&1 ||
        { echo "trash-codegen-diff: $1 build failed:" >&2; tail -20 "$tmp/$1.log" >&2; exit 2; }
}
prepare base && prepare work || exit 2
build base & base_pid=$!
build work & work_pid=$!
wait "$base_pid" || exit 2
wait "$work_pid" || exit 2

# Build receipts and caches record the compiler itself; compare classes only.
(cd "$tmp" && diff -ru -x '.*' base/trash/.compiled work/trash/.compiled) >"$tmp/diff"
status=$?
(( status > 1 )) && { cat "$tmp/diff" >&2; exit 2; }
if (( status == 0 )); then
    echo "Generated Bash is identical ($rev vs working tree)."
    exit 0
fi
if (( stat )); then
    awk '/^\+\+\+ /{file=$2; sub(".*/.compiled/", "", file)}
         /^[-+][^-+]/{n[file]++}
         END{for (f in n) printf "%6d  %s\n", n[f], f}' "$tmp/diff" | sort -k2
else
    sed -e "s|$tmp/||g" "$tmp/diff"
fi
exit 1
