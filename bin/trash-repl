#!/usr/bin/env bash
# Trashtalk REPL

case "${1:-}" in
    -h|--help)
        cat <<'EOF'
Trashtalk REPL - interactive message-send shell.

Usage: trash-repl              start the REPL
       trash-repl --help       show this help

Inside the REPL:
  Counter new               create an instance
  $counter increment        send a message to an instance
  Trash listObjects         list known classes
  help                      show in-REPL examples
  exit | quit | q           leave the REPL
EOF
        exit 0
        ;;
esac

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TRASHTALK_DIR="$(dirname "$SCRIPT_DIR")"

export TRASH_DEBUG=0
source "$TRASHTALK_DIR/lib/trash.bash" || exit 1
if [[ -t 0 && -t 2 ]]; then export TRASHTALK_INTERACTIVE=1; fi

# Readline runs in this shell, so completion can see live object variables.
# Noninteractive input keeps its exact message/output protocol.
repl_interactive=false
if [[ -t 0 && -t 1 ]]; then
    repl_interactive=true
    source "$TRASHTALK_DIR/lib/trash-completion.bash"
    set -o emacs
    repl_history_file="${TRASHTALK_HISTORY_FILE:-$HOME/.trash_history}"
    history -r "$repl_history_file" 2>/dev/null || true
    bind -x '"\C-i":_trash_repl_complete'
fi

echo "Trashtalk REPL"
echo "Type 'help' for commands, 'exit' to quit"
echo ""

while { if $repl_interactive; then read -erp "@ " cmd; else read -r cmd; fi; }; do
    [[ -z "$cmd" ]] && continue
    if $repl_interactive; then
        history -s -- "$cmd"
        history -a "$repl_history_file"
    fi

    cmd="${cmd#@ }"
    cmd="${cmd#@}"

    [[ "$cmd" == "exit" || "$cmd" == "quit" || "$cmd" == "q" ]] && break

    if [[ "$cmd" == "help" ]]; then
        echo "Examples:"
        echo "  Counter new              - Create a counter"
        echo "  \$counter increment      - Call method on instance"
        echo "  Trash listObjects        - List all classes"
        echo "  Trash help               - Full system help"
        echo ""
        echo "Commands: help, exit, quit, q"
        continue
    fi

    if [[ "$cmd" =~ ^([a-zA-Z_][a-zA-Z0-9_]*)'=$('(.+)')' ]]; then
        varname="${BASH_REMATCH[1]}"
        subcmd="${BASH_REMATCH[2]}"
        eval "$varname=\$(send $subcmd)"
        echo "$varname=${!varname}"
    elif [[ "$cmd" =~ ^([a-zA-Z_][a-zA-Z0-9_]*)=(.+)$ ]]; then
        varname="${BASH_REMATCH[1]}"
        value="${BASH_REMATCH[2]}"
        eval "$varname=\"$value\""
    else
        eval "send $cmd"
    fi
done

echo "Goodbye!"
