#!/usr/bin/env bash
# Trashtalk REPL

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TRASHTALK_DIR="$(dirname "$SCRIPT_DIR")"

export TRASH_DEBUG=0
source "$TRASHTALK_DIR/lib/trash.bash" 2>/dev/null

# Persistent history
HISTFILE="${TRASH_HISTFILE:-$HOME/.trash_history}"
HISTSIZE="${TRASH_HISTSIZE:-1000}"
HISTFILESIZE="${TRASH_HISTFILESIZE:-2000}"
history -r "$HISTFILE" 2>/dev/null

# Context-aware tab completion
source "$TRASHTALK_DIR/lib/trash-completion.bash" 2>/dev/null
bind -x '"\t": _trash_repl_complete' 2>/dev/null

echo "Trashtalk REPL"
echo "Type 'help' for commands, 'exit' to quit"
echo ""

_repl_cleanup() {
    history -w "$HISTFILE" 2>/dev/null
    echo "Goodbye!"
}
trap _repl_cleanup EXIT

while read -rep "@ " cmd; do
    [[ -z "$cmd" ]] && continue

    cmd="${cmd#@ }"
    cmd="${cmd#@}"

    [[ -z "$cmd" ]] && continue
    history -s "$cmd"

    [[ "$cmd" == "exit" || "$cmd" == "quit" || "$cmd" == "q" ]] && break

    if [[ "$cmd" == "help" ]]; then
        echo "Examples:"
        echo "  Counter new              - Create a counter"
        echo "  \$counter increment      - Call method on instance"
        echo "  Trash listObjects        - List all classes"
        echo "  Trash help               - Full system help"
        echo ""
        echo "Commands: help, exit, quit, q"
        continue
    fi

    if [[ "$cmd" =~ ^([a-zA-Z_][a-zA-Z0-9_]*)'=$('(.+)')' ]]; then
        varname="${BASH_REMATCH[1]}"
        subcmd="${BASH_REMATCH[2]}"
        eval "$varname=\$(send $subcmd)"
        echo "$varname=${!varname}"
    elif [[ "$cmd" =~ ^([a-zA-Z_][a-zA-Z0-9_]*)=(.+)$ ]]; then
        varname="${BASH_REMATCH[1]}"
        value="${BASH_REMATCH[2]}"
        eval "$varname=\"$value\""
    else
        eval "send $cmd"
    fi
done
