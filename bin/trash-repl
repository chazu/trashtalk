#!/usr/bin/env bash
# Trashtalk REPL

case "${1:-}" in
    -h|--help)
        cat <<'EOF'
Trashtalk REPL - interactive message-send shell.

Usage: trash-repl              start the REPL
       trash-repl --help       show this help

Inside the REPL:
  Counter new               create an instance
  $counter increment        send a message to an instance
  Trash listObjects         list known classes
  help                      show in-REPL examples
  exit | quit | q           leave the REPL
EOF
        exit 0
        ;;
esac

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TRASHTALK_DIR="$(dirname "$SCRIPT_DIR")"

export TRASH_DEBUG=0
source "$TRASHTALK_DIR/lib/trash.bash" 2>/dev/null

echo "Trashtalk REPL"
echo "Type 'help' for commands, 'exit' to quit"
echo ""

while read -rp "@ " cmd; do
    [[ -z "$cmd" ]] && continue

    cmd="${cmd#@ }"
    cmd="${cmd#@}"

    [[ "$cmd" == "exit" || "$cmd" == "quit" || "$cmd" == "q" ]] && break

    if [[ "$cmd" == "help" ]]; then
        echo "Examples:"
        echo "  Counter new              - Create a counter"
        echo "  \$counter increment      - Call method on instance"
        echo "  Trash listObjects        - List all classes"
        echo "  Trash help               - Full system help"
        echo ""
        echo "Commands: help, exit, quit, q"
        continue
    fi

    if [[ "$cmd" =~ ^([a-zA-Z_][a-zA-Z0-9_]*)'=$('(.+)')' ]]; then
        varname="${BASH_REMATCH[1]}"
        subcmd="${BASH_REMATCH[2]}"
        eval "$varname=\$(send $subcmd)"
        echo "$varname=${!varname}"
    elif [[ "$cmd" =~ ^([a-zA-Z_][a-zA-Z0-9_]*)=(.+)$ ]]; then
        varname="${BASH_REMATCH[1]}"
        value="${BASH_REMATCH[2]}"
        eval "$varname=\"$value\""
    else
        eval "send $cmd"
    fi
done

echo "Goodbye!"
