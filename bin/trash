#!/usr/bin/env bash
# Trashtalk REPL launcher

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TRASHTALK_DIR="$(dirname "$SCRIPT_DIR")"
export TRASHTALK_DIR

# Locate RlwrapFilter.pm (installed alongside rlwrap)
RLWRAP_FILTERDIR="$(find /opt/homebrew /usr/local -name "RlwrapFilter.pm" 2>/dev/null | head -1 | xargs dirname 2>/dev/null)"
export RLWRAP_FILTERDIR

FILTER="$TRASHTALK_DIR/lib/rlwrap-completion.pl"

# rlwrap gives line editing, history and completion, but it's optional. If it
# isn't installed, fall back to the plain REPL rather than dying with a bare
# "rlwrap: command not found".
if ! command -v rlwrap >/dev/null 2>&1; then
    echo "Note: rlwrap not found; starting REPL without line editing/history." >&2
    echo "      Install rlwrap for a better experience." >&2
    exec "$SCRIPT_DIR/trash-repl"
fi

exec rlwrap \
    --history-filename "$HOME/.trash_history" \
    --history-no-dupes 2 \
    --break-chars $'precisely: \t' \
    --case-insensitive \
    -z "$FILTER" \
    "$SCRIPT_DIR/trash-repl"
