#!/usr/bin/env bash
# trash-send - Dispatch a message send from external scripts and tools
#
# Usage: trash-send <receiver> <selector> [args...]
#
# Stdout carries the message result; diagnostics use stderr.

usage() {
    cat <<'EOF'
Usage: trash-send <receiver> <selector> [args...]

Dispatch a single message send to the trashtalk runtime and print the result.

  receiver   a class name (e.g. Counter) or instance id
  selector   the message/method to send (e.g. new, increment)

Examples:
  trash-send Counter new
  trash-send "$counter" increment 5
EOF
}

case "${1:-}" in
    -h|--help) usage; exit 0 ;;
esac

if [[ $# -lt 2 ]]; then
    echo "Error: trash-send requires a receiver and a selector." >&2
    echo "" >&2
    usage >&2
    exit 2
fi

# Find the trashtalk installation
TRASH_DIR="${TRASHTALK_DIR:-$HOME/.trashtalk}"

# Default logging is quiet; startup failures must remain visible.
source "$TRASH_DIR/lib/trash.bash" || exit 1

# Dispatch the message. Only stdout carries the result; let real errors reach
# stderr (callers capture stdout, so this aids debugging without polluting it).
@ "$@"
