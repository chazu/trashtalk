#!/usr/bin/env bash
# macOS user timer; each invocation performs one bounded HTTPS poll.
set -euo pipefail
root="${TRASHTALK_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
label=org.trashtalk.github-events
domain="gui/$(id -u)"
target="$HOME/Library/LaunchAgents/$label.plist"
[[ $(uname -s) == Darwin ]] || { echo 'Use a user systemd timer for bin/trash-github-events on Linux.' >&2; exit 2; }
case "${1:-status}" in
  install)
    mkdir -p "$(dirname "$target")" "$root/run/github-events"
    jq -nr --arg bash "$(command -v bash)" --arg root "$root" --arg path "$PATH" \
      --arg db "${SQLITE_JSON_DB:-$root/instances.db}" '
      def xml: @html;
      "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<plist version=\"1.0\"><dict>
      <key>Label</key><string>org.trashtalk.github-events</string>
      <key>ProgramArguments</key><array><string>\($bash|xml)</string><string>\(($root+"/bin/trash-github-events")|xml)</string></array>
      <key>WorkingDirectory</key><string>\($root|xml)</string>
      <key>EnvironmentVariables</key><dict><key>PATH</key><string>\($path|xml)</string><key>TRASHTALK_DIR</key><string>\($root|xml)</string><key>SQLITE_JSON_DB</key><string>\($db|xml)</string><key>LC_ALL</key><string>C</string></dict>
      <key>RunAtLoad</key><true/><key>StartInterval</key><integer>15</integer>
      <key>StandardOutPath</key><string>\(($root+"/run/github-events/stdout.log")|xml)</string>
      <key>StandardErrorPath</key><string>\(($root+"/run/github-events/stderr.log")|xml)</string>
      </dict></plist>"' > "$target"
    plutil -lint "$target" ;;
  start)
    if launchctl print "$domain/$label" >/dev/null 2>&1; then launchctl kickstart "$domain/$label"
    else launchctl bootstrap "$domain" "$target"; fi ;;
  stop) launchctl bootout "$domain/$label" ;;
  status) launchctl print "$domain/$label" ;;
  *) echo 'Usage: trash-github-events-service install|start|stop|status' >&2; exit 2 ;;
esac
