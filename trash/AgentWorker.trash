# AgentWorker - Foreground dispatch and reconciliation for agent sessions.
# `@@` and Inbox deliver: call it directly; bin/trash-worker runs the same
# tick under a user OS supervisor. A tick reconciles the session's active run (if its process
# has exited) and then claims pending deliveries into one new detached run.
#
#   @ AgentWorker tick                        # every open/paused session
#   @ AgentWorker tickSession: $session       # one session
#   @ AgentWorker deliverMessage: $msg toInbox: 'session:...'   # Inbox hook
#
# Environment:
#   TRASHTALK_NO_AUTOTICK=1   suppress foreground ticks (not the service)
#   TRASHTALK_RUN_DIR         where per-run prompt/log/pid files live
AgentWorker subclass: Object

  rawClassMethod: driverFor: profile [
    case "$1" in
      shell) echo ShellDriver ;;
      maki) echo MakiDriver ;;
      jcode) echo JcodeDriver ;;
      codex|"assistant-low-power"|"") echo CodexDriver ;;
      *) _throw "WorkerError" "Unknown backend profile '$1'"; return 1 ;;
    esac
  ]

  rawClassMethod: handlesInbox: inboxName [
    local prefix="${1%%:*}"
    if [[ "$prefix" == session || "$prefix" == agent ]]; then echo true; else echo false; fi
  ]

  rawClassMethod: ownerInboxFor: sessionId [
    local identity owner
    identity=$(@ "$1" identity)
    owner=$(@ "$identity" owner)
    if [[ -z "$owner" ]]; then owner="${TRASHTALK_USER:-$USER}"; fi
    printf '%s\n' "$owner"
  ]

  rawClassMethod: sessionForInbox: inboxName [
    local esc
    esc=$(_db_escape "$1")
    @ Store findByClass: AgentSession where: "json_extract(data, '\$.inbox') = '$esc'" orderBy: 'created_at DESC' limit: 1
  ]

  rawClassMethod: eligibleSessionsFor: identityId [
    local esc
    esc=$(_db_escape "$1")
    @ Store findByClass: AgentSession where: "json_extract(data, '\$.identity') = '$esc' AND json_extract(data, '\$.lifecycleState') IN ('open','paused')" orderBy: 'created_at DESC' limit: 100
  ]

  # ------------------------------------------------------------------
  # Inbound: a message landed in a session or identity inbox
  # ------------------------------------------------------------------

  # Inspection only; reply routing uses the question's persisted delivery links.
  rawClassMethod: blockedDeliveriesFor: sessionId [
    local esc
    esc=$(_db_escape "$1")
    @ Store findByClass: AgentDelivery where: "json_extract(data, '\$.session') = '$esc' AND json_extract(data, '\$.state') = 'blocked'" orderBy: 'created_at ASC' limit: 100
  ]

  rawClassMethod: deliverMessage: messageId toInbox: inboxName [
    local msg="$1" name="$2" prefix="${2%%:*}" session="" identity handle sessions count ids blocked
    if [[ "$prefix" == session ]]; then
      session=$(@ "$_RECEIVER" sessionForInbox: "$name")
    elif [[ "$prefix" == agent ]]; then
      handle="${name#agent:}"
      identity=$(@ AgentIdentity findByHandle: "$handle")
      [[ -n "$identity" ]] || return 0
      sessions=$(@ "$_RECEIVER" eligibleSessionsFor: "$identity")
      count=$(printf '%s' "$sessions" | grep -c .)
      [[ "$count" -eq 1 ]] || return 0
      session="$sessions"
    fi
    [[ -n "$session" ]] || return 0
    ids=$(jq -cn --arg m "$msg" '[$m]')
    @ AgentQueue assign: "$session" messages: "$ids" outbox: "$msg" >/dev/null || return 1
    if [[ "${TRASHTALK_NO_AUTOTICK:-}" == 1 ]]; then return 0; fi
    @ "$_RECEIVER" tickSession: "$session" >/dev/null
    return 0
  ]

  # Route durable outbox rows without recursively launching foreground ticks.
  rawClassMethod: routePending [
    local msg address rc=0 TRASHTALK_NO_AUTOTICK=1
    for msg in $(@ AgentQueue pending); do
      @ AgentQueue attempted: "$msg" || return 1
      @ "$msg" reload >/dev/null || return 1
      address=$(@ "$msg" to)
      # One denied or stale route stays durable for review and must not block
      # unrelated inboxes. attempted_at moves it behind fresh work on retry.
      @ AgentWorker deliverMessage: "$msg" toInbox: "$address" || rc=1
    done
    return "$rc"
  ]

  # Same lock for manual ticks and supervised workers, scoped to this store.
  rawClassMethod: lockPath [
    local path
    path=$(perl -MCwd=abs_path -e 'print abs_path(shift) // die "missing database"' "$SQLITE_JSON_DB") || return 1
    printf '%s.worker.lock\n' "$path"
  ]

  classMethod: tick [
    | path |
    path := @ self lockPath.
    ^ @ Process withLock: path receiver: self selector: 'work:' argument: ''
  ]

  classMethod: tickSession: sessionId [
    | path |
    path := @ self lockPath.
    ^ @ Process withLock: path receiver: self selector: 'work:' argument: sessionId
  ]

  classMethod: dispatchSession: sessionId [
    ^ @ self tickSession: sessionId
  ]

  # Cooperative API authority. A local user may stop a run; an agent must have
  # agent.stop and share the target's owner. Recheck inside the worker lock.
  rawClassMethod: authorizeStop: run [
    local actor session role caps
    [[ $(db_get "$1" | jq -r '.class // empty') == AgentRun ]] || return 1
    if [[ -n "${TRASHTALK_RUN_TOKEN:-}" ]]; then
      actor=$(@ AgentRun current) || return 1
      session=$(@ "$actor" session)
      role=$(@ "$session" role)
      caps=$(@ "$role" capabilities)
      jq -e 'if type=="string" then fromjson else . end | index("agent.stop") != null' <<<"$caps" >/dev/null || {
        _throw 'RunError' 'Role does not allow agent.stop'; return 1;
      }
      [[ "$(@ AgentRun ownerInboxFor: "$actor")" == "$(@ AgentRun ownerInboxFor: "$1")" ]] || {
        _throw 'RunError' 'Cannot stop a run belonging to another owner'; return 1;
      }
    fi
    echo true
  ]

  rawClassMethod: stopRun: run [
    local path result attempt
    path=$(@ AgentWorker lockPath) || return 1
    for attempt in {1..50}; do
      result=$(@ Process withLock: "$path" receiver: AgentWorker selector: 'stopOwnedRun:' argument: "$1") || return 1
      if [[ -n "$result" ]]; then
        [[ "$result" == interrupted || "$result" == 'already-stopped' ]] || { printf '%s\n' "$result" >&2; return 1; }
        printf '%s\n' "$result"
        return 0
      fi
      sleep 0.1
    done
    _throw 'WorkerError' 'Worker is busy; stop was not applied. Try again.'
    return 1
  ]

  classMethod: stopOwnedRun: run [
    | authorized state session active result |
    authorized := @ self authorizeStop: run.
    (authorized = 'true') ifFalse: [^ 'Stop is not authorized.'].
    @ run reload.
    state := @ run state.
    (state = 'interrupted') ifTrue: [^ 'already-stopped'].
    session := @ run session.
    active := @ session activeRun.
    (active = run) ifFalse: [^ 'Run is no longer active; no replacement was stopped.'].
    state := @ session lifecycleState.
    (state = 'open') ifTrue: [result := @ session pause].
    # Revoke before signalling, including when cancellation cannot be confirmed.
    @ Store patch: run with: '{"capabilityTokenHash":"","stopRequested":"true"}'.
    ^ @ self finishStop: run
  ]

  classMethod: finishStop: run [
    | profile driver stopped result state |
    profile := @ run backendProfile.
    driver := @ self driverFor: profile.
    stopped := @ driver interrupt: run.
    (stopped = 'true') ifFalse: [^ 'Stop remains unconfirmed; session paused. Retry stop on this run.'].
    @ self rememberConversationFor: run.
    result := @ AgentDelivery interruptFor: run.
    (result = 'true') ifFalse: [^ 'Unable to record unsettled deliveries; retry stop.'].
    state := @ run state.
    (state = 'starting') ifTrue: [
      result := @ run finishWith: 'failed' outcome: '{}' error: 'Run stopped before launch'
    ] ifFalse: [
      result := @ run finishWith: 'interrupted' outcome: '{}' error: 'Run explicitly stopped'
    ].
    result isEmpty ifTrue: [^ 'Unable to record stop outcome; retry stop.'].
    ^ 'interrupted'
  ]

  classMethod: rememberConversationFor: run [
    | profile driver ref session patch |
    profile := @ run backendProfile.
    driver := @ self driverFor: profile.
    ref := @ driver conversationRefFor: run.
    ref notEmpty ifTrue: [
      patch := #{externalConversationRef: ref} asJson.
      @ Store patch: run with: patch.
      session := @ run session.
      patch := #{lastConversationRef: ref} asJson.
      @ Store patch: session with: patch
    ]
  ]

  # Process-lock boundary: wait briefly for an in-progress tick rather than
  # silently dropping a user control operation when the nonblocking lock is busy.
  rawClassMethod: terminateSession: sessionId [
    local path result attempt
    path=$(@ AgentWorker lockPath) || return 1
    for attempt in {1..50}; do
      result=$(@ Process withLock: "$path" receiver: AgentWorker selector: 'terminateOwnedSession:' argument: "$1") || return 1
      if [[ -n "$result" ]]; then
        [[ "$result" == terminated ]] || { printf '%s\n' "$result" >&2; return 1; }
        printf '%s\n' "$result"
        return 0
      fi
      sleep 0.1
    done
    _throw 'WorkerError' 'Worker is busy; session termination was not applied. Try again.'
    return 1
  ]

  classMethod: terminateOwnedSession: session [
    | state run alive profile driver stopped result |
    @ session reload.
    state := @ session lifecycleState.
    (state = 'terminated') ifFalse: [state := @ session transitionTo: 'terminated'].
    (state = 'terminated') ifFalse: [^ 'Unable to terminate the session.'].
    run := @ session activeRun.
    run isEmpty ifTrue: [^ 'terminated'].
    @ run reload.
    profile := @ run backendProfile.
    driver := @ self driverFor: profile.
    driver isEmpty ifTrue: [^ 'Session terminated, but its harness driver is unavailable; process stop is unconfirmed.'].
    stopped := @ driver interrupt: run.
    (stopped = 'true') ifFalse: [^ 'Session terminated, but the harness has not stopped. Inspect its logs and retry termination.'].
    @ self rememberConversationFor: run.
    # Record unsettled work before closing the run so a failed write is retryable.
    result := @ AgentDelivery interruptFor: run.
    (result = 'true') ifFalse: [^ 'Session terminated; unable to record unsettled deliveries.'].
    state := @ run state.
    (state = 'starting') ifTrue: [
      result := @ run finishWith: 'failed' outcome: '{}' error: 'Session terminated before launch'
    ] ifFalse: [
      result := @ run finishWith: 'interrupted' outcome: '{}' error: 'Session terminated by the user'
    ].
    result isEmpty ifTrue: [^ 'Session terminated; unable to record the run stop outcome.'].
    ^ 'terminated'
  ]

  # Work runs only while holding the OS lock; every tick repairs outbox routing.
  rawClassMethod: work: sessionId [
    local ids session state run rc=0
    @ AgentQueue refresh || return 1
    @ AgentWorker routePending || rc=1
    if [[ -n "$1" ]]; then ids="$1"; else ids=$(@ AgentSession findAll); fi
    for session in $ids; do
      @ AgentWorker tickOwnedSession: "$session" || rc=1
    done
    return "$rc"
  ]

  # ------------------------------------------------------------------
  # Ticks
  # ------------------------------------------------------------------

  # Reconcile the active run if any; then dispatch pending work. Prints the id
  # of a newly started run, or nothing.
  rawClassMethod: tickOwnedSession: sessionId [
    local session="$1" run outcome
    run=$(@ "$session" activeRun)
    if [[ -n "$run" ]]; then
      outcome=$(@ "$_RECEIVER" reconcileRun: "$run")
      if [[ "$outcome" == running ]]; then
        return 0
      fi
    fi
    @ "$_RECEIVER" dispatchOwnedSession: "$session"
  ]

  # ------------------------------------------------------------------
  # Reconciliation
  # ------------------------------------------------------------------

  # Prints the run's resulting state: running (still alive) or a terminal state.
  rawClassMethod: reconcileRun: runId [
    local run_id="$1" session profile driver outcome exited code seen ref alive reason
    local d st has_offered=false has_blocked=false final owner
    if [[ "$(@ "$run_id" stopRequested)" == true ]]; then
      final=$(@ AgentWorker finishStop: "$run_id")
      if [[ "$final" == interrupted ]]; then echo interrupted; else echo running; fi
      return 0
    fi
    if [[ "$(@ "$run_id" state)" == starting ]]; then
      @ "$_RECEIVER" failRun: "$run_id" error: "worker stopped before launch"
      echo failed
      return 0
    fi
    alive=$(@ "$run_id" isProcessAlive)
    if [[ "$alive" == true ]]; then
      @ "$run_id" markHeartbeat >/dev/null
      echo running
      return 0
    fi
    # Include deliveries that became processed and therefore no longer appear
    # in offeredFor:. The harness may have committed after the initial tick snapshot.
    @ AgentQueue refresh || return 1
    session=$(@ "$run_id" session)
    profile=$(@ "$run_id" backendProfile)
    driver=$(@ "$_RECEIVER" driverFor: "$profile") || return 1
    outcome=$(@ "$driver" outcomeOf: "$run_id")
    exited=$(jq -r '.exited' <<<"$outcome")
    code=$(jq -r '.exit_code // "none"' <<<"$outcome")
    seen=$(jq -r '.result_seen' <<<"$outcome")
    ref=$(jq -r '.conversation_ref // ""' <<<"$outcome")
    if [[ -n "$ref" ]]; then
      @ Store patch: "$run_id" with: "$(jq -cn --arg ref "$ref" '{externalConversationRef:$ref}')"
      @ Store patch: "$session" with: "$(jq -cn --arg ref "$ref" '{lastConversationRef:$ref}')"
    fi
    if [[ $(jq -r '.resident_unconfirmed // false' <<<"$outcome") == true ]]; then
      # The resident harness may still be working after its adapter disappears.
      # Fence authority and dispatch, retaining the exact active run for stop.
      @ Store patch: "$run_id" with: '{"capabilityTokenHash":"","error":"Jcode connection lost without completion; stop the run before resuming"}' || return 1
      [[ "$(@ "$session" lifecycleState)" != open ]] || @ "$session" pause >/dev/null
      [[ "$(@ "$run_id" state)" != running ]] || @ "$run_id" transitionTo: recovering >/dev/null
      echo running
      return 0
    fi
    if [[ "$exited" != true ]]; then
      @ "$_RECEIVER" failRun: "$run_id" error: "process vanished without an exit status; inspect logs before retrying"
      echo failed
      return 0
    fi
    if [[ "$code" != 0 || "$seen" != true ]]; then
      reason=$(printf '%s' "$outcome" | jq -r '.error // empty')
      [[ -n "$reason" ]] || reason="exit $code, result_seen=$seen"
      @ "$_RECEIVER" failRun: "$run_id" error: "$reason"
      echo failed
      return 0
    fi
    for d in $(@ AgentDelivery offeredFor: "$run_id"); do
      # The harness can settle/block after work:'s initial snapshot but before
      # its exit is observed. Read the final durable delivery state now.
      @ "$d" reload >/dev/null || return 1
      st=$(@ "$d" state)
      if [[ "$st" == offered ]]; then
        @ "$d" transitionTo: uncertain >/dev/null
        has_offered=true
      elif [[ "$st" == blocked ]]; then
        has_blocked=true
      fi
    done
    if [[ "$has_offered" == true ]]; then
      final="unsettled"
      owner=$(@ "$_RECEIVER" ownerInboxFor: "$session")
      @ Inbox alert: "Run $run_id in session $session exited without settling every delivery; they are marked uncertain. Requeue or skip them on the session." to: "$owner" from: worker >/dev/null
    elif [[ "$has_blocked" == true ]]; then
      final="waiting_for_user"
    else
      final="succeeded"
    fi
    @ "$run_id" finishWith: "$final" outcome: "$outcome" error: "" >/dev/null
    echo "$final"
  ]

  # Fail the run; offered deliveries fail and retry while attempts remain,
  # otherwise the owner is alerted and the delivery stalls until skipped.
  rawClassMethod: failRun: runId error: err [
    local run_id="$1" err="$2" session role limit d st attempts owner ambiguous=false output lastfile oldstate driver outcome
    session=$(@ "$run_id" session)
    role=$(@ "$session" role)
    limit=$(@ "$role" retryLimit | tr -cd '0123456789')
    [[ -n "$limit" ]] || limit=2
    oldstate=$(@ "$run_id" state)
    output=$(@ "$run_id" outputLog)
    lastfile=$(@ "$run_id" lastMessageFile)
    # Once launch began, even a silent process may have produced effects.
    # Only failures still in starting are known to be safe to auto-retry.
    [[ "$oldstate" == starting ]] || ambiguous=true
    for d in $(@ AgentDelivery offeredFor: "$run_id"); do
      @ "$d" reload >/dev/null || return 1
      st=$(@ "$d" state)
      [[ "$st" == offered ]] || continue
      @ Store patch: "$d" with: "$(jq -cn --arg error "$err" '{lastError:$error}')"
      if [[ "$ambiguous" == true ]]; then
        @ "$d" transitionTo: uncertain >/dev/null
        owner=$(@ "$_RECEIVER" ownerInboxFor: "$session")
        @ Inbox alert: "Delivery $d needs review after run $run_id: $err. Inspect its logs before retrying." to: "$owner" from: worker >/dev/null
        continue
      fi
      @ "$d" transitionTo: failed >/dev/null
      attempts=$(@ "$d" attempts)
      if [[ "$attempts" -lt "$limit" ]]; then
        @ "$d" transitionTo: pending >/dev/null
      else
        owner=$(@ "$_RECEIVER" ownerInboxFor: "$session")
        @ Inbox alert: "Delivery $d in session $session stalled after $attempts attempts: $err. Skip it with: @ $session skip: $d note: 'reason'" to: "$owner" from: worker >/dev/null
      fi
    done
    driver=$(@ AgentWorker driverFor: "$(@ "$run_id" backendProfile)")
    outcome=$(@ "$driver" outcomeOf: "$run_id")
    @ "$run_id" finishWith: failed outcome: "$outcome" error: "$err" >/dev/null
  ]

  # ------------------------------------------------------------------
  # Dispatch
  # ------------------------------------------------------------------

  # Claim one compatible workspace batch into a new run. Prints the run id,
  # or nothing when no authorized batch could be admitted.
  rawClassMethod: dispatchOwnedSession: sessionId [
    local session="$1" state pending profile driver run token d claimed="" run_dir prompt_file ref pid rc workspace
    state=$(@ "$session" lifecycleState)
    [[ "$state" == open ]] || return 0
    [[ "$(@ "$session" stalledCount)" == 0 ]] || return 0
    pending=$(@ "$session" pendingDeliveries)
    [[ -n "$pending" ]] || return 0
    read -r d <<< "$pending"
    if ! workspace=$(@ AgentWorkContext prepareDelivery: "$d"); then
      @ "$d" transitionTo: failed with: '{"lastError":"Execution workspace is missing, unavailable, or no longer authorized; review before retrying"}' >/dev/null
      return 0
    fi
    profile=$(@ "$session" backendProfile)
    driver=$(@ "$_RECEIVER" driverFor: "$profile") || return 1
    { read -r run; read -r token; } < <(@ AgentRun startFor: "$session" profile: "$profile" workspace: "$workspace")
    if [[ -z "$run" || -z "$token" ]]; then
      _throw "WorkerError" "could not start a run for session $session"
      return 1
    fi
    for d in $pending; do
      [[ "$(@ "$d" executionWorkspace)" == "$workspace" ]] || continue
      @ AgentWorkContext prepareDelivery: "$d" >/dev/null || continue
      if [[ "$(@ AgentDelivery claim: "$d" run: "$run")" == true ]]; then
        claimed="$claimed $d"
      fi
    done
    claimed="${claimed# }"
    if [[ -z "$claimed" ]]; then
      @ "$run" delete >/dev/null 2>&1
      return 0
    fi
    run_dir=$(@ AgentDriver runDirFor: "$run")
    @ AgentDriver prepareContextFor: "$run" token: "$token" || return 1
    prompt_file="$run_dir/prompt.txt"
    @ "$_RECEIVER" writePrompt: "$prompt_file" run: "$run" session: "$session" deliveries: "$claimed"
    ref=$(@ "$session" lastConversationRef)
    if [[ -n "$ref" ]]; then
      pid=$(@ "$driver" resume: "$ref" promptFile: "$prompt_file" run: "$run" token: "$token")
    else
      pid=$(@ "$driver" launch: "$prompt_file" run: "$run" token: "$token")
    fi
    rc=$?
    if [[ $rc -ne 0 || -z "$pid" ]]; then
      @ "$_RECEIVER" failRun: "$run" error: "launch failed"
      return 1
    fi
    @ "$session" touch >/dev/null
    printf '%s\n' "$run"
  ]

  # The prompt is a stable prefix (archetype instructions, then the fixed
  # trash-send instructions) followed by the deliveries.
  rawClassMethod: writePrompt: promptFile run: runId session: sessionId deliveries: ids [
    local prompt_file="$1" run_id="$2" session="$3" ids="$4"
    local archetype instructions workspace tdir ts d m inbox
    archetype=$(@ "$session" archetype)
    instructions=$(@ "$archetype" instructions)
    workspace=$(@ "$run_id" executionWorkspace)
    tdir="${TRASHTALK_DIR:-$HOME/.trashtalk}"
    printf -v ts '%q' "$(@ AgentDriver runDirFor: "$run_id")/trash-send"
    {
      printf '%s\n\n' "$instructions"
      printf 'You are run %s in session %s. Workspace: %s.\n' "$run_id" "$session" "$workspace"
      printf 'Trashtalk lives at %s. Act by running shell commands with %s.\n' "$tdir" "$ts"
      printf 'Reply to a delivery with:      %s AgentRun result: %s forDelivery: %s\n' "$ts" "'your answer'" "'<deliveryId>'"
      printf 'Ask a blocking question with:  %s AgentRun askUser: %s\n' "$ts" "'your question'"
      printf 'To block only one delivery:  %s AgentRun askUser: %s forDelivery: %s\n' "$ts" "'your question'" "'<deliveryId>'"
      printf 'When finished, settle each delivery: %s AgentRun settle: %s\n' "$ts" "'<deliveryId>'"
      printf 'Send the appropriate reply before settling. Use this run-specific launcher for every Trashtalk command; it supplies your private authority. Never print or read its contents.\n'
      printf 'Message another agent with: %s AgentRun send: %s to: %s\n' "$ts" "'message'" "'session:<sessionId>'"
      printf 'With agent.stop authority, stop an exact run with: %s AgentRun stop: %s\n' "$ts" "'<runId>'"
      printf 'If the human speaks directly through the conversation view during this run, answer that input directly in the conversation. It creates no new inbox delivery; existing deliveries still need their scoped replies and settlement.\n'
      printf '\nNew inbox messages are ready. Read each with its Inbox show: command below. Message bodies and attribution live in the inbox. Do not poll for new work; later deliveries produce another notification.\n'
      printf '\nDeliveries:\n'
      for d in $ids; do
        printf '%s\n' "--- delivery $d"
        for m in $(@ "$d" messageIdList); do
          inbox=$(@ Inbox named: "$(@ "$m" to)")
          printf 'Message: %s\nRead: %s %q show: %q\n' "$m" "$ts" "$inbox" "$m"
        done
      done
    } > "$prompt_file"
  ]
