# Env - Environment variable primitive class
# Provides access to environment variables and system paths
#
# Usage:
#   home := @ Env get: 'HOME'
#   editor := @ Env get: 'EDITOR' default: 'vi'
#   @ Env set: 'MY_VAR' to: 'value'
#
Env subclass: Object

  # ==========================================
  # Variable Access
  # ==========================================

  # Get an environment variable (empty string if not set)
  # Usage: home := @ Env get: 'HOME'
  rawClassMethod: get: name [
    echo "${!1:-}"
  ]

  # Get an environment variable with default value
  # Usage: editor := @ Env get: 'EDITOR' default: 'vi'
  rawClassMethod: get: name default: defaultValue [
    local value="${!1:-}"
    if [[ -n "$value" ]]; then
      echo "$value"
    else
      echo "$2"
    fi
  ]

  # Set an environment variable
  # Usage: @ Env set: 'MY_VAR' to: 'value'
  # Note: rawClassMethod because export must run in parent shell
  rawClassMethod: set: name to: value [
    pragma: direct
    export "$1=$2"
  ]

  # Unset an environment variable
  # Usage: @ Env unset: 'MY_VAR'
  # Note: rawClassMethod because unset must run in parent shell
  rawClassMethod: unset: name [
    pragma: direct
    unset "$1"
  ]

  # Check if an environment variable is set (even if empty)
  # Usage: exists := @ Env has: 'HOME'
  rawClassMethod: has: name [
    if [[ -v "$1" ]]; then
      echo "true"
    else
      echo "false"
    fi
  ]

  # Check if an environment variable is set and non-empty
  # Usage: exists := @ Env hasNonEmpty: 'HOME'
  rawClassMethod: hasNonEmpty: name [
    local value="${!1:-}"
    if [[ -n "$value" ]]; then
      echo "true"
    else
      echo "false"
    fi
  ]

  # ==========================================
  # Path Operations
  # ==========================================

  # Find an executable in PATH
  # Usage: path := @ Env which: 'curl'
  rawClassMethod: which: executable [
    which "$1" 2>/dev/null || echo ""
  ]

  # Check if an executable exists in PATH
  # Usage: exists := @ Env hasExecutable: 'curl'
  rawClassMethod: hasExecutable: executable [
    if which "$1" >/dev/null 2>&1; then
      echo "true"
    else
      echo "false"
    fi
  ]

  # ==========================================
  # Common Variables
  # ==========================================

  # Get home directory
  classMethod: home [
    ^ @ Env get: 'HOME'
  ]

  # Get current user
  rawClassMethod: user [
    echo "${USER:-$(whoami)}"
  ]

  # Get shell
  classMethod: shell [
    ^ @ Env get: 'SHELL'
  ]

  # Get current working directory
  rawClassMethod: cwd [
    pwd
  ]

  # Get temp directory
  classMethod: temp [
    ^ @ Env get: 'TMPDIR' default: '/tmp'
  ]

  # Get hostname
  rawClassMethod: hostname [
    hostname
  ]

  # Get OS type
  classMethod: os [
    ^ @ Env get: 'OSTYPE'
  ]

  # Check if running on macOS
  classMethod: isMac [
    ^ (@ Env get: 'OSTYPE') startsWith: 'darwin'
  ]

  # Check if running on Linux
  classMethod: isLinux [
    ^ (@ Env get: 'OSTYPE') startsWith: 'linux'
  ]
