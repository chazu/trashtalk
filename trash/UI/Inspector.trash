package: UI

# UI::Inspector - Navigable view of one JSON snapshot. A live object's scalar
# ivars can be edited; each edit is an ObjectEditProposal, committed only if
# the object is unchanged since it was presented.
Inspector subclass: Object
  classMethod: openRecord: record title: title [
    ^ @ self open: record title: title editable: false
  ]

  # The single entry point for inspecting an object or a class. Without a
  # human at the terminal, or without inui, it describes itself as text.
  # Class state is shown read-only; only object ivars stage edits.
  classMethod: openObject: objectId [
    | record available |
    record := @ self recordFor: objectId.
    record isEmpty ifTrue: [@ StateError signal: 'Object does not exist: ' , objectId].
    available := @ UI::Surface isAvailable.
    (available ~= 'true') ifTrue: [^ @ objectId describe].
    ^ @ self openState: record
  ]

  # Opens at the record's state, titled with whose state it is: the class and
  # id of an object, or the class and its superclass.
  classMethod: openState: record [
    | className objectId superclass |
    className := record jsonTextAt: 'class_name'.
    (record jsonHas: 'object_id') ifTrue: [
      objectId := record jsonTextAt: 'object_id'.
      ^ @ self open: record title: className , ' ' , objectId editable: 'true' paths: '[["data"]]'
    ].
    superclass := record jsonTextAt: 'superclass'.
    ^ @ self open: record title: 'class ' , className , ', subclass of ' , superclass editable: 'false' paths: '[["data"]]'
  ]

  # A live object's record, or a class's record when objectId names a class.
  # Both carry the object references found in their state, so the projection
  # can show each as a link without reflecting while it paints.
  classMethod: recordFor: objectId [
    | className rawData data refs |
    className := @ Runtime classFor: objectId.
    className isEmpty ifTrue: [^ @ self classRecordFor: objectId].
    rawData := @ Runtime dataFor: objectId.
    data := @ String jsonInstanceView: rawData.
    refs := @ Runtime referencesIn: data.
    ^ #{schema_version: 1 object_id: objectId class_name: className data: (data jsonValue)
        refs: (refs jsonValue)} asJson
  ]

  classMethod: classRecordFor: className [
    | state superclass refs |
    state := (@ Runtime classStateFor: className) ifFailed: [^ ''].
    superclass := @ Runtime superclassOf: className.
    refs := @ Runtime referencesIn: state.
    ^ #{schema_version: 1 class_name: className superclass: superclass data: (state jsonValue)
        refs: (refs jsonValue)} asJson
  ]

  classMethod: open: record title: title editable: editable [
    ^ @ self open: record title: title editable: editable paths: '[[]]'
  ]

  classMethod: open: record title: title editable: editable paths: paths [
    | context |
    context := #{record: (record jsonValue) title: title paths: (paths jsonValue) active: 0 revision: 0
                 editable: (editable jsonValue)} asJson.
    ^ @ UI::Surface open: self context: context
  ]

  classMethod: frameFor: context [
    ^ @ self project: 'init' context: context frame: 'null' extra: 'null'
  ]

  # Drilling into a reference not yet loaded asks for its record; the frame is
  # then projected again with that record, which may no longer exist.
  classMethod: handleFrame: frame context: context [
    | action result objectId record extra |
    action := frame jsonAt: 'action' ifAbsent: 'null'.
    (action = '"apply"') ifTrue: [^ @ self applyEdit: frame context: context].
    result := (@ self project: 'handle' context: context frame: frame extra: 'null') ifFailed: [:error | @ error signal].
    (result jsonHas: 'load') ifFalse: [^ result].
    objectId := result jsonTextAt: 'load'.
    record := @ self recordFor: objectId.
    record isEmpty ifTrue: [record := 'null'].
    extra := #{object_id: objectId record: (record jsonValue)} asJson.
    ^ @ self project: 'handle' context: context frame: frame extra: extra
  ]

  # The projection stages the draft; ObjectEditProposal owns the stale check
  # and the mutation. The pane then shows the record as now stored.
  classMethod: applyEdit: frame context: context [
    | staged proposal objectId result record extra |
    staged := (@ self project: 'propose' context: context frame: frame extra: 'null') ifFailed: [:error | @ error signal].
    (staged jsonHas: 'proposal') ifFalse: [^ staged].
    proposal := staged jsonAt: 'proposal'.
    objectId := proposal jsonTextAt: 'object_id'.
    result := @ ObjectEditProposal apply: proposal to: objectId.
    record := @ self recordFor: objectId.
    record isEmpty ifTrue: [record := 'null'].
    extra := #{result: (result jsonValue) object_id: objectId record: (record jsonValue)} asJson.
    ^ @ self project: 'settle' context: context frame: frame extra: extra
  ]

  classMethod: pollFor: context [
    ^ '{"frames":[]}'
  ]

  # The snapshot is supplied explicitly. No reflective getters run in paint.
  rawClassMethod: project: mode context: context frame: frame extra: extra [
    jq -cn --arg mode "$1" --argjson context "$2" --argjson frame "$3" --argjson extra "$4" -f "${TRASHTALK_DIR:-$HOME/.trashtalk}/lib/ui-inspector.jq"
  ]
