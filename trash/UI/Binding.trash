package: UI

Binding subclass: Object
  # The runtime invokes ordinary blocks in command substitutions; capture is
  # isolated in this boundary so dependent DSL code needs no new syntax.
  rawClassMethod: named: name block: block [
    source "${TRASHTALK_DIR:-$HOME/.trashtalk}/lib/ui-signals.bash"
    ui_binding_register "$1" "$2"
  ]
  rawClassMethod: evaluate: name [
    source "${TRASHTALK_DIR:-$HOME/.trashtalk}/lib/ui-signals.bash"
    ui_binding_evaluate "$1"
  ]
  rawClassMethod: invalidated [
    source "${TRASHTALK_DIR:-$HOME/.trashtalk}/lib/ui-signals.bash"
    ui_binding_invalidated
  ]
  rawClassMethod: clearInvalidations [
    source "${TRASHTALK_DIR:-$HOME/.trashtalk}/lib/ui-signals.bash"
    ui_binding_clear
  ]
