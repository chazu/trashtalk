package: Agent

# Agent::Delivery - A batch of inbound messages handed to one session
# Deliveries are created when messages land in a session inbox and are
# claimed by a run with an atomic compare-and-set (claim:run:). Idempotent
# per (session, message ids) via deliveryKey.
#
# States: pending offered blocked processed uncertain failed skipped
#
# Usage:
#   d=$(@ Agent::Delivery forSession: $session messages: '["message_..."]')
#   @ Agent::Delivery claim: $d run: $run       # true once, then false
#   @ $d transitionTo: processed
Delivery subclass: Object
  include: Persistable
  include: StateMachine
  instanceVars: session:'' run:'' messageIds:'[]' deliveryKey:'' state:'pending' attempts:0
                lastError:'' note:'' created:'' assignment:'' generation:0 dispatchMode:'automatic'
                executionWorkspace:'' authorizationRole:'' authorizationRevision:'' authorizationWorkspacePolicy:''

  # Stable authority IDs survive the namespace migration and existing validators.
  classMethod: new [
    | id |
    id := @ Runtime generateId: 'AgentDelivery'.
    @ Runtime create: 'Agent::Delivery' id: id.
    ^ id
  ]

  # Common transition rule: check the table, set, save, echo the new state.
  method: transitionRules [
    ^ '["pending:offered","pending:failed","offered:processed","offered:blocked","offered:uncertain","offered:pending","offered:failed","blocked:processed","blocked:pending","failed:pending","failed:skipped","uncertain:pending","uncertain:processed","uncertain:skipped"]'
  ]

  method: transitionTo: newState [
    ^ @ self transitionTo: newState with: '{}'
  ]

  # Atomic state transition plus associated fields; rejected transitions write nothing.
  rawMethod: transitionTo: newState with: patchJson [
    local to="$1" from
    _env_set "$_RECEIVER" "$(db_get "$_RECEIVER")"
    from=$(_ivar state)
    @ "$_RECEIVER" requireTransitionFrom: "$from" to: "$to" >/dev/null || return 1
    local eid ef et changed patch
    printf '%s' "$2" | jq -e 'type == "object"' >/dev/null || return 1
    patch=$(_db_escape "$2")
    eid=$(_db_escape "$_RECEIVER"); ef=$(_db_escape "$from"); et=$(_db_escape "$to")
    changed=$(_db_sql "UPDATE instances SET data=json_set(json_patch(data,'$patch'),'$.state','$et') WHERE id='$eid' AND json_extract(data,'$.state')='$ef'; SELECT changes();") || return 1
    [[ "$changed" == 1 ]] || { _throw "TransitionError" "Concurrent transition; reload and retry"; return 1; }
    _env_set "$_RECEIVER" "$(db_get "$_RECEIVER")"
    echo "$to"
  ]

  # Create (or return the existing) delivery for these message ids.
  classMethod: forSession: sessionId messages: idsJson [
    ^ @ Agent::Queue assign: sessionId messages: idsJson outbox: ''
  ]

  # Pending deliveries for a session, oldest first
  rawClassMethod: pendingFor: sessionId [
    local esc
    esc=$(_db_escape "$1")
    @ Store findByClass: Agent::Delivery where: "json_extract(data, '\$.session') = '$esc' AND json_extract(data, '\$.state') = 'pending' AND coalesce(json_extract(data, '\$.dispatchMode'),'automatic') != 'manual'" orderBy: "json_extract(data, '\$.created') ASC, rowid ASC" limit: 1000
  ]

  # Deliveries a run is currently holding (offered or blocked), oldest first
  rawClassMethod: offeredFor: runId [
    local esc
    esc=$(_db_escape "$1")
    @ Store findByClass: Agent::Delivery where: "json_extract(data, '\$.run') = '$esc' AND json_extract(data, '\$.state') IN ('offered', 'blocked')" orderBy: "json_extract(data, '\$.created') ASC, rowid ASC" limit: 1000
  ]

  rawClassMethod: forKey: key [
    local esc
    esc=$(_db_escape "$1")
    @ Store findByClass: Agent::Delivery where: "json_extract(data, '\$.deliveryKey') = '$esc'" orderBy: 'created_at ASC' limit: 1
  ]

  # SQLite boundary: stopping a launched run never infers successful processing.
  rawClassMethod: interruptFor: runId [
    local run ids delivery
    run=$(_db_escape "$1")
    ids=$(_db_sql "UPDATE instances SET data=json_set(data,'$.state','uncertain','$.lastError','Run explicitly stopped or session terminated')
      WHERE class='Agent::Delivery' AND json_extract(data,'$.run')='$run' AND json_extract(data,'$.state')='offered' RETURNING id;") || return 1
    for delivery in $ids; do @ "$delivery" reload >/dev/null || return 1; done
    echo true
  ]

  # Atomic claim: pending -> offered for runId, attempts+1, in one SQL
  # statement guarded by the current state. Prints true when the row changed.
  rawClassMethod: claim: deliveryId run: runId [
    local id="$1" erun eid changed
    # Assignment claims also fence the selected session generation and append
    # participating runs in the same transaction as the delivery claim.
    if [[ -n "$(db_get "$id" | jq -r '.assignment // empty')" ]]; then
      @ Assignment claim: "$id" run: "$2"
      return
    fi
    erun=$(_db_escape "$2")
    eid=$(_db_escape "$id")
    changed=$(_db_sql "UPDATE instances SET data = json_set(data, '\$.state', 'offered', '\$.run', '$erun', '\$.attempts', json_extract(data, '\$.attempts') + 1) WHERE id = '$eid' AND json_extract(data, '\$.state') = 'pending'; SELECT changes();")
    if [[ "$changed" == "1" ]]; then
      @ "$id" reload >/dev/null 2>&1 || true
      echo "true"
    else
      echo "false"
    fi
  ]

  # Message ids, one per line
  rawMethod: messageIdList [
    local ids
    ids=$(_ivar messageIds)
    [[ -n "$ids" && "$ids" != "null" ]] || ids='[]'
    printf '%s' "$ids" | jq -r 'if type == "string" then (fromjson? // []) else . end | .[]'
  ]

  rawMethod: senderOfFirstMessage [
    local first
    first=$(@ "$_RECEIVER" messageIdList | head -n 1)
    [[ -n "$first" ]] || return 0
    @ "$first" from
  ]

  classMethod: forAssignment: assignment session: session generation: generation message: message [
    | id d ids key now workspace role revision policy mode |
    @ Store requireTransaction.
    id := 'agentdelivery_' , assignment , '_' , generation.
    d := @ Store create: 'Agent::Delivery' id: id.
    ids := '[]'.
    ids := ids arrayPush: message.
    key := assignment , ':' , generation.
    now := @ Time nowISO.
    @ d session: session.
    @ d messageIds: ids.
    @ d deliveryKey: key.
    @ d created: now.
    @ d assignment: assignment.
    @ d generation: generation.
    mode := @ assignment dispatchMode.
    @ d dispatchMode: mode.
    workspace := @ session workspace.
    role := @ session role.
    revision := @ role revision.
    policy := @ role workspacePolicy.
    @ d executionWorkspace: workspace.
    @ d authorizationRole: role.
    @ d authorizationRevision: revision.
    @ d authorizationWorkspacePolicy: policy.
    @ d save.
    ^ d
  ]

  # Workstation delegation: automatic dispatch to one resolved session, with a
  # deterministic id per (attention, delegation revision) so replay is inert.
  classMethod: forAttention: attention message: message session: session revision: revision [
    | id d ids key now workspace role roleRevision policy |
    @ Store requireTransaction.
    id := 'agentdelivery_' , attention , '_delegation_' , revision.
    d := @ Store create: 'Agent::Delivery' id: id.
    ids := '[]'.
    ids := ids arrayPush: message.
    key := 'attention:' , attention , ':' , revision.
    now := @ Time nowISO.
    workspace := @ message executionWorkspace.
    role := @ session role.
    role := @ Store read: role class: 'Agent::Role'.
    roleRevision := @ role revision.
    policy := @ role workspacePolicy.
    @ d session: session.
    @ d messageIds: ids.
    @ d deliveryKey: key.
    @ d created: now.
    @ d dispatchMode: 'automatic'.
    @ d executionWorkspace: workspace.
    @ d authorizationRole: role.
    @ d authorizationRevision: roleRevision.
    @ d authorizationWorkspacePolicy: policy.
    @ d save.
    ^ d
  ]
