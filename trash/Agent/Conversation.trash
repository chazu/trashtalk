package: Agent

# Human input goes to the session driver. Runs retain authority and lifecycle;
# conversation input never creates a Message or an Agent::Delivery.
Conversation subclass: Object
  # Lock acquisition and failure propagation are process boundaries. Queue
  # behind a running worker tick instead of polling: a tick over many sessions
  # can hold the store lock longer than any polite retry window.
  rawClassMethod: send: text to: session [
    local path args result
    @ Agent::Focus human >/dev/null || return 1
    @ Require text: "$1" || return 1
    path=$(@ Agent::Worker lockPath) || return 1
    args=$(jq -cn --arg session "$2" --arg text "$1" '{session:$session,text:$text}') || return 1
    if ! result=$(@ Process withLock: "$path" receiver: Agent::Conversation selector: 'sendOwned:' argument: "$args" waiting: "$(@ Agent::Worker controlWait)"); then
      [[ -z "$result" ]] || printf '%s\n' "$result" >&2
      return 1
    fi
    if [[ -n "$result" ]]; then printf '%s\n' "$result"; return 0; fi
    printf 'Session control stayed busy for %ss; input was not sent. Check the worker (bin/trash-worker-service status) and try again\n' "$(@ Agent::Worker controlWait)" >&2
    return 1
  ]

  classMethod: sendOwned: args [
    args jsonUnpack: #('session' 'text') into: [:session :text |
      @ self sendText: text toSession: session
    ]
  ]

  classMethod: sendText: text toSession: session [
    | profile driver run purpose workspace role allowed ignored human |
    human := @ Agent::Focus human.
    (human isEmpty) ifTrue: [^ @ Require reject: 'Human session input required'].
    session := @ Agent::Access liveSession: session.
    (session isEmpty) ifTrue: [^ @ Require reject: 'Current session access required'].
    run := @ self requireInputReady: session.
    profile := @ session backendProfile.
    driver := @ Agent::Worker driverFor: profile.
    allowed := (@ driver capabilities) jsonTextAt: 'live_input'.
    (allowed ~= 'true') ifTrue: [^ @ Require reject: 'This driver does not support direct session input'].
    (run notEmpty) ifTrue: [
      ignored := @ Agent::Worker reconcileRun: run.
      ignored := @ session reload.
      run := @ self requireInputReady: session
    ].
    (run notEmpty) ifTrue: [
      purpose := @ run purpose.
      (purpose = 'compact') ifTrue: [^ @ Require reject: 'Wait for context compaction to finish before sending input'].
      workspace := @ run executionWorkspace.
      role := @ session role.
      ignored := @ role reload.
      allowed := @ role allowsWorkspace: workspace.
      (allowed ~= 'true') ifTrue: [^ @ Require reject: 'Session workspace is no longer authorized'].
      ^ @ driver input: text run: run
    ].
    ^ @ self launch: text session: session driver: driver
  ]

  # A lost native connection retains its run for explicit stop. Resuming alone
  # cannot recover it; reconcile can also discover this during the input send.
  classMethod: requireInputReady: session [
    | run state |
    run := @ session activeRun.
    (run notEmpty) ifTrue: [
      state := @ run state.
      (state = 'recovering') ifTrue: [
        ^ @ Require reject: 'Session recovery is incomplete. Use M-x -> Stop displayed run, then M-x -> Resume queued work before sending input'
      ]
    ].
    state := @ session lifecycleState.
    (state ~= 'open') ifTrue: [
      ^ @ Require reject: 'Session paused. Use M-x -> Resume queued work before sending input'
    ].
    ^ run
  ]

  # Token plumbing and prompt files are process boundaries. The user text is
  # a literal native input; execution context is a separate system reminder.
  rawClassMethod: launch: text session: session driver: driver [
    local text="$1" session="$2" driver="$3" profile workspace run token directory pid ref
    profile=$(@ "$session" backendProfile) || return 1
    workspace=$(@ "$session" workspace) || return 1
    ref=$(@ "$session" lastConversationRef) || return 1
    # A view continues the native session's working directory, independently
    # of the shell directory from which the view was opened.
    if [[ "$profile" == jcode && -n "$ref" ]]; then
      workspace=$(@ Agent::JcodeDriver workspaceFor: "$session") || return 1
    fi
    { read -r run; read -r token; } < <(@ Agent::Run startFor: "$session" profile: "$profile" workspace: "$workspace")
    [[ -n "$run" && -n "$token" ]] || return 1
    directory=$(@ Agent::Driver runDirFor: "$run")
    if ! {
      @ Store patch: "$run" with: '{"purpose":"conversation"}' &&
      @ Agent::Driver prepareContextFor: "$run" token: "$token" &&
      @ Agent::Conversation writeContextFor: "$run" &&
      printf '%s' "$text" > "$directory/prompt.txt" &&
      pid=$(@ "$driver" resume: "$ref" promptFile: "$directory/prompt.txt" run: "$run" token: "$token")
    }; then
      @ Agent::Worker failRun: "$run" error: 'Direct conversation could not start' >/dev/null
      return 1
    fi
    @ "$driver" awaitInputFor: "$run"
  ]

  rawClassMethod: writeContextFor: run [
    local run="$1" session archetype directory launcher
    session=$(@ "$run" session)
    archetype=$(@ "$session" archetype)
    directory=$(@ Agent::Driver runDirFor: "$run")
    printf -v launcher '%q' "$directory/trash-send"
    {
      @ "$archetype" instructions
      printf '\nYou are run %s in session %s. Workspace: %s.\n' "$run" "$session" "$(@ "$run" executionWorkspace)"
      printf 'The current run protocol below governs input and delegation even when older conversation or archetype instructions describe an inbox-only workflow.\n'
      printf 'The user is speaking directly through the conversation view. Reply directly in this conversation. There is no inbox delivery to read, reply to, or settle for this input.\n'
      printf 'For Trashtalk commands use this current run launcher: %s. It supplies private authority; never read or print its contents. Older run launchers have expired.\n' "$launcher"
      printf 'To delegate background work durably: %s Agent::Run delegate: %s criteria: %s key: %s\n' "$launcher" "'objective'" "'completion criteria and evidence'" "'stable-key-for-this-request'"
      printf 'Reuse the key on retry. This queues one specialist assignment and returns its handle. Tell the human that handle; inspect it with <launcher> <assignment> show. Queued and started are different. Progress and completion update its durable inbox item. Use delegation for entrusted work; ordinary send:to: is for conversation.\n'
      printf 'One open child assignment per conversation; no recursive delegation. Do not bypass Assignment by spawning another harness or changing stored lifecycle fields directly. Acknowledge the queued handle directly here, then stay available without waiting or polling. The outcome will arrive as an inbox notification; read it and report its evidence and limitations when notified. If delegation fails, report the failure without claiming an agent started. This direct input has no delivery to settle.\n'
    } > "$directory/system-reminder.txt"
  ]
