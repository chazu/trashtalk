package: Agent

# Agent::JcodeDriver - A private resident daemon per session, one API adapter per run.
# Worker lifecycle and message delivery remain harness-independent.
JcodeDriver subclass: Agent::Driver

  classMethod: capabilities [
    ^ '{"schema_version":1,"headless":true,"resume":true,"queued_input":true,"stop":true,"live_input":true,"sandbox":false}'
  ]

  # Native history owns the current directory of the conversation proxy.
  rawClassMethod: workspaceFor: session [
    local directory ref pattern='^[A-Za-z0-9_-]+$'
    directory=$(@ Agent::Driver runDirFor: "$1")
    ref=$(@ "$1" lastConversationRef)
    [[ "$ref" =~ $pattern ]] || return 1
    source "${TRASHTALK_DIR:-$HOME/.trashtalk}/lib/jcode-context.bash"
    _jcode_context_value "${directory%/*}/hosts/$1/jcode/sessions/$ref.json" '' working_dir | jq -er 'select(type=="string" and length>0)'
  ]

  rawClassMethod: awaitInputFor: run [
    bash "${TRASHTALK_DIR:-$HOME/.trashtalk}/lib/jcode-input.bash" await "$(@ Agent::Driver runDirFor: "$1")"
  ]

  # Use the active adapter's connection, so steering neither creates a second
  # controller nor replaces the run's capability context.
  rawClassMethod: input: text run: run [
    [[ "$(@ "$2" state)" == running && "$(@ "$2" isProcessAlive)" == true ]] || {
      echo 'The native session connection is unavailable; input was not sent' >&2; return 1;
    }
    printf '%s' "$1" | bash "${TRASHTALK_DIR:-$HOME/.trashtalk}/lib/jcode-input.bash" send "$(@ Agent::Driver runDirFor: "$2")"
  ]

  classMethod: model [ ^ @ Agent::JcodeSettings model ]
  classMethod: provider [ ^ @ Agent::JcodeSettings provider ]

  # Filesystem boundary for a local OpenAI-compatible provider. Jcode takes a
  # named profile only from config.toml, selected with --provider auto, and
  # reads its key from an env file in its app config directory. The managed home
  # gets a generated config and a symlink to the user's key file, so no ambient
  # tool or search settings leak in and the key is never copied.
  rawClassMethod: prepareLocalProvider: provider home: home model: model [
    local provider="$1" home="$2" model="$3" pattern='^[A-Za-z][A-Za-z0-9_-]*$' base window key_file
    [[ "$provider" =~ $pattern ]] || { echo "jcode.provider must be openai or a plain profile name, not '$provider'" >&2; return 1; }
    base=$(@ Agent::JcodeSettings baseUrl)
    [[ -n "$base" ]] || { echo "jcode.baseUrl is required for local Jcode provider $provider" >&2; return 1; }
    [[ -n "$model" ]] || { echo "jcode.model is required for local Jcode provider $provider" >&2; return 1; }
    window=$(@ Agent::JcodeSettings contextWindow)
    key_file="${XDG_CONFIG_HOME:-$HOME/.config}/jcode/provider-$provider.env"
    [[ -f "$key_file" ]] || {
      echo "Jcode provider $provider needs its API key in $key_file (JCODE_PROVIDER_${provider^^}_API_KEY=...)" >&2
      return 1
    }
    mkdir -p "$home/config/jcode" || return 1
    ln -sfn "$key_file" "$home/config/jcode/provider-$provider.env" || return 1
    jq -rn --arg p "$provider" --arg base "$base" --arg model "$model" --argjson window "$window" \
      --arg env "JCODE_PROVIDER_$(printf '%s' "$provider" | tr '[:lower:]-' '[:upper:]_')_API_KEY" '
      "[provider]\ndefault_provider = \($p | tojson)\ndefault_model = \($model | tojson)\n\n"
      + "[providers.\($p)]\ntype = \"openai-compatible\"\nbase_url = \($base | tojson)\n"
      + "auth = \"bearer\"\napi_key_env = \($env | tojson)\nenv_file = \("provider-\($p).env" | tojson)\n"
      + "default_model = \($model | tojson)\nrequires_api_key = true\n\n"
      + "[[providers.\($p).models]]\nid = \($model | tojson)\ncontext_window = \($window)\n"' > "$home/config.toml.tmp" \
      && mv "$home/config.toml.tmp" "$home/config.toml"
  ]

  # Filesystem/CLI boundary. Private homes exclude ambient Jcode config and
  # share only OAuth files (symlinks preserve credential refresh). Runtime paths
  # are short for macOS Unix socket limits and persisted with the session home.
  rawClassMethod: prepare: run ref: ref [
    local run="$1" ref="$2" directory session home runtime source_auth codex_auth executable workspace model bash_path provider
    executable=$(@ Jcode path)
    [[ -n "$executable" ]] || { echo 'Jcode is missing; see https://jcode.sh' >&2; return 1; }
    directory=$(@ Agent::Driver runDirFor: "$run")
    session=$(@ "$run" session)
    workspace=$(@ "$run" executionWorkspace)
    home="${directory%/*}/hosts/$session/jcode"
    source_auth="${JCODE_HOME:-$HOME/.jcode}/openai-auth.json"
    codex_auth="${CODEX_HOME:-$HOME/.codex}/auth.json"
    provider=$(@ Agent::JcodeDriver provider) || return 1
    [[ "$provider" != openai ]] || [[ -f "$source_auth" || -f "$codex_auth" ]] || {
      echo 'Jcode requires OpenAI subscription authentication; run @ Jcode login' >&2
      return 1
    }
    umask 077
    mkdir -p "$home/external/.codex" "$home/bin" "$home/processes" || return 1
    bash_path=$(command -v bash)
    {
      printf '#!%s\n' "$bash_path"
      printf 'exec %q %q shell %q %q "$@"\n' "$bash_path" "${TRASHTALK_DIR:-$HOME/.trashtalk}/lib/jcode-processes.bash" "$home" "$bash_path"
    } > "$home/bin/bash.tmp" || return 1
    chmod 700 "$home/bin/bash.tmp" && mv "$home/bin/bash.tmp" "$home/bin/bash" || return 1
    rm -f "$home/stopping"
    if [[ -f "$source_auth" ]]; then ln -sfn "$source_auth" "$home/openai-auth.json" || return 1; fi
    if [[ -f "$codex_auth" ]]; then ln -sfn "$codex_auth" "$home/external/.codex/auth.json" || return 1; fi
    runtime=''
    [[ ! -s "$home/runtime.path" ]] || runtime=$(cat "$home/runtime.path")
    # /tmp may be cleared on reboot; history lives in the durable private home.
    if [[ -z "$runtime" || ( ! -e "$runtime" && ! -L "$runtime" ) ]]; then
      runtime=$(mktemp -d /tmp/tt-jcode.XXXXXXXX) || return 1
      printf '%s\n' "$runtime" > "$home/runtime.path.tmp" && mv "$home/runtime.path.tmp" "$home/runtime.path" || return 1
    fi
    [[ -d "$runtime" && -O "$runtime" && ! -L "$runtime" ]] || {
      echo 'Jcode private runtime directory is missing or has changed ownership' >&2; return 1;
    }
    model=$(@ Agent::JcodeDriver model) || return 1
    if [[ "$provider" != openai ]]; then
      @ Agent::JcodeDriver prepareLocalProvider: "$provider" home: "$home" model: "$model" || return 1
    else
      rm -f "$home/config.toml"
    fi
    jq -cn --arg executable "$executable" --arg home "$home" --arg runtime "$runtime" \
      --arg workspace "$workspace" --arg model "$model" --arg ref "$ref" --arg bash "$bash_path" --arg provider "$provider" \
      '{executable:$executable,home:$home,runtime:$runtime,workspace:$workspace,model:$model,ref:$ref,bash:$bash,provider:$provider}' > "$directory/jcode.json"
  ]

  # Agent::Driver launchRef: has created the run directory and captures stderr.
  rawClassMethod: launchPreparedRef: ref promptFile: promptFile run: run token: token [
    local directory argv
    directory=$(@ Agent::Driver runDirFor: "$3")
    @ Agent::JcodeDriver prepare: "$3" ref: "$1" || return 1
    [[ "$2" == "$directory/prompt.txt" ]] || cp "$2" "$directory/prompt.txt" || return 1
    argv=$(jq -cn --arg bash "$(command -v bash)" --arg script "${TRASHTALK_DIR:-$HOME/.trashtalk}/lib/jcode-api.bash" \
      --arg directory "$directory" '[$bash,$script,"run",$directory]') || return 1
    @ Agent::JcodeDriver launchArgv: "$argv" promptFile: "$directory/prompt.txt" run: "$3" token: "$4" ref: "$1"
  ]

  rawClassMethod: harnessConversationRefFor: run [
    local directory ref session pattern='^[A-Za-z0-9_-]+$'
    directory=$(@ Agent::Driver runDirFor: "$1")
    [[ -s "$directory/conversation" ]] || return 0
    ref=$(cat "$directory/conversation")
    session=$(@ "$1" session)
    # Creation alone may be memory-only. A pre-send configuration failure
    # must not strand the session on a reference with no resumable history.
    # Send intent still retains the exact reference for ambiguous-run stop.
    if [[ "$ref" =~ $pattern ]] && { [[ -e "$directory/send-intent" ]] || [[ -s "${directory%/*}/hosts/$session/jcode/sessions/$ref.json" ]]; }; then
      printf '%s\n' "$ref"
    fi
  ]

  rawClassMethod: resultSeenFor: run [
    local directory
    directory=$(@ Agent::Driver runDirFor: "$1")
    if [[ -s "$directory/completed" && -s "$directory/conversation" ]] && cmp -s "$directory/completed" "$directory/conversation"; then echo true; else echo false; fi
  ]

  # A sent prompt with no terminal receipt may still be executing in the daemon.
  # Keep its exact run available for stop even if its adapter has disappeared.
  rawClassMethod: outcomeOf: run [
    local directory outcome resident=false
    directory=$(@ Agent::Driver runDirFor: "$1")
    # The shared outcome dispatches this driver's receipt hooks.
    outcome=$(@ "$_RECEIVER" processOutcomeOf: "$1") || return 1
    # Context maintenance has no inbox deliveries or tool execution. Losing its
    # observer can fail maintenance, but must not stall ordinary conversation.
    if [[ "$(@ "$1" purpose)" != compact && -e "$directory/send-intent" && ! -e "$directory/request-rejected" && "$(jq -r .result_seen <<<"$outcome")" != true ]]; then resident=true; fi
    jq -c --argjson resident "$resident" '.resident_unconfirmed=$resident' <<<"$outcome"
  ]

  # Stop the adapter first: it must not race cancellation by sending late input.
  # Then stop the exact native conversation, even when the adapter was lost.
  rawClassMethod: interrupt: run [
    local directory
    [[ "$(@ Agent::Driver interrupt: "$1")" == true ]] || { echo false; return; }
    directory=$(@ Agent::Driver runDirFor: "$1")
    [[ -e "$directory/send-intent" ]] || { echo true; return; }
    if [[ -s "$directory/conversation" && -s "$directory/jcode.json" ]] && \
      (
        # Recovery can start a resident daemon. Only the parent controller
        # may retain the worker lock; the daemon must not inherit it.
        if [[ -n "${TRASH_PROCESS_LOCK_FD:-}" ]]; then _trash_close_process_lock; fi
        bash "${TRASHTALK_DIR:-$HOME/.trashtalk}/lib/jcode-api.bash" stop "$directory"
      ) >>"$directory/control.log" 2>>"$directory/stderr.log"; then
      echo true
    else
      echo false
    fi
  ]

  # Provider history/CLI boundary. Compaction uses a normal detached run so
  # the API connection survives dismissal and the worker can reconcile/stop it.
  rawClassMethod: launchCompaction: run token: token [
    local run="$1" token="$2" session ref directory host history pattern argv
    session=$(@ "$run" session) || return 1
    ref=$(@ "$session" lastConversationRef) || return 1
    pattern='^[A-Za-z0-9_-]+$'
    [[ "$ref" =~ $pattern ]] || { echo 'No valid Jcode conversation to compact' >&2; return 1; }
    directory=$(@ Agent::Driver runDirFor: "$run")
    host="${directory%/*}/hosts/$session/jcode"
    history="$host/sessions/$ref.json"
    [[ -s "$history" ]] || { echo 'Native conversation history is missing; compaction was not requested' >&2; return 1; }
    umask 077
    mkdir -p "$directory" || return 1
    cp "$history" "$directory/context-before.json" || return 1
    if [[ -f "${history%.json}.journal.jsonl" ]]; then
      cp "${history%.json}.journal.jsonl" "$directory/context-before.journal.jsonl" || return 1
    fi
    @ Agent::JcodeDriver prepare: "$run" ref: "$ref" || return 1
    argv=$(jq -cn --arg bash "$(command -v bash)" --arg script "${TRASHTALK_DIR:-$HOME/.trashtalk}/lib/jcode-api.bash" \
      --arg directory "$directory" '[$bash,$script,"compact",$directory]') || return 1
    @ Agent::JcodeDriver launchArgv: "$argv" promptFile: /dev/null run: "$run" token: "$token" ref: "$ref"
  ]
