package: Agent

# Agent::Session - A durable conversation between an identity and a workspace
# A session snapshots the archetype/role revisions it was opened with, owns an
# inbox named `session:<id>`, and is the unit that deliveries and runs attach
# to. Lifecycle: open <-> paused, open|paused -> closed -> open (reopen),
# anything -> terminated.
#
# Usage:
#   s=$(@ Agent::Session openFor: $identity archetype: $arch role: $role workspace: /path profile: shell)
#   @ $s pause / resume / close / reopen / terminate
#   @ Agent::Session findFor: $identity workspace: /path
#
# Viewing a session (reading never settles deliveries):
#   @ $s summary            # one line: handle, lifecycle, workspace, pending, run; for listings
#   @ $s details            # multi-line text report of counts, latest run and error; for reading
#   @ $s snapshot           # JSON projection behind details; for scripts and UIs
#   @ $s browse             # interactive picker of session actions (details, messages, runs, retry)
#   @ Agent::Session browse # the same picker over all sessions, starting from a list
#   @ $s focus              # live conversation view for talking to the agent (alias: attach)
Session subclass: Object
  include: Persistable
  include: Agent::LegacyId
  instanceVars: identity:'' archetype:'' archetypeRevision:'' instructionsHash:'' role:''
                roleRevision:'' backendProfile:'' executionPolicy:'single' workspace:''
                lifecycleState:'open' inbox:'' lastConversationRef:'' parentSession:''
                created:'' lastActivityAt:'' sessionPolicyRevision:0 supersededBy:''

  # Scalar persisted-state count, shared with the jq-free shell API.
  # SQL aggregation/index access is the storage boundary, not DSL iteration.
  classPrimitive: activeCount calls: trashtalk_active_session_count

  # Old persisted records predate membership; reads must not enroll them.
  method: sessionPolicyRevision [
    | value |
    value := sessionPolicyRevision.
    (value isEmpty) ifTrue: [^ 0].
    ^ value
  ]

  # SQLite DDL is the persistence boundary, shared by creation and the worker.
  rawClassMethod: ensureSchema [
    pragma: direct
    if [[ "${_AGENT_SESSION_SCHEMA_DB:-}" != "$SQLITE_JSON_DB" ]]; then
      _db_sql -bail < "${TRASHTALK_DIR:-$HOME/.trashtalk}/lib/agent-session-schema.sql" || return 1
      _env_evict_prefix agentidentity_ agentsession_ agentrun_ agentdelivery_ agentarchetype_ agentrole_
      _AGENT_SESSION_SCHEMA_DB="$SQLITE_JSON_DB"
    fi
  ]

  # Common transition rule over lifecycleState.
  method: transitionTo: newState [
    ^ @ self transitionTo: newState with: '{}'
  ]

  method: transitionTo: newState with: patchJson [
    | args |
    args := #{session: self state: newState patch: (patchJson jsonValue)} asJson.
    @ Agent::Session ensureSchema.
    ^ @ Store transaction: 'Agent::Session' sending: 'transitionWithin:' with: args
  ]

  # Lifecycle and identity selection change together. Reopen guards the empty
  # current-session query, so it cannot race ensure/fresh into a second session.
  classMethod: transitionWithin: args [
    | session from to pair data patch present vars |
    @ Store requireTransaction.
    session := @ Store read: (args objectAt: 'session') class: 'Agent::Session'.
    data := @ Store getInstance: session.
    from := ''.
    present := data jsonAt: 'lifecycleState' ifAbsent: 'null'.
    (present ~= 'null') ifTrue: [from := data jsonTextAt: 'lifecycleState'].
    to := args objectAt: 'state'.
    pair := from , ':' , to.
    @ Require member: pair of: '[":terminated","open:paused","paused:open","open:closed","paused:closed","closed:open","open:terminated","paused:terminated","closed:terminated"]'.
    @ self selectionWithin: session transitioningTo: to.
    patch := args jsonAt: 'patch'.
    @ Store patch: session with: patch.
    vars := data jsonAt: '_vars' ifAbsent: '[]'.
    present := @ Require contains: 'lifecycleState' in: vars.
    (present = 'false') ifTrue: [
      vars := vars arrayPush: 'lifecycleState'.
      @ Store patch: session with: (#{_vars: (vars jsonValue)} asJson)
    ].
    @ session lifecycleState: to.
    @ session save.
    ^ to
  ]

  # An identity-scoped session is its identity's current selection while open:
  # opening selects it, closing requires no active runs, and closing or
  # terminating clears the selection. Workspace-scoped sessions are unaffected.
  classMethod: selectionWithin: session transitioningTo: to [
    | identity scope workspace current runs allowed |
    identity := @ session identity.
    (identity isEmpty) ifTrue: [^ ''].
    identity := @ Store read: identity class: 'Agent::Identity'.
    scope := @ identity sessionScope.
    (scope ~= 'identity') ifTrue: [^ ''].
    (to = 'open') ifTrue: [
      workspace := @ session workspace.
      current := @ self currentWithinFor: identity workspace: workspace.
      (current notEmpty) ifTrue: [@ Require equal: current to: session].
      @ identity currentSession: session.
      @ identity save
    ].
    (to = 'closed') ifTrue: [
      runs := @ Agent::Run activeFor: session except: ''.
      @ Require equal: runs to: '[]'
    ].
    allowed := @ Require contains: to in: '["closed","terminated"]'.
    (allowed = 'true') ifTrue: [
      current := @ identity currentSession.
      (current = session) ifTrue: [
        @ identity currentSession: ''.
        @ identity save
      ]
    ].
    ^ ''
  ]

  # All public creation paths use the same guarded transaction.
  classMethod: openFor: identityId archetype: archetypeId role: roleId workspace: path profile: profileName [
    ^ @ self creation: 'openWithin:' for: identityId archetype: archetypeId role: roleId workspace: path profile: profileName replaying: false
  ]

  classMethod: creation: selector for: identityId archetype: archetypeId role: roleId workspace: path profile: profileName replaying: replay [
    | args workspace |
    workspace := @ self workspaceFor: path.
    args := #{identity: identityId archetype: archetypeId role: roleId workspace: workspace profile: profileName} asJson.
    @ self ensureSchema.
    ^ @ Store transaction: self sending: selector with: args replaying: replay
  ]

  # Constructor is private to a Store unit of work; session and inbox publish together.
  classMethod: createWithinFor: identityId archetype: archetypeId role: roleId workspace: path profile: profileName [
    | allowed session now inboxName box revision hash |
    @ Store requireTransaction.
    allowed := @ roleId allowsWorkspace: path.
    @ Require equal: allowed to: 'true'.
    now := @ Time nowISO.
    session := @ Agent::Session new.
    inboxName := 'session:' , session.
    @ session identity: identityId.
    revision := @ identityId sessionPolicyRevision.
    @ session sessionPolicyRevision: revision.
    @ session archetype: archetypeId.
    revision := @ archetypeId revision.
    @ session archetypeRevision: revision.
    hash := @ archetypeId instructionsHash.
    @ session instructionsHash: hash.
    @ session role: roleId.
    revision := @ roleId revision.
    @ session roleRevision: revision.
    @ session backendProfile: profileName.
    @ session workspace: path.
    @ session lifecycleState: 'open'.
    @ session inbox: inboxName.
    @ session created: now.
    @ session lastActivityAt: now.
    @ session save.
    box := @ Inbox new.
    @ box name: inboxName.
    @ box save.
    ^ session
  ]

  # Resolution never creates or picks a conversation from ambiguous history.
  classMethod: currentFor: identityId workspace: path [
    | args |
    args := #{identity: identityId workspace: path} asJson.
    ^ @ Store transaction: self sending: 'resolveWithin:' with: args
  ]

  classMethod: resolveOwnedWithin: args [
    | identity workspace |
    @ Store requireTransaction.
    identity := @ Agent::Access validateIdentity: (args objectAt: 'identity').
    workspace := args objectAt: 'workspace'.
    (@ identity sessionScope = 'workspace') ifTrue: [workspace := @ self workspaceFor: workspace].
    ^ @ self currentWithinFor: identity workspace: workspace
  ]

  classMethod: resolveWithin: args [
    | identityId path |
    @ Store requireTransaction.
    identityId := args objectAt: 'identity'.
    path := args objectAt: 'workspace'.
    ^ @ self currentWithinFor: identityId workspace: path
  ]

  classMethod: currentWithinFor: identityId workspace: path [
    | identity scope fields ids selected valid count revision |
    @ Store requireTransaction.
    identity := @ Store read: identityId class: 'Agent::Identity'.
    scope := @ identity sessionScope.
    @ Require member: scope of: '["workspace","identity"]'.
    (scope = 'workspace') ifTrue: [path := @ self workspaceFor: path].
    revision := @ identity sessionPolicyRevision.
    (revision > 0) ifTrue: [^ @ self memberFor: identity workspace: path scope: scope revision: revision].
    fields := #{identity: identityId lifecycleState: #('open' 'paused')} asJson.
    (scope = 'workspace') ifTrue: [
      fields := #{identity: identityId workspace: path lifecycleState: #('open' 'paused')} asJson
    ].
    ids := @ Store idsOf: 'Agent::Session' matching: fields.
    (scope = 'identity') ifTrue: [
      selected := @ identity currentSession.
      valid := @ Require contains: selected in: ids.
      (valid = 'true') ifTrue: [^ selected]
    ].
    count := ids arrayLength.
    (count > 1) ifTrue: [^ @ Require reject: 'Multiple eligible sessions; select the conversation explicitly before continuing'].
    ^ ids arrayLast
  ]

  # Storage lookup is scalar and guarded, including the no-current-session case.
  rawClassMethod: memberFor: identity workspace: path scope: scope revision: revision [
    local key="$2"
    [[ "$3" != identity ]] || key=''
    _store_guarded_query "SELECT coalesce((SELECT session_id FROM agent_session_memberships
      WHERE identity_id='$(_db_escape "$1")' AND scope_key='$(_db_escape "$key")'
      AND policy_revision='$(_db_escape "$4")'),'')"
  ]

  classMethod: requireCurrentWithin: session [
    | identity revision current sessionRevision workspace |
    @ Store requireTransaction.
    session := @ Store read: session class: 'Agent::Session'.
    identity := @ session identity.
    identity := @ Store read: identity class: 'Agent::Identity'.
    revision := @ identity sessionPolicyRevision.
    (revision > 0) ifTrue: [
      sessionRevision := @ session sessionPolicyRevision.
      @ Require equal: sessionRevision to: revision.
      workspace := @ session workspace.
      current := @ self currentWithinFor: identity workspace: workspace.
      @ Require equal: current to: session
    ].
  ]

  classMethod: ensureFor: identityId archetype: archetypeId role: roleId workspace: path profile: profileName [
    ^ @ self creation: 'ensureWithin:' for: identityId archetype: archetypeId role: roleId workspace: path profile: profileName replaying: true
  ]

  # Guarded queries detect competing creation even for an empty result.
  # Read-only conflict replay can return the winner but cannot create again.
  classMethod: ensureWithin: args [
    | identity path current |
    @ Store requireTransaction.
    identity := args objectAt: 'identity'.
    path := args objectAt: 'workspace'.
    current := @ self currentWithinFor: identity workspace: path.
    (current notEmpty) ifTrue: [^ current].
    ^ @ self openWithin: args
  ]

  classMethod: openWithin: args [
    | identity path archetype role profile session scope current |
    @ Store requireTransaction.
    identity := @ Store read: (args objectAt: 'identity') class: 'Agent::Identity'.
    path := args objectAt: 'workspace'.
    scope := @ identity sessionScope.
    @ Require member: scope of: '["workspace","identity"]'.
    (scope = 'identity') ifTrue: [
      current := @ self currentWithinFor: identity workspace: path.
      (current notEmpty) ifTrue: [^ @ Require reject: 'This identity already has a current session; reuse it or explicitly start fresh']
    ].
    archetype := @ Store read: (args objectAt: 'archetype') class: 'Agent::Archetype'.
    role := @ Store read: (args objectAt: 'role') class: 'Agent::Role'.
    profile := args objectAt: 'profile'.
    session := @ self createWithinFor: identity archetype: archetype role: role workspace: path profile: profile.
    (scope = 'identity') ifTrue: [
      @ identity currentSession: session.
      @ identity save
    ].
    ^ session
  ]

  classMethod: freshFor: identityId archetype: archetypeId role: roleId workspace: path profile: profileName [
    ^ @ self creation: 'freshWithin:' for: identityId archetype: archetypeId role: roleId workspace: path profile: profileName replaying: false
  ]

  # A focused human may explicitly replace the conversation they are currently
  # attached to. Resolve its identity/configuration in the transaction so a
  # stale UI frame cannot replace a different session after a concurrent change.
  classMethod: freshFrom: session [
    ^ @ self freshFrom: session profile: ''
  ]

  # An empty profile keeps the replaced session's backend; a caller that knows
  # the agent's configured profile passes it so a settings change takes effect.
  classMethod: freshFrom: session profile: profile [
    | args |
    args := #{session: session profile: profile} asJson.
    @ self ensureSchema.
    ^ @ Store transaction: self sending: 'freshFromWithin:' with: args
  ]

  classMethod: freshFromWithin: args [
    | current settings profile |
    @ Store requireTransaction.
    current := @ Agent::Access validateLiveSession: (args objectAt: 'session').
    profile := args jsonTextAt: 'profile'.
    (profile isEmpty) ifTrue: [profile := @ current backendProfile].
    settings := #{identity: (@ current identity) archetype: (@ current archetype)
      role: (@ current role) workspace: (@ current workspace)
      profile: profile} asJson.
    ^ @ self freshWithin: settings
  ]

  # Closing and replacement are atomic. Guard both the current-session query
  # and active runs so concurrent creation/start cannot invalidate the decision.
  classMethod: freshWithin: args [
    | identity path current runs |
    @ Store requireTransaction.
    identity := args objectAt: 'identity'.
    path := args objectAt: 'workspace'.
    current := @ self currentWithinFor: identity workspace: path.
    (current notEmpty) ifTrue: [
      runs := @ Agent::Run activeFor: current except: ''.
      @ Require equal: runs to: '[]'.
      current := @ Store read: current class: 'Agent::Session'.
      @ current lifecycleState: 'closed'.
      @ current save
    ].
    ^ @ self replaceWithin: args
  ]

  classMethod: replaceWithin: args [
    | identity session |
    @ Store requireTransaction.
    identity := @ Store read: (args objectAt: 'identity') class: 'Agent::Identity'.
    session := @ self createWithinFor: identity archetype: (args objectAt: 'archetype') role: (args objectAt: 'role') workspace: (args objectAt: 'workspace') profile: (args objectAt: 'profile').
    (@ identity sessionScope = 'identity') ifTrue: [
      @ identity currentSession: session.
      @ identity save
    ].
    ^ session
  ]

  # Open or paused sessions for identity + workspace, newest first
  classMethod: findFor: identityId workspace: path [
    ^ @ Store findByClass: 'Agent::Session'
        matching: (#{identity: identityId workspace: path lifecycleState: #('open' 'paused')} asJson)
        orderBy: "json_extract(data, '$.created') DESC, rowid DESC" limit: 1000
  ]

  # Git toplevel when dir is inside a repo, otherwise the real path of dir
  rawClassMethod: workspaceFor: dir [
    local dir="$1" top revparse="rev-parse" toplevel="--show-toplevel"
    if [[ ! -d "$dir" ]]; then
      _throw "SessionError" "Not a directory: $dir"
      return 1
    fi
    top=$(git -C "$dir" "$revparse" "$toplevel" 2>/dev/null)
    if [[ -n "$top" ]]; then
      (cd "$top" && pwd -P)
      return
    fi
    (cd "$dir" && pwd -P)
  ]

  method: pause [
    ^ @ self transitionTo: 'paused'
  ]

  method: resume [
    ^ @ self transitionTo: 'open'
  ]

  method: close [
    ^ @ self transitionTo: 'closed'
  ]

  alias: reopen for: resume

  method: terminate [
    ^ @ Agent::Worker terminateSession: self
  ]

  method: touch [
    | now |
    now := @ Time nowISO.
    @ Store patch: self with: (#{lastActivityAt: now} asJson)
  ]

  method: inboxObject [
    ^ @ Inbox named: inbox
  ]

  method: pendingDeliveries [
    ^ @ Agent::Delivery pendingFor: self
  ]

  # Id of the run in starting|running|recovering for this session, or empty
  method: activeRun [
    ^ @ Store findByClass: 'Agent::Run'
        matching: (#{session: self state: #('starting' 'running' 'recovering')} asJson)
        orderBy: "json_extract(data, '$.started') DESC, rowid DESC" limit: 1
  ]

  # Number of pending deliveries.
  method: pendingCount [
    | ids count |
    ids := @ Agent::Delivery pendingFor: self.
    count := 0.
    ids linesDo: [:id | count := count + 1].
    ^ count
  ]

  # Inbox name of this session's identity owner, or the local user.
  method: ownerInbox [
    | owner |
    owner := ''.
    (identity notEmpty) ifTrue: [owner := @ identity owner].
    (owner isEmpty) ifTrue: [^ @ Agent::Focus localUser].
    ^ owner
  ]

  method: summary [
    | handle run count |
    handle := @ identity handle.
    run := @ self activeRun.
    (run isEmpty) ifTrue: [run := '-'].
    count := @ self pendingCount.
    ^ self , ' ' , handle , ' ' , lifecycleState , ' ws=' , workspace , ' pending=' , count , ' run=' , run
  ]

  # Ordinary delivery retries are owner-only. Assignment work is retried
  # through the Assignment, which journals the decision.
  method: requeue: deliveryId [
    @ Agent::Queue ensureSchema.
    ^ @ Store transaction: self sending: 'requeueWithin:' with: deliveryId replaying: true
  ]

  method: requeueWithin: deliveryId [
    | actor session identity d state runs value |
    @ Store requireTransaction.
    actor := @ Agent::Run actingContext.
    @ Require equal: (actor objectAt: 'run') to: ''.
    session := @ Store read: self class: 'Agent::Session'.
    identity := @ session identity.
    identity := @ Store read: identity class: 'Agent::Identity'.
    value := @ identity owner.
    @ Require equal: (actor objectAt: 'human') to: value.
    @ Agent::Session requireCurrentWithin: session.
    d := @ Store read: deliveryId class: 'Agent::Delivery'.
    value := @ d session.
    @ Require equal: value to: session.
    value := @ d assignment.
    (value notEmpty) ifTrue: [^ @ Require reject: 'Use the Assignment retry to requeue its work'].
    state := @ d state.
    @ Require member: state of: '["failed","uncertain"]'.
    runs := @ Agent::Run activeFor: session except: ''.
    @ Require equal: runs to: '[]'.
    @ d state: 'pending'.
    @ d save.
    ^ 'pending'
  ]

  # Human-only: give up on a failed or uncertain delivery with a reason.
  method: skip: deliveryId note: text [
    | state owner inboxName line |
    (text isEmpty) ifTrue: [ @ SessionError signal: 'skip: requires a non-empty note' ].
    owner := @ deliveryId session.
    (owner ~= self) ifTrue: [
      @ SessionError signal: 'Delivery ' , deliveryId , ' does not belong to session ' , self
    ].
    state := @ deliveryId state.
    ((state ~= 'failed') and: [state ~= 'uncertain']) ifTrue: [
      @ SessionError signal: 'Delivery ' , deliveryId , ' is ' , state , '; only failed or uncertain deliveries can be skipped'
    ].
    (@ deliveryId transitionTo: 'skipped' with: (#{note: text lastError: text} asJson)) ifFailed: [:e | @ e signal ].
    # Record the skip where the human reads, not in the session inbox: a message
    # to the session would become a new delivery.
    inboxName := @ self ownerInbox.
    line := 'skipped ' , deliveryId , ' in session ' , self , ': ' , text.
    @ Inbox send: line to: inboxName from: 'worker' subject: 'skipped' kind: 'note'.
    ^ 'skipped'
  ]

  # SQL aggregate boundary; presentation and workflow use these public counts.
  rawMethod: deliveryCountIn: states [
    local sid states
    sid=$(_db_escape "$_RECEIVER")
    states=$(_db_escape "$1")
    _db_sql "SELECT count(*) FROM instances WHERE class='Agent::Delivery' AND json_extract(data,'$.session')='$sid' AND json_extract(data,'$.state') IN (SELECT value FROM json_each('$states'));"
  ]

  method: stalledCount [
    ^ @ self deliveryCountIn: '["failed","uncertain"]'
  ]

  # Stalled deliveries outside any Assignment; these hold back dispatch.
  rawMethod: stalledOrdinaryCount [
    local sid
    sid=$(_db_escape "$_RECEIVER")
    _db_sql "SELECT count(*) FROM instances WHERE class='Agent::Delivery' AND json_extract(data,'$.session')='$sid' AND json_extract(data,'$.state') IN ('failed','uncertain') AND coalesce(json_extract(data,'$.assignment'),'')='';"
  ]

  # Single and batch snapshots share one indexed SQL projection. The requested
  # order is retained and each batch observes one SQLite read snapshot.
  method: snapshot [
    ^ @ Agent::Session snapshotsFor: self
  ]

  rawClassMethod: snapshotsFor: sessions [
    local ids
    ids=$(printf '%s' "$1" | jq -Rsc 'split("\n") | map(select(length>0))') || return
    ids=$(_db_escape "$ids")
    _db_sql "SELECT json_object(
      'id',s.id,'identity',json_extract(s.data,'$.identity'),
      'workspace',json_extract(s.data,'$.workspace'),'lifecycle',json_extract(s.data,'$.lifecycleState'),
      'pending',(SELECT count(*) FROM instances d WHERE d.class='Agent::Delivery' AND json_extract(d.data,'$.session')=s.id AND json_extract(d.data,'$.state')='pending'),
      'questions',(SELECT count(*) FROM instances d WHERE d.class='Agent::Delivery' AND json_extract(d.data,'$.session')=s.id AND json_extract(d.data,'$.state')='blocked'),
      'stalled',(SELECT count(*) FROM instances d WHERE d.class='Agent::Delivery' AND json_extract(d.data,'$.session')=s.id AND json_extract(d.data,'$.state') IN ('failed','uncertain')),
      'run',coalesce((SELECT r.id FROM instances r WHERE r.class='Agent::Run' AND json_extract(r.data,'$.session')=s.id ORDER BY r.rowid DESC LIMIT 1),''),
      'activity',coalesce((SELECT json_extract(r.data,'$.state') FROM instances r WHERE r.class='Agent::Run' AND json_extract(r.data,'$.session')=s.id ORDER BY r.rowid DESC LIMIT 1),'idle'),
      'error',coalesce((SELECT json_extract(r.data,'$.error') FROM instances r WHERE r.class='Agent::Run' AND json_extract(r.data,'$.session')=s.id AND coalesce(json_extract(r.data,'$.error'),'')!='' ORDER BY r.rowid DESC LIMIT 1),''))
      FROM instances s JOIN json_each('$ids') requested ON requested.value=s.id ORDER BY CAST(requested.key AS INTEGER);"
  ]

  method: details [
    | data |
    data := @ self snapshot.
    ^ @ Agent::Browser describeSession: data
  ]

  method: runs [
    ^ @ Store findByClass: 'Agent::Run' matching: (#{session: self} asJson) orderBy: 'rowid DESC' limit: 100
  ]

  method: stalledDeliveries [
    ^ @ Store findByClass: 'Agent::Delivery'
        matching: (#{session: self state: #('failed' 'uncertain')} asJson)
        orderBy: 'rowid ASC' limit: 100
  ]

  rawMethod: messageIds [
    local address
    address=$(_db_escape "$(@ "$_RECEIVER" inbox)")
    @ Store findByClass: Message where: "json_extract(data,'$.to')='$address' OR json_extract(data,'$.from')='$address'" orderBy: 'rowid ASC' limit: 200
  ]

  classMethod: browse [
    ^ @ Agent::Browser browse
  ]

  method: browse [
    ^ @ Agent::Browser browseSession: self
  ]

  method: compact [ ^ @ Agent::Context compactSession: self ]
  # Human conversation input is direct session interaction, without inbox mail.
  method: input: text [
    ^ @ Agent::Conversation send: text to: self
  ]

  method: focus [ ^ @ Agent::Focus open: self ]
  alias: attach for: focus

  # Storage migration boundary: guards, retirement, revision, and membership
  # publication must commit in this order. No deliveries or provider data move.
  rawClassMethod: select: session forIdentity: identity owner: owner [
    @ Agent::Session ensureSchema || return 1
    local sid identity owner human
    human=$(@ Agent::Focus human) || return 1
    [[ "$human" == "$3" ]] || return 1
    sid=$(_db_escape "$1"); identity=$(_db_escape "$2"); owner=$(_db_escape "$3")
    @ Store executeBatch: "BEGIN IMMEDIATE;
      CREATE TEMP TABLE selection_guard(ok INTEGER NOT NULL CHECK(ok=1));
      CREATE TEMP TABLE selection_change AS SELECT 1 AS needed WHERE NOT EXISTS(
        SELECT 1 FROM agent_session_memberships m JOIN instances i ON i.id=m.identity_id
        WHERE i.id='$identity' AND m.session_id='$sid' AND m.scope_key=''
          AND json_extract(i.data,'$.sessionScope')='identity'
          AND m.policy_revision=json_extract(i.data,'$.sessionPolicyRevision'));
      INSERT INTO selection_guard SELECT EXISTS(SELECT 1 FROM instances i JOIN instances s
        ON json_extract(s.data,'$.identity')=i.id WHERE i.id='$identity' AND i.class='Agent::Identity'
        AND json_extract(i.data,'$.owner')='$owner' AND json_extract(i.data,'$.enabled') IN (1,'true')
        AND s.id='$sid' AND s.class='Agent::Session' AND json_extract(s.data,'$.lifecycleState') IN ('open','paused'));
      INSERT INTO selection_guard SELECT NOT EXISTS(SELECT 1 FROM instances r JOIN instances s
        ON s.id=json_extract(r.data,'$.session') WHERE r.class='Agent::Run'
        AND json_extract(s.data,'$.identity')='$identity'
        AND json_extract(r.data,'$.state') IN ('starting','running','recovering')) OR NOT EXISTS(SELECT 1 FROM selection_change);
      UPDATE instances SET data=json_set(data,'$.lifecycleState','closed','$.supersededBy','$sid',
        '$._vars',json((SELECT json_group_array(DISTINCT value) FROM (SELECT value FROM json_each(json_extract(data,'$._vars')) UNION SELECT 'supersededBy'))))
        WHERE EXISTS(SELECT 1 FROM selection_change) AND class='Agent::Session' AND id!='$sid' AND json_extract(data,'$.identity')='$identity'
          AND json_extract(data,'$.lifecycleState') IN ('open','paused');
      DELETE FROM agent_session_memberships WHERE identity_id='$identity' AND EXISTS(SELECT 1 FROM selection_change);
      INSERT INTO agent_session_policy_changes SELECT '$identity',coalesce(json_extract(data,'$.sessionPolicyRevision'),0),
        coalesce(json_extract(data,'$.sessionPolicyRevision'),0)+1 FROM instances WHERE id='$identity' AND EXISTS(SELECT 1 FROM selection_change);
      UPDATE instances SET data=json_set(data,'$.sessionScope','identity','$.currentSession','$sid',
        '$.sessionPolicyRevision',coalesce(json_extract(data,'$.sessionPolicyRevision'),0)+1,
        '$._vars',json((SELECT json_group_array(DISTINCT value) FROM (SELECT value FROM json_each(json_extract(data,'$._vars')) UNION SELECT 'sessionScope' UNION SELECT 'currentSession' UNION SELECT 'sessionPolicyRevision'))))
        WHERE id='$identity' AND EXISTS(SELECT 1 FROM selection_change);
      UPDATE instances SET data=json_set(data,'$.sessionPolicyRevision',
        (SELECT json_extract(data,'$.sessionPolicyRevision') FROM instances WHERE id='$identity'),
        '$.supersededBy','',
        '$._vars',json((SELECT json_group_array(DISTINCT value) FROM (SELECT value FROM json_each(json_extract(data,'$._vars')) UNION SELECT 'sessionPolicyRevision' UNION SELECT 'supersededBy')))) WHERE id='$sid' AND EXISTS(SELECT 1 FROM selection_change);
      DELETE FROM agent_session_policy_changes WHERE identity_id='$identity';
      COMMIT;" || return 1
    @ "$2" reload >/dev/null || return 1
    @ "$1" reload >/dev/null || return 1
    printf '%s\n' "$1"
  ]
