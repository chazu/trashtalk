package: Agent

# Human focus is temporary; messages and explicit controls stay in the domain.
Focus subclass: Object
  classMethod: open: session [
    | context human |
    human := @ self human.
    human isEmpty ifTrue: [^ @ Require reject: 'Session focus requires a human context'].
    session := @ Agent::Access liveSession: session.
    session isEmpty ifTrue: [^ @ Require reject: 'Session access denied'].
    context := #{session: session window: 400} asJson.
    ^ @ self openContext: context
  ]

  # Gusgus is the one global human conversation. Opening it remains read-only;
  # when no session exists, the UI creates one only with the first explicit send.
  classMethod: openGusgusIn: workspace [
    | context human profile session |
    human := @ self human.
    human isEmpty ifTrue: [^ @ Require reject: 'Session focus requires a human context'].
    workspace := @ Agent::Session workspaceFor: workspace.
    session := @ Gusgus currentFor: workspace.
    (session notEmpty) ifTrue: [^ @ self open: session].
    profile := @ Gusgus profile.
    context := #{session: '' window: 400 mode: 'gusgus-start'
      workspace: workspace profile: profile} asJson.
    ^ @ self openContext: context
  ]

  classMethod: openContext: context [
    | available argv |
    available := @ Tools::Inagent isInstalled.
    (available ~= 'true') ifTrue: [^ @ Require reject: 'inagent is not installed; build and install the Innards applet'].
    argv := @ Tools::Inagent argv.
    ^ @ Tool duplexArgvJson: argv handler: 'Agent::Focus' context: context
  ]

  classMethod: frameFor: context [
    | mode session |
    session := context jsonTextAt: 'session'.
    (session isEmpty) ifTrue: [
      mode := context jsonTextAt: 'mode'.
      @ Require equal: mode to: 'gusgus-start'.
      ^ #{schema_version: 1 type: 'start' agent: 'Gusgus' scope: 'global'
        workspace: (context jsonTextAt: 'workspace')
        profile: (context jsonTextAt: 'profile')} asJson
    ].
    session := @ Agent::Access session: session.
    session isEmpty ifTrue: [^ @ Require reject: 'Session access denied'].
    ^ @ Agent::Transcript snapshotFor: session limit: (context jsonTextAt: 'window')
  ]

  classMethod: markViewed: messages inSession: session [
    | included |
    session := @ Agent::Access session: session.
    session isEmpty ifTrue: [^ @ Require reject: 'Session access denied'].
    included := @ Agent::Transcript includesMessages: messages inSession: session.
    (included ~= 'true') ifTrue: [^ @ Require reject: 'Message does not belong to this conversation'].
    messages arrayEach: [:message | @ message markViewed].
    ^ 'Messages marked read'
  ]

  classMethod: perform: intent session: session body: body run: run [
    | result inbox message state allowed recipient sender workspace |
    # Native input validates current ownership and membership under the worker
    # lock. Reuse that authoritative admission instead of validating twice here.
    (intent = 'send_message') ifTrue: [^ @ session input: body].
    session := @ Agent::Access session: session.
    session isEmpty ifTrue: [^ @ Require reject: 'Session access denied'].
    (intent = 'start_fresh_session') ifTrue: [^ @ Agent::Session freshFrom: session].
    (intent = 'compact_session') ifTrue: [^ @ session compact].
    (intent = 'pause_session') ifTrue: [^ @ session pause].
    (intent = 'resume_session') ifTrue: [
      result := @ session resume.
      (result = 'open') ifTrue: [result := @ Agent::Worker tickSession: session].
      ^ 'Resumed'
    ].
    (intent = 'interrupt_run') ifTrue: [
      allowed := @ self run: run belongsTo: session.
      (allowed ~= 'true') ifTrue: [^ @ Require reject: 'The displayed run does not belong to this session'].
      ^ @ Agent::Worker stopRun: run
    ].
    ^ @ Require reject: 'Unsupported session intent'
  ]

  # Fresh run attribution applies to public controls as well as UI frames.
  rawClassMethod: run: run belongsTo: session [
    db_get "$1" | jq -r --arg session "$2" '.class=="Agent::Run" and .session==$session'
  ]

  # Cheap read-only change probe for the polling view. It covers every record
  # frameFor: authorizes or projects (identity, session, memberships, runs,
  # deliveries, session mail, run log sizes/mtimes) plus the view context, so
  # an unchanged token means an unchanged and still-authorized frame.
  rawClassMethod: changeTokenFor: context [
    local sid esid members rows memberships runs files base
    sid=$(jq -er '.session | select(type=="string")' <<< "$1") || return 1
    if [[ -z "$sid" ]]; then
      jq -e '.mode=="gusgus-start" and (.workspace|type=="string" and length>0) and (.profile|type=="string" and length>0)' <<< "$1" >/dev/null || return 1
      printf '%s\n' "$1" | shasum -a 256 | cut -d ' ' -f 1
      return
    fi
    esid=$(_db_escape "$sid")
    rows=$(_db_sql "SELECT id||' '||data FROM instances WHERE id='$esid'
      OR id=(SELECT json_extract(data,'$.identity') FROM instances WHERE id='$esid')
      OR (class IN ('Agent::Run','Agent::Delivery') AND json_extract(data,'$.session')='$esid')
      OR (class='Message' AND (json_extract(data,'$.from')='session:$esid' OR json_extract(data,'$.to')='session:$esid'
        OR EXISTS(SELECT 1 FROM instances d,json_each(json_extract(d.data,'$.messageIds')) j
          WHERE d.class='Agent::Delivery' AND json_extract(d.data,'$.session')='$esid' AND j.value=instances.id)))
      ORDER BY id;") || return 1
    members=$(_db_sql "SELECT EXISTS(SELECT 1 FROM sqlite_master WHERE type='table' AND name='agent_session_memberships');") || return 1
    memberships=''
    if [[ "$members" == 1 ]]; then
      memberships=$(_db_sql "SELECT * FROM agent_session_memberships WHERE session_id='$esid'
        OR identity_id=(SELECT json_extract(data,'$.identity') FROM instances WHERE id='$esid') ORDER BY 1,2,3;") || return 1
    fi
    runs=$(_db_sql "SELECT id FROM instances WHERE class='Agent::Run' AND json_extract(data,'$.session')='$esid' ORDER BY id;") || return 1
    base=$(@ Agent::Driver runDirFor: "$sid") || return 1
    files=$(perl "${TRASHTALK_DIR:-$HOME/.trashtalk}/lib/run-files-stamp.pl" "${base%/*}" $runs) || return 1
    printf '%s\n%s\n%s\n%s\n' "$1" "$rows" "$memberships" "$files" | shasum -a 256 | cut -d ' ' -f 1
  ]

  rawClassMethod: human [
    [[ ! ${TRASHTALK_RUN_TOKEN+x} ]] || { echo 'Human session focus cannot use a run token' >&2; return 1; }
    printf '%s\n' "${TRASHTALK_USER:-${USER:-user}}"
  ]

  # Trust/serialization boundary: fixed intent schema, pinned session/run, and
  # nonzero action failures become feedback without discarding the draft.
  rawClassMethod: handleFrame: frame context: context [
    local frame="$1" context="$2" intent sid body run state request window result replacement='' ok=true session workspace
    @ Agent::Focus human >/dev/null || return 1
    jq -e 'type=="object" and .schema_version==1 and (.request_id|type=="number" and floor==. and .>0) and
      (.intent|IN("dismiss","load_older","start_conversation","send_message","mark_viewed","pause_session","resume_session","interrupt_run","compact_session","start_fresh_session")) and
      (if .intent=="mark_viewed" then (.message_ids|type=="array" and length>0 and length<=200 and all(.[];type=="string")) else true end) and
      (if (.intent=="send_message" or .intent=="start_conversation") then (.body|type=="string" and length>0 and length<=100000 and (contains("\u0000")|not) and test("\\S")) else true end) and
      (if .intent=="interrupt_run" then (.run_id|type=="string" and length>0) else true end)' <<< "$frame" >/dev/null || return 1
    intent=$(jq -r .intent <<< "$frame")
    request=$(jq -r .request_id <<< "$frame")
    sid=$(jq -r '.session // ""' <<< "$context")
    if [[ "$intent" == dismiss ]]; then
      jq -cn --argjson context "$context" '{context:$context,done:true}'; return
    fi
    IFS= read -r -d '' body < <(jq -jr '(.body // ""), "\u0000"' <<< "$frame")
    if [[ "$intent" == start_conversation ]]; then
      [[ -z "$sid" ]] || return 1
      workspace=$(jq -er 'select(.mode=="gusgus-start") | .workspace | select(type=="string" and length>0)' <<< "$context") || return 1
      session=$(@ Gusgus sessionFor: "$workspace" 2>&1) || { result="$session"; session=''; ok=false; }
      if [[ -n "$session" ]]; then
        context=$(jq -c --arg session "$session" '.session=$session | del(.mode)' <<< "$context") || return 1
        result=$(@ Agent::Focus perform: send_message session: "$session" body: "$body" run: '' 2>&1) || ok=false
        [[ -n "$result" ]] || { result='Action failed; inspect the session before retrying'; ok=false; }
      fi
    else
      [[ -n "$sid" ]] || return 1
      state=$(db_get "$sid" | jq -er 'select(.class=="Agent::Session") | .lifecycleState') || return 1
      if [[ "$intent" == start_fresh_session ]]; then
        result=$(@ Agent::Focus perform: "$intent" session: "$sid" body: "$body" run: '' 2>&1) || ok=false
        if [[ "$ok" == true && -n "$result" ]]; then
          replacement=$result
          context=$(jq -c --arg session "$replacement" '.session=$session' <<< "$context") || return 1
          result='Started a fresh conversation'
        fi
      elif [[ "$intent" == mark_viewed ]]; then
        result=$(@ Agent::Focus markViewed: "$(jq -c .message_ids <<< "$frame")" inSession: "$sid" 2>&1) || ok=false
      elif [[ "$intent" == load_older ]]; then
        @ Agent::Access session: "$sid" >/dev/null || return 1
        window=$(jq -r '.window' <<< "$context")
        if (( window >= 100000 )); then result='History limit reached (100,000 entries); inspect older run logs through Session actions.'; ok=false
        else context=$(jq -c '.window = ([.window*2,100000]|min)' <<< "$context"); result='Loaded earlier history'; fi
      else
        run=$(jq -r '.run_id // ""' <<< "$frame")
        result=$(@ Agent::Focus perform: "$intent" session: "$sid" body: "$body" run: "$run" 2>&1) || ok=false
        [[ -n "$result" ]] || { result='Action failed; inspect the session before retrying'; ok=false; }
      fi
    fi
    jq -cn --argjson context "$context" --argjson request "$request" --argjson ok "$ok" --arg text "$result" --arg intent "$intent" --arg session "$replacement" \
      '{context:$context,frame:{schema_version:1,type:"ack",request_id:$request,ok:$ok,result:$text,
        session:(if $ok and $intent=="start_fresh_session" then $session else null end),
        message:(if $ok and $intent=="start_conversation" then "Conversation started; input sent"
          elif $ok and $intent=="send_message" then "Input sent to agent session" else $text end)}}'
  ]
