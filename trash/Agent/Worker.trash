package: Agent

# Agent::Worker - Foreground dispatch and reconciliation for agent sessions.
# `@@` and Inbox deliver: call it directly; bin/trash-worker runs the same
# tick under a user OS supervisor. A tick reconciles the session's active run (if its process
# has exited) and then claims pending deliveries into one new detached run.
#
#   @ Agent::Worker tick                        # every open/paused session
#   @ Agent::Worker tickSession: $session       # one session
#   @ Agent::Worker deliverMessage: $msg toInbox: 'session:...'   # Inbox hook
#
# Environment:
#   TRASHTALK_NO_AUTOTICK=1   suppress foreground ticks (not the service)
#   TRASHTALK_RUN_DIR         where per-run prompt/log/pid files live
Worker subclass: Object

  classMethod: driverFor: profile [
    ^ profile caseOf: {
      'shell' -> [ 'Agent::ShellDriver' ].
      'maki' -> [ 'Agent::MakiDriver' ].
      'jcode' -> [ 'Agent::JcodeDriver' ].
      #('codex' 'assistant-low-power' '') -> [ 'Agent::CodexDriver' ]
    } otherwise: [ @ WorkerError signal: 'Unknown backend profile ' , profile ]
  ]

  classMethod: handlesInbox: inboxName [
    | prefix |
    prefix := inboxName upTo: ':'.
    ^ (prefix = 'session') or: [prefix = 'agent']
  ]

  classMethod: sessionForInbox: inboxName [
    ^ @ Store findByClass: 'Agent::Session' matching: (#{inbox: inboxName} asJson)
        orderBy: 'created_at DESC' limit: 1
  ]

  classMethod: eligibleSessionsFor: identityId [
    ^ @ Store findByClass: 'Agent::Session'
        matching: (#{identity: identityId lifecycleState: #('open' 'paused')} asJson)
        orderBy: 'created_at DESC' limit: 100
  ]

  # ------------------------------------------------------------------
  # Inbound: a message landed in a session or identity inbox
  # ------------------------------------------------------------------

  rawClassMethod: deliverMessage: messageId toInbox: inboxName [
    local msg="$1" name="$2" prefix="${2%%:*}" session="" identity handle sessions count ids blocked
    if [[ "$prefix" == session ]]; then
      session=$(@ "$_RECEIVER" sessionForInbox: "$name")
    elif [[ "$prefix" == agent ]]; then
      handle="${name#agent:}"
      identity=$(@ Agent::Identity findByHandle: "$handle")
      [[ -n "$identity" ]] || return 0
      sessions=$(@ "$_RECEIVER" eligibleSessionsFor: "$identity")
      count=$(printf '%s' "$sessions" | grep -c .)
      [[ "$count" -eq 1 ]] || return 0
      session="$sessions"
    fi
    blocked=$(@ Agent::Queue assignmentSessionForReply: "$msg") || return 1
    [[ -z "$blocked" ]] || session="$blocked"
    [[ -n "$session" ]] || return 0
    ids=$(jq -cn --arg m "$msg" '[$m]')
    @ Agent::Queue assign: "$session" messages: "$ids" outbox: "$msg" >/dev/null || return 1
    if [[ "${TRASHTALK_NO_AUTOTICK:-}" == 1 ]]; then return 0; fi
    @ "$_RECEIVER" tickSession: "$session" >/dev/null
    return 0
  ]

  # Route durable outbox rows without recursively launching foreground ticks.
  rawClassMethod: routePending [
    local msg address rc=0 TRASHTALK_NO_AUTOTICK=1
    for msg in $(@ Agent::Queue pending); do
      @ Agent::Queue attempted: "$msg" || return 1
      @ "$msg" reload >/dev/null || return 1
      address=$(@ "$msg" to)
      # One denied or stale route stays durable for review and must not block
      # unrelated inboxes. attempted_at moves it behind fresh work on retry.
      @ Agent::Worker deliverMessage: "$msg" toInbox: "$address" || rc=1
    done
    return "$rc"
  ]

  rawClassMethod: tickableSessions [
    @ Store findByClass: Agent::Session where: "json_extract(data,'$.lifecycleState') IN ('open','paused') OR id IN (SELECT json_extract(data,'$.session') FROM instances WHERE class='Agent::Run' AND json_extract(data,'$.state') IN ('starting','running','recovering'))" orderBy: 'created_at ASC' limit: 1000
  ]

  # Supervisor probe: an active run still needs prompt reconciliation, so
  # bin/trash-worker keeps its base polling interval while one exists and backs
  # off otherwise. One indexed query; foreground delivery never waits on it.
  rawClassMethod: hasActiveRuns [
    local count
    count=$(_db_sql "SELECT count(*) FROM instances WHERE class='Agent::Run' AND json_extract(data,'$.state') IN ('starting','running','recovering');") || return 1
    if [[ "$count" == 0 ]]; then echo false; else echo true; fi
  ]

  # Same lock for manual ticks and supervised workers, scoped to this store.
  rawClassMethod: lockPath [
    local path
    path=$(perl -MCwd=abs_path -e 'print abs_path(shift) // die "missing database"' "$SQLITE_JSON_DB") || return 1
    printf '%s.worker.lock\n' "$path"
  ]

  # Source reads/CUE must not run under the agent OS lock. The local stage
  # never routes its Messages. Existing agent reconciliation remains unchanged.
  rawClassMethod: tick [
    pragma: direct
    local rc=0
    # The lock path is one Perl process per store; resolve it once per process.
    if [[ "${_AGENT_WORKER_LOCK_DB:-}" != "$SQLITE_JSON_DB:$PWD" || -z "${_AGENT_WORKER_LOCK_PATH:-}" ]]; then
      _AGENT_WORKER_LOCK_PATH=$(@ Agent::Worker lockPath) || return 1
      _AGENT_WORKER_LOCK_DB="$SQLITE_JSON_DB:$PWD"
    fi
    # Warm the per-process schema memos here, outside the lock: work: runs in a
    # lock subshell, so a memo set there would otherwise rerun the DDL every tick.
    @ Agent::Queue ensureSchema || return 1
    @ Process withLock: "$_AGENT_WORKER_LOCK_PATH" receiver: Agent::Worker selector: 'work:' argument: '' || rc=1
    @ Workstation::Worker tick || rc=1
    # The prompt indicator follows every tick; it is a hint and never a failure.
    @ AgentWorkboard publishIndicator >/dev/null
    return "$rc"
  ]

  classMethod: tickSession: sessionId [
    | path |
    path := @ self lockPath.
    ^ @ Process withLock: path receiver: self selector: 'work:' argument: sessionId
  ]

  # Cooperative API authority. A local user may stop a run; an agent must have
  # agent.stop and share the target's owner. Recheck inside the worker lock.
  rawClassMethod: authorizeStop: run [
    local actor session role caps
    [[ $(db_get "$1" | jq -r '.class // empty') == Agent::Run ]] || return 1
    if [[ -n "${TRASHTALK_RUN_TOKEN:-}" ]]; then
      actor=$(@ Agent::Run current) || return 1
      session=$(@ "$actor" session)
      role=$(@ "$session" role)
      caps=$(@ "$role" capabilities)
      jq -e 'if type=="string" then fromjson else . end | index("agent.stop") != null' <<<"$caps" >/dev/null || {
        _throw 'RunError' 'Role does not allow agent.stop'; return 1;
      }
      [[ "$(@ Agent::Run ownerInboxFor: "$actor")" == "$(@ Agent::Run ownerInboxFor: "$1")" ]] || {
        _throw 'RunError' 'Cannot stop a run belonging to another owner'; return 1;
      }
    fi
    echo true
  ]

  # Whole seconds a user control operation queues behind a running tick.
  classMethod: controlWait [
    | seconds |
    seconds := @ Env get: 'TRASHTALK_CONTROL_WAIT' default: '30'.
    (seconds matches: '^[0-9]{1,4}$') ifTrue: [^ seconds].
    ^ 30
  ]

  rawClassMethod: stopRun: run [
    local path result
    path=$(@ Agent::Worker lockPath) || return 1
    result=$(@ Process withLock: "$path" receiver: Agent::Worker selector: 'stopOwnedRun:' argument: "$1" waiting: "$(@ Agent::Worker controlWait)") || return 1
    if [[ -n "$result" ]]; then
      [[ "$result" == interrupted || "$result" == 'already-stopped' ]] || { printf '%s\n' "$result" >&2; return 1; }
      printf '%s\n' "$result"
      return 0
    fi
    _throw 'WorkerError' 'Worker is busy; stop was not applied. Try again.'
    return 1
  ]

  classMethod: stopOwnedRun: run [
    | authorized state session active result |
    authorized := @ self authorizeStop: run.
    (authorized = 'true') ifFalse: [^ 'Stop is not authorized.'].
    @ run reload.
    state := @ run state.
    (state = 'interrupted') ifTrue: [^ 'already-stopped'].
    session := @ run session.
    active := @ session activeRun.
    (active = run) ifFalse: [^ 'Run is no longer active; no replacement was stopped.'].
    state := @ session lifecycleState.
    (state = 'open') ifTrue: [result := @ session pause].
    # Revoke before signalling, including when cancellation cannot be confirmed.
    @ Store patch: run with: '{"capabilityTokenHash":"","stopRequested":"true"}'.
    ^ @ self finishStop: run
  ]

  classMethod: finishStop: run [
    | step |
    step := @ self interrupt: run beforeLaunch: 'Run stopped before launch' launched: 'Run explicitly stopped'.
    ^ step caseOf: {
      'done' -> [ 'interrupted' ].
      #('driver' 'interrupt') -> [ 'Stop remains unconfirmed; session paused. Retry stop on this run.' ].
      'deliveries' -> [ 'Unable to record unsettled deliveries; retry stop.' ]
    } otherwise: [ 'Unable to record stop outcome; retry stop.' ]
  ]

  # Shared stop tail: interrupt the harness, keep its conversation, mark
  # unsettled deliveries, then record the run outcome. Answers 'done' or the
  # step that failed: driver, interrupt, deliveries or outcome.
  classMethod: interrupt: run beforeLaunch: early launched: late [
    | profile driver stopped result state |
    profile := @ run backendProfile.
    driver := @ self driverFor: profile.
    driver isEmpty ifTrue: [^ 'driver'].
    stopped := @ driver interrupt: run.
    (stopped = 'true') ifFalse: [^ 'interrupt'].
    @ self rememberConversationFor: run.
    # Record unsettled work before closing the run so a failed write is retryable.
    result := @ Agent::Delivery interruptFor: run.
    (result = 'true') ifFalse: [^ 'deliveries'].
    state := @ run state.
    (state = 'starting') ifTrue: [
      result := @ run finishWith: 'failed' outcome: '{}' error: early
    ] ifFalse: [
      result := @ run finishWith: 'interrupted' outcome: '{}' error: late
    ].
    result isEmpty ifTrue: [^ 'outcome'].
    ^ 'done'
  ]

  classMethod: rememberConversationFor: run [
    | profile driver ref session patch |
    profile := @ run backendProfile.
    driver := @ self driverFor: profile.
    ref := @ driver conversationRefFor: run.
    ref notEmpty ifTrue: [
      patch := #{externalConversationRef: ref} asJson.
      @ Store patch: run with: patch.
      session := @ run session.
      patch := #{lastConversationRef: ref} asJson.
      @ Store patch: session with: patch
    ]
  ]

  # Process-lock boundary: queue behind an in-progress tick rather than
  # silently dropping a user control operation when the lock is busy.
  rawClassMethod: terminateSession: sessionId [
    local path result
    path=$(@ Agent::Worker lockPath) || return 1
    result=$(@ Process withLock: "$path" receiver: Agent::Worker selector: 'terminateOwnedSession:' argument: "$1" waiting: "$(@ Agent::Worker controlWait)") || return 1
    if [[ -n "$result" ]]; then
      [[ "$result" == terminated ]] || { printf '%s\n' "$result" >&2; return 1; }
      printf '%s\n' "$result"
      return 0
    fi
    _throw 'WorkerError' 'Worker is busy; session termination was not applied. Try again.'
    return 1
  ]

  classMethod: terminateOwnedSession: session [
    | state run step |
    @ session reload.
    state := @ session lifecycleState.
    (state = 'terminated') ifFalse: [state := @ session transitionTo: 'terminated'].
    (state = 'terminated') ifFalse: [^ 'Unable to terminate the session.'].
    run := @ session activeRun.
    run isEmpty ifTrue: [^ 'terminated'].
    @ run reload.
    step := @ self interrupt: run beforeLaunch: 'Session terminated before launch' launched: 'Session terminated by the user'.
    ^ step caseOf: {
      'done' -> [ 'terminated' ].
      'driver' -> [ 'Session terminated, but its harness driver is unavailable; process stop is unconfirmed.' ].
      'interrupt' -> [ 'Session terminated, but the harness has not stopped. Inspect its logs and retry termination.' ].
      'deliveries' -> [ 'Session terminated; unable to record unsettled deliveries.' ]
    } otherwise: [ 'Session terminated; unable to record the run stop outcome.' ]
  ]

  # Work runs only while holding the OS lock; every tick repairs outbox routing.
  # A full tick visits live sessions plus any session still owning an active
  # run; terminated sessions with settled runs cost nothing under the lock.
  rawClassMethod: work: sessionId [
    local ids session state run rc=0
    @ Agent::Queue refresh || return 1
    @ Agent::Worker routePending || rc=1
    if [[ -n "$1" ]]; then ids="$1"; else ids=$(@ Agent::Worker tickableSessions); fi
    for session in $ids; do
      @ Agent::Worker tickOwnedSession: "$session" || rc=1
    done
    @ Agent::Delegation reconcile >/dev/null || rc=1
    return "$rc"
  ]

  # ------------------------------------------------------------------
  # Ticks
  # ------------------------------------------------------------------

  # Reconcile the active run if any; then dispatch pending work. Prints the id
  # of a newly started run, or nothing.
  classMethod: tickOwnedSession: sessionId [
    | run outcome |
    run := (@ sessionId activeRun) ifFailed: [:error | @ error signal].
    (run notEmpty) ifTrue: [
      outcome := (@ self reconcileRun: run) ifFailed: [:error | @ error signal].
      (outcome = 'running') ifTrue: [^ '']
    ].
    ^ @ self dispatchOwnedSession: sessionId
  ]

  # ------------------------------------------------------------------
  # Reconciliation
  # ------------------------------------------------------------------

  # Prints the run's resulting state: running (still alive) or a terminal state.
  classMethod: reconcileRun: runId [
    | session profile driver outcome final owner deliveries hasOffered hasBlocked resident reason detail |
    ((@ runId stopRequested) = 'true') ifTrue: [
      final := (@ self finishStop: runId) ifFailed: [:error | @ error signal].
      (final = 'interrupted') ifTrue: [^ 'interrupted'].
      ^ 'running'
    ].
    ((@ runId state) = 'starting') ifTrue: [
      (@ self failRun: runId error: 'worker stopped before launch') ifFailed: [:error | @ error signal].
      ^ 'failed'
    ].
    ((@ runId isProcessAlive) = 'true') ifTrue: [
      (@ runId markHeartbeat) ifFailed: [:error | @ error signal].
      ^ 'running'
    ].
    # Refresh durable delivery state: the harness may have settled after the tick snapshot.
    (@ Agent::Queue refresh) ifFailed: [:error | @ error signal].
    session := @ runId session.
    profile := @ runId backendProfile.
    driver := (@ self driverFor: profile) ifFailed: [:error | @ error signal].
    outcome := (@ driver outcomeOf: runId) ifFailed: [:error | @ error signal].
    resident := outcome jsonAt: 'resident_unconfirmed' ifAbsent: 'false'.
    outcome jsonUnpack: #('exited' 'exit_code' 'result_seen' 'conversation_ref' 'error') into: [:exited :code :seen :ref :reason |
      (ref = 'null') ifTrue: [ref := ''].
      (ref notEmpty) ifTrue: [
        (@ Store patch: runId with: (#{externalConversationRef: ref} asJson)) ifFailed: [:error | @ error signal].
        (@ Store patch: session with: (#{lastConversationRef: ref} asJson)) ifFailed: [:error | @ error signal]
      ].
      (resident = 'true') ifTrue: [
        # A resident harness may still be working after its adapter disappears.
        # Fence its authority and dispatch, retaining the exact active run for stop.
        (@ Store patch: runId with: (#{capabilityTokenHash: '' error: 'Jcode connection lost without completion; stop the run before resuming'} asJson)) ifFailed: [:error | @ error signal].
        ((@ session lifecycleState) = 'open') ifTrue: [(@ session pause) ifFailed: [:error | @ error signal] ].
        ((@ runId state) = 'running') ifTrue: [(@ runId transitionTo: 'recovering') ifFailed: [:error | @ error signal] ].
        ^ 'running'
      ].
      (exited ~= 'true') ifTrue: [
        (@ self failRun: runId error: 'process vanished without an exit status; inspect logs before retrying') ifFailed: [:error | @ error signal].
        ^ 'failed'
      ].
      (code ~= '0') or: [seen ~= 'true'] ifTrue: [
        (code = 'null') ifTrue: [code := 'none'].
        (reason = 'null') ifTrue: [reason := ''].
        (reason isEmpty) ifTrue: [reason := 'exit ' , code , ', result_seen=' , seen].
        (@ self failRun: runId error: reason) ifFailed: [:error | @ error signal].
        ^ 'failed'
      ]
    ].
    hasOffered := 'false'.
    hasBlocked := 'false'.
    deliveries := @ Agent::Delivery offeredFor: runId.
    deliveries linesDo: [:delivery |
      (@ delivery reload) ifFailed: [:error | @ error signal].
      (@ delivery state) caseOf: {
        'offered' -> [
          (@ delivery transitionTo: 'uncertain') ifFailed: [:error | @ error signal].
          hasOffered := 'true'
        ].
        'blocked' -> [hasBlocked := 'true']
      } otherwise: []
    ].
    (hasOffered = 'true') ifTrue: [
      final := 'unsettled'.
      reason := outcome jsonAt: 'stop_reason' ifAbsent: 'null'.
      (reason = 'null') or: [reason = 'false'] ifTrue: [outcome := outcome objectAt: 'stop_reason' put: 'unfinished'].
      detail := outcome jsonAt: 'stop_detail' ifAbsent: 'null'.
      (detail = 'null') or: [detail = 'false'] ifTrue: [outcome := outcome objectAt: 'stop_detail' put: 'Provider turn ended without completing the Assignment or settling its delivery; budget exhaustion is not confirmed'].
      owner := @ session ownerInbox.
      (@ Inbox alert: ('Run ' , runId , ' in session ' , session , ' exited without settling every delivery; they are marked uncertain. Inspect the recorded effects. For Assignment deliveries use Assignment continue:afterDelivery:key:; for ordinary deliveries use session requeue or skip.') to: owner from: 'worker') ifFailed: [:error | @ error signal]
    ] ifFalse: [
      (hasBlocked = 'true') ifTrue: [final := 'waiting_for_user'] ifFalse: [final := 'succeeded']
    ].
    (@ runId finishWith: final outcome: outcome error: '') ifFailed: [:error | @ error signal].
    ^ final
  ]

  # Only a failure before launch is safe to retry automatically. Once launched,
  # even a silent process may have produced effects; offered work becomes uncertain.
  classMethod: failRun: runId error: err [
    | session role limit oldstate deliveries owner attempts driver outcome profile |
    session := @ runId session.
    role := @ session role.
    limit := @ role retryLimit.
    (limit matches: '^[0-9]+$') ifFalse: [limit := 2].
    oldstate := @ runId state.
    deliveries := @ Agent::Delivery offeredFor: runId.
    deliveries linesDo: [:delivery |
      (@ delivery reload) ifFailed: [:error | @ error signal].
      ((@ delivery state) = 'offered') ifTrue: [
        (@ Store patch: delivery with: (#{lastError: err} asJson)) ifFailed: [:error | @ error signal].
        (oldstate ~= 'starting') ifTrue: [
          (@ delivery transitionTo: 'uncertain') ifFailed: [:error | @ error signal].
          owner := @ session ownerInbox.
          (@ Inbox alert: ('Delivery ' , delivery , ' needs review after run ' , runId , ': ' , err , '. Inspect its logs before retrying.') to: owner from: 'worker') ifFailed: [:error | @ error signal]
        ] ifFalse: [
          (@ delivery transitionTo: 'failed') ifFailed: [:error | @ error signal].
          attempts := @ delivery attempts.
          (attempts < limit) ifTrue: [
            (@ delivery transitionTo: 'pending') ifFailed: [:error | @ error signal]
          ] ifFalse: [
            owner := @ session ownerInbox.
            (@ Inbox alert: ('Delivery ' , delivery , ' in session ' , session , ' stalled after ' , attempts , ' attempts: ' , err , '. Skip it with: @ ' , session , ' skip: ' , delivery , ' note: reason') to: owner from: 'worker') ifFailed: [:error | @ error signal]
          ]
        ]
      ]
    ].
    profile := @ runId backendProfile.
    driver := (@ self driverFor: profile) ifFailed: [:error | @ error signal].
    outcome := (@ driver outcomeOf: runId) ifFailed: [:error | @ error signal].
    (@ runId finishWith: 'failed' outcome: outcome error: err) ifFailed: [:error | @ error signal].
    ^ ''
  ]

  # ------------------------------------------------------------------
  # Dispatch
  # ------------------------------------------------------------------

  # Claim one compatible workspace batch into a new run. Prints the run id,
  # or nothing when no authorized batch could be admitted.
  rawClassMethod: dispatchOwnedSession: sessionId [
    local session="$1" state pending profile driver run token d claimed="" run_dir prompt_file ref pid rc workspace
    state=$(@ "$session" lifecycleState)
    [[ "$state" == open ]] || return 0
    [[ "$(@ "$session" stalledCount)" == 0 ]] || return 0
    pending=$(@ "$session" pendingDeliveries)
    [[ -n "$pending" ]] || return 0
    read -r d <<< "$pending"
    if ! workspace=$(@ Agent::WorkContext prepareDelivery: "$d"); then
      @ "$d" transitionTo: failed with: '{"lastError":"Execution workspace is missing, unavailable, or no longer authorized; review before retrying"}' >/dev/null
      return 0
    fi
    profile=$(@ "$session" backendProfile)
    driver=$(@ "$_RECEIVER" driverFor: "$profile") || return 1
    { read -r run; read -r token; } < <(@ Agent::Run startFor: "$session" profile: "$profile" workspace: "$workspace")
    if [[ -z "$run" || -z "$token" ]]; then
      _throw "WorkerError" "could not start a run for session $session"
      return 1
    fi
    for d in $pending; do
      [[ "$(@ "$d" executionWorkspace)" == "$workspace" ]] || continue
      @ Agent::WorkContext prepareDelivery: "$d" >/dev/null || continue
      if [[ "$(@ Agent::Delivery claim: "$d" run: "$run")" == true ]]; then
        claimed="$claimed $d"
      fi
    done
    claimed="${claimed# }"
    if [[ -z "$claimed" ]]; then
      @ "$run" delete >/dev/null 2>&1
      return 0
    fi
    run_dir=$(@ Agent::Driver runDirFor: "$run")
    @ Agent::Driver prepareContextFor: "$run" token: "$token" || return 1
    prompt_file="$run_dir/prompt.txt"
    @ "$_RECEIVER" writePrompt: "$prompt_file" run: "$run" session: "$session" deliveries: "$claimed"
    ref=$(@ "$session" lastConversationRef)
    for d in $claimed; do
      [[ "$(@ "$d" freshConversation)" != true ]] || ref=''
    done
    if [[ -n "$ref" ]]; then
      pid=$(@ "$driver" resume: "$ref" promptFile: "$prompt_file" run: "$run" token: "$token")
    else
      pid=$(@ "$driver" launch: "$prompt_file" run: "$run" token: "$token")
    fi
    rc=$?
    if [[ $rc -ne 0 || -z "$pid" ]]; then
      @ "$_RECEIVER" failRun: "$run" error: "launch failed"
      return 1
    fi
    @ "$session" touch >/dev/null
    printf '%s\n' "$run"
  ]

  # The prompt is a stable prefix (archetype instructions, then the fixed
  # trash-send instructions) followed by the deliveries.
  rawClassMethod: writePrompt: promptFile run: runId session: sessionId deliveries: ids [
    local prompt_file="$1" run_id="$2" session="$3" ids="$4"
    local archetype instructions workspace tdir ts d m inbox assignment kind
    archetype=$(@ "$session" archetype)
    instructions=$(@ "$archetype" instructions)
    workspace=$(@ "$run_id" executionWorkspace)
    tdir="${TRASHTALK_DIR:-$HOME/.trashtalk}"
    printf -v ts '%q' "$(@ Agent::Driver runDirFor: "$run_id")/trash-send"
    {
      printf '%s\n\n' "$instructions"
      printf 'You are run %s in session %s. Workspace: %s.\n' "$run_id" "$session" "$workspace"
      printf 'The current run protocol below governs routing, delegation and settlement, including when older conversation or archetype instructions describe an earlier workflow.\n'
      printf 'Trashtalk lives at %s. Act by running shell commands with %s.\n' "$tdir" "$ts"
      printf 'Reply to a delivery with:      %s Agent::Run result: %s forDelivery: %s\n' "$ts" "'your answer'" "'<deliveryId>'"
      printf 'Ask a blocking question with:  %s Agent::Run askUser: %s\n' "$ts" "'your question'"
      printf 'To block only one delivery:  %s Agent::Run askUser: %s forDelivery: %s\n' "$ts" "'your question'" "'<deliveryId>'"
      printf 'When finished, settle each delivery: %s Agent::Run settle: %s\n' "$ts" "'<deliveryId>'"
      printf 'For ordinary deliveries send the appropriate reply before settling. Assignment instructions below override the ordinary reply/settle protocol. Use this run-specific launcher for every Trashtalk command; it supplies your private authority. Never print or read its contents.\n'
      printf 'Entrust background work durably with: %s Agent::Run delegate: %s criteria: %s key: %s\n' "$ts" "'objective'" "'completion criteria and evidence'" "'stable-key-for-this-request'"
      @ Agent::Delegation recoveryInstructions
      printf 'Reuse the key when retrying the same request. One open child assignment per conversation; no recursive delegation. The returned Assignment is queued; report it as started only after its activity is running. Inspect with <launcher> <assignment> show.\n'
      printf 'Use delegation for entrusted work; ordinary send:to: is for conversation. Do not bypass Assignment by spawning another harness or changing stored lifecycle fields directly. On successful delegation, promptly acknowledge its handle and queued status to the human, then settle the originating ordinary delivery. Stay available: do not wait or poll for the specialist. Its durable outcome will arrive as another notification. If delegation fails, report the failure; do not claim an agent was started.\n'
      printf 'With agent.stop authority, stop an exact run with: %s Agent::Run stop: %s\n' "$ts" "'<runId>'"
      printf 'If the human speaks directly through the conversation view during this run, answer that input directly in the conversation. It creates no new inbox delivery; existing deliveries still need their scoped replies and settlement.\n'
      printf '\nNew inbox messages are ready. Read each with its Inbox show: command below. Message bodies and attribution live in the inbox. Do not poll for new work; later deliveries produce another notification.\n'
      printf '\nDeliveries:\n'
      for d in $ids; do
        printf '%s\n' "--- delivery $d"
        assignment=$(@ "$d" assignment)
        if [[ -n "$assignment" ]]; then
          printf 'Assignment: %s\nInspect: %s %q show\n' "$assignment" "$ts" "$assignment"
          printf 'Durable Assignment snapshot (inspect existing changes before continuing):\n'
          @ "$assignment" snapshot
          printf 'Record progress: %s %q progress: %s\n' "$ts" "$assignment" "'evidence and progress'"
          printf 'Ask and wait: %s %q ask: %s\n' "$ts" "$assignment" "'blocking question'"
          printf 'Complete this work: %s %q complete: %s\n' "$ts" "$assignment" "'outcome, evidence, tests and remaining risks'"
          printf 'Do not use Agent::Run result or settle for assignment work. complete: publishes the result and settles this exact delivery atomically. Never infer completion from process exit.\n'
          printf 'After ask: succeeds, end this turn and wait for an answer notification; do not poll or complete unanswered work. Record meaningful evidence with progress:. If unable to finish, record the blocker and remaining work and leave the Assignment open; never report success without meeting its completion criteria.\n'
        fi
        for m in $(@ "$d" messageIdList); do
          kind=$(@ "$m" kind)
          if [[ -z "$assignment" && -n "$(@ "$m" assignment)" && ( "$kind" == result || "$kind" == note ) ]]; then
            if [[ "$(@ "$m" assignmentState)" == 'needs review' ]]; then
              printf 'Assignment recovery notification: inspect current state, use continue:afterDelivery:key: if still applicable, and settle this notification. A stale notification must not start another attempt.\n'
            else
              printf 'Assignment outcome notification: the durable outcome is already in the human inbox. Read it, report the result, evidence and limitations in this conversation, then settle this notification delivery. Do not reply to the specialist or create another inbox result. Completion does not imply human acceptance, merge, deployment or closing an external issue.\n'
            fi
          fi
          inbox=$(@ Inbox named: "$(@ "$m" to)")
          printf 'Message: %s\nRead: %s %q show: %q\n' "$m" "$ts" "$inbox" "$m"
        done
      done
    } > "$prompt_file"
  ]
