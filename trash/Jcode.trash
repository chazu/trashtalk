# Jcode - Installation discovery and interactive authentication for the CLI.
# Persistent execution belongs to Agent::JcodeDriver, not the one-shot Agent adapter.
Jcode subclass: Tool

  classMethod: name [
    ^ 'jcode'
  ]

  rawClassMethod: path [
    local executable
    executable=$(command -v jcode) && { printf '%s\n' "$executable"; return; }
    [[ ! -x "$HOME/.local/bin/jcode" ]] || printf '%s\n' "$HOME/.local/bin/jcode"
    return 0
  ]

  classMethod: installCommand [
    ^ 'See https://jcode.sh for Jcode installation'
  ]

  # Interactive OS boundary: the CLI owns OAuth and terminal interaction.
  rawClassMethod: login [
    pragma: direct
    local executable
    executable=$(@ Jcode path)
    [[ -n "$executable" ]] || { _throw 'ToolError' 'Jcode is not installed'; return 127; }
    "$executable" login openai
  ]
