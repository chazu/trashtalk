# Process - External OS process management
# Provides an interface to spawn and manage POSIX processes
# Pure Trashtalk wrapper around Shell primitives
Process subclass: Object
  include: Debuggable
  instanceVars: command pid status exitCode stdout stderr startTime endTime resultDirectory

  # Create a new process wrapper for a command
  # Usage: proc=$(@ Process for: "curl -s https://example.com")
  classMethod: for: command [
    | id |
    id := (@ self new) ifFailed: [:error | @ error signal].
    (@ id command: command) ifFailed: [:error | @ error signal].
    (@ id status: 'created') ifFailed: [:error | @ error signal].
    ^ id
  ]

  # Tool owns process groups, interrupt restoration, and atomic exit receipts.
  classMethod: launch: command in: directory combined: combined [
    | root script argv |
    root := @ Env get: 'TRASHTALK_DIR'.
    script := root , '/lib/process-command.bash'.
    argv := #('bash' script command combined) asJson.
    ^ @ Tool detachArgvJson: argv stdinFile: '/dev/null' dir: directory
  ]

  classMethod: waitFor: processId in: directory [
    | exitFile alive |
    exitFile := directory , '/exit'.
    [exitFile fileExists] whileFalse: [
      alive := @ self alive: processId in: directory.
      (alive = 'false') ifTrue: [
        exitFile fileExists ifFalse: [@ ProcessError signal: 'Process vanished without an exit receipt']
      ].
      @ Time sleep: '0.02'
    ].
    ^ @ File read: exitFile
  ]

  # PID identity, signals, and filesystem cleanup are Bash/OS primitives.
  classPrimitive: alive: processId in: directory calls: _trash_process_alive
  classPrimitive: signal: processId in: directory with: sig calls: _trash_process_signal
  classPrimitive: cleanupDirectory: directory calls: _trash_process_cleanup

  # OS boundary: flock is held by this shell's open file description. Perl
  # supplies flock(2) on both macOS and Linux. Crash/exit closes the descriptor;
  # there is no expiring lease that can admit a second live owner. Busy = no-op.
  rawClassMethod: withLock: path receiver: receiver selector: selector argument: argument [
    source "${TRASHTALK_DIR:-$HOME/.trashtalk}/lib/process-lock.bash" || return 1
    _trash_with_process_lock "$@"
  ]

  # Queue behind a running holder for up to N whole seconds, then give up
  # exactly like a busy nonblocking attempt (no output, status 0).
  rawClassMethod: withLock: path receiver: receiver selector: selector argument: argument waiting: seconds [
    source "${TRASHTALK_DIR:-$HOME/.trashtalk}/lib/process-lock.bash" || return 1
    _trash_with_process_lock_wait "$1" "$5" "$2" "$3" "$4"
  ]

  # List running Process instances, one instance id per line
  rawClassMethod: listProcesses [
    @ Runtime dataForClass: Process | jq -r 'to_entries[] | select(.value.status == "running") | .key'
  ]

  # Run the command in the foreground (blocking)
  # Captures stdout/stderr and exit code
  method: run [
    | result |
    @ self debug: 'Running command: ' , command.
    status := 'running'.
    startTime := @ Time now.

    # Shell execFull: captures stdout, stderr, and exit code as one JSON object
    result := @ Shell execFull: command.
    result jsonUnpack: #('stdout' 'stderr' 'exitCode') into: [:stdoutVal :stderrVal :exitCodeVal |
      exitCode := exitCodeVal.
      stdout := stdoutVal.
      stderr := stderrVal
    ].
    endTime := @ Time now.
    status := 'completed'.
    ^ exitCode
  ]

  # Start the command in the background (non-blocking)
  # Returns immediately, use wait or poll to check completion
  method: start [
    (status = 'running') ifTrue: [@ ProcessError signal: 'Process is already running'].
    resultDirectory isEmpty ifTrue: [resultDirectory := (@ File tempDirectory) ifFailed: [:error | @ error signal] ].
    pid := (@ Process launch: command in: resultDirectory combined: 'false') ifFailed: [:error | @ error signal].
    startTime := @ Time now.
    status := 'running'.
    ^ pid
  ]

  method: wait [
    (status ~= 'running') ifTrue: [^ exitCode].
    exitCode := (@ Process waitFor: pid in: resultDirectory) ifFailed: [:error | @ error signal].
    stdout := (@ File read: (resultDirectory , '/stdout.log')) ifFailed: [:error | @ error signal].
    stderr := (@ File read: (resultDirectory , '/stderr.log')) ifFailed: [:error | @ error signal].
    (@ Process cleanupDirectory: resultDirectory) ifFailed: [:error | @ error signal].
    resultDirectory := ''.
    endTime := @ Time now.
    status := 'completed'.
    ^ exitCode
  ]

  method: isRunning [
    (status ~= 'running') ifTrue: [^ 'false'].
    ((resultDirectory , '/exit') fileExists) ifFalse: [
      ((@ Process alive: pid in: resultDirectory) = 'true') ifTrue: [^ 'true']
    ].
    (@ self wait) ifFailed: [:error | @ error signal].
    ^ 'false'
  ]

  method: signal: sig [
    ^ @ Process signal: pid in: resultDirectory with: sig
  ]

  method: terminate [
    | code |
    (@ self signal: 'TERM') ifFailed: [:error | @ error signal].
    code := (@ self wait) ifFailed: [:error | @ error signal].
    status := 'terminated'.
    ^ code
  ]

  method: kill [
    | code |
    (@ self signal: 'KILL') ifFailed: [:error | @ error signal].
    code := (@ self wait) ifFailed: [:error | @ error signal].
    status := 'killed'.
    ^ code
  ]

  # Get stdout from the process
  method: output [
    ^ stdout
  ]

  # Get stderr from the process
  method: errors [
    ^ stderr
  ]

  # Check if process succeeded (exit code 0)
  method: succeeded [
    ^ exitCode = '0'
  ]

  # Get process info
  method: info [
    pragma: stream
    | duration formattedStart formattedEnd |
    @ Console print: 'Command: ' , command.
    @ Console print: 'PID: ' , pid.
    @ Console print: 'Status: ' , status.
    @ Console print: 'Exit Code: ' , exitCode.
    formattedStart := @ Time formatISO: startTime.
    @ Console print: 'Started: ' , formattedStart.
    endTime notEmpty ifTrue: [
      formattedEnd := @ Time formatISO: endTime.
      @ Console print: 'Ended: ' , formattedEnd.
      duration := @ Time from: startTime to: endTime.
      @ Console print: 'Duration: ' , duration , 's'
    ]
  ]

  # === Class methods for quick execution ===

  # Run a command and return stdout (blocking, simple)
  # Usage: output=$(@ Process exec: "ls -la")
  classMethod: exec: command [
    ^ @ Shell execAll: command
  ]

  # Run a command and return exit code only
  # Usage: @ Process run: "make test"
  classMethod: run: command [
    ^ @ Shell run: command
  ]

  # Show help
  method: help [
    ^ '''=== Process Management ===

Instance Methods (for managed processes):
  proc=$(@ Process for: "command")   - Create process wrapper
  @ $proc run                          - Run blocking, capture output
  @ $proc start                        - Run in background
  @ $proc wait                         - Wait for background completion
  @ $proc isRunning                    - Check if still running
  @ $proc terminate                    - Send SIGTERM
  @ $proc kill                         - Send SIGKILL
  @ $proc output                       - Get stdout
  @ $proc errors                       - Get stderr
  @ $proc exitCode                     - Get exit code
  @ $proc succeeded                    - Check if exit code is 0
  @ $proc info                         - Show process info'''
  ]
