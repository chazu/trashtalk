# AgentQueue - SQLite boundary for durable message routing and delivery identity.
# Outbox rows are committed with the final message snapshot. Honker is a hint;
# the worker can route these rows after any crash, without a second logical send.
AgentQueue subclass: Object

  rawClassMethod: ensureSchema [
    _db_sql "CREATE TABLE IF NOT EXISTS agent_outbox (
      message_id TEXT PRIMARY KEY, inbox TEXT NOT NULL,
      session TEXT NOT NULL DEFAULT '', attempted_at INTEGER NOT NULL DEFAULT 0, created_at INTEGER NOT NULL DEFAULT (unixepoch()));
      CREATE TABLE IF NOT EXISTS agent_questions (
        message_id TEXT PRIMARY KEY, session TEXT NOT NULL, run TEXT NOT NULL,
        delivery_ids TEXT NOT NULL, answer_id TEXT NOT NULL DEFAULT '', answered_at INTEGER);
      CREATE INDEX IF NOT EXISTS agent_questions_session_run ON agent_questions(session,run);"
  ]

  classMethod: persist: message [
    ^ @ self persist: message questionRun: '' deliveries: '[]'
  ]

  # SQLite boundary: question publication, its immutable delivery links, and
  # blocking commit together. A reply can never observe a half-published question.
  rawClassMethod: persist: message questionRun: run deliveries: deliveryIds [
    local id data address erun ids question_sql=''
    @ AgentQueue ensureSchema || return 1
    id=$(_db_escape "$1")
    data=$(@ "$1" asJson) || return 1
    address=$(printf '%s' "$data" | jq -r '.to')
    address=$(_db_escape "$address")
    data=$(_db_escape "$data")
    if [[ -n "$2" ]]; then
      ids=$(printf '%s' "$3" | jq -ce 'select(type == "array" and all(.[]; type == "string")) | unique') || return 1
      ids=$(_db_escape "$ids"); erun=$(_db_escape "$2")
      question_sql="CREATE TEMP TABLE question_guard (valid INTEGER NOT NULL CHECK(valid=1));
        INSERT INTO question_guard SELECT CASE WHEN EXISTS (
          SELECT 1 FROM instances r JOIN instances s ON s.id=json_extract(r.data,'$.session')
          WHERE r.id='$erun' AND r.class='AgentRun' AND s.class='AgentSession'
          AND json_extract(r.data,'$.state') IN ('running','recovering')
          AND json_extract(s.data,'$.lifecycleState')!='terminated'
          AND json_extract('$data','$.from')='session:'||s.id
          AND json_extract('$data','$.kind')='question'
          AND NOT EXISTS (SELECT 1 FROM json_each('$ids') j LEFT JOIN instances d ON d.id=j.value
            WHERE d.id IS NULL OR d.class!='AgentDelivery'
            OR coalesce(json_extract(d.data,'$.run'),'')!='$erun'
            OR coalesce(json_extract(d.data,'$.session'),'')!=s.id
            OR coalesce(json_extract(d.data,'$.state'),'') NOT IN ('offered','blocked'))
        ) THEN 1 ELSE 0 END;
        INSERT INTO agent_questions(message_id,session,run,delivery_ids)
          SELECT '$id',json_extract(data,'$.session'),'$erun','$ids' FROM instances WHERE id='$erun';
        UPDATE instances SET data=json_set(data,'$.state','blocked')
          WHERE id IN (SELECT value FROM json_each('$ids'));"
    fi
    @ Store executeBatch: "BEGIN IMMEDIATE;
      INSERT INTO instances(id,data) VALUES('$id','$data')
        ON CONFLICT(id) DO UPDATE SET data=excluded.data;
      INSERT OR IGNORE INTO agent_outbox(message_id,inbox)
        SELECT '$id','$address' WHERE '$address' LIKE 'session:%' OR '$address' LIKE 'agent:%';
      $question_sql
      COMMIT;"
  ]

  # Separate processing metadata survives Message read/archive saves and caches.
  rawClassMethod: questionFor: message [
    local id data
    @ AgentQueue ensureSchema || return 1
    id=$(_db_escape "$1")
    data=$(_db_sql "SELECT json_object('deliveryIds',json(delivery_ids),'answerId',answer_id)
      FROM agent_questions WHERE message_id='$id';") || return 1
    [[ -n "$data" ]] || data='{"deliveryIds":[],"answerId":""}'
    printf '%s\n' "$data"
  ]

  rawClassMethod: pending [
    @ AgentQueue ensureSchema || return 1
    _db_sql "SELECT message_id FROM agent_outbox WHERE session='' ORDER BY attempted_at, created_at, rowid LIMIT 100;"
  ]

  # Atomic lookup/create, plus routing acknowledgement and question unblocking.
  # A deterministic id and BEGIN IMMEDIATE make concurrent replay harmless.
  rawClassMethod: assign: sessionId messages: idsJson outbox: messageId [
    local sid ids key hash id now data esc_key esc_sid esc_id esc_data esc_msg guard
    sid="$1"
    ids=$(printf '%s' "$2" | jq -ce 'select(type == "array" and length > 0 and all(.[]; type == "string"))') || return 1
    @ AgentQueue ensureSchema || return 1
    hash=$(printf '%s' "$ids" | shasum -a 256 | cut -d' ' -f1)
    key="$sid:${hash:0:16}"
    id="agentdelivery_$(printf '%s' "$key" | shasum -a 256 | cut -d' ' -f1)"
    now=$(@ Time nowISO)
    data=$(jq -cn --arg sid "$sid" --argjson ids "$ids" --arg key "$key" --arg now "$now" \
      '{class:"AgentDelivery",session:$sid,messageIds:$ids,deliveryKey:$key,state:"pending",run:"",attempts:0,lastError:"",note:"",created:$now,created_at:(now|floor)} | ._vars = (keys - ["class"])')
    esc_sid=$(_db_escape "$sid"); esc_key=$(_db_escape "$key")
    esc_id=$(_db_escape "$id"); esc_data=$(_db_escape "$data"); esc_msg=$(_db_escape "$3")
    guard="('$esc_msg' = '' OR EXISTS(SELECT 1 FROM agent_outbox WHERE message_id='$esc_msg' AND session=''))"
    @ Store executeBatch: "BEGIN IMMEDIATE;
      INSERT INTO instances(id,data) SELECT '$esc_id','$esc_data'
        WHERE $guard AND NOT EXISTS(SELECT 1 FROM instances WHERE json_extract(data,'$.class')='AgentDelivery' AND json_extract(data,'$.deliveryKey')='$esc_key');
      UPDATE agent_questions SET answer_id='$esc_msg',answered_at=unixepoch()
        WHERE session='$esc_sid' AND answer_id='' AND '$esc_msg'!='' AND $guard
        AND EXISTS (SELECT 1 FROM instances reply JOIN instances question
          ON question.id=json_extract(reply.data,'$.replyTo')
          WHERE reply.id='$esc_msg' AND question.id=agent_questions.message_id
          AND json_extract(reply.data,'$.from')=json_extract(question.data,'$.to')
          AND json_extract(reply.data,'$.to')=json_extract(question.data,'$.from'));
      UPDATE instances SET data=json_set(data,'$.state','pending')
        WHERE json_extract(data,'$.class')='AgentDelivery' AND json_extract(data,'$.session')='$esc_sid'
        AND json_extract(data,'$.state')='blocked' AND '$esc_msg' != '' AND $guard
        AND EXISTS (SELECT 1 FROM agent_questions q,json_each(q.delivery_ids) j
          WHERE q.answer_id='$esc_msg' AND q.session='$esc_sid'
          AND q.run=json_extract(instances.data,'$.run') AND j.value=instances.id)
        AND NOT EXISTS (SELECT 1 FROM agent_questions q,json_each(q.delivery_ids) j
          WHERE q.answer_id='' AND q.session='$esc_sid'
          AND q.run=json_extract(instances.data,'$.run') AND j.value=instances.id);
      UPDATE agent_outbox SET session='$esc_sid' WHERE message_id='$esc_msg' AND session='';
      COMMIT;
      SELECT id FROM instances WHERE json_extract(data,'$.class')='AgentDelivery' AND json_extract(data,'$.deliveryKey')='$esc_key' LIMIT 1;"
  ]

  # Session caches are snapshots; refresh worker-owned records between ticks.
  # Only cache messages whose final snapshot and outbox row have committed;
  # Message new persists an empty draft before its sender fills local fields.
  rawClassMethod: refresh [
    local id data
    @ AgentQueue ensureSchema || return 1
    while IFS='|' read -r id data; do
      [[ -z "$id" ]] || _env_set "$id" "$data"
    done < <(_db_sql "SELECT id || '|' || json(data) FROM instances WHERE class IN ('AgentSession','AgentRun','AgentDelivery')
      OR (class='Message' AND EXISTS(SELECT 1 FROM agent_outbox WHERE message_id=instances.id));")
  ]

  # Move unresolved identity routes to the back so they cannot starve new mail.
  rawClassMethod: attempted: message [
    local id
    id=$(_db_escape "$1")
    _db_sql "UPDATE agent_outbox SET attempted_at=unixepoch() WHERE message_id='$id';"
  ]
