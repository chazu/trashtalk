package: Kube

# Base class for all Kubernetes resources.
# Stores full raw kubectl JSON and unpacks common metadata fields into ivars.
# Subclasses add kind-specific fields through kindFields and accessors on top.
#
# Usage:
#   resource=$(@ Kube::Resource fromJson: "$json" cluster: 'prod')
#   @ $resource getName        # => 'api-server'
#   @ $resource get: '.status.phase'   # jsonPath into rawJson
#   @ $resource save           # persist snapshot to SQLite
#   @ Kube::Resource history   # all snapshots ordered by capturedAt
#   @ Kube::Resource latestFor: 'Pod/default/api'   # newest snapshot of one resource
#   (subclasses such as Pod do not inherit Snapshotable; ask Resource)
Resource subclass: Object
  include: Persistable
  include: Snapshotable
  instanceVars: rawJson kind name namespace cluster capturedAt identity

  # Virtual columns for fast querying across snapshots.
  classMethod: indexedColumns [
    ^ '[{"name":"kube_kind","path":"$.kind"},{"name":"kube_name","path":"$.name"},{"name":"kube_namespace","path":"$.namespace"},{"name":"kube_cluster","path":"$.cluster"},{"name":"captured_at","path":"$.capturedAt"}]'
  ]

  # Hook: a jq object expression, evaluated against the raw kubectl JSON, for
  # kind and any kind-specific ivars. Values become text.
  classMethod: kindFields [
    ^ '{kind: (.kind // "")}'
  ]

  # Factory: create a Resource (or subclass instance) from raw kubectl JSON.
  # capturedAt is stamped at fetch time, not save time.
  classMethod: fromJson: json cluster: clusterName [
    | filter fields id |
    filter := @ self kindFields.
    fields := (@ self fieldsFrom: json cluster: clusterName kindFields: filter) ifFailed: [:error | @ error signal].
    id := (@ self new) ifFailed: [:error | @ error signal].
    (@ id rawJson: json) ifFailed: [:error | @ error signal].
    (@ Runtime assign: fields to: id) ifFailed: [:error | @ error signal].
    ^ id
  ]

  # jq boundary: one pass derives the common metadata, the kindFields
  # expression, and identity (kind/namespace/name) as a flat text object.
  rawClassMethod: fieldsFrom: json cluster: clusterName kindFields: filter [
    local common='{name: (.metadata.name // ""), namespace: (.metadata.namespace // ""), cluster: $cluster, capturedAt: (now | floor | todate)}'
    local finish='.identity = (.kind + "/" + .namespace + "/" + .name) | map_values(tostring)'
    printf '%s' "$1" | jq -c --arg cluster "$2" "($common) + ($3) | $finish"
  ]

  # Extract a value from rawJson using a jq path expression.
  # Usage: phase=$(@ $resource get: '.status.phase')
  rawMethod: get: path [
    local raw
    raw=$(_ivar rawJson)
    echo "$raw" | jq -r "$path // empty"
  ]

  # Return labels as a jq-formatted JSON object.
  method: labels [
    ^ rawJson jsonAt: 'metadata.labels' ifAbsent: '{}'
  ]

  # Return annotations as a jq-formatted JSON object.
  method: annotations [
    ^ rawJson jsonAt: 'metadata.annotations' ifAbsent: '{}'
  ]

  # Human-readable age since creationTimestamp.
  rawMethod: age [
    local raw created now delta
    raw=$(_ivar rawJson)
    created=$(echo "$raw" | jq -r '.metadata.creationTimestamp // ""')
    [[ -z "$created" ]] && echo "unknown" && return
    if command -v gdate >/dev/null 2>&1; then
      now=$(gdate +%s)
      delta=$((now - $(gdate -d "$created" +%s 2>/dev/null || echo "$now")))
    else
      now=$(date +%s)
      delta=$((now - $(date -j -f '%Y-%m-%dT%H:%M:%SZ' "$created" +%s 2>/dev/null || echo "$now")))
    fi
    if   (( delta < 3600   )); then echo "$((delta / 60))m"
    elif (( delta < 86400  )); then echo "$((delta / 3600))h"
    else echo "$((delta / 86400))d"
    fi
  ]

  # Compare this snapshot with another Resource instance field-by-field.
  method: diffWith: other [
    ^ @ Kube::Diff compareResource: self with: other
  ]
