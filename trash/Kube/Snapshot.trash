package: Kube

# A labeled, timestamped set of resource IDs captured together.
# Represents a point-in-time picture of a cluster's resources.
#
# Resource IDs are stored as a JSON array in the resourceIds ivar.
# SQLite's json_each() can traverse this for cross-reference queries:
#   SELECT s.id FROM instances s, json_each(json_extract(s.data, '$.resourceIds')) r
#   WHERE s.class = 'Kube::Snapshot' AND r.value = '<resource-id>'
#
# Usage:
#   snap=$(@ Kube::Snapshot take: 'daily' of: 'pods deployments' onCluster: 'prod')
#   @ $snap save
#   snap=$(@ Kube::Snapshot latest: 'daily' onCluster: 'prod')
Snapshot subclass: Object
  include: Persistable
  instanceVars: label cluster takenAt resourceIds

  # Fetch all resources of the given space-separated kinds from a cluster,
  # save each resource, and collect their IDs into a new snapshot.
  classMethod: take: label of: kinds onCluster: ctx [
    | id now clusterObj kindList ids resources items |
    id := @ self new.
    now := @ Time nowISO.
    clusterObj := @ Kube::Cluster named: ctx.
    kindList := @ String splitToArray: kinds on: ' '.
    ids := '[]'.
    kindList arrayEach: [:kind |
      resources := @ clusterObj fetch: kind.
      items := @ resources getItems.
      items arrayEach: [:resource |
        @ resource save.
        ids := ids arrayPush: resource
      ]
    ].
    @ id setLabel: label.
    @ id setCluster: ctx.
    @ id setTakenAt: now.
    @ id setResourceIds: ids.
    ^ id
  ]

  # Most recent saved snapshot with the given label on the given cluster.
  classMethod: latest: label onCluster: ctx [
    ^ @ Store findByClass: 'Kube::Snapshot' matching: (#{label: label cluster: ctx} asJson) orderBy: "json_extract(data, '$.takenAt') DESC" limit: 1
  ]

  # All saved snapshots with the given label, ordered newest first.
  classMethod: history: label onCluster: ctx [
    ^ @ Store findByClass: 'Kube::Snapshot' matching: (#{label: label cluster: ctx} asJson) orderBy: "json_extract(data, '$.takenAt') DESC" limit: ''
  ]

  # Return resource IDs as newline-separated list.
  rawMethod: resourceIds [
    _ivar resourceIds | jq -r '.[]'
  ]

  # Return resource IDs for a specific kind.
  method: resourcesOfKind: kind [
    pragma: stream
    | data |
    resourceIds arrayEach: [:rid |
      data := @ Store getInstance: rid.
      ((data objectAt: 'kind') = kind) ifTrue: [@ Console print: rid]
    ]
  ]

  # Count of resources in this snapshot.
  method: size [
    ^ resourceIds arrayLength
  ]

  # Return a JSON object mapping identity strings to resource IDs.
  # Used by Kube::Diff to align resources across two snapshots.
  method: identityMap [
    | map data identity |
    map := '{}'.
    resourceIds arrayEach: [:rid |
      data := @ Store getInstance: rid.
      identity := data objectAt: 'identity'.
      (identity notEmpty) ifTrue: [map := map objectAt: identity put: rid]
    ].
    ^ map
  ]
