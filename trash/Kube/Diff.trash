package: Kube

# Field-level diff between two Resource instances or two Snapshots.
# Compares all fields, filtering out high-churn metadata fields.
#
# Usage (two resources):
#   diff=$(@ Kube::Diff compareResource: $a with: $b)
#   @ $diff report
#   @ $diff hasChanges
#
# Usage (two snapshots):
#   diff=$(@ Kube::Diff compare: $snapA with: $snapB)
#   @ $diff report
Diff subclass: Object
  instanceVars: added removed changed

  # Diff two Resource instances field-by-field.
  # Returns a Diff whose 'changed' ivar holds [{path, from, to}] JSON.
  classMethod: compareResource: a with: b [
    | changes |
    changes := @ self changesFrom: a to: b.
    ^ @ self added: '[]' removed: '[]' changed: changes
  ]

  # Diff two Snapshots: resources only in A (removed), only in B (added), in both but changed.
  # 'changed' holds [{identity, changes}] for each resource with field changes.
  classMethod: compare: snapA with: snapB [
    | mapA mapB addedIds removedIds sharedIds changedResources ridA ridB changes entry |
    mapA := @ snapA identityMap.
    mapB := @ snapB identityMap.
    addedIds := @ self keysOf: mapB missingFrom: mapA.
    removedIds := @ self keysOf: mapA missingFrom: mapB.
    sharedIds := @ self keysOf: mapA sharedWith: mapB.
    changedResources := '[]'.
    sharedIds arrayEach: [:identity |
      ridA := mapA objectAt: identity.
      ridB := mapB objectAt: identity.
      changes := @ self changesFrom: ridA to: ridB.
      ((changes arrayLength) > 0) ifTrue: [
        entry := #{identity: identity changes: (changes jsonValue)} asJson.
        changedResources := changedResources arrayPushJson: entry
      ]
    ].
    ^ @ self added: addedIds removed: removedIds changed: changedResources
  ]

  classMethod: added: addedIds removed: removedIds changed: changes [
    | id |
    id := @ self new.
    @ id setAdded: addedIds.
    @ id setRemoved: removedIds.
    @ id setChanged: changes.
    ^ id
  ]

  # Changed scalar fields between two resources as [{path, from, to}] JSON.
  classMethod: changesFrom: a to: b [
    | rawA rawB |
    rawA := @ a rawJson.
    rawB := @ b rawJson.
    ^ @ self fieldChangesFrom: rawA to: rawB
  ]

  # jq boundary: scalar paths of B whose values differ in A, minus noisy metadata.
  rawClassMethod: fieldChangesFrom: rawA to: rawB [
    printf '%s\n%s' "$1" "$2" | jq -cs '
      .[0] as $a | .[1] as $b |
      def noisy: test(
        "metadata\\.resourceVersion|metadata\\.generation|metadata\\.managedFields|metadata\\.annotations\\.kubectl|metadata\\.creationTimestamp"
      );
      [ ($b | path(.. | scalars)) as $p
        | ($p | join(".")) as $pstr
        | select($pstr | noisy | not)
        | select(($a | getpath($p)) != ($b | getpath($p)))
        | {path: $pstr, from: ($a | getpath($p)), to: ($b | getpath($p))}
      ]
    '
  ]

  # Keys of one identity map that the other lacks, as a JSON array.
  rawClassMethod: keysOf: map missingFrom: other [
    printf '%s\n%s' "$1" "$2" | jq -cs '.[0] as $a | .[1] as $b | [$a | keys[] | select(. as $k | $b | has($k) | not)]'
  ]

  # Keys present in both identity maps, as a JSON array.
  rawClassMethod: keysOf: map sharedWith: other [
    printf '%s\n%s' "$1" "$2" | jq -cs '.[0] as $a | .[1] as $b | [$a | keys[] | select(. as $k | $b | has($k))]'
  ]

  # Print a human-readable diff report to stdout.
  rawMethod: report [
    local added removed changed nadded nremoved nchanged
    added=$(_ivar added)
    removed=$(_ivar removed)
    changed=$(_ivar changed)
    nadded=$(echo "$added" | jq 'length')
    nremoved=$(echo "$removed" | jq 'length')
    nchanged=$(echo "$changed" | jq 'length')

    echo "=== Kube Diff ==="
    echo "Added: $nadded  Removed: $nremoved  Changed: $nchanged"
    echo ""

    if (( nadded > 0 )); then
      echo "--- Added ---"
      echo "$added" | jq -r '.[]'
      echo ""
    fi

    if (( nremoved > 0 )); then
      echo "--- Removed ---"
      echo "$removed" | jq -r '.[]'
      echo ""
    fi

    if (( nchanged > 0 )); then
      echo "--- Changed ---"
      if echo "$changed" | jq -e '.[0] | has("identity")' >/dev/null 2>&1; then
        echo "$changed" | jq -r '.[] | "  \(.identity):", (.changes[] | "    \(.path): \(.from) → \(.to)")'
      else
        echo "$changed" | jq -r '.[] | "  \(.path): \(.from) → \(.to)"'
      fi
    fi
  ]

  # true if any fields were added, removed, or changed.
  method: hasChanges [
    | total |
    total := (added arrayLength) + (removed arrayLength) + (changed arrayLength).
    ^ total > 0
  ]
