package: Kube

# Field-level diff between two Resource instances or two Snapshots.
# Compares all fields, filtering out high-churn metadata fields.
#
# Usage (two resources):
#   diff=$(@ Kube::Diff compareResource: $a with: $b)
#   @ $diff report
#   @ $diff hasChanges
#
# Usage (two snapshots):
#   diff=$(@ Kube::Diff compare: $snapA with: $snapB)
#   @ $diff report
Diff subclass: Object
  instanceVars: added removed changed

  # Diff two Resource instances field-by-field.
  # Returns a Diff whose 'changed' ivar holds [{path, from, to}] JSON.
  rawClassMethod: compareResource: a with: b [
    local rawA rawB patch id
    rawA=$(@ Store getField: "$a" field: "rawJson")
    rawB=$(@ Store getField: "$b" field: "rawJson")

    patch=$(printf '%s\n%s' "$rawA" "$rawB" | jq -s '
      .[0] as $a | .[1] as $b |
      def noisy: test(
        "metadata\\.resourceVersion|metadata\\.generation|metadata\\.managedFields|metadata\\.annotations\\.kubectl|metadata\\.creationTimestamp"
      );
      [ path($b | .. | scalars) as $p
        | ($p | join(".")) as $pstr
        | select($pstr | noisy | not)
        | select(($a | getpath($p)) != ($b | getpath($p)))
        | {path: $pstr, from: ($a | getpath($p)), to: ($b | getpath($p))}
      ]
    ')

    id=$(@ Runtime generateId: "$_CLASS")
    @ Runtime create: "$_CLASS" id: "$id"
    @ "$id" setChanged: "$patch"
    @ "$id" setAdded:   '[]'
    @ "$id" setRemoved: '[]'
    echo "$id"
  ]

  # Diff two Snapshots: resources only in A (removed), only in B (added), in both but changed.
  rawClassMethod: compare: snapA with: snapB [
    local id mapA mapB
    id=$(@ Runtime generateId: "$_CLASS")
    @ Runtime create: "$_CLASS" id: "$id"

    mapA=$(@ "$snapA" _identityMap)
    mapB=$(@ "$snapB" _identityMap)

    local added removed
    added=$(printf '%s\n%s' "$mapA" "$mapB" | jq -s '
      .[0] as $a | .[1] as $b |
      [$b | keys[] | select(. as $k | $a | has($k) | not)]')
    removed=$(printf '%s\n%s' "$mapA" "$mapB" | jq -s '
      .[0] as $a | .[1] as $b |
      [$a | keys[] | select(. as $k | $b | has($k) | not)]')

    local shared_diffs='[]'
    while IFS= read -r identity; do
      [[ -z "$identity" ]] && continue
      local ridA ridB rdiff patch
      ridA=$(echo "$mapA" | jq -r --arg k "$identity" '.[$k]')
      ridB=$(echo "$mapB" | jq -r --arg k "$identity" '.[$k]')
      rdiff=$(@ "$_RECEIVER" compareResource: "$ridA" with: "$ridB")
      patch=$(@ Store getField: "$rdiff" field: "changed")
      if echo "$patch" | jq -e 'length > 0' >/dev/null 2>&1; then
        shared_diffs=$(echo "$shared_diffs" | jq --arg id "$identity" --argjson c "$patch" \
          '. + [{identity: $id, changes: $c}]')
      fi
      @ Runtime delete: "$rdiff"
    done < <(printf '%s\n%s' "$mapA" "$mapB" | jq -rs \
      '.[0] as $a | .[1] as $b | [$a | keys[] | select(. as $k | $b | has($k))] | .[]')

    @ "$id" setAdded:   "$added"
    @ "$id" setRemoved: "$removed"
    @ "$id" setChanged: "$shared_diffs"
    echo "$id"
  ]

  # Print a human-readable diff report to stdout.
  rawMethod: report [
    local added removed changed nadded nremoved nchanged
    added=$(_ivar added)
    removed=$(_ivar removed)
    changed=$(_ivar changed)
    nadded=$(echo "$added" | jq 'length')
    nremoved=$(echo "$removed" | jq 'length')
    nchanged=$(echo "$changed" | jq 'length')

    echo "=== Kube Diff ==="
    echo "Added: $nadded  Removed: $nremoved  Changed: $nchanged"
    echo ""

    if (( nadded > 0 )); then
      echo "--- Added ---"
      echo "$added" | jq -r '.[]'
      echo ""
    fi

    if (( nremoved > 0 )); then
      echo "--- Removed ---"
      echo "$removed" | jq -r '.[]'
      echo ""
    fi

    if (( nchanged > 0 )); then
      echo "--- Changed ---"
      if echo "$changed" | jq -e '.[0] | has("identity")' >/dev/null 2>&1; then
        echo "$changed" | jq -r '.[] | "  \(.identity):", (.changes[] | "    \(.path): \(.from) → \(.to)")'
      else
        echo "$changed" | jq -r '.[] | "  \(.path): \(.from) → \(.to)"'
      fi
    fi
  ]

  # true if any fields were added, removed, or changed.
  rawMethod: hasChanges [
    local a r c total
    a=$(_ivar added)
    r=$(_ivar removed)
    c=$(_ivar changed)
    total=$(printf '%s\n%s\n%s' "$a" "$r" "$c" | jq -s '[.[] | length] | add')
    (( total > 0 )) && echo "true" || echo "false"
  ]
