package: Kube

# Kubernetes Node resource.
# Unpacks ready status and schedulability into ivars.
Node subclass: Resource
  instanceVars: rawJson kind name cluster capturedAt identity
                ready unschedulable

  rawClassMethod: fromJson: json cluster: clusterName [
    local id k n rdy unsched
    id=$(@ Runtime generateId: "$_CLASS")
    @ Runtime create: "$_CLASS" id: "$id"
    k="Node"
    n=$(echo      "$json" | jq -r '.metadata.name // ""')
    rdy=$(echo    "$json" | jq -r '.status.conditions[]? | select(.type == "Ready") | .status')
    unsched=$(echo "$json" | jq -r '.spec.unschedulable // false')
    @ "$id" setRawJson:       "$json"
    @ "$id" setCluster:       "$clusterName"
    @ "$id" setKind:          "$k"
    @ "$id" setName:          "$n"
    @ "$id" setCapturedAt:    "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    @ "$id" setIdentity:      "$k//$n"
    @ "$id" setReady:         "$rdy"
    @ "$id" setUnschedulable: "$unsched"
    echo "$id"
  ]

  # All conditions as a JSON array.
  method: conditions [
    ^ rawJson jsonAt: 'status.conditions' ifAbsent: '[]'
  ]

  # Taints as a JSON array.
  method: taints [
    ^ rawJson jsonAt: 'spec.taints' ifAbsent: '[]'
  ]

  # Allocatable resources as a JSON object.
  method: allocatable [
    ^ rawJson jsonAt: 'status.allocatable' ifAbsent: '{}'
  ]

  # One-line summary: ready status and schedulability.
  method: summary [
    | label |
    label := 'NotReady'.
    (ready = 'True') ifTrue: [ label := 'Ready' ].
    (unschedulable = 'true') ifTrue: [ label := label , ',SchedulingDisabled' ].
    ^ label
  ]
