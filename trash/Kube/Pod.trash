package: Kube

# Kubernetes Pod resource.
# Unpacks phase, restart count, and container readiness into ivars for fast access.
# The runtime does not resolve a superclass's traits for subclass receivers,
# so each resource kind includes Persistable again (for save). Snapshotable is
# not repeated: a trait method would shadow Resource's indexedColumns.
Pod subclass: Resource
  include: Persistable
  instanceVars: phase restartCount readyCount totalCount

  classMethod: kindFields [
    ^ '{kind: "Pod", phase: (.status.phase // "Unknown"), restartCount: ([.status.containerStatuses[]?.restartCount // 0] | add // 0), readyCount: ([.status.containerStatuses[]? | select(.ready == true)] | length), totalCount: (.spec.containers | length)}'
  ]

  # true if all containers are ready.
  method: ready [
    ^ (readyCount notEmpty) and: [readyCount = totalCount]
  ]

  # Container names as a JSON array.
  rawMethod: containers [
    local raw
    raw=$(_ivar rawJson)
    echo "$raw" | jq -c '[.spec.containers[].name]'
  ]

  # One-line status summary: phase, ready/total, restart count.
  method: summary [
    ^ phase , ' ' , readyCount , '/' , totalCount , ' restarts=' , restartCount
  ]

  # Fetch current logs via kubectl (requires cluster context).
  method: logs [
    ^ @ Kube::Kubectl logs: name namespace: namespace context: cluster
  ]
