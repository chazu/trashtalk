package: Kube

# Thin kubectl CLI wrapper. All methods are stateless class methods.
# Context and namespace default to empty (kubectl uses current config defaults).
Kubectl subclass: Tool

  classMethod: name [
    ^ 'kubectl'
  ]

  classMethod: installCommand [
    ^ "brew install kubectl"
  ]

  # Fetch a single resource as JSON. Returns empty on failure.
  classMethod: get: kind name: name namespace: ns context: ctx [
    | argv |
    argv := #('get' kind name '-o' 'json') asJson.
    ^ @ self run: argv namespace: ns context: ctx
  ]

  # List all resources of a kind, one compact JSON object per line.
  classMethod: list: kind namespace: ns context: ctx [
    | argv listing |
    argv := #('get' kind '-o' 'json') asJson.
    listing := @ self run: argv namespace: ns context: ctx.
    ^ @ self itemsOf: listing
  ]

  # List all resources across all namespaces.
  classMethod: listAll: kind context: ctx [
    | argv listing |
    argv := #('get' kind '-A' '-o' 'json') asJson.
    listing := @ self run: argv namespace: '' context: ctx.
    ^ @ self itemsOf: listing
  ]

  # Return the current kubectl context name.
  classMethod: currentContext [
    | argv |
    argv := #('config' 'current-context') asJson.
    ^ @ self run: argv namespace: '' context: ''
  ]

  # Return all available context names, one per line.
  classMethod: listContexts [
    | argv |
    argv := #('config' 'get-contexts' '-o' 'name') asJson.
    ^ @ self run: argv namespace: '' context: ''
  ]

  # Return all namespace names in a cluster, one per line.
  classMethod: listNamespaces: ctx [
    | argv listing |
    argv := #('get' 'namespaces' '-o' 'json') asJson.
    listing := @ self run: argv namespace: '' context: ctx.
    ^ @ self namesOf: listing
  ]

  # Fetch raw pod logs.
  classMethod: logs: podName namespace: ns context: ctx [
    | argv |
    argv := #('logs' podName) asJson.
    ^ @ self run: argv namespace: ns context: ctx
  ]

  # Process boundary for every query: kubectl with an exact argv (a JSON array),
  # scoped by namespace and context when given. stderr is discarded.
  rawClassMethod: run: argv namespace: ns context: ctx [
    local -a args
    mapfile -t args < <(printf '%s' "$1" | jq -r '.[]')
    [[ -n "$3" ]] && args=("--context" "$3" "${args[@]}")
    [[ -n "$2" ]] && args=("-n" "$2" "${args[@]}")
    kubectl "${args[@]}" 2>/dev/null
  ]

  # Items of a kubectl list, one compact JSON object per line.
  rawClassMethod: itemsOf: listing [
    printf '%s' "$1" | jq -c '.items[]'
  ]

  # Item names of a kubectl list, one per line.
  rawClassMethod: namesOf: listing [
    printf '%s' "$1" | jq -r '.items[].metadata.name'
  ]
