package: Kube

# Kubernetes Deployment resource.
# Unpacks replica counts into ivars.
# Persistable is included again; see Kube::Pod.
Deployment subclass: Resource
  include: Persistable
  instanceVars: replicas readyReplicas unavailableReplicas

  classMethod: kindFields [
    ^ '{kind: "Deployment", replicas: (.spec.replicas // 0), readyReplicas: (.status.readyReplicas // 0), unavailableReplicas: (.status.unavailableReplicas // 0)}'
  ]

  # available / progressing / degraded based on .status.conditions.
  rawMethod: rolloutStatus [
    _ivar rawJson | jq -r '[.status.conditions[]? | select(.status == "True") | .type] |
      if any(.[]; . == "Available") then "available"
      elif any(.[]; . == "Progressing") then "progressing"
      else "degraded" end'
  ]

  # Image of the first container.
  method: image [
    | image |
    image := rawJson jsonAt: '["spec","template","spec","containers",0,"image"]' ifAbsent: '""'.
    ^ image jsonTextAt: ''
  ]

  # One-line status: ready/desired replicas and rollout status.
  method: summary [
    | status |
    status := @ self rolloutStatus.
    ^ readyReplicas , '/' , replicas , ' ' , status
  ]
