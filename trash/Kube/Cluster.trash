package: Kube

# Lightweight value object representing a kubectl context + namespace.
# Not a persistent connection — just named configuration for building kubectl calls.
# Cascade-friendly: @ $cluster withNamespace: 'kube-system' returns self.
Cluster subclass: Object
  instanceVars: context namespace:'default'

  # Create a Cluster for the named kubectl context.
  classMethod: named: ctx [
    | id |
    id := @ self new.
    @ id setContext: ctx.
    ^ id
  ]

  # Create a Cluster for the current kubectl context.
  classMethod: current [
    | ctx |
    ctx := @ Kube::Kubectl currentContext.
    ^ @ self named: ctx
  ]

  # Create a Cluster for each available kubectl context.
  classMethod: all [
    | contexts arr cluster |
    contexts := @ Kube::Kubectl listContexts.
    arr := @ Array new.
    contexts linesDo: [:ctx |
      cluster := @ self named: ctx.
      @ arr push: cluster
    ].
    ^ arr
  ]

  # Set namespace and return self (for cascade configuration).
  method: withNamespace: ns [
    namespace := ns.
    ^ self
  ]

  # Fetch all resources of a kind, returning an Array of typed Resource instances.
  # Kind may be plural or singular (e.g. 'pods', 'pod', 'deployments').
  method: fetch: kind [
    | resourceClass items arr resource |
    resourceClass := @ Kube::Cluster classForKind: kind.
    items := @ Kube::Kubectl list: kind namespace: namespace context: context.
    arr := @ Array new.
    items linesDo: [:line |
      resource := @ resourceClass fromJson: line cluster: context.
      @ arr push: resource
    ].
    ^ arr
  ]

  # Fetch a single named resource; empty when kubectl finds none.
  method: fetch: kind named: name [
    | raw resourceClass |
    raw := @ Kube::Kubectl get: kind name: name namespace: namespace context: context.
    raw isEmpty ifTrue: [^ ''].
    resourceClass := @ Kube::Cluster classForKind: kind.
    ^ @ resourceClass fromJson: raw cluster: context
  ]

  # Map a kind string (singular, plural, or short, any case) to its Kube:: class.
  classMethod: classForKind: kind [
    | lower |
    lower := kind asLowercase.
    ^ lower caseOf: {
      #('pod' 'pods') -> [ 'Kube::Pod' ].
      #('deployment' 'deployments') -> [ 'Kube::Deployment' ].
      #('node' 'nodes') -> [ 'Kube::Node' ].
      #('service' 'services' 'svc') -> [ 'Kube::Service' ]
    } otherwise: [ 'Kube::Resource' ]
  ]
