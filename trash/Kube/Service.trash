package: Kube

# Kubernetes Service resource.
# Unpacks type and clusterIP into ivars.
# Persistable is included again; see Kube::Pod.
Service subclass: Resource
  include: Persistable
  instanceVars: serviceType clusterIP

  classMethod: kindFields [
    ^ '{kind: "Service", serviceType: (.spec.type // "ClusterIP"), clusterIP: (.spec.clusterIP // "")}'
  ]

  # Ports as a JSON array of {port, targetPort, protocol} objects.
  rawMethod: ports [
    local raw
    raw=$(_ivar rawJson)
    echo "$raw" | jq -c '[.spec.ports[]? | {port: .port, targetPort: .targetPort, protocol: .protocol}]'
  ]

  # Selector labels as a JSON object.
  method: selector [
    ^ rawJson jsonAt: 'spec.selector' ifAbsent: '{}'
  ]

  # One-line summary: type, clusterIP, port list.
  # printf keeps the space before '[', which "$cip [" would lose in a raw body.
  rawMethod: summary [
    local t cip ports
    t=$(_ivar serviceType)
    cip=$(_ivar clusterIP)
    ports=$(@ "$_RECEIVER" ports | jq -r '[.[] | "\(.port)/\(.protocol)"] | join(",")')
    printf "%s %s [%s]\n" "$t" "$cip" "$ports"
  ]
