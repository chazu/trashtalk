# String - String manipulation and testing utilities
# Most of these class methods are thin names over the compiler's string
# intrinsics (`str startsWith: p`, `str withoutPrefix: p`, `str size`, ...),
# which lower to Bash parameter expansion with no dispatch. Prefer the
# intrinsic in DSL code; these selectors remain for callers and raw code.
#
# Usage:
#   (@ String isEmpty: myVar) ifTrue: [ ... ]
#   (@ String contains: text substring: "error") ifTrue: [ ... ]
#   result := @ String trimSuffix: ".trash" from: filename
#
String subclass: Object

  # ========================================
  # String Tests
  # ========================================

  # Test if string is empty (replaces [[ -z "$str" ]])
  classMethod: isEmpty: aStr [
    ^ aStr isEmpty
  ]

  # Test if string is not empty (replaces [[ -n "$str" ]])
  classMethod: notEmpty: aStr [
    ^ aStr notEmpty
  ]

  # Test if string contains substring
  classMethod: contains: str substring: sub [
    ^ str includes: sub
  ]

  # Test if string starts with prefix
  classMethod: startsWith: str prefix: prefix [
    ^ str startsWith: prefix
  ]

  # Test if string ends with suffix
  classMethod: endsWith: str suffix: suffix [
    ^ str endsWith: suffix
  ]

  # Test if two strings are equal
  classMethod: equals: a to: b [
    ^ a = b
  ]

  # ========================================
  # String Manipulation
  # ========================================

  # Remove prefix pattern from string (replaces ${str##pattern})
  classMethod: trimPrefix: pattern from: str [
    ^ str withoutPrefix: pattern
  ]

  # Remove suffix pattern from string (replaces ${str%%pattern})
  classMethod: trimSuffix: pattern from: str [
    ^ str withoutSuffix: pattern
  ]

  # Remove shortest prefix match (replaces ${str#pattern})
  classMethod: trimShortPrefix: pattern from: str [
    ^ str withoutPrefix: pattern
  ]

  # Remove shortest suffix match (replaces ${str%pattern})
  classMethod: trimShortSuffix: pattern from: str [
    ^ str withoutSuffix: pattern
  ]

  # Replace first occurrence (replaces ${str/old/new})
  classMethod: replace: old with: new in: str [
    ^ str replaceFirst: old with: new
  ]

  # Replace all occurrences (replaces ${str//old/new})
  classMethod: replaceAll: old with: new in: str [
    ^ str replaceAll: old with: new
  ]

  # Get substring (replaces ${str:start:length})
  classMethod: substring: str from: start length: len [
    ^ str copyFrom: start + 1 to: start + len
  ]

  # Get string length
  classMethod: length: str [
    ^ str size
  ]

  # Return the last N characters. This keeps compact display identities in
  # ordinary DSL workflows without duplicating Bash slicing at call sites.
  classMethod: suffix: str length: count [
    (count =~ '^[0-9]+$') ifFalse: [
      @ StringError signal: 'suffix length must be a non-negative integer'
    ].
    ^ str last: count
  ]

  # Convert to uppercase
  classMethod: uppercase: str [
    ^ str asUppercase
  ]

  # Convert to lowercase
  classMethod: lowercase: str [
    ^ str asLowercase
  ]

  # ========================================
  # String Splitting
  # ========================================

  # Split string on delimiter, return as newline-separated values
  rawClassMethod: split: str on: delim [
    local IFS="$delim"
    local parts
    read -ra parts <<< "$str"
    printf '%s\n' "${parts[@]}"
  ]

  # Split string on delimiter, return as JSON array
  rawClassMethod: splitToArray: str on: delim [
    local IFS="$delim"
    local parts newline
    printf -v newline '\n'
    if [[ "$delim" == "$newline" ]]; then
      # read -a stops at the first newline, losing all later Store IDs.
      mapfile -t parts < <(printf '%s' "$str")
    else
      read -ra parts <<< "$str"
    fi
    # jo with no arguments reads stdin, which blocks when stdin is open.
    if (( ${#parts[@]} == 0 )); then
      echo '[]'
      return
    fi
    jo -a "${parts[@]}"
  ]

  # Get part before delimiter (replaces ${str%%delim*})
  classMethod: before: delim in: str [
    ^ str upTo: delim
  ]

  # First line of a multi-line string (replaces ${str%%$'\n'*})
  classMethod: firstLine: str [
    ^ str firstLine
  ]

  # Get part after delimiter (replaces ${str#*delim})
  classMethod: after: delim in: str [
    ^ str after: delim
  ]

  # ========================================
  # String Building
  # ========================================

  # Concatenate two strings
  classMethod: concat: a with: b [
    ^ a , b
  ]

  # Concatenate three strings
  classMethod: concat: a with: b with: c [
    ^ a , b , c
  ]

  # Join array elements with delimiter
  rawClassMethod: join: delimiter values: values [
    local IFS="$delimiter"
    echo "$values"
  ]

  # Repeat string n times
  rawClassMethod: repeat: str times: n [
    local result=""
    local i
    for ((i=0; i<n; i++)); do
      result="${result}${str}"
    done
    echo "$result"
  ]

  # ========================================
  # JSON Operations
  # ========================================

  # Extract value at JSON path from a JSON string
  # Usage: value := @ String jsonPath: 'session_id.id' from: jsonString
  rawClassMethod: jsonPath: path from: jsonString [
    echo "$2" | jq -r ".$1 // empty"
  ]

  classMethod: jsonAt: path from: data [ ^ data jsonAt: path ]

  classMethod: jsonTextAt: path from: data [ ^ data jsonTextAt: path ]

  classMethod: jsonHas: path in: data [ ^ data jsonHas: path ]

  classMethod: jsonAt: path from: data ifAbsent: fallback [
    ^ data jsonAt: path ifAbsent: fallback
  ]

  rawClassMethod: isJson: jsonString [
    if printf '%s' "$1" | jq -se 'length == 1' >/dev/null 2>&1; then
      echo 'true'
    else
      echo 'false'
    fi
  ]

  # Filter JSON Lines records by an exact top-level field value. This is a
  # reusable jq boundary; browser policy stays in ordinary DSL methods.
  rawClassMethod: jsonLinesWhere: field equals: expected from: records [
    printf '%s\n' "$3" | jq -c --arg field "$1" --arg expected "$2" \
      'select(type == "object" and .[$field] == $expected)'
  ]

  # Convert a JSON array into one compact JSON record per line.
  rawClassMethod: jsonArrayAsLines: arrayJson [
    printf '%s' "$1" | jq -c '.[]'
  ]

  # Present persisted instance state as a compact key=value row for one-line
  # pickers such as the fzf fallback.
  rawClassMethod: jsonInstanceSummary: jsonString [
    printf '%s' "$1" | jq -r '
      def shown:
        if type == "string" then .
        elif type == "null" then "null"
        else tojson
        end;
      if type != "object" then shown
      elif (._vars | type) == "array" then
        . as $object
        | [._vars[] as $key
           | select($object | has($key))
           | "\($key)=\($object[$key] | shown)"]
        | join(" | ")
      else
        [to_entries[]
         | select(.key != "class" and .key != "created_at" and .key != "_vars")
         | "\(.key)=\(.value | shown)"]
        | join(" | ")
      end'
  ]

  # Convert the declared state of a Runtime object into the named cells used by
  # structured pickers.  _vars is deliberate: it preserves the class's
  # declaration order rather than leaking Runtime metadata or jq's key order.
  rawClassMethod: jsonInstanceColumns: jsonString [
    printf '%s' "$1" | jq -c '
      def shown:
        if type == "string" then .
        elif type == "null" then "null"
        else tojson
        end;
      if type != "object" then []
      else . as $object
        | [._vars[]? as $key
           | select($object | has($key))
           | {name:$key, value:($object[$key] | shown)}]
      end'
  ]

  # Project persisted Runtime data to declared instance variables. Class,
  # creation time, and the _vars manifest are implementation metadata rather
  # than editable object state in the inspector.
  rawClassMethod: jsonInstanceView: jsonString [
    printf '%s' "$1" | jq -c '
      if type != "object" then {}
      else . as $object
        | reduce ($object._vars[]?) as $key
            ({}; if ($object | has($key)) then .[$key] = $object[$key] else . end)
      end'
  ]

  # ========================================
  # Whitespace Handling
  # ========================================

  # Trim leading and trailing whitespace (using extglob)
  classMethod: trim: str [
    ^ str trimmed
  ]

  # Trim leading whitespace (using extglob)
  rawClassMethod: trimLeft: str [
    shopt -s extglob
    echo "${str##+([[:space:]])}"
  ]

  # Trim trailing whitespace (using extglob)
  rawClassMethod: trimRight: str [
    shopt -s extglob
    echo "${str%%+([[:space:]])}"
  ]
