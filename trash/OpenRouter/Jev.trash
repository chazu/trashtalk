# Jev's structured Decisions API, explicitly through OpenRouter.
package: OpenRouter

Jev subclass: Object
  classMethod: model [ ^ @ Config at: 'jev.model' ]

  classMethod: decide: state questions: questions [
    | model |
    model := @ self model ifFailed: [:e | @ e signal].
    ^ @ Decision::Request decide: state questions: questions model: model endpoint: 'https://openrouter.ai/api/alpha/decisions' credential: 'OPENROUTER_API_KEY' required: 'true'
  ]
