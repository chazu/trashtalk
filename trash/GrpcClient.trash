# GrpcClient - unary gRPC calls and reflection discovery through grpcurl.
# Each request starts a subprocess. No pooling, callback streaming, or local
# proto schemas are exposed. Plaintext is the compatibility default; enableTLS
# selects grpcurl's normal TLS verification. Child stderr/status are preserved.
GrpcClient subclass: Object
  instanceVars: address:'' usePlaintext:'yes'

  classMethod: connectTo: address [
    | client |
    address isEmpty ifTrue: [^ @ Require reject: 'A gRPC address is required'].
    client := @ self new.
    @ client address: address.
    ^ client
  ]

  method: call: rpc with: payload [
    | options arguments |
    options := #('-d' payload) asJson.
    arguments := #(rpc) asJson.
    ^ @ self invokeOptions: options arguments: arguments
  ]

  method: call: rpc [
    ^ @ self call: rpc with: '{}'
  ]

  method: listServices [
    ^ @ self invokeOptions: '[]' arguments: '["list"]'
  ]

  method: listMethods: service [
    | arguments |
    arguments := #('list' service) asJson.
    ^ @ self invokeOptions: '[]' arguments: arguments
  ]

  method: describe: target [
    | arguments |
    arguments := #('describe' target) asJson.
    ^ @ self invokeOptions: '[]' arguments: arguments
  ]

  method: enableTLS [ usePlaintext := 'no' ]
  method: enablePlaintext [ usePlaintext := 'yes' ]

  # Domain configuration builds exact argv; Tool owns JSON decoding and exec.
  method: invokeOptions: options arguments: arguments [
    | tool argv |
    tool := @ Tools::Grpcurl path.
    tool isEmpty ifTrue: [^ @ Require reject: 'grpcurl is not installed'].
    argv := #(tool) asJson.
    (usePlaintext = 'yes') ifTrue: [argv := argv arrayPush: '-plaintext'].
    argv := @ Tool argv: argv appendEach: options.
    argv := argv arrayPush: address.
    argv := @ Tool argv: argv appendEach: arguments.
    ^ @ Tool runArgvJson: argv
  ]
