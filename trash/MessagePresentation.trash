# Human-facing projection shared by inbox previews and session transcripts.
# Message.show remains the complete metadata view. Rendering never marks read.
MessagePresentation subclass: Object

  classMethod: dataFor: message [
    | data snapshots inputs presented |
    data := @ message asJson.
    snapshots := #{id: message data: (data jsonValue)} asJson.
    inputs := @ self inputsFor: snapshots.
    presented := @ self present: inputs.
    ^ presented jsonAt: 'data'
  ]

  # Presentation policy stays in the language. All input fields across all rows
  # are decoded once; only the final typed document needs a serializer per row.
  classMethod: present: inputs [
    pragma: stream
    | marker label prefix header search preview |
    inputs jsonRows: #('id' 'sender' 'rowSender' 'recipient' 'from' 'to' 'kind' 'status'
      'subject' 'body' 'firstLine' 'day' 'today' 'shortDate' 'fullDate' 'clock')
      into: [:id :sender :rowSender :recipient :from :to :kind :status
        :subject :body :firstLine :day :today :shortDate :fullDate :clock |
      (day = today) ifTrue: [shortDate := clock. fullDate := 'Today ' , clock].
      marker := ' '.
      (status = 'unread') ifTrue: [marker := '●'].
      (kind = 'question') ifTrue: [marker := marker , '?'].
      (kind = 'alert') ifTrue: [marker := marker , '!'].
      label := subject.
      (label = kind) ifTrue: [label := ''. subject := ''].
      label isEmpty ifTrue: [label := firstLine].
      label isEmpty ifTrue: [label := '(empty message)'].
      prefix := marker , ' ' , rowSender , '  ' , shortDate.
      header := sender , ' → ' , recipient , '  ·  ' , fullDate.
      search := from , ' ' , to , ' ' , status , ' ' , kind , ' ' , body.
      preview := header , '
'.
      subject notEmpty ifTrue: [preview := preview , subject , '
'].
      preview := preview , '
' , body.
      @ Console print: (#{id: id kind: kind text: preview
        data: #{label: label prefix: prefix header: header subject: subject body: body search: search}} asJson)
    ]
  ]

  classMethod: documentsFor: snapshots [
    | inputs presentations template |
    inputs := @ self inputsFor: snapshots.
    presentations := @ self present: inputs.
    template := #{path: #{_concat: #(#{_at: 'id'} '.txt')} text: #{_at: 'text'}
      record: #{schema_version: 1 id: #{_at: 'id'} label: #{_at: 'data.label'} kind: #{_at: 'kind'}
        detail: #{_at: 'data.prefix'} path: #{_concat: #(#{_at: 'id'} '.txt')} line: 1 column: 1
        display: #{prefix: #{_at: 'data.prefix'} preview_title: 'Message' search_text: #{_at: 'data.search'}}}} asJson.
    ^ @ Json projectEach: presentations with: template
  ]

  # SQL and text boundary: resolve distinct addresses in one read, normalize
  # Unicode once for all rows, and reuse calendar values for repeated times.
  rawClassMethod: inputsFor: snapshots [
    local addresses names timestamps calendar today
    addresses=$(printf '%s' "$1" | jq -cs '[.[] | .data | .from,.to] | unique') || return
    addresses=$(_db_escape "$addresses")
    names=$(_db_sql "SELECT coalesce(json_group_object(a.value,coalesce((
      SELECT coalesce(nullif(json_extract(i.data,'$.displayName'),''),json_extract(i.data,'$.handle'))
      FROM instances i WHERE i.class='AgentIdentity' AND (json_extract(i.data,'$.inbox')=a.value
      OR i.id=(SELECT json_extract(s.data,'$.identity') FROM instances s
        WHERE s.class='AgentSession' AND json_extract(s.data,'$.inbox')=a.value LIMIT 1)) LIMIT 1),a.value)),'{}')
      FROM json_each('$addresses') a;") || return
    timestamps=$(printf '%s' "$1" | jq -cs '[.[] | .data.sentAt | if .=="" then 0 else tonumber end | ./1000 | floor | select(.>0)] | unique') || return
    calendar=$(@ Time calendarFor: "$timestamps") || return
    printf -v today '%(%Y-%m-%d)T' -1
    printf '%s' "$1" | jq -cs --argjson names "$names" --argjson calendar "$calendar" \
      --arg today "$today" --arg human "${TRASHTALK_USER:-$USER}" -f "$SCRIPT_DIR/json/message-inputs.jq"
  ]

  classMethod: textFor: message [
    | data |
    data := @ self dataFor: message.
    ^ @ self textFrom: data
  ]

  classMethod: textFrom: data [

    pragma: stream
    | subject |
    @ Console print: (data jsonTextAt: 'header').
    subject := data jsonTextAt: 'subject'.
    subject notEmpty ifTrue: [@ Console print: subject].
    @ Console print: ''.
    @ Console print: (data jsonTextAt: 'body')
  ]

  classMethod: recordFor: message data: data [
    | label prefix search kind path |
    label := data jsonTextAt: 'label'.
    prefix := data jsonTextAt: 'prefix'.
    search := data jsonTextAt: 'search'.
    kind := @ message kind.
    path := message , '.txt'.
    ^ #{schema_version: 1 id: message label: label kind: kind detail: prefix path: path line: 1 column: 1 display: #{prefix: prefix preview_title: 'Message' search_text: search}} asJson
  ]

  classMethod: displayFor: message [
    | data |
    data := @ self dataFor: message.
    ^ #{prefix: (data jsonTextAt: 'prefix') preview_title: 'Message' search_text: (data jsonTextAt: 'search')} asJson
  ]

  # SQL boundary: resolve existing addresses without creating inboxes/identities.
  # Unknown senders retain their address so distinct participants stay distinct.
  rawClassMethod: participant: address [
    local address="$1" name escaped
    if [[ "$address" == "${TRASHTALK_USER:-$USER}" ]]; then echo You; return; fi
    escaped=$(_db_escape "$address")
    name=$(_db_sql "SELECT COALESCE(NULLIF(json_extract(i.data,'$.displayName'),''),json_extract(i.data,'$.handle')) FROM instances i WHERE i.class='AgentIdentity' AND (json_extract(i.data,'$.inbox')='$escaped' OR i.id=(SELECT json_extract(s.data,'$.identity') FROM instances s WHERE s.class='AgentSession' AND json_extract(s.data,'$.inbox')='$escaped' LIMIT 1)) LIMIT 1;")
    @ MessagePresentation singleLine: "${name:-$address}"
  ]

  # Text normalization at the jq boundary; discard control codes and collapse
  # whitespace before putting untrusted message text on a single terminal row.
  rawClassMethod: singleLine: text [
    printf '%s' "$1" | jq -Rrs 'gsub("[\u0000-\u001f\u007f-\u009f]"; " ") | gsub("\\s+"; " ") | sub("^ +"; "") | sub(" +$"; "")'
  ]

  rawClassMethod: firstLine: text [
    local line
    line=$(printf '%s' "$1" | jq -Rrs 'split("\n") | map(select(test("\\S"))) | .[0] // ""')
    @ MessagePresentation singleLine: "$line"
  ]

  # Unicode slicing at the jq boundary: Bash substring under LC_ALL=C may
  # split a UTF-8 name mid-character. Preserve the full name in the preview.
  rawClassMethod: rowName: name [
    printf '%s' "$1" | jq -Rrs 'if length > 20 then .[:19] + "…" else . end'
  ]
