# Scheduler - Cron-based periodic tasks via Honker
# Registers tasks with cron expressions. A background tick loop claims
# due tasks and executes them. Honker handles leader election — multiple
# processes can run the tick loop and only one claims each task.
#
# Usage:
#   @ Scheduler every: '*/5 * * * *' do: $handler named: 'cleanup'
#   @ Scheduler start           # start tick loop
#   @ Scheduler stop            # stop tick loop
#   @ Scheduler unschedule: 'cleanup'

Scheduler subclass: Object
  include: Debuggable

  # Register a periodic task with a handler block
  classMethod: every: cronExpr do: handler named: name [
    | payload |
    payload := #{handler: handler type: 'block'} asJson.
    ^ @ Honker schedule: name task: name cron: cronExpr payload: payload
  ]

  # Register a periodic task with a bash callback function
  classMethod: every: cronExpr call: callbackFn named: name [
    | payload |
    payload := #{callback: callbackFn type: 'function'} asJson.
    ^ @ Honker schedule: name task: name cron: cronExpr payload: payload
  ]

  # Unregister a scheduled task
  classPrimitive: unschedule: name calls: honker_unschedule

  # Start the background tick loop
  # Checks for due tasks every second and executes them
  rawClassMethod: start [
    pragma: direct
    (
      while true; do
        local due
        due=$(honker_scheduler_tick)

        if [[ -n "$due" && "$due" != "[]" && "$due" != "null" ]]; then
          echo "$due" | jq -c '.[]' 2>/dev/null | while IFS= read -r task; do
            local payload task_type handler callback
            payload=$(echo "$task" | jq -r '.payload // empty' 2>/dev/null)

            if [[ -n "$payload" ]]; then
              task_type=$(echo "$payload" | jq -r '.type // empty' 2>/dev/null)

              case "$task_type" in
                block)
                  handler=$(echo "$payload" | jq -r '.handler // empty' 2>/dev/null)
                  [[ -n "$handler" ]] && @ "$handler" value 2>/dev/null || true
                  ;;
                function)
                  callback=$(echo "$payload" | jq -r '.callback // empty' 2>/dev/null)
                  [[ -n "$callback" ]] && "$callback" 2>/dev/null || true
                  ;;
                *)
                  echo "$payload" | jq -r '.handler // .callback // empty' 2>/dev/null | while IFS= read -r h; do
                    [[ -n "$h" ]] && eval "$h" 2>/dev/null || true
                  done
                  ;;
              esac
            fi
          done
        fi

        sleep 1
      done
    ) &

    _SCHEDULER_PID=$!
    export _SCHEDULER_PID
  ]

  # Stop the tick loop
  rawClassMethod: stop [
    pragma: direct
    if [[ -n "${_SCHEDULER_PID:-}" ]]; then
      kill "$_SCHEDULER_PID" 2>/dev/null
      wait "$_SCHEDULER_PID" 2>/dev/null
      unset _SCHEDULER_PID
    fi
  ]

  # Check if the tick loop is running
  classMethod: isRunning [
    | pid |
    pid := @ Env get: '_SCHEDULER_PID'.
    pid isEmpty ifTrue: [^ 'false'].
    ^ @ Tool isAlivePid: pid
  ]

  # Get seconds until the next scheduled task fires
  classPrimitive: soonest calls: honker_scheduler_soonest

  # Manually tick once (for testing)
  classPrimitive: tick calls: honker_scheduler_tick

  classMethod: help [
    ^ '''=== Scheduler - Cron-Based Periodic Tasks ===

Register tasks:
  @ Scheduler every: '*/5 * * * *' do: $handler named: 'cleanup'
  @ Scheduler every: '0 * * * *' call: 'my_hourly_fn' named: 'hourly'

Control:
  @ Scheduler start       # start tick loop
  @ Scheduler stop        # stop tick loop
  @ Scheduler isRunning

Manage:
  @ Scheduler unschedule: 'cleanup'
  @ Scheduler soonest     # seconds until next task
  @ Scheduler tick        # manual tick (testing)'''
  ]
