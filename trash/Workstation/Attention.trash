package: Workstation

# Local attention lifecycle and atomic user-Inbox projection. No agent effects.
Attention subclass: Object
  include: Persistable
  instanceVars: id:'' subscription:'' groupKey:'' state:'open' message:'' firstCoordinate:'null'
    lastCoordinate:'null' eventCount:0 snoozeUntil:'' note:'' actor:'' createdAt:'' updatedAt:''
    schema_version:1 schemaDigest:'' lastResolvedSession:'' workspace:'' origin:'null' lineageDepth:0
    delegationRevision:0 delegatedMessage:'' delegatedSession:'' delegatedIdentity:'' routingNote:''

  classMethod: new [ @ Require reject: 'Use Attention createFrom: with a closed document' ]
  method: save [ @ Require reject: 'Use Attention lifecycle messages' ]
  classMethod: read: id [
    @ Workstation::Schema ensureSchema.
    ^ @ Store read: id class: 'Workstation::Attention'
  ]
  classMethod: createFrom: document [
    ^ @ Workstation::Schema transact: document as: 'Attention' sending: 'createWithin:'
  ]
  classMethod: validateWithin: document [
    | sub human message session owner |
    @ Workstation::Schema requireValidated: document.
    human := @ AgentFocus human.
    @ Require equal: (document jsonTextAt: 'actor') to: human.
    sub := @ Store read: (document jsonTextAt: 'subscription') class: 'Workstation::EventSubscription'.
    owner := @ sub owner.
    @ Require equal: owner to: human.
    @ Require text: (document jsonTextAt: 'groupKey').
    @ Workstation::Schema timestampEpoch: (document jsonTextAt: 'createdAt').
    @ Workstation::Schema timestampEpoch: (document jsonTextAt: 'updatedAt').
    message := document jsonTextAt: 'message'.
    (message notEmpty) ifTrue: [@ Store read: message class: 'Message'].
    session := document jsonTextAt: 'lastResolvedSession'.
    (session notEmpty) ifTrue: [@ Store read: session class: 'AgentSession'].
    @ self validateRoutingWithin: document
  ]
  # Routing references are optional metadata; when present they must resolve.
  classMethod: validateRoutingWithin: document [
    | value |
    value := document jsonAt: 'delegatedSession' ifAbsent: '""'.
    value := value jsonTextAt: ''.
    (value notEmpty) ifTrue: [@ Store read: value class: 'AgentSession'].
    value := document jsonAt: 'delegatedIdentity' ifAbsent: '""'.
    value := value jsonTextAt: ''.
    (value notEmpty) ifTrue: [@ Store read: value class: 'AgentIdentity'].
    value := document jsonAt: 'delegatedMessage' ifAbsent: '""'.
    value := value jsonTextAt: ''.
    (value notEmpty) ifTrue: [@ Store read: value class: 'Message']
  ]
  classMethod: createWithin: document [
    | id |
    @ self validateWithin: document.
    @ Require equal: (document jsonTextAt: 'state') to: 'open'.
    @ Require equal: (document jsonTextAt: 'eventCount') to: '0'.
    @ Require equal: (document jsonAt: 'firstCoordinate') to: 'null'.
    @ Require equal: (document jsonAt: 'lastCoordinate') to: 'null'.
    @ Require equal: (document jsonTextAt: 'snoozeUntil') to: ''.
    @ Require equal: (document jsonTextAt: 'createdAt') to: (document jsonTextAt: 'updatedAt').
    @ Require equal: (document jsonAt: 'delegatedMessage' ifAbsent: '""') to: '""'.
    @ Require equal: (document jsonAt: 'delegationRevision' ifAbsent: '0') to: '0'.
    id := document jsonTextAt: 'id'.
    @ Store create: 'Workstation::Attention' id: id.
    @ Workstation::Schema write: document to: id.
    ^ id
  ]
  classMethod: allowedTransitions [
    ^ '["open:acknowledged","open:snoozed","open:resolved","open:suppressed","acknowledged:open","acknowledged:snoozed","acknowledged:resolved","acknowledged:suppressed","snoozed:open","snoozed:acknowledged","snoozed:resolved","snoozed:suppressed","resolved:open","suppressed:open"]'
  ]
  classMethod: transitionWithin: document [
    | id old from to pair allowed wakeTime now reason |
    @ self validateWithin: document.
    id := document jsonTextAt: 'id'.
    @ Store read: id class: 'Workstation::Attention'.
    old := @ Store getInstance: id.
    old := @ Workstation::Schema document: old.
    '["id","subscription","groupKey","message","firstCoordinate","lastCoordinate","eventCount","createdAt","schema_version","schemaDigest","lastResolvedSession","workspace","origin","lineageDepth","delegationRevision","delegatedMessage","delegatedSession","delegatedIdentity","routingNote"]' arrayEach: [:field |
      @ Require equal: (document jsonAt: field ifAbsent: 'null') to: (old jsonAt: field ifAbsent: 'null')
    ].
    from := old jsonTextAt: 'state'.
    to := document jsonTextAt: 'state'.
    pair := from , ':' , to.
    allowed := @ self allowedTransitions.
    @ Require member: pair of: allowed.
    reason := document jsonTextAt: 'note'.
    (to = 'resolved') ifTrue: [@ Require text: reason].
    (to = 'suppressed') ifTrue: [@ Require text: reason].
    (to = 'snoozed') ifTrue: [
      wakeTime := @ Workstation::Schema timestampEpoch: (document jsonTextAt: 'snoozeUntil').
      now := @ Time now.
      (wakeTime > now) ifFalse: [^ @ Require reject: 'Snooze requires a future normalized UTC timestamp']
    ] ifFalse: [@ Require equal: (document jsonTextAt: 'snoozeUntil') to: ''].
    @ Workstation::Schema write: document to: id.
    ^ id
  ]
  method: transitionTo: state until: wakeTime note: reason [
    | document patch actor now |
    document := @ Store getInstance: self.
    document := @ Workstation::Schema document: document.
    actor := @ AgentFocus human.
    now := @ Time nowISO.
    patch := #{state: state snoozeUntil: wakeTime note: reason actor: actor updatedAt: now} asJson.
    document := @ Workstation::Schema merge: document with: patch.
    # The transaction's failure must reach the caller: an unguarded assignment
    # from a send would swallow it. Its value is this record's id.
    (@ Workstation::Schema transact: document as: 'Attention' sending: 'transitionWithin:') ifFailed: [:error | @ error signal].
    # Lifecycle changes are what a prompt indicator is for; refresh it after
    # the commit, outside the transaction.
    @ AgentWorkboard publishIndicator.
    ^ self
  ]
  classMethod: delegateWithin: candidate [ ^ @ Workstation::Routing delegateWithin: candidate ]
  method: acknowledge [ ^ @ self transitionTo: 'acknowledged' until: '' note: '' ]
  method: snoozeUntil: wakeTime [ ^ @ self transitionTo: 'snoozed' until: wakeTime note: '' ]
  method: resolveWithNote: note [ ^ @ self transitionTo: 'resolved' until: '' note: note ]
  method: suppress: note [ ^ @ self transitionTo: 'suppressed' until: '' note: note ]
  method: reopen [ ^ @ self transitionTo: 'open' until: '' note: '' ]
  method: summary [ ^ @ self display ]
  method: display [
    ^ #{id: self subscription: subscription groupKey: groupKey state: state eventCount: (eventCount jsonValue) updatedAt: updatedAt workspace: workspace delegationRevision: (delegationRevision jsonValue) delegatedSession: delegatedSession routingNote: routingNote} asJson
  ]

  # Phase 2 routing. The dry run mutates nothing; delegation publishes through
  # WorkstationRouting; focus attaches to the recorded session only.
  method: routingStatus [ ^ @ Workstation::Routing statusFor: self ]
  method: delegate [ ^ @ Workstation::Routing delegate: self ]
  method: redelegate: reason [ ^ @ Workstation::Routing redelegate: self reason: reason ]
  method: focusDelegated [ ^ @ Workstation::Routing focus: self ]

  # Preparation and CUE execute outside both Store and the worker OS lock.
  classMethod: accept: event for: subscription [
    | candidate now actor id group partition parts digest bundle workspace origin depth |
    (@ Workstation::Schema validate: event as: 'Envelope') ifFailed: [:error | @ error signal].
    (@ Workstation::CommandReceiptSourceAdapter validateSubscription: subscription) ifFailed: [:error | @ error signal].
    id := @ Runtime generateId: 'Workstation::Attention'.
    actor := @ AgentFocus human.
    now := @ Time nowISO.
    group := event jsonTextAt: 'groupKey'.
    partition := event jsonTextAt: 'coordinate.partition'.
    parts := #(group partition) asJson.
    group := @ Workstation::Schema hash: parts.
    digest := @ Workstation::Schema digest.
    # Routing metadata is fixed at group creation: workspace, closed origin, and lineage depth.
    workspace := event jsonAt: 'workspace' ifAbsent: '""'.
    workspace := workspace jsonTextAt: ''.
    origin := event jsonAt: 'origin' ifAbsent: 'null'.
    depth := @ Workstation::Routing lineageFor: origin.
    candidate := #{schema_version: 1 id: id subscription: (subscription jsonTextAt: 'id')
      groupKey: group state: 'open' message: '' firstCoordinate: null lastCoordinate: null
      eventCount: 0 snoozeUntil: '' note: '' actor: actor createdAt: now updatedAt: now
      schemaDigest: digest lastResolvedSession: '' workspace: workspace origin: (origin jsonValue)
      lineageDepth: (depth jsonValue) delegationRevision: 0 delegatedMessage: '' delegatedSession: ''
      delegatedIdentity: '' routingNote: ''} asJson.
    (@ Workstation::Schema validate: candidate as: 'Attention') ifFailed: [:error | @ error signal].
    bundle := #{event: (event jsonValue) subscription: (subscription jsonValue) candidate: (candidate jsonValue)} asJson.
    ^ @ self acceptPrepared: bundle
  ]
  # Dynamic exact-document capability, following WorkstationSchema.transact:.
  # Revalidate at this public entry so direct callers cannot forge preparation.
  rawClassMethod: acceptPrepared: bundle [
    local event subscription candidate group digest
    event=$(printf '%s' "$1" | jq -ce .event) || return 1
    subscription=$(printf '%s' "$1" | jq -ce .subscription) || return 1
    candidate=$(printf '%s' "$1" | jq -ce .candidate) || return 1
    @ Workstation::Schema validate: "$event" as: Envelope >/dev/null || return 1
    @ Workstation::CommandReceiptSourceAdapter validateSubscription: "$subscription" >/dev/null || return 1
    @ Workstation::Schema validate: "$candidate" as: Attention >/dev/null || return 1
    group=$(@ Workstation::Schema hash: "$(printf '%s' "$event" | jq -c '[.groupKey,.coordinate.partition]')") || return 1
    digest=$(@ Workstation::Schema digest) || return 1
    printf '%s' "$candidate" | jq -e --arg g "$group" --arg d "$digest" --argjson s "$subscription" --argjson e "$event" '
      .groupKey==$g and .subscription==$s.id and .schemaDigest==$d and
      .message=="" and .lastResolvedSession=="" and .delegatedMessage=="" and .delegationRevision==0 and
      .workspace==($e.workspace // "") and .origin==($e.origin // null)' >/dev/null || return 1
    @ Workstation::Schema ensureSchema || return 1
    _WORKSTATION_VALIDATED_JSON="$candidate" _WORKSTATION_ACCEPTANCE="$1" @ Store transaction: Workstation::Attention sending: 'acceptWithin:' with: "$1" replaying: true
  ]
  rawClassMethod: requireAcceptance: bundle [
    @ Store requireTransaction || return 1
    [[ -n ${_WORKSTATION_ACCEPTANCE:-} && "$1" == "$_WORKSTATION_ACCEPTANCE" ]] || { _throw WorkstationSchemaError 'Attention acceptance requires exact prevalidation'; return 1; }
  ]
  classMethod: acceptWithin: bundle [
    | event subscription candidate coordinate existing id group matches attention message display inbox |
    @ self requireAcceptance: bundle.
    event := bundle jsonAt: 'event'.
    subscription := bundle jsonAt: 'subscription'.
    candidate := bundle jsonAt: 'candidate'.
    @ Workstation::Worker filterWithin: subscription.
    coordinate := event jsonAt: 'coordinate'.
    id := subscription jsonTextAt: 'id'.
    @ Require equal: (coordinate jsonTextAt: 'subscription') to: id.
    @ Require equal: (coordinate jsonTextAt: 'streamName') to: (subscription jsonTextAt: 'streamName').
    existing := @ Store claimedCoordinate: coordinate.
    (existing notEmpty) ifTrue: [^ existing].
    @ Workstation::Schema requireValidated: candidate.
    @ Require equal: (candidate jsonTextAt: 'subscription') to: id.
    group := candidate jsonTextAt: 'groupKey'.
    matches := @ Store findByClass: 'Workstation::Attention' matching: (#{subscription: id groupKey: group state: #('open' 'acknowledged' 'snoozed' 'suppressed')} asJson) orderBy: 'created_at DESC' limit: 1.
    attention := matches firstLine.
    (attention isEmpty) ifTrue: [attention := @ self createWithin: candidate].
    @ Store recordCoordinate: coordinate forAttention: attention.
    # Opt-in automatic routing commits with the acceptance; the root Message
    # then reflects any assignment. Ineligible groups keep a visible reason.
    @ Workstation::Routing autoWithin: attention subscription: subscription.
    display := event jsonAt: 'display'.
    inbox := @ Inbox localFor: (subscription jsonTextAt: 'owner').
    message := @ inbox attention: attention display: display debounce: (subscription jsonTextAt: 'debounceSeconds').
    @ Store patch: attention with: (#{message: message} asJson).
    ^ attention
  ]

  # UI projection only. An expired snooze is visible without mutating lifecycle
  # state or manufacturing a new event. SQL joins scope by subscription owner.
  rawClassMethod: localOpen [
    local owner
    owner=$(_db_escape "$(@ AgentFocus human)")
    @ Store findByClass: Workstation::Attention where: "json_extract(data,'$.subscription') IN (SELECT id FROM instances WHERE class='Workstation::EventSubscription' AND json_extract(data,'$.owner')='$owner') AND (json_extract(data,'$.state')='open' OR (json_extract(data,'$.state')='snoozed' AND json_extract(data,'$.snoozeUntil')<=strftime('%Y-%m-%dT%H:%M:%SZ','now')))" orderBy: 'created_at DESC' limit: 1000
  ]
  classMethod: localOpenCount [
    | ids count |
    ids := @ self localOpen.
    count := 0.
    ids linesDo: [:id | count := count + 1].
    ^ count
  ]
