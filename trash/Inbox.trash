# Inbox - Durable, queryable message inbox for agents, humans, and processes
# An inbox is addressed by a free-form name and created on first use. Messages
# are Persistable Message objects, so they survive process exit and can be
# listed, read, replied to, and archived from any trashtalk process sharing
# the Store. Honker pub/sub is used only as a wakeup signal: `onMessage:`
# runs a Block for each delivery, and that Block is where transports live
# (mosquitto_pub, tmux send-keys, maki session notify, ...). Everything except
# `onMessage:` works without the honker extension.
#
# Usage:
#   @ Inbox send: 'tests pass' to: 'chazu' from: 'maki' subject: 'done' kind: 'result'
#   @ Inbox ask: 'ok to force-push?' to: 'chazu' from: 'maki'
#
#   inbox=$(@ Inbox named: 'chazu')
#   @ $inbox list                 # unread, one line each
#   @ $inbox show: $msgId         # full message, marks it read
#   @ $inbox unreadCount
#   @ $inbox questions            # unread messages of kind 'question'
#   @ $inbox thread: $msgId       # every message in that thread, oldest first
#   @ $msgId reply: 'yes'         # lands in the sender's inbox
#
#   handler=$(@ Block params: '["payload"]' code: 'mosquitto_pub -t inbox -m "$payload"' captured: '{}')
#   @ $inbox onMessage: $handler  # background listener (needs honker)
#   @ $inbox stopListening
Inbox subclass: Object
  include: Persistable
  include: Observable
  instanceVars: name:'' listenerPids:''

  # Find or create the inbox with this name. The same instance id backs every
  # call, which keeps the Observable topic (<id>.message) stable across
  # processes. The name is interpolated into SQL (here and in scope:), so it is
  # constrained to letters, digits, _ . : - and may not start with . or -. The
  # classes are spelled out: ranges such as A-Z admit accented letters in UTF-8.
  classMethod: named: inboxName [
    | where existing id |
    (inboxName matches: '^[ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_:][ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_.:-]*$') ifFalse: [
      @ InboxError signal: "Invalid inbox name '$inboxName' (allowed: letters, digits, _ . : -)"
    ].
    where := "json_extract(data, '$.name') = '${inboxName}'".
    existing := @ Store findByClass: 'Inbox' where: where orderBy: 'created_at ASC' limit: 1.
    existing notEmpty ifTrue: [^ existing].
    @ Inbox ensureSchema.
    id := @ Inbox new.
    @ id name: inboxName.
    @ id save.
    ^ id
  ]

  # Virtual columns + indexes for the Message fields inboxes query on.
  # Best-effort and idempotent; queries below work without them.
  classMethod: ensureSchema [
    @ Store ensureIndex: 'msg_to' path: '$.to'.
    @ Store ensureIndex: 'msg_status' path: '$.status'.
    @ Store ensureIndex: 'msg_thread' path: '$.thread'
  ]

  # Class sends fall through to instance methods before trait methods, so
  # preserve Persistable's class count explicitly alongside message count.
  classMethod: count [
    ^ @ Store countByClass: self
  ]

  # Names of every known inbox
  classMethod: names [
    | ids n |
    ids := @ Inbox findAll.
    ids linesDo: [:id |
      n := @ id name.
      @ Console print: n
    ]
  ]

  # ------------------------------------------------------------------
  # Sending
  # ------------------------------------------------------------------

  classMethod: send: text to: recipient from: sender subject: subj kind: aKind [
    | msg inbox |
    msg := @ Message to: recipient from: sender subject: subj body: text kind: aKind.
    inbox := @ Inbox named: recipient.
    ^ @ inbox deliver: msg
  ]

  classMethod: send: text to: recipient from: sender [
    ^ @ Inbox send: text to: recipient from: sender subject: '' kind: 'note'
  ]

  classMethod: send: text to: recipient from: sender in: workspace [
    ^ @ self send: text to: recipient from: sender subject: '' kind: 'note' in: workspace
  ]

  classMethod: send: text to: recipient from: sender subject: subject kind: kind in: workspace [
    | msg inbox directory |
    directory := @ Agent::Session workspaceFor: workspace.
    msg := @ Message to: recipient from: sender subject: subject body: text kind: kind.
    @ msg executionWorkspace: directory.
    inbox := @ Inbox named: recipient.
    ^ @ inbox deliver: msg
  ]

  # A question expects a reply: the recipient answers with `@ msg reply:`.
  classMethod: ask: text to: recipient from: sender [
    ^ @ Inbox send: text to: recipient from: sender subject: '' kind: 'question'
  ]

  classMethod: alert: text to: recipient from: sender [
    ^ @ Inbox send: text to: recipient from: sender subject: '' kind: 'alert'
  ]

  # Stamp, persist, and signal. Returns the message id. Inboxes named
  # `session:<id>` or `agent:<handle>` belong to agent sessions: the message
  # also becomes an Agent::Delivery and the worker ticks that session.
  # Never report success or emit a wake when persistence failed.
  method: deliver: message [
    (@ self prepare: message) ifFailed: [:error | @ error signal].
    (@ Agent::Queue persist: message) ifFailed: [:error | @ error signal].
    ^ @ self announce: message
  ]

  method: prepare: message [
    | now millis existingThread |
    now := @ Time nowISO.
    millis := @ Time nowMillis.
    @ Runtime assign: (#{to: name created: now sentAt: millis} asJson) to: message.
    existingThread := @ message thread.
    (existingThread isEmpty) ifTrue: [@ message thread: message]
  ]

  method: announce: message [
    | routed |
    @ self announceLocal: message.
    routed := @ Agent::Worker handlesInbox: name.
    (routed = 'true') ifTrue: [
      @ Agent::Worker deliverMessage: message toInbox: name
    ].
    ^ message
  ]

  # ------------------------------------------------------------------
  # Queries (ids, one per line)
  # ------------------------------------------------------------------

  # SQL predicate scoping a Message query to this inbox. `name` is validated
  # by named:, so interpolating it is safe.
  method: scope: extra [
    | inboxName where |
    inboxName := name.
    where := "json_extract(data, '$.to') = '${inboxName}'${extra}".
    ^ where
  ]

  # Messages in this inbox matching an extra predicate, oldest first.
  method: oldestWhere: extra [
    | where |
    where := @ self scope: extra.
    ^ @ Store findByClass: 'Message' where: where orderBy: "json_extract(data, '$.sentAt') ASC, rowid ASC" limit: 1000
  ]

  method: unread [
    ^ @ self oldestWhere: " AND json_extract(data, '$.status') = 'unread'"
  ]

  # Number of ids in a newline-separated id list (empty lines skipped).
  method: countIds: ids [
    | count |
    count := 0.
    ids linesDo: [:id | count := count + 1].
    ^ count
  ]

  method: unreadCount [
    | ids |
    ids := @ self unread.
    ^ @ self countIds: ids
  ]

  method: questions [
    ^ @ self oldestWhere: " AND json_extract(data, '$.status') = 'unread' AND json_extract(data, '$.kind') = 'question'"
  ]

  # Recent non-archived messages, newest first
  method: messages: limit [
    | where |
    where := @ self scope: " AND json_extract(data, '$.status') != 'archived'".
    ^ @ Store findByClass: 'Message' where: where orderBy: "json_extract(data, '$.sentAt') DESC, rowid DESC" limit: limit
  ]

  method: messages [
    ^ @ self messages: 50
  ]

  # All visible messages, including read messages, without a page limit.
  method: count [
    | ids |
    ids := @ self messages: -1.
    ^ @ self countIds: ids
  ]

  # Every message in a thread, across inboxes, oldest first
  method: thread: threadId [
    ^ @ Store findByClass: 'Message' matching: (#{thread: threadId} asJson) orderBy: "json_extract(data, '$.sentAt') ASC, rowid ASC" limit: 1000
  ]

  # ------------------------------------------------------------------
  # Human-facing
  # ------------------------------------------------------------------

  # Print unread messages, one line each
  method: list [
    pragma: stream
    | ids count header line |
    ids := @ self unread.
    count := @ self countIds: ids.
    (count = 0) ifTrue: [
      header := 'Inbox ' , name , ': no unread messages'.
      @ Console print: header.
      ^ self
    ].
    header := 'Inbox ' , name , ' (' , count , ' unread):'.
    @ Console print: header.
    ids linesDo: [:id |
      line := @ id summary.
      @ Console print: line
    ]
  ]

  # Print one message in full and mark it read
  method: show: messageId [
    @ messageId markRead.
    @ messageId show
  ]

  method: readAll [
    | ids |
    ids := @ self unread.
    ids linesDo: [:id | @ id markRead]
  ]

  # ------------------------------------------------------------------
  # Innards UI: pick a message, read its thread, reply or archive
  # ------------------------------------------------------------------

  # Interactive loop over inpick / inpage / inmacs (with fzf and $EDITOR
  # fallbacks). Selecting a message marks it read and offers reply, view
  # thread/details, attach to sender session, archive, or back. Returns when
  # the message picker is cancelled. Prints the final outcome.
  rawMethod: browse [
    local preview_dir result outcome msg action
    preview_dir=$(mktemp -d "${TMPDIR:-/tmp}/trash-inbox.XXXXXX")
    while true; do
      result=$(@ "$_RECEIVER" pickMessageIn: "$preview_dir")
      outcome=$(printf '%s' "$result" | jq -r '.outcome // "cancelled"')
      [[ "$outcome" == selected ]] || break
      msg=$(printf '%s' "$result" | jq -r '.selection.id // empty')
      [[ -n "$msg" ]] || break
      action=$(printf '%s' "$result" | jq -r '.action // empty')
      if [[ "$action" == archive ]]; then
        @ "$msg" archive >/dev/null
        continue
      fi
      @ "$msg" markViewed >/dev/null
      while true; do
        action=$(@ "$_RECEIVER" pickActionFor: "$msg" in: "$preview_dir")
        case "$action" in
          reply) @ "$_RECEIVER" composeReplyTo: "$msg" >/dev/null; break ;;
          view) @ "$_RECEIVER" readThreadOf: "$msg" ;;
          details) @ "$_RECEIVER" readDetailsOf: "$msg" ;;
          session) @ Agent::Browser focusSenderOf: "$msg" in: "$preview_dir" >/dev/null ;;
          acknowledge|snooze|resolve|suppress|reopen|routing|delegate|redelegate|focus) @ "$_RECEIVER" attentionAction: "$action" on: "$msg" ;;
          archive) @ "$msg" archive >/dev/null; break ;;
          *) break ;;
        esac
      done
    done
    rm -rf "$preview_dir"
    printf '%s\n' "$outcome"
  ]

  # One picker record per recent message, newest first, with a rendered
  # preview file the picker can show beside the list.
  rawMethod: pickMessageIn: previewDir [
    local dir="$1" ids m data name title records
    name=$(_ivar name)
    : > "$dir/records.jsonl"
    ids=$(@ "$_RECEIVER" messages: 200)
    local snapshots documents
    snapshots=$(@ Runtime reloadDataFor: "$ids") || return 1
    documents=$(@ MessagePresentation documentsFor: "$snapshots") || return 1
    @ Json writeDocuments: "$documents" in: "$dir" > "$dir/records.jsonl" || return 1
    if [[ ! -s "$dir/records.jsonl" ]]; then
      printf '%s\n' "Inbox $name is empty" >&2
      jq -cn '{schema_version:1,outcome:"cancelled",selection:null}'
      return 0
    fi
    records=$(cat "$dir/records.jsonl")
    title="Inbox $name"
    if [[ "$(@ Tools::Inpick isInstalled)" == true ]]; then
      @ "$_RECEIVER" writePreviewHookIn: "$dir" || return 1
      @ Tools::Inpick selectRecords: "$records" root: "$dir" query: "" title: "$title" controlDAction: archive previewHook: "$dir/preview-hook"
    else
      @ Tools::Inpick fallbackSelectRecords: "$records" query: "" title: "$title" controlDAction: archive
    fi
  ]

  # OS boundary: inpick reports only previews it has displayed. The private
  # executable validates the id against this picker before using the public API.
  rawMethod: writePreviewHookIn: dir [
    local dir="$1" tdir="${TRASHTALK_DIR:-$HOME/.trashtalk}"
    {
      printf '#!/usr/bin/env bash\nset -euo pipefail\n'
      printf 'export TRASHTALK_DIR=%q SQLITE_JSON_DB=%q\n' "$tdir" "$SQLITE_JSON_DB"
      # Share the caller's cache so subsequent message getters see this read.
      printf 'export TRASH_SESSION_ID=%q\n' "$TRASH_SESSION_ID"
      printf 'id=$(jq -er .id)\n'
      printf 'jq -e --arg id "$id" %q %q >/dev/null\n' 'select(.id == $id)' "$dir/records.jsonl"
      printf 'exec %q %q previewed: "$id"\n' "$tdir/bin/trash-send" "$_RECEIVER"
    } > "$dir/preview-hook" || return 1
    chmod 700 "$dir/preview-hook"
  ]

  method: previewed: message [
    @ message markViewed.
    ^ @ MessagePresentation displayFor: message
  ]

  # Show the whole thread in inpage (or plain stdout). Leave inpage with
  # Ctrl-X Ctrl-C; Ctrl-C interrupts the whole browse loop.
  method: readThreadOf: message [
    | conversation ids part text |
    conversation := @ message thread.
    ids := @ self thread: conversation.
    text := ''.
    ids linesDo: [:id |
      part := @ id readText.
      (text notEmpty) ifTrue: [text := text , '

'].
      text := text , part , '

----------------------------------------'
    ].
    @ self page: text title: 'Conversation'
  ]

  # Page text in inpage when it is installed, otherwise print it.
  method: page: text title: title [
    | available ignored |
    available := @ Tools::Inpage isInstalled.
    (available = 'true') ifTrue: [
      ignored := @ Tools::Inpage viewText: text title: title
    ] ifFalse: [@ Console print: text]
  ]

  # Attention controls from the browser. Notes are asked for on a terminal;
  # otherwise a plain default note records that the action came from the inbox.
  # Failures (an illegal transition, another owner) are shown, never hidden.
  rawMethod: attentionAction: action on: messageId [
    local note='' until
    case "$1" in
      acknowledge) @ "$2" acknowledgeAttention >/dev/null ;;
      reopen) @ "$2" reopenAttention >/dev/null ;;
      snooze)
        until=$(perl -MPOSIX -e 'print strftime("%Y-%m-%dT%H:%M:%SZ", gmtime(time + 86400))') || return 1
        @ "$2" snoozeAttentionUntil: "$until" >/dev/null ;;
      resolve|suppress)
        if [[ -t 0 && -t 1 ]]; then read -r -p "Note for $1: " note; fi
        [[ -n "$note" ]] || note="${1}d from the inbox"
        if [[ "$1" == resolve ]]; then @ "$2" resolveAttentionWithNote: "$note" >/dev/null; else @ "$2" suppressAttention: "$note" >/dev/null; fi ;;
      # Phase 2 routing: a dry run shows the structured reason; delegation and
      # focus are explicit and never create, resume, or stop a session.
      routing) @ "$_RECEIVER" showRoutingOf: "$2" ;;
      delegate) @ "$2" delegateAttention >/dev/null ;;
      redelegate)
        if [[ -t 0 && -t 1 ]]; then read -r -p "Reason for redelegation: " note; fi
        [[ -n "$note" ]] || note="redelegated from the inbox"
        @ "$2" redelegateAttention: "$note" >/dev/null ;;
      focus) @ "$2" focusDelegatedAttention >/dev/null ;;
      *) return 1 ;;
    esac
  ]

  method: showRoutingOf: message [
    | text |
    text := @ message routingStatus.
    @ self page: text title: 'Attention routing'
  ]

  # Second picker: what to do with the selected message. Every record points
  # at the message's preview file so inpick keeps showing it. Workstation
  # alerts get attention controls in place of reply, which would only mail a
  # producer inbox nobody reads. Prints the chosen record id, or back.
  rawMethod: pickActionFor: messageId in: previewDir [
    local msg="$1" dir="$2" records from attention state sessions selected
    from=$(@ MessagePresentation participant: "$(@ "$msg" from)")
    attention=$(@ "$msg" attention)
    if [[ -n "$attention" ]]; then
      state=$(@ "$msg" inspectAttention 2>/dev/null | jq -r '"\(.state), \(.eventCount) events"' 2>/dev/null) || state=''
    fi
    sessions=$(@ "$msg" senderSessions)
    records=$(jq -cn --arg path "$msg.txt" --arg state "${state:-attention unavailable}" \
        --arg attention "$attention" --arg sessions "$sessions" '
      def action($id; $label; $detail):
        {schema_version:1,id:$id,path:$path,line:1,column:1,label:$label,kind:"action",detail:$detail};
      def view: action("view"; "View the whole thread"; "inpage; leave with Ctrl-X Ctrl-C");
      def details: action("details"; "Message details"; "Full addresses, timestamps, and IDs");
      def back: action("back"; "Back to inbox"; "");
      def preview($title): . + {display:{prefix:"",preview_title:$title}};
      if $attention != "" then
        (action("acknowledge"; "Acknowledge attention"; "seen, keeps counting (" + $state + ")"),
         action("snooze"; "Snooze attention for a day"; "reappears in the count after 24 hours or on new events"),
         action("resolve"; "Resolve attention"; "asks for a note; a later failure opens a new alert"),
         action("suppress"; "Suppress attention"; "asks for a note; keeps counting silently"),
         action("reopen"; "Reopen attention"; "after resolve or suppress"),
         action("routing"; "Routing status"; "dry run: target, session, reason, links; changes nothing"),
         action("delegate"; "Delegate to configured agent"; "one message to the eligible existing session; repeats are inert"),
         action("redelegate"; "Redelegate"; "asks for a reason; clears the current assignment for a new delegation"),
         action("focus"; "Focus delegated conversation"; "attach to the recorded session without resuming or stopping it"),
         view, details,
         action("archive"; "Archive"; "hide it from the inbox; the attention stays open"),
         back) | preview("Attention")
      else
        (action("reply"; "Reply in this thread"; "compose in inmacs; Ctrl-X Ctrl-S saves and sends"),
         view, details,
         action("archive"; "Archive"; "hide it from the inbox"),
         back) | preview("Message")
      end,
      if $sessions != "" then
        action("session"; "Attach to sender session"; "Current conversation, or originating history if none is current") | preview("Message")
      else empty end')
    selected=$(@ Agent::Browser pick: "$records" root: "$dir" title: "From $from")
    printf '%s\n' "${selected:-back}"
  ]

  method: readDetailsOf: message [
    | text |
    @ message markViewed.
    text := @ message show.
    @ self page: text title: 'Message details'
  ]

  # Compose a reply in inmacs (or $EDITOR) and send it into the thread. Prints
  # the new message id, or the editor outcome when nothing was sent.
  rawMethod: composeReplyTo: messageId [
    local msg="$1" draft result outcome text reply from
    draft=$(mktemp "${TMPDIR:-/tmp}/trash-reply.XXXXXX")
    from=$(@ MessagePresentation participant: "$(@ "$msg" from)")
    if [[ "$(@ Tools::Inmacs isInstalled)" == true ]]; then
      result=$(@ Tools::Inmacs composeInto: "$draft" title: "Reply to $from")
      outcome=$(printf '%s' "$result" | jq -r '.outcome // "cancelled"')
    else
      @ Tools::Inmacs fallbackEditFile: "$draft" line: ""
      outcome="saved"
      [[ -s "$draft" ]] || outcome="cancelled"
    fi
    if [[ "$outcome" != saved ]]; then
      rm -f "$draft"
      printf '%s\n' "$outcome"
      return 0
    fi
    text=$(cat "$draft")
    rm -f "$draft"
    if [[ -z "$(printf '%s' "$text" | tr -d '[:space:]')" ]]; then
      echo "empty"
      return 0
    fi
    reply=$(@ "$msg" reply: "$text") || return 1
    printf '%s\n' "Reply sent to $from as $reply" >&2
    printf '%s\n' "$reply"
  ]

  # ------------------------------------------------------------------
  # Wakeups (honker)
  # ------------------------------------------------------------------

  # Run handler (a Block taking the message JSON) for every future delivery.
  # Returns the listener pid, or '' when honker is unavailable.
  method: onMessage: handler [
    | available pid pids |
    available := @ Honker isAvailable.
    (available = 'true') ifFalse: [
      @ Console error: 'Inbox onMessage: requires the honker extension; messages are still stored'.
      ^ ''
    ].
    pid := @ self on: 'message' do: handler.
    pids := listenerPids.
    (pids isEmpty) ifTrue: [listenerPids := pid] ifFalse: [listenerPids := pids , ' ' , pid].
    @ self save.
    ^ pid
  ]

  method: stopListening [
    | pids |
    pids := @ String splitToArray: listenerPids on: ' '.
    pids arrayEach: [:pid | @ Honker unlisten: pid].
    listenerPids := ''.
    @ self save
  ]

  method: isListening [
    ^ listenerPids notEmpty
  ]

  # Stop listeners and delete the inbox record. Messages are kept.
  method: destroy [
    @ self stopListening.
    @ self delete
  ]

  classMethod: help [
    ^ '''=== Inbox - Messages between agents, humans, and processes ===

Send:
  @ Inbox send: 'tests pass' to: 'chazu' from: 'maki'
  @ Inbox send: 'body' to: 'chazu' from: 'maki' subject: 'done' kind: 'result'
  @ Inbox ask: 'ok to force-push?' to: 'chazu' from: 'maki'   # kind: question
  @ Inbox alert: 'disk 95%' to: 'chazu' from: 'cron'          # kind: alert

Read:
  inbox=$(@ Trash userInbox)   # your Inbox instance
  other=$(@ Inbox named: 'gusgus')  # another Inbox instance
  @ $inbox list               # unread, one line each
  @ $inbox show: $msgId       # full message, marks read
  @ $inbox count | unread | unreadCount | questions | messages | messages: 10
  @ $inbox thread: $msgId     # whole thread, oldest first
  @ $inbox readAll
  @ $msgId reply: 'yes'       # to sender, same thread

Browse (Innards, with fzf/$EDITOR fallbacks):
  @ $inbox browse             # pick, read thread, reply or archive
  Ctrl-D archives the highlighted message; Enter opens its actions.

Wakeups (needs honker):
  handler=$(@ Block params: '["payload"]' code: 'echo "$payload"' captured: '{}')
  @ $inbox onMessage: $handler
  @ $inbox stopListening

Workstation attention (local command receipts, no agent effects):
  @ $inbox attentionCount     # open or due-snoozed attention for this user
  @ $msgId inspectAttention | acknowledgeAttention | reopenAttention
  @ $msgId snoozeAttentionUntil: '2099-01-01T00:00:00Z'
  @ $msgId resolveAttentionWithNote: 'fixed' | suppressAttention: 'noise'
  @ $msgId routingStatus          # Phase 2 dry run: target, session, reason
  @ $msgId delegateAttention | redelegateAttention: 'why' | focusDelegatedAttention

Other:
  @ Inbox names
  @ Inbox count               # number of stored Inbox instances
  @ Message help'''
  ]

  # A transaction-only human inbox boundary. Unlike deliver:, this cannot
  # create an outbox row, Agent::Delivery, session, or a foreground worker tick.
  classMethod: localFor: owner [
    | human inbox id |
    @ Store requireTransaction.
    human := @ Agent::Focus human.
    @ Require equal: owner to: human.
    (owner startsWith: 'session:') ifTrue: [^ @ Require reject: 'Local attention cannot target a session inbox'].
    (owner startsWith: 'agent:') ifTrue: [^ @ Require reject: 'Local attention cannot target an agent inbox'].
    inbox := @ Store findByClass: 'Inbox' matching: (#{name: owner} asJson) orderBy: 'created_at ASC' limit: 1.
    (inbox isEmpty) ifTrue: [
      id := @ Runtime generateId: 'Inbox'.
      inbox := @ Store create: 'Inbox' id: id.
      @ Store patch: inbox with: (#{name: owner} asJson)
    ].
    ^ inbox
  ]
  method: attention: attention display: display debounce: seconds [
    | message hint human |
    @ Store requireTransaction.
    human := @ Agent::Focus human.
    @ Require equal: name to: human.
    message := @ Message forAttention: attention display: display to: name.
    hint := @ message attentionHintDue: seconds.
    (hint = 'true') ifTrue: [
      @ message recordAttentionHint.
      @ Store afterCommit: self sending: 'announceLocal:' with: message
    ].
    ^ message
  ]
  method: announceLocal: message [
    | available payload |
    available := @ Honker isAvailable.
    (available = 'true') ifTrue: [
      payload := @ message asJson.
      @ self emit: 'message' payload: payload
    ].
    ^ message
  ]

  method: attentionCount [
    | human |
    human := @ Agent::Focus human.
    (@ Require equal: name to: human) ifFailed: [:error | @ error signal].
    ^ @ Workstation::Attention localOpenCount
  ]
