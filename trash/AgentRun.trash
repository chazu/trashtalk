# AgentRun - One backend execution on behalf of a session
# A run is started by the worker (startFor:profile:), which hands the child
# process a capability token `<runId>:<secret>` in TRASHTALK_RUN_TOKEN. Only
# the sha256 of the secret is stored. The agent-facing class methods
# (settle:, result:, send:to:, askUser:, inbox) all resolve the run from that
# token via `current` and derive the sender from it; they never trust a
# caller-supplied sender.
#
# States: starting running recovering succeeded waiting_for_user unsettled
#         failed interrupted
#
# Usage (worker):
#   read -r run token < <(@ AgentRun startFor: $session profile: shell)
#   @ $run transitionTo: running
# Usage (agent, with TRASHTALK_RUN_TOKEN exported):
#   @ AgentRun result: 'done'
#   @ AgentRun settle: $delivery
AgentRun subclass: Object
  include: Persistable
  instanceVars: session:'' state:'starting' archetypeRevision:'' roleRevision:''
                backendProfile:'' externalConversationRef:'' ownerGeneration:0 workerId:''
                capabilityTokenHash:'' processPid:0 pidFile:'' exitFile:'' outputLog:''
                errorLog:'' promptFile:'' lastMessageFile:'' priorRun:'' started:''
                heartbeatAt:'' finished:'' outcome:'' error:'' stopRequested:'false'

  # Common transition rule over state.
  method: transitionTo: newState [
    ^ @ self transitionTo: newState with: '{}'
  ]

  # Atomic state transition plus associated fields; rejected transitions write nothing.
  rawMethod: transitionTo: newState with: patchJson [
    local to="$1" from allowed
    _env_set "$_RECEIVER" "$(db_get "$_RECEIVER")"
    from=$(_ivar state)
    allowed=" starting:running starting:failed running:recovering running:succeeded running:waiting_for_user running:unsettled running:failed running:interrupted recovering:running recovering:failed recovering:unsettled recovering:succeeded recovering:waiting_for_user recovering:interrupted "
    if [[ "$allowed" != *" $from:$to "* ]]; then
      _throw "TransitionError" "AgentRun $_RECEIVER: $from -> $to rejected"
      return 1
    fi
    local eid ef et changed patch
    printf '%s' "$2" | jq -e 'type == "object"' >/dev/null || return 1
    patch=$(_db_escape "$2")
    eid=$(_db_escape "$_RECEIVER"); ef=$(_db_escape "$from"); et=$(_db_escape "$to")
    changed=$(_db_sql "UPDATE instances SET data=json_set(json_patch(data,'$patch'),'$.state','$et') WHERE id='$eid' AND json_extract(data,'$.state')='$ef'; SELECT changes();") || return 1
    [[ "$changed" == 1 ]] || { _throw "TransitionError" "Concurrent transition; reload and retry"; return 1; }
    _env_set "$_RECEIVER" "$(db_get "$_RECEIVER")"
    echo "$to"
  ]

  # Create a run for a session and mint its token. Prints two lines: the run
  # id, then `<runId>:<secret>`. The secret is never stored.
  rawClassMethod: startFor: sessionId profile: p [
    local sid="$1" profile="$2" run secret hash now
    now=$(@ Time nowISO)
    run=$(@ AgentRun new)
    @ "$run" session: "$sid"
    @ "$run" state: starting
    @ "$run" archetypeRevision: "$(@ "$sid" archetypeRevision)"
    @ "$run" roleRevision: "$(@ "$sid" roleRevision)"
    @ "$run" backendProfile: "$profile"
    @ "$run" started: "$now"
    secret=$(uuidgen | tr -d '-' | tr 'A-Z' 'a-z')
    hash=$(printf '%s' "$secret" | shasum -a 256 | cut -d' ' -f1)
    @ "$run" capabilityTokenHash: "$hash"
    @ "$run" save
    echo "$run"
    echo "$run:$secret"
  ]

  rawMethod: finishWith: state outcome: o error: e [
    local patch
    patch=$(jq -cn --arg outcome "$2" --arg error "$3" --arg now "$(@ Time nowISO)" '{outcome:$outcome,error:$error,finished:$now}')
    @ "$_RECEIVER" transitionTo: "$1" with: "$patch"
  ]

  method: markHeartbeat [
    | now patch |
    now := @ Time nowISO.
    patch := #{heartbeatAt: now} asJson.
    @ Store patch: self with: patch
  ]

  # Prefer the durable pid file: the launcher may die before storing processPid.
  # Exit files win over kill -0 (which can see an unrelated reused PID).
  rawMethod: isProcessAlive [
    local pid pf ef state birth actual
    ef=$(_ivar exitFile)
    [[ -z "$ef" || ! -f "$ef" ]] || { echo false; return; }
    pf=$(_ivar pidFile)
    pid=$(_ivar processPid)
    [[ -z "$pf" || ! -s "$pf" ]] || read -r pid < "$pf"
    if [[ "$pid" =~ ^[0-9]+$ && "$pid" -gt 0 ]] && kill -0 "$pid" 2>/dev/null; then
      if [[ -n "$pf" && -s "$pf.start" ]]; then
        birth=$(cat "$pf.start")
        actual=$(ps -p "$pid" -o lstart= 2>/dev/null)
        [[ "$birth" == "$actual" ]] || { echo false; return; }
      fi
      state=$(ps -p "$pid" -o stat= 2>/dev/null)
      [[ -n "$state" && "$state" != *Z* ]] && { echo true; return; }
    fi
    echo false
  ]

  # Resolve the calling agent's run from TRASHTALK_RUN_TOKEN. Prints the run
  # id; throws RunTokenError when the token is missing, wrong, or the run or
  # its session is no longer live. Never prints the secret.
  rawClassMethod: current [
    local token="${TRASHTALK_RUN_TOKEN:-}" runId secret hash stored state sid life data cls
    if [[ -z "$token" || "${token#*:}" == "$token" ]]; then
      _throw "RunTokenError" "TRASHTALK_RUN_TOKEN is missing or malformed"
      return 1
    fi
    runId="${token%%:*}"
    secret="${token#*:}"
    data=$(db_get "$runId" 2>/dev/null)
    cls=""
    [[ -n "$data" ]] && cls=$(printf '%s' "$data" | jq -r '.class // empty')
    if [[ "$cls" != "AgentRun" ]]; then
      _throw "RunTokenError" "Unknown run '$runId'"
      return 1
    fi
    _env_set "$runId" "$data"
    stored=$(printf '%s' "$data" | jq -r '.capabilityTokenHash // empty')
    hash=$(printf '%s' "$secret" | shasum -a 256 | cut -d' ' -f1)
    if [[ -z "$stored" || "$hash" != "$stored" ]]; then
      _throw "RunTokenError" "Run token rejected for '$runId'"
      return 1
    fi
    state=$(@ "$runId" state)
    if [[ "$state" != "running" && "$state" != "recovering" ]]; then
      _throw "RunTokenError" "Run '$runId' is $state, not running"
      return 1
    fi
    sid=$(@ "$runId" session)
    life=""
    [[ -n "$sid" ]] && life=$(db_get "$sid" | jq -r '.lifecycleState // empty')
    if [[ -z "$life" || "$life" == "terminated" ]]; then
      _throw "RunTokenError" "Session for run '$runId' is terminated"
      return 1
    fi
    echo "$runId"
  ]

  # Inbox name of the identity owner behind a run (env TRASHTALK_USER / $USER
  # when the identity has no owner).
  rawClassMethod: ownerInboxFor: runId [
    local sid identity owner
    sid=$(@ "$1" session)
    identity=""
    [[ -n "$sid" ]] && identity=$(@ "$sid" identity)
    owner=""
    [[ -n "$identity" ]] && owner=$(@ "$identity" owner)
    [[ -n "$owner" ]] || owner="${TRASHTALK_USER:-${USER:-user}}"
    echo "$owner"
  ]

  # ------------------------------------------------------------------
  # Agent-facing (require TRASHTALK_RUN_TOKEN)
  # ------------------------------------------------------------------

  rawClassMethod: settle: deliveryId [
    @ AgentRun settle: "$1" note: ''
  ]

  rawClassMethod: settle: deliveryId note: text [
    local d="$1" note="$2" run drun state
    run=$(@ AgentRun current) || {
      _throw "RunTokenError" "AgentRun settle: requires a valid TRASHTALK_RUN_TOKEN"
      return 1
    }
    drun=$(@ "$d" run 2>/dev/null)
    if [[ -z "$drun" || "$drun" != "$run" ]]; then
      _throw "RunError" "Delivery $d is not offered to run $run"
      return 1
    fi
    state=$(@ "$d" state)
    if [[ "$state" != "offered" && "$state" != "blocked" ]]; then
      _throw "RunError" "Delivery $d is $state; only offered or blocked deliveries can be settled"
      return 1
    fi
    @ "$d" transitionTo: processed with: "$(jq -cn --arg note "$note" '{note:$note}')" >/dev/null || return 1
    echo "processed"
  ]

  # Reply in-thread to every delivery this run holds; prints the message ids.
  # Without a held delivery the result goes to the identity owner's inbox.
  rawClassMethod: result: body [
    local body="$1" run sid sender deliveries d first to subj thread msg inbox owner
    run=$(@ AgentRun current) || {
      _throw "RunTokenError" "AgentRun result: requires a valid TRASHTALK_RUN_TOKEN"
      return 1
    }
    sid=$(@ "$run" session)
    sender="session:$sid"
    deliveries=$(@ AgentDelivery offeredFor: "$run")
    if [[ -z "$deliveries" ]]; then
      owner=$(@ AgentRun ownerInboxFor: "$run")
      @ Inbox send: "$body" to: "$owner" from: "$sender" subject: result kind: result
      return
    fi
    local seen_threads=" "
    for d in $deliveries; do
      first=$(@ "$d" messageIdList | head -n 1)
      [[ -n "$first" ]] || continue
      to=$(@ "$first" from)
      subj=$(@ "$first" subject)
      thread=$(@ "$first" thread)
      # One reply per conversation thread, not one per delivery.
      case "$seen_threads" in
        *" $thread "*) continue ;;
      esac
      seen_threads="$seen_threads$thread "
      msg=$(@ Message to: "$to" from: "$sender" subject: "$subj" body: "$body" kind: result)
      @ "$msg" thread: "$thread"
      @ "$msg" replyTo: "$first"
      inbox=$(@ Inbox named: "$to")
      @ "$inbox" deliver: "$msg"
    done
  ]

  # Reply to one held delivery, retaining its thread and authenticated sender.
  # Raw boundary: reject foreign receipts before resolving their message data.
  rawClassMethod: result: body forDelivery: delivery [
    local run sid first msg inbox
    run=$(@ AgentRun current) || return 1
    [[ "$(@ "$2" run)" == "$run" ]] || { _throw 'RunError' 'Delivery is not held by this run'; return 1; }
    case "$(@ "$2" state)" in offered|blocked) ;; *) _throw 'RunError' 'Delivery is no longer held'; return 1 ;; esac
    first=$(@ "$2" messageIdList | head -n 1)
    [[ -n "$first" ]] || return 1
    sid=$(@ "$run" session)
    msg=$(@ Message to: "$(@ "$first" from)" from: "session:$sid" subject: "$(@ "$first" subject)" body: "$1" kind: result)
    @ "$msg" thread: "$(@ "$first" thread)"
    @ "$msg" replyTo: "$first"
    inbox=$(@ Inbox named: "$(@ "$first" from)")
    @ "$inbox" deliver: "$msg"
  ]

  # Local user control targets this immutable run id, never a replacement run.
  method: stop [
    ^ @ AgentWorker stopRun: self
  ]

  # Agent entry point requires a valid token even if the caller omitted one.
  rawClassMethod: stop: target [
    @ AgentRun current >/dev/null || return 1
    @ AgentWorker stopRun: "$1"
  ]

  rawClassMethod: send: body to: address [
    local run sid
    run=$(@ AgentRun current) || {
      _throw "RunTokenError" "AgentRun send:to: requires a valid TRASHTALK_RUN_TOKEN"
      return 1
    }
    sid=$(@ "$run" session)
    @ Inbox send: "$1" to: "$2" from: "session:$sid" subject: '' kind: note
  ]

  # Deduplicated send: one message per (session, key).
  rawClassMethod: send: body to: address key: k [
    local run sid key esc efrom existing
    run=$(@ AgentRun current) || {
      _throw "RunTokenError" "AgentRun send:to:key: requires a valid TRASHTALK_RUN_TOKEN"
      return 1
    }
    sid=$(@ "$run" session)
    key="key:$3"
    esc=$(_db_escape "$key")
    efrom=$(_db_escape "session:$sid")
    existing=$(@ Store findByClass: Message where: "json_extract(data, '\$.from') = '$efrom' AND json_extract(data, '\$.subject') = '$esc'" orderBy: 'created_at ASC' limit: 1)
    if [[ -n "$existing" ]]; then
      echo "$existing"
      return
    fi
    @ Inbox send: "$1" to: "$2" from: "session:$sid" subject: "$key" kind: note
  ]

  # Default: the question blocks all deliveries currently held by this run.
  rawClassMethod: askUser: question [
    local run ids
    run=$(@ AgentRun current) || return 1
    ids=$(@ AgentDelivery offeredFor: "$run" | jq -Rsc 'split("\n") | map(select(length > 0))') || return 1
    @ AgentRun askUser: "$1" forDeliveries: "$ids"
  ]

  classMethod: askUser: question forDelivery: delivery [
    | ids |
    ids := #(delivery) asJson.
    ^ @ self askUser: question forDeliveries: ids
  ]

  # Raw wrapper propagates transaction failure before sending notifications.
  # The queue checks delivery ownership again inside the publication transaction.
  rawClassMethod: askUser: question forDeliveries: deliveryIds [
    local run sid owner ids first delivery thread msg inbox
    run=$(@ AgentRun current) || {
      _throw "RunTokenError" "AgentRun askUser: requires a valid TRASHTALK_RUN_TOKEN"
      return 1
    }
    sid=$(@ "$run" session)
    owner=$(@ AgentRun ownerInboxFor: "$run")
    ids=$(printf '%s' "$2" | jq -ce 'select(type == "array" and all(.[]; type == "string")) | unique') || return 1
    delivery=$(printf '%s' "$ids" | jq -r '.[0] // empty')
    thread=""
    if [[ -n "$delivery" ]]; then
      first=$(@ "$delivery" messageIdList | head -n 1)
      [[ -n "$first" ]] && thread=$(@ "$first" thread)
    fi
    msg=$(@ Message to: "$owner" from: "session:$sid" subject: question body: "$1" kind: question)
    [[ -n "$thread" ]] && @ "$msg" thread: "$thread"
    inbox=$(@ Inbox named: "$owner")
    @ "$inbox" prepare: "$msg" || return 1
    @ AgentQueue persist: "$msg" questionRun: "$run" deliveries: "$ids" || return 1
    for delivery in $(printf '%s' "$ids" | jq -r '.[]'); do
      @ "$delivery" reload >/dev/null
    done
    @ "$inbox" announce: "$msg"
  ]

  rawClassMethod: inbox [
    local run sid ib
    run=$(@ AgentRun current) || {
      _throw "RunTokenError" "AgentRun inbox requires a valid TRASHTALK_RUN_TOKEN"
      return 1
    }
    sid=$(@ "$run" session)
    ib=$(@ "$sid" inboxObject)
    @ "$ib" list
  ]

  # Environment boundary: a present but invalid token never becomes a human.
  rawClassMethod: actingContext [
    local run hash
    if [[ ${TRASHTALK_RUN_TOKEN+x} ]]; then
      run=$(@ AgentRun current) || return 1
      hash=$(printf '%s' "${TRASHTALK_RUN_TOKEN#*:}" | shasum -a 256 | cut -d' ' -f1)
      jq -cn --arg run "$run" --arg hash "$hash" '{run:$run,hash:$hash,human:""}'
    else
      jq -cn --arg human "${TRASHTALK_USER:-${USER:-user}}" '{run:"",hash:"",human:$human}'
    fi
  ]


  classMethod: activeFor: session except: run [
    | fields ids remaining same |
    fields := #{session: session state: #('starting' 'running' 'recovering')} asJson.
    ids := @ Store idsOf: 'AgentRun' matching: fields.
    remaining := '[]'.
    ids arrayEach: [:id |
      same := @ String equals: id to: run.
      (same = 'false') ifTrue: [remaining := remaining arrayPush: id]
    ].
    ^ remaining
  ]
