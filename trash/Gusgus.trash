# Gusgus - The persistent low-power assistant behind @@.
# One current AgentSession across workspaces, identity
# 'gusgus', archetype 'assistant', role 'assistant'. `@@ 'text'` sends a
# message to the session and returns; Gusgus answers into the user's inbox in
# the same thread, and replying to that message resumes the conversation.
#
# Environment:
#   TRASHTALK_USER            owner inbox name (default: $USER)
#   TRASHTALK_GUSGUS_PROFILE  backend profile (default: jcode)
#   TRASHTALK_JCODE_MODEL     Jcode model (default: gpt-5.6-terra)
#   TRASHTALK_MAKI_MODEL      Maki model (default: openai/gpt-5.6-terra)
#   TRASHTALK_CODEX_MODEL     model for the Codex driver (default: gpt-5.6-terra)
# Jcode, Maki, and Codex drivers use medium reasoning effort.
Gusgus subclass: Object

  rawClassMethod: owner [
    printf '%s\n' "${TRASHTALK_USER:-$USER}"
  ]

  rawClassMethod: profile [
    printf '%s\n' "${TRASHTALK_GUSGUS_PROFILE:-jcode}"
  ]

  rawClassMethod: instructions [
    printf '%s' "You are Gusgus, a lightweight assistant for the person working in this workspace. Answer briefly and concretely. Read files in the workspace when a question needs it. You cannot see the user's terminal; everything you know about their situation is in the deliveries below. Each delivery ends with a [context] line giving the working directory and the exit status of their last command."
  ]

  rawClassMethod: archetype [
    local text profile
    text=$(@ "$_RECEIVER" instructions)
    profile=$(@ "$_RECEIVER" profile)
    @ AgentArchetype define: assistant revision: 1 instructions: "$text" profile: "$profile"
  ]

  rawClassMethod: role [
    @ AgentRole define: assistant revision: 1 capabilities: '["inbox.read","message.send","question.ask","source.read","proposal.submit"]' workspacePolicy: '[]' runBudget: '{"turns":0,"usd":0,"retryLimit":2}'
  ]

  rawClassMethod: identity [
    local id args
    id=$(@ AgentIdentity named: gusgus) || return 1
    args=$(jq -cn --arg id "$id" --arg owner "$(@ Gusgus owner)" --arg archetype "$(@ Gusgus archetype)" --arg role "$(@ Gusgus role)" \
      '{identity:$id,owner:$owner,archetype:$archetype,role:$role}') || return 1
    @ Store transaction: Gusgus sending: 'configureIdentityWithin:' with: "$args" replaying: true
  ]

  classMethod: configureIdentityWithin: args [
    | identity owner scope |
    @ Store requireTransaction.
    identity := @ Store read: (args objectAt: 'identity') class: 'AgentIdentity'.
    owner := @ identity owner.
    (owner isEmpty) ifTrue: [
      @ identity owner: (args objectAt: 'owner').
      @ identity displayName: 'Gusgus'.
      @ identity defaultArchetype: (args objectAt: 'archetype').
      @ identity defaultRole: (args objectAt: 'role').
      @ identity sessionScope: 'identity'.
      @ identity sessionPolicyRevision: 1.
      @ identity save
    ].
    scope := @ identity sessionScope.
    (scope ~= 'identity') ifTrue: [^ @ Require reject: 'Gusgus needs explicit session selection; use selectCurrentSession: on the identity'].
    ^ @ AgentAccess validateIdentity: identity
  ]

  # Conversation identity is independent of each delivery's execution workspace.
  classMethod: sessionFor: dir [
    | identity workspace archetype role profile current |
    workspace := @ AgentSession workspaceFor: dir.
    current := @ self currentFor: workspace.
    (current notEmpty) ifTrue: [^ current].
    identity := @ self identity.
    archetype := @ self archetype.
    role := @ self role.
    profile := @ self profile.
    ^ @ AgentSession ensureFor: identity archetype: archetype role: role workspace: workspace profile: profile
  ]

  # Existing conversations need only one guarded read; do not rebuild identity,
  # archetype, and role defaults on every message or focus request.
  classMethod: currentFor: workspace [
    ^ @ Store transaction: self sending: 'currentWithinFor:' with: workspace
  ]

  classMethod: currentWithinFor: workspace [
    | ids count identity scope |
    @ Store requireTransaction.
    ids := @ Store idsOf: 'AgentIdentity' matching: (#{handle: 'gusgus'} asJson).
    count := ids arrayLength.
    (count = 0) ifTrue: [^ ''].
    @ Require equal: count to: 1.
    identity := ids arrayFirst.
    identity := @ AgentAccess validateIdentity: identity.
    scope := @ identity sessionScope.
    (scope ~= 'identity') ifTrue: [^ @ Require reject: 'Gusgus needs explicit session selection; use selectCurrentSession: on the identity'].
    ^ @ AgentSession currentWithinFor: identity workspace: workspace
  ]

  classMethod: focusCurrent [
    | session |
    session := @ self currentFor: '.'.
    (session isEmpty) ifTrue: [^ @ Require reject: 'No current Gusgus conversation; send a message first'].
    ^ @ session focus
  ]

  # Send a question to Gusgus and return immediately with the message id.
  rawClassMethod: chat: text workingDirectory: dir status: status lastResult: lastResult [
    local text="$1" dir="$2" status="$3" last="$4" session inbox owner body msg
    session=$(@ "$_RECEIVER" sessionFor: "$dir") || return 1
    inbox=$(@ "$session" inbox)
    owner=$(@ "$_RECEIVER" owner)
    body=$(printf '%s\n\n[context] working_directory=%s last_status=%s' "$text" "$dir" "$status")
    if [[ -n "$last" ]]; then
      body=$(printf '%s\n[last_result]\n%s' "$body" "${last:0:2000}")
    fi
    msg=$(@ Inbox send: "$body" to: "$inbox" from: "$owner" subject: "" kind: question in: "$dir") || return 1
    printf '%s\n' "$msg"
    printf "Gusgus will reply in inbox '%s' (thread %s)\n" "$owner" "$msg" >&2
  ]

  # Close only the identity's idle current session and atomically replace it.
  classMethod: fresh: dir [
    | identity workspace archetype role profile |
    identity := @ self identity.
    workspace := @ AgentSession workspaceFor: dir.
    archetype := @ self archetype.
    role := @ self role.
    profile := @ self profile.
    ^ @ AgentSession freshFor: identity archetype: archetype role: role workspace: workspace profile: profile
  ]

  rawClassMethod: help [
    echo "=== Gusgus - persistent assistant behind @@ ==="
    echo ""
    echo "  @@ 'why did that fail?'      # send; reply lands in your inbox thread"
    echo "  @@ treats every argument as message text; it has no flags."
    echo "  Option-U toggles the current conversation view."
    echo "  @ Gusgus focusCurrent       # open the current conversation"
    echo "  @ Gusgus fresh: \"\$PWD\"    # explicitly replace an idle conversation"
    echo ""
    echo "  inbox=\$(@ Trash userInbox)"
    echo "  @ \$inbox browse              # Innards UI: read replies, respond in-thread"
    echo "  @ \$inbox list                # Gusgus's replies"
    echo "  @ AgentSession browse        # activity, questions, logs, pause/resume/retry"
    echo "  @ \$msg reply: 'and then?'    # continues the same conversation"
    echo ""
    echo "  @ Gusgus sessionFor: \"\$PWD\"  # the current identity session"
    echo "  @ \$session summary"
  ]
