# Gusgus - the persistent assistant behind @@. Stable agent mechanics live in
# Agent::Stable; this facade supplies only Gusgus policy and its human-chat UX.
Gusgus subclass: Object
  include: Agent::Stable

  classMethod: owner [ ^ @ Agent::Focus localUser ]
  classMethod: profile [ ^ @ GusgusSettings profile ]
  classMethod: agentHandle [ ^ 'gusgus' ]
  classMethod: agentDisplayName [ ^ 'Gusgus' ]
  classMethod: sessionScope [ ^ 'identity' ]

  classMethod: instructions [
    ^ 'You are Gusgus, the persistent assistant for the person working in this workspace. Answer briefly and concretely. Read relevant files when needed. You cannot see the terminal; use the supplied conversation, inbox messages and workspace context. Inbox requests may include a [context] line with the working directory and last command status. Direct conversation input has no inbox delivery. Follow the current run instructions for the input mode and authenticated launcher. Entrust background work through Agent::Run delegate:criteria:key:, creating a durable Assignment before dispatch. State the objective and completion criteria, reuse the request key on retry, and promptly tell the human the Assignment handle and observed status. Queued is not started; process exit is not completion. Stay available instead of polling the specialist. When its outcome notification arrives, read the evidence, report the result and limitations, and settle the notification as instructed. Do not claim work was started or completed without checking its durable records.'
  ]

  classMethod: archetype [
    | text profile |
    text := @ self instructions.
    profile := @ self profile ifFailed: [:e | @ e signal].
    ^ @ Agent::Archetype define: 'assistant' revision: 2 instructions: text profile: profile
  ]

  classMethod: role [
    ^ @ Agent::Role define: 'assistant' revision: 1
        capabilities: '["inbox.read","message.send","question.ask","source.read","proposal.submit"]'
        workspacePolicy: '[]' runBudget: '{"turns":0,"usd":0,"retryLimit":2}'
  ]

  # Option-U can open before the global conversation exists. The view itself is
  # read-only until the human explicitly sends its first direct-input message.
  classMethod: focusCurrent [
    ^ @ Agent::Focus openGusgusIn: '.'
  ]

  # Gusgus-specific human command wrapper. Other stable facades may expose a
  # different UX, but all use the same durable Inbox/Agent::Session boundary.
  classMethod: chat: text workingDirectory: dir status: status lastResult: lastResult [
    | session inbox owner body msg |
    session := @ self sessionFor: dir ifFailed: [:e | @ e signal].
    inbox := @ session inbox.
    owner := @ self owner.
    body := text , '

[context] working_directory=' , dir , ' last_status=' , status.
    (lastResult notEmpty) ifTrue: [body := body , '
[last_result]
' , (lastResult first: 2000)].
    msg := @ Inbox send: body to: inbox from: owner subject: '' kind: 'question' in: dir ifFailed: [:e | @ e signal].
    @ Console error: "Gusgus will reply in inbox '" , owner , "' (thread " , msg , ')'.
    ^ msg
  ]

  classMethod: help [
    pragma: stream
    @ Console print: '=== Gusgus - persistent assistant behind @@ ==='.
    @ Console print: "  @@ 'why did that fail?'      # send; reply lands in your inbox thread".
    @ Console print: '  @ Gusgus focusCurrent        # open the current conversation'.
    @ Console print: '  @ Gusgus fresh: "$PWD"     # explicitly replace an idle conversation'
  ]
