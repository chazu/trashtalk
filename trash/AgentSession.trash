# AgentSession - A durable conversation between an identity and a workspace
# A session snapshots the archetype/role revisions it was opened with, owns an
# inbox named `session:<id>`, and is the unit that deliveries and runs attach
# to. Lifecycle: open <-> paused, open|paused -> closed -> open (reopen),
# anything -> terminated.
#
# Usage:
#   s=$(@ AgentSession openFor: $identity archetype: $arch role: $role workspace: /path profile: shell)
#   @ $s summary
#   @ $s pause / resume / close / reopen / terminate
#   @ AgentSession findFor: $identity workspace: /path
AgentSession subclass: Object
  include: Persistable
  instanceVars: identity:'' archetype:'' archetypeRevision:'' instructionsHash:'' role:''
                roleRevision:'' backendProfile:'' executionPolicy:'single' workspace:''
                lifecycleState:'open' inbox:'' lastConversationRef:'' parentSession:''
                created:'' lastActivityAt:''

  # Common transition rule over lifecycleState.
  method: transitionTo: newState [
    ^ @ self transitionTo: newState with: '{}'
  ]

  # Atomic state transition plus associated fields; rejected transitions write nothing.
  rawMethod: transitionTo: newState with: patchJson [
    local to="$1" from allowed
    _env_set "$_RECEIVER" "$(db_get "$_RECEIVER")"
    from=$(_ivar lifecycleState)
    allowed=" open:paused paused:open open:closed paused:closed closed:open open:terminated paused:terminated closed:terminated "
    if [[ "$allowed" != *" $from:$to "* ]]; then
      # Pre-durable AgentSession records have no lifecycle. Permit explicit
      # retirement without treating these incomplete records as open sessions.
      if [[ -n "$from" || "$to" != terminated ]]; then
        _throw "TransitionError" "AgentSession $_RECEIVER: $from -> $to rejected"
        return 1
      fi
    fi
    local eid ef et changed patch
    printf '%s' "$2" | jq -e 'type == "object"' >/dev/null || return 1
    patch=$(_db_escape "$2")
    eid=$(_db_escape "$_RECEIVER"); ef=$(_db_escape "$from"); et=$(_db_escape "$to")
    # Register the field atomically too: lazy schema loading must not replace
    # a legacy record's explicit terminal state with the default open state.
    changed=$(_db_sql "UPDATE instances SET data=json_set(json_patch(data,'$patch'),'$.lifecycleState','$et',
      '$._vars',json(CASE WHEN EXISTS (SELECT 1 FROM json_each(json_extract(data,'$._vars')) WHERE value='lifecycleState')
        THEN json_extract(data,'$._vars')
        ELSE json_insert(coalesce(json_extract(data,'$._vars'),'[]'),'\$[#]','lifecycleState') END))
      WHERE id='$eid' AND coalesce(json_extract(data,'$.lifecycleState'),'')='$ef'; SELECT changes();") || return 1
    [[ "$changed" == 1 ]] || { _throw "TransitionError" "Concurrent transition; reload and retry"; return 1; }
    _env_set "$_RECEIVER" "$(db_get "$_RECEIVER")"
    echo "$to"
  ]

  # Open a session, snapshotting the archetype and role revisions.
  rawClassMethod: openFor: identityId archetype: archetypeId role: roleId workspace: path profile: profileName [
    local identity="$1" archetype="$2" role="$3" ws="$4" profile="$5"
    local allowed session now inboxName
    allowed=$(@ "$role" allowsWorkspace: "$ws")
    if [[ "$allowed" != "true" ]]; then
      _throw "SessionError" "Role $role does not allow workspace $ws"
      return 1
    fi
    now=$(@ Time nowISO)
    session=$(@ AgentSession new)
    inboxName="session:$session"
    @ "$session" identity: "$identity"
    @ "$session" archetype: "$archetype"
    @ "$session" archetypeRevision: "$(@ "$archetype" revision)"
    @ "$session" instructionsHash: "$(@ "$archetype" instructionsHash)"
    @ "$session" role: "$role"
    @ "$session" roleRevision: "$(@ "$role" revision)"
    @ "$session" backendProfile: "$profile"
    @ "$session" workspace: "$ws"
    @ "$session" lifecycleState: open
    @ "$session" inbox: "$inboxName"
    @ "$session" created: "$now"
    @ "$session" lastActivityAt: "$now"
    @ "$session" save
    @ Inbox named: "$inboxName" >/dev/null
    echo "$session"
  ]

  # Open or paused sessions for identity + workspace, newest first
  rawClassMethod: findFor: identityId workspace: path [
    local eid ews
    eid=$(_db_escape "$1")
    ews=$(_db_escape "$2")
    @ Store findByClass: AgentSession where: "json_extract(data, '\$.identity') = '$eid' AND json_extract(data, '\$.workspace') = '$ews' AND json_extract(data, '\$.lifecycleState') IN ('open', 'paused')" orderBy: "json_extract(data, '\$.created') DESC, rowid DESC" limit: 1000
  ]

  # Git toplevel when dir is inside a repo, otherwise the real path of dir
  rawClassMethod: workspaceFor: dir [
    local dir="$1" top revparse="rev-parse" toplevel="--show-toplevel"
    if [[ ! -d "$dir" ]]; then
      _throw "SessionError" "Not a directory: $dir"
      return 1
    fi
    top=$(git -C "$dir" "$revparse" "$toplevel" 2>/dev/null)
    if [[ -n "$top" ]]; then
      echo "$top"
      return
    fi
    (cd "$dir" && pwd -P)
  ]

  method: pause [
    ^ @ self transitionTo: 'paused'
  ]

  method: resume [
    ^ @ self transitionTo: 'open'
  ]

  method: close [
    ^ @ self transitionTo: 'closed'
  ]

  method: reopen [
    ^ @ self transitionTo: 'open'
  ]

  method: terminate [
    ^ @ AgentWorker terminateSession: self
  ]

  method: touch [
    | now |
    now := @ Time nowISO.
    @ Store patch: self with: (#{lastActivityAt: now} asJson)
  ]

  method: inboxObject [
    ^ @ Inbox named: inbox
  ]

  method: pendingDeliveries [
    ^ @ AgentDelivery pendingFor: self
  ]

  # Id of the run in starting|running|recovering for this session, or empty
  rawMethod: activeRun [
    local esc
    esc=$(_db_escape "$_RECEIVER")
    @ Store findByClass: AgentRun where: "json_extract(data, '\$.session') = '$esc' AND json_extract(data, '\$.state') IN ('starting', 'running', 'recovering')" orderBy: "json_extract(data, '\$.started') DESC, rowid DESC" limit: 1
  ]

  # Number of pending deliveries. Raw: counts lines without touching stdin.
  rawMethod: pendingCount [
    local ids
    ids=$(@ AgentDelivery pendingFor: "$_RECEIVER")
    if [[ -z "$ids" ]]; then
      echo 0
    else
      printf '%s\n' "$ids" | wc -l | tr -d ' '
    fi
  ]

  method: summary [
    | handle run count |
    handle := @ identity handle.
    run := @ self activeRun.
    (run isEmpty) ifTrue: [run := '-'].
    count := @ self pendingCount.
    ^ self , ' ' , handle , ' ' , lifecycleState , ' ws=' , workspace , ' pending=' , count , ' run=' , run
  ]

  # Human-only: put a failed or uncertain delivery back in the queue, e.g. after
  # fixing whatever made it fail. The next tick claims it again.
  rawMethod: requeue: deliveryId [
    local d="$1" owner state
    owner=$(@ "$d" session)
    if [[ "$owner" != "$_RECEIVER" ]]; then
      _throw "SessionError" "Delivery $d does not belong to session $_RECEIVER"
      return 1
    fi
    state=$(@ "$d" state)
    if [[ "$state" != "failed" && "$state" != "uncertain" ]]; then
      _throw "SessionError" "Delivery $d is $state; only failed or uncertain deliveries can be requeued"
      return 1
    fi
    @ "$d" transitionTo: pending with: '{"attempts":0}' >/dev/null || return 1
    echo "pending"
  ]

  # Human-only: give up on a failed or uncertain delivery with a reason.
  rawMethod: skip: deliveryId note: text [
    local d="$1" note="$2" state owner inboxName line
    if [[ -z "$note" ]]; then
      _throw "SessionError" "skip: requires a non-empty note"
      return 1
    fi
    owner=$(@ "$d" session)
    if [[ "$owner" != "$_RECEIVER" ]]; then
      _throw "SessionError" "Delivery $d does not belong to session $_RECEIVER"
      return 1
    fi
    state=$(@ "$d" state)
    if [[ "$state" != "failed" && "$state" != "uncertain" ]]; then
      _throw "SessionError" "Delivery $d is $state; only failed or uncertain deliveries can be skipped"
      return 1
    fi
    @ "$d" transitionTo: skipped with: "$(jq -cn --arg note "$note" '{note:$note,lastError:$note}')" >/dev/null || return 1
    # Record the skip where the human reads, not in the session inbox: a message
    # to the session would become a new delivery.
    inboxName=$(@ AgentWorker ownerInboxFor: "$_RECEIVER")
    [[ -n "$inboxName" ]] || inboxName="${TRASHTALK_USER:-$USER}"
    line="skipped $d in session $_RECEIVER: $note"
    @ Inbox send: "$line" to: "$inboxName" from: worker subject: skipped kind: note >/dev/null
    echo "skipped"
  ]

  # SQL aggregate boundary; presentation and workflow use these public counts.
  rawMethod: deliveryCountIn: states [
    local sid states
    sid=$(_db_escape "$_RECEIVER")
    states=$(_db_escape "$1")
    _db_sql "SELECT count(*) FROM instances WHERE json_extract(data,'$.class')='AgentDelivery' AND json_extract(data,'$.session')='$sid' AND json_extract(data,'$.state') IN (SELECT value FROM json_each('$states'));"
  ]

  method: stalledCount [
    ^ @ self deliveryCountIn: '["failed","uncertain"]'
  ]

  method: questionCount [
    ^ @ self deliveryCountIn: '["blocked"]'
  ]

  # Snapshot in one SQLite read, so a picker never mixes counts from two ticks.
  rawMethod: snapshot [
    local sid
    sid=$(_db_escape "$_RECEIVER")
    _db_sql "SELECT json_object(
      'id',s.id,'identity',json_extract(s.data,'$.identity'),
      'workspace',json_extract(s.data,'$.workspace'),'lifecycle',json_extract(s.data,'$.lifecycleState'),
      'pending',(SELECT count(*) FROM instances d WHERE json_extract(d.data,'$.class')='AgentDelivery' AND json_extract(d.data,'$.session')=s.id AND json_extract(d.data,'$.state')='pending'),
      'questions',(SELECT count(*) FROM instances d WHERE json_extract(d.data,'$.class')='AgentDelivery' AND json_extract(d.data,'$.session')=s.id AND json_extract(d.data,'$.state')='blocked'),
      'stalled',(SELECT count(*) FROM instances d WHERE json_extract(d.data,'$.class')='AgentDelivery' AND json_extract(d.data,'$.session')=s.id AND json_extract(d.data,'$.state') IN ('failed','uncertain')),
      'run',coalesce((SELECT r.id FROM instances r WHERE json_extract(r.data,'$.class')='AgentRun' AND json_extract(r.data,'$.session')=s.id ORDER BY r.rowid DESC LIMIT 1),''),
      'activity',coalesce((SELECT json_extract(r.data,'$.state') FROM instances r WHERE json_extract(r.data,'$.class')='AgentRun' AND json_extract(r.data,'$.session')=s.id ORDER BY r.rowid DESC LIMIT 1),'idle'),
      'error',coalesce((SELECT json_extract(r.data,'$.error') FROM instances r WHERE json_extract(r.data,'$.class')='AgentRun' AND json_extract(r.data,'$.session')=s.id AND coalesce(json_extract(r.data,'$.error'),'')!='' ORDER BY r.rowid DESC LIMIT 1),''))
      FROM instances s WHERE s.id='$sid';"
  ]

  method: details [
    | data |
    data := @ self snapshot.
    ^ @ AgentBrowser describeSession: data
  ]

  rawMethod: runs [
    local sid
    sid=$(_db_escape "$_RECEIVER")
    @ Store findByClass: AgentRun where: "json_extract(data,'$.session')='$sid'" orderBy: 'rowid DESC' limit: 100
  ]

  rawMethod: stalledDeliveries [
    local sid
    sid=$(_db_escape "$_RECEIVER")
    @ Store findByClass: AgentDelivery where: "json_extract(data,'$.session')='$sid' AND json_extract(data,'$.state') IN ('failed','uncertain')" orderBy: 'rowid ASC' limit: 100
  ]

  rawMethod: messageIds [
    local address
    address=$(_db_escape "$(@ "$_RECEIVER" inbox)")
    @ Store findByClass: Message where: "json_extract(data,'$.to')='$address' OR json_extract(data,'$.from')='$address'" orderBy: 'rowid ASC' limit: 200
  ]

  classMethod: browse [
    ^ @ AgentBrowser browse
  ]

  method: browse [
    ^ @ AgentBrowser browseSession: self
  ]
