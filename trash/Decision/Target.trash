package: Decision

# Resolve once and pass the temporary JSON value through a whole workflow.
Target subclass: Object
  classMethod: selected [
    | name |
    name := @ Config at: 'decision.target' ifFailed: [:e | @ e signal].
    ^ @ self named: name
  ]

  classMethod: named: name [
    | url model credential target |
    name caseOf: {
      'jev' -> [
        model := @ OpenRouter::Jev model ifFailed: [:e | @ e signal].
        ^ #{name: name provider: 'jev' model: model} asJson
      ].
      'clm-local' -> [url := @ Config at: 'clm.baseUrl' ifFailed: [:e | @ e signal]. credential := 'CLM_API_KEY'].
      'clm-bc250' -> [url := @ Config at: 'clm.bc250Url' ifFailed: [:e | @ e signal]. credential := 'CLM_BC250_API_KEY'].
      'clm-prefer-bc250' -> [
        target := @ self named: 'clm-bc250'.
        ((@ CLM::Client ready: target) = 'true') ifTrue: [^ target].
        target := @ self named: 'clm-local'.
        ((@ CLM::Client ready: target) = 'true') ifTrue: [^ target].
        @ DecisionError signal: 'Neither CLM endpoint is ready'
      ]
    } otherwise: [@ DecisionError signal: 'Unknown decision target'].
    url := url withoutSuffix: '/'.
    model := @ Config at: 'clm.model' ifFailed: [:e | @ e signal].
    ^ #{name: name provider: 'clm' url: url model: model credential: credential} asJson
  ]

  classMethod: decide: state questions: questions using: target [
    | provider |
    provider := target jsonTextAt: 'provider'.
    provider caseOf: {
      'jev' -> [^ @ OpenRouter::Jev decide: state questions: questions].
      'clm' -> [^ @ CLM::Client decide: state questions: questions using: target]
    } otherwise: [@ DecisionError signal: 'Unknown decision provider']
  ]
