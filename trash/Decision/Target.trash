package: Decision

# Resolve once and pass the temporary JSON value through a whole workflow.
# A target never switches providers after selection.
Target subclass: Object
  classMethod: selected [
    | name |
    name := @ Decision::TargetSettings target ifFailed: [:e | @ e signal].
    ^ @ self named: name
  ]

  # textLimit, when present, is the message text an application may send.
  classMethod: named: name [
    | url model limit |
    name caseOf: {
      'jev' -> [
        model := @ OpenRouter::Jev model ifFailed: [:e | @ e signal].
        ^ #{name: name provider: 'jev' model: model} asJson
      ].
      'decider' -> [
        url := @ Decision::DeciderSettings url ifFailed: [:e | @ e signal].
        url := url withoutSuffix: '/'.
        model := @ Decision::DeciderSettings model ifFailed: [:e | @ e signal].
        limit := @ Decision::DeciderSettings textLimit ifFailed: [:e | @ e signal].
        ^ #{name: name provider: 'decider' url: url model: model textLimit: (limit jsonValue)} asJson
      ]
    } otherwise: [@ DecisionError signal: 'Unknown decision target'].
  ]

  # Probe before a batch so an unavailable service fails once, up front.
  classMethod: requireReady: target [
    | provider url |
    provider := target jsonTextAt: 'provider'.
    (provider = 'decider') ifFalse: [^ target].
    ((@ Decider::Client ready: target) = 'true') ifTrue: [^ target].
    url := target jsonTextAt: 'url'.
    @ DecisionUnavailableError signal: 'Decider is not ready at ' , url
  ]

  # After a context overflow, the same target with half the text limit. Fails
  # for any other error or below 500 characters; the caller reports the original.
  classMethod: shrink: target after: error [
    | receipt limit |
    ((error upTo: ':') = 'DecisionRequestError') ifFalse: [@ DecisionError signal: 'Not a decision request failure'].
    receipt := error withoutPrefix: 'DecisionRequestError: '.
    ((@ Decider::Client overflowed: receipt) = 'true') ifFalse: [@ DecisionError signal: 'Not a context overflow'].
    limit := (target jsonAt: 'textLimit') / 2.
    (limit < 500) ifTrue: [@ DecisionError signal: 'Text limit cannot shrink further'].
    ^ #{name: (target jsonTextAt: 'name') provider: (target jsonTextAt: 'provider') url: (target jsonTextAt: 'url')
        model: (target jsonTextAt: 'model') textLimit: (limit jsonValue)} asJson
  ]

  classMethod: decide: state questions: questions using: target [
    | provider |
    provider := target jsonTextAt: 'provider'.
    provider caseOf: {
      'jev' -> [^ @ OpenRouter::Jev decide: state questions: questions].
      'decider' -> [^ @ Decider::Client decide: state questions: questions using: target]
    } otherwise: [@ DecisionError signal: 'Unknown decision provider']
  ]
