# Message - A durable message addressed to an Inbox
# Messages are plain Persistable objects: agents, humans, and deterministic
# processes all exchange the same shape. Delivery, listing, and wakeups live
# on Inbox; Message only knows its own fields and how to reply.
#
# Instance variables:
#   to        - inbox name this message was delivered to
#   from      - sender name (free-form: 'chazu', 'maki:abc123', 'cron')
#   subject   - one-line summary (may be empty)
#   body      - full text
#   kind      - note | question | alert | result (free-form, conventional)
#   status    - unread | read | archived
#   thread    - thread id (own id for a fresh message, inherited by replies)
#   replyTo   - id of the message this one answers, or empty
#   created   - ISO timestamp set on delivery
#   sentAt    - epoch millis set on delivery (ordering key)
#   readAt    - ISO timestamp set by markRead
#
# Usage:
#   msg=$(@ Message to: 'chazu' from: 'maki' subject: 'done' body: 'tests pass' kind: 'result')
#   @ $msg summary
#   @ $msg show
#   @ $msg reply: 'thanks'          # lands in the sender's inbox, same thread
#   @ $msg markRead
#   @ $msg archive
Message subclass: Object
  include: Persistable
  instanceVars: to:'' from:'' subject:'' body:'' kind:'note' status:'unread'
                assignment:'' generation:0 dispatchMode:'automatic' executionWorkspace:''
                thread:'' replyTo:'' created:'' sentAt:0 readAt:''
                attention:'' attentionFirstCoordinate:'null' attentionLastCoordinate:'null'
                attentionEventCount:0 attentionHintAt:0 attentionLineageDepth:0

  # Build an undelivered message. Inbox deliver: stamps to/created/sentAt/thread.
  classMethod: to: recipient from: sender subject: subj body: text kind: aKind [
    | msg |
    msg := @ Message new.
    @ Runtime assign: (#{to: recipient from: sender subject: subj body: text kind: aKind} asJson) to: msg.
    ^ msg
  ]

  classMethod: to: recipient from: sender subject: subj body: text [
    ^ @ Message to: recipient from: sender subject: subj body: text kind: 'note'
  ]

  method: isUnread [
    (status = 'unread') ifTrue: [^ 'true'].
    ^ 'false'
  ]

  # Processing links are owned by the queue, independently of read/archive state.
  method: blockingDeliveryIds [
    | question |
    question := @ AgentQueue questionFor: self.
    ^ question jsonAt: 'deliveryIds'
  ]

  method: answerId [
    | question |
    question := @ AgentQueue questionFor: self.
    ^ question jsonTextAt: 'answerId'
  ]

  method: markRead [
    | now |
    now := @ Time nowISO.
    status := 'read'.
    readAt := now.
    @ self save
  ]

  # UI reads preserve archive state and the first read timestamp.
  method: markViewed [
    @ self reload.
    (status = 'unread') ifTrue: [@ self markRead]
  ]

  method: readText [
    @ self markViewed.
    ^ @ MessagePresentation textFor: self
  ]

  # Address lookup only: no identity/session creation for legacy or unknown mail.
  rawMethod: originSession [
    local sender session
    sender=$(_ivar from)
    [[ "${sender%%:*}" == session ]] || return 0
    session=${sender#*:}
    [[ $(db_get "$session" | jq -r '.class // ""') == AgentSession ]] || return 0
    printf '%s\n' "$session"
  ]

  rawMethod: senderIdentity [
    local sender session
    sender=$(_ivar from)
    session=$(@ "$_RECEIVER" originSession)
    if [[ -n "$session" ]]; then @ "$session" identity
    elif [[ "${sender%%:*}" == agent ]]; then @ AgentIdentity findByHandle: "${sender#*:}"; fi
  ]

  # Prefer the exact originating conversation while it is current. Otherwise
  # return candidates in that same workspace; a UI must resolve ambiguity.
  method: senderSessions [
    | origin identity state current workspace scope |
    origin := @ self originSession.
    identity := @ self senderIdentity.
    identity isEmpty ifTrue: [^ ''].
    @ identity reload.
    scope := @ identity sessionScope.
    (scope = 'identity') ifTrue: [
      current := @ AgentSession currentFor: identity workspace: ''.
      (current notEmpty) ifTrue: [^ current].
      ^ origin
    ].
    origin notEmpty ifTrue: [
      @ origin reload.
      state := @ origin lifecycleState.
      (state = 'open') ifTrue: [^ origin].
      (state = 'paused') ifTrue: [^ origin].
      workspace := @ origin workspace.
      current := @ AgentSession findFor: identity workspace: workspace.
      current isEmpty ifTrue: [^ origin].
      ^ current
    ].
    ^ @ AgentWorker eligibleSessionsFor: identity
  ]

  method: archive [
    status := 'archived'.
    @ self save
  ]

  # Reply to the sender. The reply keeps this message's thread and points
  # replyTo at this message, so an agent that asked a question can find
  # the answer with `@ inbox thread: questionId`.
  method: reply: text [
    | msg inbox |
    msg := @ Message to: from from: to subject: subject body: text kind: 'note'.
    @ msg thread: thread.
    @ msg replyTo: self.
    @ msg executionWorkspace: executionWorkspace.
    inbox := @ Inbox named: from.
    ^ @ inbox deliver: msg
  ]

  # One-line rendering for inbox listings
  method: summary [
    | label marker |
    label := subject.
    (label isEmpty) ifTrue: [label := body].
    marker := ' '.
    (status = 'unread') ifTrue: [marker := '*'].
    ^ marker , ' ' , self , '  [' , kind , '] ' , from , ' -> ' , to , ': ' , label
  ]

  # Full rendering
  method: show [
    pragma: stream
    | line |
    line := 'Id:      ' , self.
    @ Console print: line.
    line := 'From:    ' , from.
    @ Console print: line.
    line := 'To:      ' , to.
    @ Console print: line.
    line := 'Subject: ' , subject.
    @ Console print: line.
    line := 'Kind: ' , kind , '  Status: ' , status , '  Sent: ' , created.
    @ Console print: line.
    (thread notEmpty) ifTrue: [
      line := 'Thread:  ' , thread.
      @ Console print: line
    ].
    (replyTo notEmpty) ifTrue: [
      line := 'ReplyTo: ' , replyTo.
      @ Console print: line
    ].
    @ Console print: ''.
    @ Console print: body
  ]

  rawClassMethod: help [
    echo "=== Message - Durable message addressed to an Inbox ==="
    echo ""
    echo "Build (undelivered):"
    echo "  msg=\$(@ Message to: 'chazu' from: 'maki' subject: 'done' body: 'tests pass' kind: 'result')"
    echo ""
    echo "Inspect:"
    echo "  @ \$msg summary        # one line"
    echo "  @ \$msg show           # full"
    echo "  @ \$msg isUnread"
    echo ""
    echo "Act:"
    echo "  @ \$msg markRead"
    echo "  @ \$msg archive"
    echo "  @ \$msg reply: 'thanks'   # to sender, same thread"
    echo ""
    echo "Kinds (conventional): note | question | alert | result"
  ]

  # Assignment factories use Message defaults and the normal serializer.
  classMethod: forAssignment: assignment id: id to: recipient sender: sender subject: title body: body kind: kind [
    | msg origin conversation now millis |
    @ Store requireTransaction.
    msg := @ Store create: 'Message' id: id.
    origin := @ assignment originMessage.
    conversation := msg.
    (origin notEmpty) ifTrue: [
      origin := @ Store read: origin class: 'Message'.
      conversation := @ origin thread.
      (conversation isEmpty) ifTrue: [conversation := msg]
    ].
    now := @ Time nowISO.
    millis := @ Time nowMillis.
    @ msg to: recipient.
    @ msg from: sender.
    @ msg subject: title.
    @ msg body: body.
    @ msg kind: kind.
    @ msg thread: conversation.
    @ msg replyTo: origin.
    @ msg created: now.
    @ msg sentAt: millis.
    @ msg assignment: assignment.
    @ msg dispatchMode: 'manual'.
    ^ msg
  ]

  classMethod: workForAssignment: assignment session: session generation: generation sender: sender [
    | id recipient title objective criteria body msg |
    id := 'message_' , assignment , '_work_' , generation.
    recipient := 'session:' , session.
    objective := @ assignment objective.
    criteria := @ assignment completionCriteria.
    title := 'Assignment: ' , objective.
    body := @ Console printf: 'Assignment %s\n%s\nCompletion criteria: %s' with: assignment and: objective and: criteria.
    msg := @ self forAssignment: assignment id: id to: recipient sender: sender subject: title body: body kind: 'assignment'.
    @ msg generation: generation.
    ^ msg
  ]

  classMethod: questionForAssignment: assignment body: body sender: sender [
    | id recipient objective title |
    id := @ Runtime generateId: 'Message'.
    recipient := @ assignment owner.
    objective := @ assignment objective.
    title := 'Question: ' , objective.
    ^ @ self forAssignment: assignment id: id to: recipient sender: sender subject: title body: body kind: 'question'
  ]

  classMethod: outcomeForAssignment: assignment body: body sender: sender cancelled: cancelled [
    | id recipient origin objective title kind |
    id := 'message_' , assignment , '_outcome'.
    recipient := @ assignment owner.
    origin := @ assignment originMessage.
    (origin notEmpty) ifTrue: [
      origin := @ Store read: origin class: 'Message'.
      recipient := @ origin from.
      (recipient isEmpty) ifTrue: [recipient := @ assignment owner]
    ].
    objective := @ assignment objective.
    title := 'Assignment completed: ' , objective.
    kind := 'result'.
    (cancelled = 'true') ifTrue: [title := 'Assignment cancelled: ' , objective. kind := 'note'].
    ^ @ self forAssignment: assignment id: id to: recipient sender: sender subject: title body: body kind: kind
  ]

  # Safe local projection factory. All Message and Attention changes commit
  # together through the public Inbox attention: boundary, without AgentQueue.
  classMethod: forAttention: attention display: display to: owner [
    | data message id title summary count first last body now millis patch human recipient linked delegated |
    @ Store requireTransaction.
    human := @ AgentFocus human.
    @ Require equal: owner to: human.
    @ Store read: attention class: 'Workstation::Attention'.
    data := @ Store getInstance: attention.
    data := @ Workstation::Schema document: data.
    message := data jsonTextAt: 'message'.
    title := display jsonTextAt: 'title'.
    summary := display jsonTextAt: 'summary'.
    count := data jsonTextAt: 'eventCount'.
    first := data jsonAt: 'firstCoordinate'.
    last := data jsonAt: 'lastCoordinate'.
    body := 'Attention ' , attention , ': ' , count , ' matching events. ' , summary.
    delegated := data jsonAt: 'delegatedSession' ifAbsent: '""'.
    delegated := delegated jsonTextAt: ''.
    (delegated notEmpty) ifTrue: [body := body , ' Delegated to session ' , delegated , '.'].
    (message isEmpty) ifTrue: [
      id := @ Runtime generateId: 'Message'.
      message := @ Store create: 'Message' id: id.
      now := @ Time nowISO.
      millis := @ Time nowMillis.
      @ Store patch: message with: (#{to: owner from: 'workstation' kind: 'alert' dispatchMode: 'manual'
        thread: message created: now sentAt: millis attention: attention} asJson)
    ] ifFalse: [
      @ Store read: message class: 'Message'.
      recipient := @ message to.
      linked := @ message attention.
      @ Require equal: recipient to: owner.
      @ Require equal: linked to: attention
    ].
    patch := #{subject: title body: body attentionFirstCoordinate: (first jsonValue)
      attentionLastCoordinate: (last jsonValue) attentionEventCount: (count jsonValue)} asJson.
    @ Store patch: message with: patch.
    ^ message
  ]
  method: attentionHintDue: seconds [
    | data state until now last elapsed |
    @ Store requireTransaction.
    data := @ Store getInstance: attention.
    state := data jsonTextAt: 'state'.
    (state = 'snoozed') ifTrue: [
      until := @ Workstation::Schema timestampEpoch: (data jsonTextAt: 'snoozeUntil').
      now := @ Time now.
      (until > now) ifTrue: [^ 'false'].
      state := 'open'
    ].
    (state ~= 'open') ifTrue: [^ 'false'].
    now := @ Time now.
    last := attentionHintAt.
    elapsed := now - last.
    (elapsed < seconds) ifTrue: [^ 'false'].
    ^ 'true'
  ]
  method: recordAttentionHint [
    | now |
    @ Store requireTransaction.
    now := @ Time now.
    @ Store patch: self with: (#{attentionHintAt: (now jsonValue)} asJson)
  ]

  # These controls deliberately do not reuse reply/archive/session actions.
  method: localAttention [
    | human recipient linked |
    human := @ AgentFocus human.
    recipient := to.
    (@ Require equal: recipient to: human) ifFailed: [:error | @ error signal].
    linked := attention.
    (@ Require text: linked) ifFailed: [:error | @ error signal].
    ^ @ Workstation::Attention read: linked
  ]
  method: inspectAttention [
    | linked |
    linked := @ self localAttention.
    ^ @ linked asJson
  ]
  method: acknowledgeAttention [
    | linked |
    linked := @ self localAttention.
    ^ @ linked acknowledge
  ]
  method: snoozeAttentionUntil: timestamp [
    | linked |
    linked := @ self localAttention.
    ^ @ linked snoozeUntil: timestamp
  ]
  method: resolveAttentionWithNote: reason [
    | linked |
    linked := @ self localAttention.
    ^ @ linked resolveWithNote: reason
  ]
  method: suppressAttention: reason [
    | linked |
    linked := @ self localAttention.
    ^ @ linked suppress: reason
  ]
  method: reopenAttention [
    | linked |
    linked := @ self localAttention.
    ^ @ linked reopen
  ]
  # Phase 2 routing controls, scoped to the current human owner like the rest.
  method: routingStatus [
    | linked |
    linked := @ self localAttention.
    ^ @ linked routingStatus
  ]
  method: delegateAttention [
    | linked |
    linked := @ self localAttention.
    ^ @ linked delegate
  ]
  method: redelegateAttention: reason [
    | linked |
    linked := @ self localAttention.
    ^ @ linked redelegate: reason
  ]
  method: focusDelegatedAttention [
    | linked |
    linked := @ self localAttention.
    ^ @ linked focusDelegated
  ]

  # Agent-facing delegation Message. It is addressed to the resolved session,
  # sent by the human owner so replies return to that owner's inbox thread,
  # and carries the receipt cwd, causal coordinates, and lineage depth.
  classMethod: forDelegatedAttention: attention admission: admission revision: revision [
    | id msg data human session recipient title summary count first last depth body now millis root workspace execution |
    @ Store requireTransaction.
    human := @ AgentFocus human.
    id := 'message_' , attention , '_delegation_' , revision.
    @ Store read: attention class: 'Workstation::Attention'.
    data := @ Store getInstance: attention.
    data := @ Workstation::Schema document: data.
    session := admission jsonTextAt: 'session'.
    recipient := 'session:' , session.
    root := data jsonTextAt: 'message'.
    title := ''. summary := ''.
    (root notEmpty) ifTrue: [
      @ Store read: root class: 'Message'.
      title := @ root subject.
      summary := @ root body
    ].
    (title isEmpty) ifTrue: [title := 'Workstation attention ' , attention].
    count := data jsonTextAt: 'eventCount'.
    first := data jsonAt: 'firstCoordinate'.
    last := data jsonAt: 'lastCoordinate'.
    depth := data jsonAt: 'lineageDepth' ifAbsent: '0'.
    depth := depth + 1.
    workspace := admission jsonTextAt: 'receiptWorkspace'.
    execution := admission jsonTextAt: 'executionWorkspace'.
    body := 'Delegated workstation attention ' , attention , ' (delegation ' , revision , ').
Command: ' , title , '
Working directory: ' , workspace , '
Matching events: ' , count , '
' , summary , '
Investigate the failure in the working directory, summarize the likely cause, and reply with your findings. Do not treat this as approval to change anything.'.
    now := @ Time nowISO.
    millis := @ Time nowMillis.
    msg := @ Store create: 'Message' id: id.
    title := 'Attention: ' , title.
    # One patch: Store patch: reloads the cached object, so setters before it would be lost.
    @ Store patch: msg with: (#{to: recipient from: human subject: title body: body kind: 'attention'
      thread: msg created: now sentAt: (millis jsonValue) attention: attention executionWorkspace: execution
      dispatchMode: 'automatic' attentionFirstCoordinate: (first jsonValue) attentionLastCoordinate: (last jsonValue)
      attentionEventCount: (count jsonValue) attentionLineageDepth: (depth jsonValue)} asJson).
    ^ msg
  ]
