package: Assignment

# One durable inbox projection per automatic assignment. It is updated in the
# creation transaction; the worker is the single writer of subsequent status
# projections. Progress/completion only write domain records, avoiding races
# with presentation updates. Reconciliation also visits unpublished outcomes.
Notifications trait
  method: updateStatusWithin: unused [
    | mode data execution state activity run events event detail body fingerprint message id owner sender title kind now |
    @ Store requireTransaction.
    mode := @ self dispatchMode.
    (mode ~= 'automatic') ifTrue: [^ ''].
    data := @ self snapshotWithin: ''.
    execution := data jsonAt: 'execution'.
    state := data objectAt: 'state'.
    activity := data objectAt: 'activity'.
    (activity = 'needs review') ifTrue: [@ self notifyRecoveryWithin: data].
    run := execution objectAt: 'run'.
    detail := execution objectAt: 'error'.
    events := data jsonAt: 'events'.
    ((events arrayLength) > 0) ifTrue: [
      event := events arrayLast.
      (detail isEmpty) ifTrue: [detail := event objectAt: 'body']
    ].
    body := @ Console printf: 'Assignment %s\nStatus: %s\nAgent: %s' with: self and: activity and: (data objectAt: 'assignee').
    detail := @ Console printf: 'Session: %s\nRun: %s\n%s' with: (data objectAt: 'currentSession') and: run and: detail.
    body := @ Console printf: '%s\n%s' with: body and: detail.
    message := @ self statusMessage.
    (message notEmpty) ifTrue: [
      message := @ Store read: message class: 'Message'.
      fingerprint := @ message body.
      (fingerprint = body) ifTrue: [^ message]
    ].
    title := 'Assignment ' , activity , ': ' , (data objectAt: 'objective').
    kind := 'note'.
    (state = 'completed') ifTrue: [kind := 'result'].
    (activity = 'needs review') ifTrue: [kind := 'alert'].
    (message isEmpty) ifTrue: [
      id := self.
      id := 'message_' , id , '_status'.
      owner := @ self owner.
      sender := 'session:' , (data objectAt: 'requesterSession').
      message := @ Message forAssignment: self id: id to: owner sender: sender subject: title body: body kind: kind.
      @ message assignmentState: state.
      @ Agent::Queue publishManual: message.
      @ self statusMessage: message.
      @ self save
    ] ifFalse: [
      message := @ Store read: message class: 'Message'.
      @ message subject: title.
      @ message body: body.
      @ message kind: kind.
      @ message status: 'unread'.
      @ message readAt: ''.
      now := @ Time nowMillis.
      @ message sentAt: now.
      @ message assignmentState: state.
      @ message save.
      @ Store afterCommit: 'Agent::Queue' sending: 'announce:' with: message
    ].
    ^ message
  ]

  # Deterministic message identity and outbox commit make restart/replay inert.
  method: notifyRecoveryWithin: snapshot [
    | execution delivery run runState session id exists detail body message limit count |
    @ Store requireTransaction.
    execution := snapshot jsonAt: 'execution'.
    delivery := snapshot objectAt: 'delivery'.
    run := execution objectAt: 'run'.
    runState := execution objectAt: 'runState'.
    (run notEmpty) ifTrue: [
      exists := @ Require contains: runState in: '["starting","running","recovering"]'.
      (exists = 'true') ifTrue: [^ '']
    ].
    session := snapshot objectAt: 'requesterSession'.
    (session isEmpty) ifTrue: [^ ''].
    id := 'message_' , delivery , '_recovery_' , run.
    exists := @ Store exists: id.
    (exists = 'true') ifTrue: [^ id].
    detail := execution objectAt: 'error'.
    (detail isEmpty) ifTrue: [detail := 'The previous turn ended without completing the Assignment. The stop cause, including budget exhaustion, is unconfirmed.'].
    limit := @ self continuationLimit.
    count := @ self continuationCount.
    body := 'Assignment ' , self , ' needs recovery. Delivery: ' , delivery , '. Run: ' , run , ' (' , runState , ').
' , detail , '
Continuations used: ' , count , ' of ' , limit , '. Inspect this Assignment and existing workspace changes. If safe and within the allowance, use the current run launcher:
<launcher> ' , self , ' continue: resume-recorded-work afterDelivery: ' , delivery , ' key: recover-' , delivery , '
This returns a queued delivery, not proof of a running agent. Do not recreate the Assignment, change its original request, or promise work after a rejected command. If recovery is unsafe or the allowance is exhausted, report the exact blocker. Settle this notification after handling it.'.
    message := @ Message forAssignment: self id: id to: ('session:' , session)
      sender: 'worker' subject: 'Assignment needs recovery' body: body kind: 'note'.
    @ message assignmentState: 'needs review'.
    @ message generation: (snapshot objectAt: 'generation').
    @ Agent::Queue publishOutcome: message.
    ^ message
  ]
