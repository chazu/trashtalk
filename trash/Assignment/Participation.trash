package: Assignment

# Session participation and delivery claims. History stays embedded in the
# Assignment record; these class methods create no helper instances. The public
# Assignment operation owns the Store transaction around every read and save.
Participation subclass: Object
  classMethod: select: session for: assignment [
    | actor sender aData s allowed current runs old oldState |
    @ Store requireTransaction.
    actor := @ Agent::Run actingContext.
    sender := @ assignment authorizeCoordinator: actor.
    @ assignment requireOpen.
    aData := @ assignment asJson.
    s := @ self eligibleSession: session for: assignment.
    current := @ assignment currentSession.
    (current = s) ifTrue: [^ assignment].
    runs := @ Agent::Run activeFor: s except: ''.
    @ Require equal: runs to: '[]'.
    (current notEmpty) ifTrue: [
      runs := @ Agent::Run activeFor: current except: ''.
      @ Require equal: runs to: '[]'.
      old := @ Store read: (aData objectAt: 'delivery') class: 'Agent::Delivery'.
      oldState := @ old state.
      @ Require member: oldState of: '["pending","blocked","processed","skipped"]'.
      allowed := @ Require contains: oldState in: '["pending","blocked"]'.
      (allowed = 'true') ifTrue: [
        @ old state: 'skipped'.
        @ old note: 'Assignment continued in another session'.
        @ old save
      ]
    ].
    ^ @ self publishFor: assignment session: s sender: sender
  ]

  classMethod: eligibleSession: session for: assignment [
    | aData s sData identity iData role path canonical allowed |
    @ Store requireTransaction.
    aData := @ assignment asJson.
    s := @ Store read: session class: 'Agent::Session'.
    sData := @ s asJson.
    identity := @ Store read: (sData objectAt: 'identity') class: 'Agent::Identity'.
    iData := @ identity asJson.
    @ Require equal: identity to: (aData objectAt: 'assignee').
    @ Require member: (iData objectAt: 'enabled') of: '["true","1"]'.
    @ Require equal: (sData objectAt: 'lifecycleState') to: 'open'.
    path := @ s workspace.
    canonical := @ Agent::Session workspaceFor: path.
    @ Require equal: canonical to: (aData objectAt: 'workspace').
    role := @ Store read: (sData objectAt: 'role') class: 'Agent::Role'.
    allowed := @ role allowsWorkspace: canonical.
    @ Require equal: allowed to: 'true'.
    ^ s
  ]

  classMethod: publishFor: assignment session: s sender: sender [
    | gen message d now history participation notice path |
    @ Store requireTransaction.
    path := @ s workspace.
    gen := @ assignment generation.
    gen := gen + 1.
    message := @ Message workForAssignment: assignment session: s generation: gen sender: sender.
    d := @ Agent::Delivery forAssignment: assignment session: s generation: gen message: message.
    now := @ Time nowISO.
    participation := #{generation: gen session: s delivery: d message: message workspace: path selectedAt: now runs: #()} asJson.
    participation := participation objectAt: 'generation' putJson: gen.
    history := @ assignment history.
    history := history arrayPushJson: participation.
    @ assignment history: history.
    @ assignment currentSession: s.
    @ assignment generation: gen.
    @ assignment delivery: d.
    @ assignment save.
    @ Agent::Queue publishManual: message.
    notice := @ assignment statusMessage.
    (notice isEmpty) ifTrue: [@ assignment updateStatusWithin: ''].
    ^ assignment
  ]

  classMethod: claimWithin: args [
    | actor caller run d dData a aData r rData s sData i iData role roleData same presented expected value history participation runs questions previous oldData attempts updated gen |
    @ Store requireTransaction.
    actor := @ Agent::Run actingContext.
    caller := actor objectAt: 'run'.
    run := args objectAt: 'run'.
    (caller notEmpty) ifTrue: [@ Require equal: caller to: run].
    d := @ Store read: (args objectAt: 'delivery') class: 'Agent::Delivery'.
    dData := @ d asJson.
    a := @ Store read: (dData objectAt: 'assignment') class: 'Assignment'.
    aData := @ a asJson.
    r := @ Store read: run class: 'Agent::Run'.
    rData := @ r asJson.
    s := @ Store read: (rData objectAt: 'session') class: 'Agent::Session'.
    sData := @ s asJson.
    i := @ Store read: (sData objectAt: 'identity') class: 'Agent::Identity'.
    iData := @ i asJson.
    role := @ Store read: (sData objectAt: 'role') class: 'Agent::Role'.
    roleData := @ role asJson.
    presented := actor objectAt: 'human'.
    expected := aData objectAt: 'owner'.
    (caller notEmpty) ifTrue: [presented := actor objectAt: 'hash'. expected := rData objectAt: 'capabilityTokenHash'].
    (presented = expected) ifFalse: [^ 'false'].
    ((aData objectAt: 'state') = 'open') ifFalse: [^ 'false'].
    ((aData objectAt: 'delivery') = d) ifFalse: [^ 'false'].
    expected := dData objectAt: 'generation'.
    ((aData objectAt: 'generation') = expected) ifFalse: [^ 'false'].
    ((aData objectAt: 'currentSession') = s) ifFalse: [^ 'false'].
    ((dData objectAt: 'session') = s) ifFalse: [^ 'false'].
    ((aData objectAt: 'assignee') = i) ifFalse: [^ 'false'].
    ((sData objectAt: 'lifecycleState') = 'open') ifFalse: [^ 'false'].
    same := @ Require contains: (iData objectAt: 'enabled') in: '["true","1"]'.
    (same = 'false') ifTrue: [^ 'false'].
    same := @ Require contains: 'assignment.work' in: (roleData jsonAt: 'capabilities').
    (same = 'false') ifTrue: [^ 'false'].
    same := @ Require contains: (rData objectAt: 'state') in: '["starting","running","recovering"]'.
    (same = 'false') ifTrue: [^ 'false'].
    same := @ Require contains: (dData objectAt: 'state') in: '["pending","blocked"]'.
    (same = 'false') ifTrue: [^ 'false'].
    history := @ a history.
    participation := history arrayLast.
    expected := participation objectAt: 'workspace'.
    ((sData objectAt: 'workspace') = expected) ifFalse: [^ 'false'].
    runs := @ Agent::Run activeFor: s except: run.
    (runs = '[]') ifFalse: [^ 'false'].
    value := @ d state.
    (value = 'blocked') ifTrue: [
      previous := @ d run.
      (previous notEmpty) ifTrue: [
        oldData := @ Store getInstance: previous.
        value := oldData objectAt: 'state'.
        same := @ Require contains: value in: '["starting","running","recovering"]'.
        (same = 'true') ifTrue: [^ 'false']
      ]
    ].
    questions := @ Agent::Queue unansweredForAssignment: a.
    (questions = '[]') ifFalse: [^ 'false'].
    attempts := @ d attempts.
    attempts := attempts + 1.
    @ d state: 'offered'.
    @ d run: run.
    @ d attempts: attempts.
    @ d save.
    runs := participation jsonAt: 'runs'.
    same := @ Require contains: run in: runs.
    (same = 'false') ifTrue: [
      runs := runs arrayPush: run.
      participation := participation objectAt: 'runs' putJson: runs.
      gen := @ a generation.
      updated := '[]'.
      history arrayEach: [:entry |
        ((entry objectAt: 'generation') = gen) ifTrue: [updated := updated arrayPushJson: participation] ifFalse: [updated := updated arrayPushJson: entry]
      ].
      @ a history: updated.
      @ a save
    ].
    ^ 'true'
  ]
