# Snapshotable trait - point-in-time capture semantics
# For classes whose instances represent a snapshot of external state at a moment in time.
# Adds indexed virtual column setup and time-ordered history queries.
#
# Requirements:
#   - Including class must also include Persistable
#   - Including class must declare a 'capturedAt' instance variable
#   - Call @ MyClass initializeSchema once at load time to create indexes
#
# Usage:
#   MyResource subclass: Object
#     include: Persistable
#     include: Snapshotable
#     instanceVars: capturedAt ...
#
#     classMethod: indexedColumns [
#       ^ '[{"name": "my_field", "path": "$.myField"}]'
#     ]
#
#   @ MyResource initializeSchema

Snapshotable trait

  # Set up virtual columns and indexes declared by indexedColumns.
  # Call once at load time. Safe to call repeatedly - errors from existing columns are suppressed.
  classMethod: initializeSchema [
    | cols |
    cols := @ self indexedColumns.
    cols jsonRows: #('name' 'path') into: [:name :path |
      @ Store ensureIndex: name path: path
    ]
  ]

  # Override in subclasses to declare [{name:, path:}] for indexed virtual columns.
  classMethod: indexedColumns [
    ^ '[]'
  ]

  # All persisted instances of this class, ordered by capturedAt ascending.
  # Queries read capturedAt from the JSON so they do not depend on
  # initializeSchema having created the captured_at virtual column.
  classMethod: history [
    ^ @ Store findByClass: self orderBy: "json_extract(data, '$.capturedAt') ASC"
  ]

  # Most recent persisted instance whose identity field matches the given string.
  # Identity is expected to be a stored field like "Pod/default/api-server".
  classMethod: latestFor: identity [
    ^ @ Store findByClass: self matching: (#{identity: identity} asJson) orderBy: "json_extract(data, '$.capturedAt') DESC" limit: 1
  ]
