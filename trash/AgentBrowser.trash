# AgentBrowser - Snapshot inspection and explicit recovery through Innards.
# Pickers return intent; Trashtalk validates membership and owns all mutations.
# Reading a conversation marks its messages read without signalling execution.
AgentBrowser subclass: Object

  # OS boundary: temporary preview files and signal/exit cleanup.
  rawClassMethod: browse [
    (
      local dir
      dir=$(mktemp -d "${TMPDIR:-/tmp}/trash-sessions.XXXXXX") || exit 1
      trap 'rm -rf "$dir"' EXIT
      @ AgentBrowser browseIn: "$dir"
    )
  ]

  rawClassMethod: browseSession: session [
    (
      local dir
      dir=$(mktemp -d "${TMPDIR:-/tmp}/trash-sessions.XXXXXX") || exit 1
      trap 'rm -rf "$dir"' EXIT
      @ AgentBrowser session: "$1" in: "$dir"
    )
  ]

  classMethod: browseIn: dir [
    | records choice selected action ignored |
    [1 = 1] whileTrue: [
      records := @ self sessionRecordsIn: dir.
      choice := @ self pickSession: records in: dir.
      selected := choice jsonTextAt: 'id'.
      selected isEmpty ifTrue: [^ 'dismissed'].
      action := choice jsonTextAt: 'action'.
      (action = 'terminate') ifTrue: [
        ignored := @ self confirmTerminationOf: selected in: dir
      ] ifFalse: [ignored := @ self session: selected in: dir]
    ]
  ]

  classMethod: pickSession: records in: dir [
    | available result selected action hasAction |
    available := @ Tools::Inpick isInstalled.
    (available = 'true') ifTrue: [
      result := @ Tools::Inpick selectRecords: records root: dir query: '' title: 'Agent sessions' controlDAction: 'terminate'
    ] ifFalse: [
      result := @ Tools::Inpick fallbackSelectRecords: records query: '' title: 'Agent sessions' controlDAction: 'terminate'
    ].
    selected := @ self selectedFrom: result records: records.
    action := ''.
    hasAction := result jsonHas: 'action'.
    (hasAction = 'true') ifTrue: [action := result jsonTextAt: 'action'].
    ^ #{id: selected action: action} asJson
  ]

  classMethod: confirmTerminationOf: session in: dir [
    | path details records choice result ignored |
    @ session reload.
    details := @ session details.
    path := session , '.txt'.
    @ File write: details to: (dir , '/' , path).
    records := @ self terminationRecordsAt: path.
    choice := @ self pick: records root: dir title: 'Terminate selected session?'.
    (choice = 'terminate') ifTrue: [
      result := @ self terminateResultFor: session.
      (result = 'terminated') ifFalse: [
        ignored := @ self page: result title: 'Session termination needs attention'
      ]
    ]
  ]

  classMethod: terminationRecordsAt: path [
    @ self record: 'cancel' label: 'Cancel' detail: 'Keep the session as it is' path: path.
    @ self record: 'terminate' label: 'Terminate session and stop active work' detail: 'Revoke run access; retain messages and logs' path: path
  ]

  # Capture failure diagnostics for the UI; never report a stop we did not observe.
  rawClassMethod: terminateResultFor: session [
    @ "$1" terminate 2>&1
  ]

  classMethod: session: session in: dir [
    | details path records action text ignored |
    [1 = 1] whileTrue: [
      @ session reload.
      details := @ session details.
      path := dir , '/session.txt'.
      @ File write: details to: path.
      records := @ self actionRecordsFor: session.
      action := @ self pick: records root: dir title: 'Session actions'.
      action isEmpty ifTrue: [^ 'dismissed'].
      (action = 'back') ifTrue: [^ 'dismissed'].
      (action = 'details') ifTrue: [ignored := @ self page: details title: 'Session details'].
      (action = 'messages') ifTrue: [
        text := @ self messagesFor: session.
        ignored := @ self page: text title: 'Session messages'
      ].
      (action = 'runs') ifTrue: [ignored := @ self runsFor: session in: dir].
      (action = 'retry') ifTrue: [ignored := @ self retryFor: session in: dir].
      (action = 'pause') ifTrue: [ignored := @ session pause].
      (action = 'resume') ifTrue: [
        ignored := @ session resume.
        ignored := @ AgentWorker tickSession: session
      ]
    ]
  ]

  classMethod: page: text title: title [
    | available |
    available := @ Tools::Inpage isInstalled.
    (available = 'true') ifTrue: [^ @ Tools::Inpage viewText: text title: title].
    @ Console print: text
  ]

  classMethod: pick: records root: root title: title [
    | available result |
    available := @ Tools::Inpick isInstalled.
    (available = 'true') ifTrue: [
      result := @ Tools::Inpick selectRecords: records root: root query: '' title: title
    ] ifFalse: [
      result := @ Tools::Inpick fallbackSelectRecords: records query: '' title: title
    ].
    ^ @ self selectedFrom: result records: records
  ]

  # Validate structured UI output against the offered records, never dispatch
  # arbitrary ids returned by an external process.
  rawClassMethod: selectedFrom: result records: records [
    local id
    id=$(printf '%s' "$1" | jq -er 'select(.outcome == "selected") | .selection.id' 2>/dev/null) || return 0
    printf '%s\n' "$2" | jq -er --arg id "$id" 'select(.id == $id) | .id' | head -n 1
  ]

  classMethod: record: id label: label detail: detail path: path [
    ^ #{schema_version: 1 id: id label: label detail: detail path: path line: 1 column: 1 kind: 'agent'} asJson
  ]

  classMethod: listedSessions [
    ^ @ Store query: "class = 'AgentSession' AND coalesce(json_extract(data, '$.lifecycleState'), '') != 'terminated'"
  ]

  # Filesystem projection only; session state comes from its public snapshot.
  rawClassMethod: sessionRecordsIn: dir [
    local session data text label path
    for session in $(@ AgentBrowser listedSessions); do
      data=$(@ "$session" snapshot) || return 1
      text=$(@ AgentBrowser describeSession: "$data")
      path="$session.txt"
      printf '%s\n' "$text" > "$1/$path"
      label=$(printf '%s' "$data" | jq -r '"\(.workspace) [\(.lifecycle)/\(.activity)] pending=\(.pending) questions=\(.questions) stalled=\(.stalled)"')
      @ AgentBrowser record: "$session" label: "$label" detail: "$session" path: "$path"
    done
  ]

  # Text formatting is a projection of the snapshot, not a state mutation.
  rawClassMethod: describeSession: data [
    printf '%s' "$1" | jq -r '"Session: \(.id)\nIdentity: \(.identity)\nWorkspace: \(.workspace)\nLifecycle: \(.lifecycle)\nLatest run state: \(.activity)\nQueued: \(.pending)\nBlocked deliveries / questions: \(.questions)\nNeeds review: \(.stalled)\nLatest run: \(.run)\nLatest failure: \(.error)"'
  ]

  classMethod: actionRecordsFor: session [
    | state |
    @ self record: 'details' label: 'Session details' detail: 'Refresh snapshot' path: 'session.txt'.
    @ self record: 'messages' label: 'Messages and questions' detail: 'Read conversation' path: 'session.txt'.
    @ self record: 'runs' label: 'Runs and logs' detail: 'Inspect failures and output' path: 'session.txt'.
    @ self record: 'retry' label: 'Retry a stalled delivery' detail: 'Choose a delivery, inspect, then confirm' path: 'session.txt'.
    state := @ session lifecycleState.
    (state = 'open') ifTrue: [@ self record: 'pause' label: 'Pause new work' detail: 'Active work continues' path: 'session.txt'].
    (state = 'paused') ifTrue: [@ self record: 'resume' label: 'Resume queued work' detail: 'Allow dispatch' path: 'session.txt'].
    @ self record: 'back' label: 'Back' detail: 'Dismiss without stopping work' path: 'session.txt'
  ]

  rawClassMethod: messagesFor: session [
    local id
    for id in $(@ "$1" messageIds); do
      @ "$id" reload >/dev/null || return 1
      @ "$id" readText
      printf '\n----------------------------------------\n'
    done
  ]

  rawClassMethod: runDetails: run [
    local log
    @ "$1" reload >/dev/null || return 1
    @ "$1" asJson | jq 'del(.capabilityTokenHash)'
    for log in "$(@ "$1" outputLog)" "$(@ "$1" errorLog)"; do
      [[ -n "$log" && -f "$log" ]] || continue
      printf '\n--- %s (last 100 lines) ---\n' "$log"
      tail -n 100 "$log"
    done
  ]

  rawClassMethod: runRecordsFor: session in: dir [
    local run text
    for run in $(@ "$1" runs); do
      text=$(@ AgentBrowser runDetails: "$run")
      printf '%s\n' "$text" > "$2/$run.txt"
      @ AgentBrowser record: "$run" label: "$run [$(@ "$run" state)]" detail: "$(@ "$run" error)" path: "$run.txt"
    done
  ]

  classMethod: runsFor: session in: dir [
    | records run text |
    records := @ self runRecordsFor: session in: dir.
    run := @ self pick: records root: dir title: 'Session runs'.
    run isEmpty ifTrue: [^ 'dismissed'].
    text := @ self runDetails: run.
    ^ @ self page: text title: 'Run details and logs'
  ]

  rawClassMethod: retryRecordsFor: session in: dir [
    local d
    for d in $(@ "$1" stalledDeliveries); do
      @ "$d" reload >/dev/null || return 1
      @ "$d" asJson | jq . > "$2/$d.txt"
      @ AgentBrowser record: "$d" label: "$d [$(@ "$d" state)]" detail: "$(@ "$d" lastError)" path: "$d.txt"
    done
  ]

  classMethod: retryFor: session in: dir [
    | records delivery answer path ignored |
    records := @ self retryRecordsFor: session in: dir.
    delivery := @ self pick: records root: dir title: 'Choose delivery to retry'.
    delivery isEmpty ifTrue: [^ 'dismissed'].
    path := delivery , '.txt'.
    records := @ self record: 'retry' label: 'Retry this delivery' detail: 'Uncertain work may already have produced effects' path: path.
    answer := @ self pick: records root: dir title: 'Confirm retry (Esc cancels)'.
    (answer = 'retry') ifTrue: [
      ignored := @ session requeue: delivery.
      ignored := @ AgentWorker tickSession: session
    ]
  ]
