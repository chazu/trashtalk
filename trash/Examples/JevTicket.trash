# Minimal Jev example: three typed questions in one request, sent directly
# through OpenRouter::Jev. Examples::DecisionTicket asks the same questions
# through DecisionStage and any selected decision target.
package: Examples

JevTicket subclass: Object
  classMethod: assess: ticket [
    | questions |
    questions := @ Examples::DecisionTicket questions.
    ^ @ OpenRouter::Jev decide: ticket questions: questions
  ]
