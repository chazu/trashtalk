# Future runs a Bash/Trashtalk computation with combined output.
# Process and Tool own child lifetime, private files, and completion receipts.
Future subclass: Object
  instanceVars: command pid result_file status exit_code resultDirectory

  classMethod: for: command [
    | id directory |
    directory := (@ File tempDirectory) ifFailed: [:error | @ error signal].
    id := (@ self new) ifFailed: [:error | @ File removeEmptyDirectory: directory. @ error signal].
    (@ Runtime assign: (#{command: command resultDirectory: directory
      result_file: (directory , '/stdout.log') status: 'created'} asJson) to: id) ifFailed: [:error | @ File removeEmptyDirectory: directory. @ id delete. @ error signal].
    ^ id
  ]

  method: start [
    (status ~= 'created') ifTrue: [@ ProcessError signal: 'Future has already started'].
    pid := (@ Process launch: command in: resultDirectory combined: 'true') ifFailed: [:error | @ error signal].
    status := 'pending'.
    ^ pid
  ]

  method: await [
    (status = 'created') ifTrue: [@ ProcessError signal: 'Future has not started'].
    exit_code := (@ Process waitFor: pid in: resultDirectory) ifFailed: [:error | @ error signal].
    (status ~= 'cancelled') ifTrue: [
      status := 'failed'.
      (exit_code = '0') ifTrue: [status := 'completed']
    ].
    ^ @ File read: result_file
  ]

  alias: poll for: status

  # Shell predicate contract: isDone returns an exit status, not boolean text.
  rawMethod: isDone [
    local state
    state=$(@ "$_RECEIVER" status) || return
    [[ "$state" == completed || "$state" == failed || "$state" == cancelled ]]
  ]

  method: cancel [
    | current |
    current := (@ self status) ifFailed: [:error | @ error signal].
    (current ~= 'pending') ifTrue: [^ 'Already completed'].
    (@ Process signal: pid in: resultDirectory with: 'TERM') ifFailed: [:error | @ error signal].
    @ Time sleep: '0.1'.
    (@ Process signal: pid in: resultDirectory with: 'KILL') ifFailed: [:error | @ error signal].
    (@ self await) ifFailed: [:error | @ error signal].
    status := 'cancelled'.
    ^ 'Cancelled'
  ]

  method: status [
    (status = 'pending') ifTrue: [
      ((resultDirectory , '/exit') fileExists) ifTrue: [(@ self await) ifFailed: [:error | @ error signal] ] ifFalse: [
        ((@ Process alive: pid in: resultDirectory) = 'false') ifTrue: [(@ self await) ifFailed: [:error | @ error signal] ]
      ]
    ].
    ^ status
  ]

  method: exitCode [ ^ exit_code ]

  method: cleanup [
    (status = 'pending') ifTrue: [(@ self cancel) ifFailed: [:error | @ error signal] ].
    (@ Process cleanupDirectory: resultDirectory) ifFailed: [:error | @ error signal].
    @ self delete
  ]

  # Show help
  classMethod: help [
    ^ '''=== Future - Async Computation ===

Usage:
  future=$(@ Future for: 'command')   # Create future
  @ $future start                     # Start background process
  result=$(@ $future await)          # Get result

Class Methods:
  for: <command>  - Create future (stores command, does not start)

Instance Methods:
  start           - Start the background computation
  await           - Block until done, return result
  poll            - Check status without blocking
  isDone          - Returns 0 if done, 1 if pending
  cancel          - Kill the computation
  status          - Show status (created/pending/completed/failed/cancelled)
  exitCode        - Get exit code (empty if pending)
  cleanup         - Remove result files and delete future

Example:
  # Create future for expensive computation
  f=$(@ Future for: 'sleep 2 && echo done')
  @ $f start  # Start it
  
  # Do other work while it runs...
  @ SomeClass doOtherStuff
  
  # Get result (blocks if not ready)
  result=$(@ $f await)
  echo "Result: $result"
  @ $f cleanup'''
  ]
