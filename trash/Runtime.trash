# Runtime - Reflection and object lifecycle primitives
# Provides access to runtime context, object creation, and introspection
#
# Usage:
#   className := @ anObject class
#   id := @ Runtime generateId: 'Counter'
#   @ Runtime create: 'Counter' id: id
#
Runtime subclass: Object

  # ==========================================
  # Nested-send diagnostics (retained for compatibility)
  # ==========================================

  # These expose Runtime's own send, not the caller. Use self / @ self class
  # in DSL methods, or the dispatcher context directly at a raw boundary.
  # Runtime class returns Runtime.
  rawClassMethod: class [
    echo "$_CLASS"
  ]

  # Runtime instance is empty because this is a class send.
  rawClassMethod: instance [
    echo "$_INSTANCE"
  ]

  # Runtime receiver returns Runtime.
  rawClassMethod: receiver [
    echo "$_RECEIVER"
  ]

  # Runtime selector returns the selector of this diagnostic send.
  rawClassMethod: selector [
    echo "$_SELECTOR"
  ]

  # ==========================================
  # Object Lifecycle
  # ==========================================

  # Generate a unique instance ID for a class
  # Usage: id := @ Runtime generateId: 'Counter'
  classPrimitive: generateId: className calls: _generate_instance_id

  # Create an instance with a given ID and persist its initial defaults
  # Usage: @ Runtime create: 'Counter' id: 'counter_abc123'
  classPrimitive: create: className id: instanceId calls: _create_instance

  # Delete the session cache entry; retain the Store record
  # Usage: @ Runtime delete: instanceId
  classPrimitive: delete: instanceId calls: _delete_instance

  # ==========================================
  # Instance Data Access
  # ==========================================

  # Get instance data as JSON
  # Usage: json := @ Runtime dataFor: instanceId
  # Auto-loads from Store if not in memory, with lazy schema migration
  rawClassMethod: dataFor: instanceId [
    _ensure_loaded "$1"
    _env_get "$1"
  ]

  # Batch Store I/O is a runtime boundary. Overlay the session's live data and
  # use the same lazy migration as dataFor: for objects not already loaded.
  # The DSL receives an ordinary JSON object keyed by instance ID.
  rawClassMethod: dataForClass: className [
    local escaped rows id data
    escaped=$(_db_escape "$1")
    # IDs cannot contain '|'; read assigns the whole remaining JSON to data.
    # Use a printable separator: sqlite CLIs can escape control characters.
    rows=$(_db_sql "SELECT id || '|' || json(data) FROM instances WHERE class = '$escaped';") || return
    local snapshot
    snapshot=$(
      while IFS='|' read -r id data; do
        [[ -n "$id" ]] || continue
        _db_validate_id "$id" || return 1
        if _env_exists "$id"; then
          data=$(_env_get "$id")
        else
          data=$(_migrate_instance_schema "$data") || return
          _env_set "$id" "$data" || return
        fi
        printf '{"id":"%s","data":%s}\n' "$id" "$data"
      done <<< "$rows"
    ) || return
    printf '%s' "$snapshot" | jq -cs 'map({key:.id,value:.data}) | from_entries'
  ]

  # Batch equivalent of Persistable.reload: discard cached changes, read only
  # the requested ids in order, and install the exact persisted JSON in cache.
  rawClassMethod: reloadDataFor: instances [
    local ids rows id data
    ids=$(printf '%s' "$1" | jq -Rsc 'split("\n") | map(select(length>0))') || return
    ids=$(_db_escape "$ids")
    rows=$(_db_sql "SELECT i.id || '|' || json(i.data) FROM json_each('$ids') requested
      JOIN instances i ON i.id=requested.value ORDER BY CAST(requested.key AS INTEGER);") || return
    while IFS='|' read -r id data; do
      [[ -n "$id" ]] || continue
      _db_validate_id "$id" || return 1
      _env_set "$id" "$data" || return
      printf '{"id":"%s","data":%s}\n' "$id" "$data"
    done <<< "$rows"
  ]

  # Assign properties through their public setters. Exact generated setters
  # without advice share one cache update; custom behavior retains send order.
  classPrimitive: assign: fields to: instanceId calls: _trash_assign_fields

  # Set session-cache data from JSON (does not save to Store)
  # Usage: @ Runtime setData: '{"value":42}' for: instanceId
  rawClassMethod: setData: json for: instanceId [
    _env_set "$2" "$1"
  ]

  # Get an instance variable value
  # Usage: value := @ Runtime ivar: 'count' of: instanceId
  rawClassMethod: ivar: varName of: instanceId [
    local data value
    data=$(_env_get "$2")
    echo "$data" | jq -r --arg k "$1" '.[$k] // empty'
  ]

  # Set an instance variable value
  # Usage: @ Runtime ivar: 'count' of: instanceId set: 42
  rawClassMethod: ivar: varName of: instanceId set: value [
    local data
    data=$(_env_get "$2")
    data=$(echo "$data" | jq -c --arg k "$1" --arg v "$3" '.[$k] = $v')
    _env_set "$2" "$data"
  ]

  # ==========================================
  # Introspection
  # ==========================================

  # Get class name from an instance ID
  # Usage: class := @ Runtime classFor: instanceId
  classPrimitive: classFor: instanceId calls: _get_instance_class

  # Class existence loads current metadata without constructing an object.
  classPrimitive: superclassOf: className calls: _trash_superclass_of
  classPrimitive: classExists: className calls: _trash_class_exists

  # Sorted compiled selector names, including direct traits and methods declared by ancestors.
  # Class methods have the class__ prefix; keyword selectors end in underscore.
  classPrimitive: methodsFor: className calls: _trash_methods_json
  classPrimitive: methodsFor: className matching: pattern calls: _trash_methods_json
  classPrimitive: class: className hasMethod: methodName calls: _trash_has_method

  # ==========================================
  # Call Stack
  # ==========================================

  # Get current call depth
  rawClassMethod: callDepth [
    echo "${_CALL_DEPTH:-0}"
  ]

  # Get call stack as JSON array
  rawClassMethod: callStack [
    local stack="[]"
    local i
    for ((i=0; i<${#_CALL_STACK[@]}; i++)); do
      stack=$(echo "$stack" | jq -c --arg s "${_CALL_STACK[$i]}" '. + [$s]')
    done
    echo "$stack"
  ]

  # Print stack trace to stderr
  classPrimitive: printStackTrace calls: _print_stack_trace
