package: Gmail

# No Gmail writes. Return one proposal with both model receipts per message.
Review subclass: Object
  classMethod: assess: message [
    | target |
    target := (@ Decision::Target selected) ifFailed: [:error | ^ @ Decision::Request failure: error].
    ^ @ self assess: message using: target
  ]

  classMethod: assess: message using: target [
    | category context attention review |
    message := (@ Gmail::Client fit: message to: target) ifFailed: [:error | ^ @ Decision::Request failure: error].
    category := (@ Gmail::Categorizer decide: message using: target) ifFailed: [:error | ^ @ self assess: message shrinking: target after: error].
    context := #{email: (message jsonValue) categorization: ((category jsonAt: 'value') jsonValue)} asJson.
    attention := (@ Gmail::Attention decide: context using: target) ifFailed: [:error | ^ @ self assess: message shrinking: target after: error].
    review := category jsonAt: 'value.reviewNeeded'.
    ((attention jsonTextAt: 'value.suggestion') = 'review_uncertain') ifTrue: [review := 'true'].
    ((@ Gmail::Client isPartial: message) = 'true') ifTrue: [review := 'true'].
    ^ #{reviewNeeded: (review jsonValue) messageId: (message jsonTextAt: 'id') subject: (message jsonTextAt: 'subject')
        sender: (message jsonTextAt: 'from') bodySource: (message jsonTextAt: 'bodySource')
        truncated: ((message jsonAt: 'truncated') jsonValue)
        category: (category jsonValue) attention: (attention jsonValue)} asJson
  ]

  # A context overflow in either stage reruns both with a shorter body.
  classMethod: assess: message shrinking: target after: error [
    | smaller |
    smaller := (@ Decision::Target shrink: target after: error) ifFailed: [:ignored | ^ @ Decision::Request failure: error].
    ^ @ self assess: message using: smaller
  ]

  classMethod: assessMessage: messageId [
    | message |
    message := (@ Gmail::Client message: messageId) ifFailed: [:error | ^ @ Decision::Request failure: error].
    ^ @ self assess: message
  ]

  # Streaming JSONL keeps bounded reviews inspectable without persisted objects.
  classMethod: preview: query limit: limit [
    pragma: stream
    | listing rows target message assessment |
    listing := (@ Gmail::Client search: query limit: limit) ifFailed: [:error | ^ @ Decision::Request failure: error].
    rows := listing jsonAt: 'messages' ifAbsent: '[]'.
    target := (@ Decision::Target selected) ifFailed: [:error | ^ @ Decision::Request failure: error].
    target := (@ Decision::Target requireReady: target) ifFailed: [:error | ^ @ Decision::Request failure: error].
    rows jsonRows: #('id') into: [:id |
      message := (@ Gmail::Client message: id) ifFailed: [:error | ^ @ Decision::Request failure: error].
      assessment := (@ self assess: message using: target) ifFailed: [:error | ^ @ Decision::Request failure: error].
      @ Console print: assessment
    ]
  ]
