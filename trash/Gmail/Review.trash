package: Gmail

# No Gmail writes. Return one proposal with both model receipts per message.
Review subclass: Object
  classMethod: assess: message [
    | target |
    target := (@ Decision::Target selected) ifFailed: [:error | @ error signal].
    ^ @ self assess: message using: target
  ]

  classMethod: assess: message using: target [
    | category context attention review |
    category := (@ Gmail::Categorizer decide: message using: target) ifFailed: [:error | @ error signal].
    context := #{email: (message jsonValue) categorization: ((category jsonAt: 'value') jsonValue)} asJson.
    attention := (@ Gmail::Attention decide: context using: target) ifFailed: [:error | @ error signal].
    review := category jsonAt: 'value.reviewNeeded'.
    ((attention jsonTextAt: 'value.suggestion') = 'review_uncertain') ifTrue: [review := 'true'].
    ((message jsonTextAt: 'bodySource') = 'snippet') ifTrue: [review := 'true'].
    ((message jsonAt: 'truncated') = 'true') ifTrue: [review := 'true'].
    ^ #{reviewNeeded: (review jsonValue) messageId: (message jsonTextAt: 'id') subject: (message jsonTextAt: 'subject')
        sender: (message jsonTextAt: 'from') bodySource: (message jsonTextAt: 'bodySource')
        truncated: ((message jsonAt: 'truncated') jsonValue)
        category: (category jsonValue) attention: (attention jsonValue)} asJson
  ]

  classMethod: assessMessage: messageId [
    | message |
    message := (@ Gmail::Client message: messageId) ifFailed: [:error | @ error signal].
    ^ @ self assess: message
  ]

  # Streaming JSONL keeps bounded reviews inspectable without persisted objects.
  classMethod: preview: query limit: limit [
    pragma: stream
    | listing rows target message |
    listing := (@ Gmail::Client search: query limit: limit) ifFailed: [:error | @ error signal].
    rows := listing jsonAt: 'messages' ifAbsent: '[]'.
    target := (@ Decision::Target selected) ifFailed: [:error | @ error signal].
    rows jsonRows: #('id') into: [:id |
      message := (@ Gmail::Client message: id) ifFailed: [:error | @ error signal].
      (@ self assess: message using: target) ifFailed: [:error | @ error signal]
    ]
  ]
