# Human-view authority uses fresh guarded projections, never cached objects.
# Ordinary transaction validators remain available inside domain mutations.
AgentAccess subclass: Object
  classMethod: identity: identity [
    ^ @ self check: identity kind: 'identity'
  ]

  classMethod: session: session [
    ^ @ self check: session kind: 'session'
  ]

  classMethod: liveSession: session [
    ^ @ self check: session kind: 'live'
  ]

  classMethod: check: id kind: kind [
    | query |
    query := @ self snapshotQueryFor: id kind: kind.
    ^ @ Store validateSnapshot: query using: self sending: 'validateSnapshot:'
  ]

  # SQL projection boundary. Identity, session and membership values are read
  # together, and Store checks this exact projection again before returning.
  rawClassMethod: snapshotQueryFor: id kind: kind [
    local id kind has_members members="json('{}')"
    id=$(_db_escape "$1"); kind=$(_db_escape "$2")
    if [[ "$2" == identity ]]; then
      printf "SELECT json_object('kind','identity','id',i.id,'identity',json(i.data),'session',json('{}'),'members',json('{}')) FROM instances i WHERE i.id='%s'" "$id"
    else
      if [[ "$2" == live ]]; then
        # Legacy revision-zero sessions predate this table. Inspecting them must
        # neither create a schema nor require a membership they never had.
        has_members=$(_db_sql "SELECT EXISTS(SELECT 1 FROM sqlite_master WHERE type='table' AND name='agent_session_memberships');") || return
      fi
      if [[ "$2" == live && "$has_members" == 1 ]]; then
        members="json(coalesce((SELECT json_group_object(scope_key,json_object('session',session_id,'revision',policy_revision)) FROM
          (SELECT scope_key,session_id,policy_revision FROM agent_session_memberships WHERE identity_id=i.id ORDER BY scope_key)),'{}'))"
      fi
      printf "SELECT json_object('kind','%s','id',s.id,'identityId',i.id,'identity',json(coalesce(i.data,'{}')),'session',json(s.data),'members',%s) FROM instances s LEFT JOIN instances i ON i.id=json_extract(s.data,'$.identity') WHERE s.id='%s'" "$kind" "$members" "$id"
    fi
  ]

  # Normalize optional legacy fields once; strict text conversion preserves the
  # existing getter convention for booleans and missing/null fields.
  rawClassMethod: snapshotFields: data [
    printf '%s' "$1" | jq -ce '
      def scalar: if .==null or .==false then "" elif type=="string" then sub("\n+$";"") else tostring end;
      {id:.id,identityId:(.identityId // .id),kind:.kind,
        identityClass:(.identity.class|scalar),owner:(.identity.owner|scalar),enabled:(.identity.enabled|scalar),
        revision:(.identity.sessionPolicyRevision // 0 | scalar),scope:(.identity.sessionScope|scalar),
        sessionClass:(.session.class|scalar),state:(.session.lifecycleState|scalar),
        sessionRevision:(.session.sessionPolicyRevision|scalar),workspace:(.session.workspace|scalar),members:.members}'
  ]

  classMethod: validateSnapshot: snapshot [
    | fields human current key member memberRevision |
    @ Store requireSnapshot.
    human := @ AgentFocus human.
    fields := @ self snapshotFields: snapshot.
    fields jsonUnpack: #('id' 'identityId' 'kind' 'identityClass' 'owner' 'enabled' 'revision'
      'scope' 'sessionClass' 'state' 'sessionRevision' 'workspace' 'members')
      into: [:id :identityId :kind :identityClass :owner :enabled :revision
        :scope :sessionClass :state :sessionRevision :workspace :members |
      @ Require equal: identityClass to: 'AgentIdentity'.
      @ Require text: owner.
      @ Require equal: owner to: human.
      @ Require equal: enabled to: 'true'.
      (kind ~= 'identity') ifTrue: [@ Require equal: sessionClass to: 'AgentSession'].
      (kind = 'live') ifTrue: [
        @ Require member: state of: '["open","paused"]'.
        (revision > 0) ifTrue: [
          @ Require equal: sessionRevision to: revision.
          @ Require member: scope of: '["workspace","identity"]'.
          key := ''.
          (scope = 'workspace') ifTrue: [key := @ AgentSession workspaceFor: workspace].
          member := members objectAt: key.
          member jsonUnpack: #('session' 'revision') into: [:current :memberRevision |
            @ Require equal: current to: id.
            @ Require equal: memberRevision to: revision
          ]
        ]
      ].
      # Match ordinary guarded reads: subsequent sends cannot use stale cached
      # lifecycle/identity fields. This discards derived cache entries only.
      @ Runtime delete: identityId.
      (kind ~= 'identity') ifTrue: [@ Runtime delete: id].
      ^ id
    ]
  ]

  classMethod: validateIdentity: identity [
    | current human owner enabled |
    @ Store requireTransaction.
    human := @ AgentFocus human.
    current := @ Store read: identity class: 'AgentIdentity'.
    owner := @ current owner.
    @ Require text: owner.
    @ Require equal: owner to: human.
    enabled := @ current enabled.
    @ Require equal: enabled to: 'true'.
    ^ current
  ]

  classMethod: validateSession: session [
    | current identity |
    @ Store requireTransaction.
    current := @ Store read: session class: 'AgentSession'.
    identity := @ current identity.
    identity := @ self validateIdentity: identity.
    ^ current
  ]

  classMethod: validateLiveSession: session [
    | current state |
    @ Store requireTransaction.
    current := @ self validateSession: session.
    state := @ current lifecycleState.
    @ Require member: state of: '["open","paused"]'.
    @ AgentSession requireCurrentWithin: current.
    ^ current
  ]
