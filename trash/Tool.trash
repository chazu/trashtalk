# Tool - Abstract base class for wrapping external command-line tools
# Provides detection, installation, and execution of external programs
# Built on Shell primitives - no raw bash required.
#
# Tool subclasses are singletons - use class methods directly:
#   @ JqTool ensure
#   @ JqTool run: '.foo'
#
# Subclass example:
#   JqTool subclass: Tool
#     classMethod: name [ ^ "jq" ]
#     classMethod: installCommand [ ^ "brew install jq" ]
#
Tool subclass: Object

  # Override in subclasses to return the command name
  classMethod: name [
    ^ ""
  ]

  # Override in subclasses to return the install command
  # e.g., "brew install jq" or "apt-get install -y jq"
  rawClassMethod: installCommand [
    echo ""
  ]

  # Check if the tool is installed and on PATH
  classMethod: isInstalled [
    | toolPath |
    toolPath := @ self path.
    ^ toolPath notEmpty
  ]

  # Get the path to the tool executable
  classMethod: path [
    | toolName |
    toolName := @ self name.
    ^ @ Env which: toolName
  ]

  # Get the version of the tool (override for tool-specific parsing)
  rawClassMethod: version [
    local toolName toolPath versionCmd result
    toolName=$(@ "$_RECEIVER" name)
    toolPath=$(@ "$_RECEIVER" path)

    if [[ -z "$toolPath" ]]; then
      echo "not installed"
      return
    fi

    # Try --version first
    versionCmd="${toolPath} --version 2>/dev/null | head -1"
    result=$(@ Shell exec: "$versionCmd")
    if [[ -n "$result" ]]; then echo "$result"; return; fi

    # Try -version
    versionCmd="${toolPath} -version 2>/dev/null | head -1"
    result=$(@ Shell exec: "$versionCmd")
    if [[ -n "$result" ]]; then echo "$result"; return; fi

    # Try -V
    versionCmd="${toolPath} -V 2>/dev/null | head -1"
    result=$(@ Shell exec: "$versionCmd")
    if [[ -n "$result" ]]; then echo "$result"; return; fi

    echo "unknown"
  ]

  # Install the tool - override in subclasses for custom behavior
  rawClassMethod: install [
    local installCmd toolName
    installCmd=$(@ "$_RECEIVER" installCommand)
    toolName=$(@ "$_RECEIVER" name)

    if [[ -z "$installCmd" ]]; then
      _throw "InstallError" "No install command defined for $toolName"
      echo ""
      return
    fi

    @ Console print: "Installing $toolName..."

    if @ Shell succeeds: "$installCmd"; then
      @ Console print: "Successfully installed $toolName"
      echo "true"
    else
      _throw "InstallError" "Failed to install $toolName"
      echo ""
    fi
  ]

  # Ensure the tool is installed and available
  # - Checks if installed
  # - Installs if not
  # - Verifies it's on PATH after install
  # Returns: "true" on success, throws error on failure
  rawClassMethod: ensure [
    local toolName isInstalledVal
    toolName=$(@ "$_RECEIVER" name)

    if [[ -z "$toolName" ]]; then
      _throw "ToolError" "Tool name not set"
      echo ""
      return
    fi

    # Check if already installed
    isInstalledVal=$(@ "$_RECEIVER" isInstalled)
    if [[ "$isInstalledVal" == "true" ]]; then
      echo "true"
      return
    fi

    # Try to install
    @ Console error: "$toolName not found, attempting install..."
    @ "$_RECEIVER" install

    # Refresh command hash table
    @ Shell silent: "hash -r"

    # Verify installation succeeded
    isInstalledVal=$(@ "$_RECEIVER" isInstalled)
    if [[ "$isInstalledVal" == "true" ]]; then
      echo "true"
    else
      _throw "PathError" "$toolName installed but not found on PATH"
      echo ""
    fi
  ]

  # Run the tool with arguments (synchronous)
  rawClassMethod: run: args [
    local args="$1" toolName toolPath runCmd
    toolName=$(@ "$_RECEIVER" name)
    toolPath=$(@ "$_RECEIVER" path)

    if [[ -z "$toolPath" ]]; then
      _throw "ToolError" "$toolName is not installed"
      echo ""
      return
    fi

    runCmd="${toolPath} ${args}"
    @ Shell exec: "$runCmd"
  ]

  # Run the tool with arguments, capturing stdout and stderr
  rawClassMethod: runCapture: args [
    local args="$1" toolName toolPath runCmd
    toolName=$(@ "$_RECEIVER" name)
    toolPath=$(@ "$_RECEIVER" path)

    if [[ -z "$toolPath" ]]; then
      _throw "ToolError" "$toolName is not installed"
      echo ""
      return
    fi

    runCmd="${toolPath} ${args}"
    @ Shell execAll: "$runCmd"
  ]

  # Execute an exact argv vector represented as JSON. The DSL builds the typed
  # request; the raw primitive below owns only JSON decoding, stdin, and exec.
  classMethod: runArgvJson: argvJson [
    | request requestJson |
    request := #{argv: (argvJson jsonValue)} asJson.
    requestJson := request.
    ^ @ self runProcessRequestJson: requestJson
  ]

  classMethod: runArgvJson: argvJson input: input [
    | request requestJson |
    request := #{argv: (argvJson jsonValue) stdin: input} asJson.
    requestJson := request.
    ^ @ self runProcessRequestJson: requestJson
  ]

  # Execute exact argv while returning stdout, stderr, and the original child
  # status in a versioned JSON envelope. Capturing is a reusable process
  # concern; tool-specific exit interpretation remains in each wrapper's DSL.
  classMethod: captureArgvJson: argvJson [
    | request requestJson |
    request := #{argv: (argvJson jsonValue) capture: true} asJson.
    requestJson := request.
    ^ @ self runProcessRequestJson: requestJson
  ]

  classMethod: captureArgvJson: argvJson input: input [
    | request requestJson |
    request := #{argv: (argvJson jsonValue) stdin: input capture: true} asJson.
    requestJson := request.
    ^ @ self runProcessRequestJson: requestJson
  ]

  classMethod: captureArgvJson: argvJson input: input progress: label [
    | request |
    request := #{argv: (argvJson jsonValue) stdin: input capture: true progress: label} asJson.
    ^ @ self runProcessRequestJson: request
  ]

  rawClassMethod: runProcessRequestJson: requestJson [
    pragma: direct
    local request_json="$1" status stdout_file stderr_file progress
    local -a argv

    if ! printf '%s' "$request_json" | jq -e '
      type == "object" and
      (.argv | type == "array" and all(.[]; type == "string" and (contains("\u0000") | not))) and
      (.stdin == null or (.stdin | type == "string")) and
      (.capture == null or (.capture | type == "boolean")) and
      (.progress == null or (.progress | type == "string"))
    ' >/dev/null; then
      _throw "ToolError" "Invalid process request JSON"
      return 1
    fi

    mapfile -d '' -t argv < <(
      printf '%s' "$request_json" | jq -jr '.argv[] | ., "\u0000"'
    )
    if [[ ${#argv[@]} -eq 0 ]]; then
      _throw "ToolError" "Invalid or empty argv JSON"
      return 1
    fi

    if printf '%s' "$request_json" | jq -e '.capture == true' >/dev/null; then
      progress=$(printf '%s' "$request_json" | jq -r '.progress // empty')
      stdout_file=$(mktemp "${TMPDIR:-/tmp}/trash-process-stdout.XXXXXX")
      stderr_file=$(mktemp "${TMPDIR:-/tmp}/trash-process-stderr.XXXXXX")
      if printf '%s' "$request_json" | jq -e '.stdin != null' >/dev/null; then
        printf '%s' "$request_json" | jq -jr '.stdin' | \
          _trash_with_progress "$progress" "${argv[@]}" >"$stdout_file" 2>"$stderr_file"
        # The pipeline is printf | jq | child, so the child is entry 2.
        status=${PIPESTATUS[2]}
      else
        _trash_with_progress "$progress" "${argv[@]}" >"$stdout_file" 2>"$stderr_file"
        status=$?
      fi
      jq -cn --argjson exit_code "$status" \
        --rawfile stdout "$stdout_file" --rawfile stderr "$stderr_file" \
        '{schema_version:1,exit_code:$exit_code,stdout:$stdout,stderr:$stderr}'
      rm -f "$stdout_file" "$stderr_file"
      return 0
    fi

    if printf '%s' "$request_json" | jq -e '.stdin != null' >/dev/null; then
      printf '%s' "$request_json" | jq -jr '.stdin' | "${argv[@]}"
      # The pipeline is printf | jq | child, so preserve the child's status.
      status=${PIPESTATUS[2]}
      return "$status"
    fi
    "${argv[@]}"
  ]

  # Run the tool asynchronously, returning a Future
  rawClassMethod: runAsync: args [
    local args="$1" toolName toolPath futureCmd
    toolName=$(@ "$_RECEIVER" name)
    toolPath=$(@ "$_RECEIVER" path)

    if [[ -z "$toolPath" ]]; then
      _throw "ToolError" "$toolName is not installed"
      echo ""
      return
    fi

    futureCmd="${toolPath} ${args}"
    @ Future value: "$futureCmd"
  ]

  # Check if a command exists on the system (utility method)
  rawClassMethod: commandExists: commandName [
    local commandName="$1" checkCmd
    checkCmd="command -v ${commandName}"
    @ Shell succeeds: "$checkCmd"
  ]

  # ---------------------------------------------------------------------------
  # Typed result helpers for exact-argv wrappers (see Tools::Cue, Tools::Mise).
  # A tool result is a versioned JSON envelope:
  #   {schema_version, tool, command, outcome, exit_code, stdout, stderr}
  # outcome is 'success' for exit 0, 'missing_tool' for exit 127, and the
  # wrapper-supplied failureOutcome for any other status.
  # ---------------------------------------------------------------------------

  # Base argv: the resolved executable path as a one-element JSON array.
  classMethod: baseArgv [
    | toolPath argv |
    toolPath := @ self path.
    argv := #(toolPath) asJson.
    ^ argv
  ]

  # Append values to a JSON argv. `values` is either a JSON array, whose
  # elements are appended one by one, or a plain string appended as one entry.
  # An empty string appends nothing.
  classMethod: argv: argv appendEach: values [
    | isArray isJson |
    values isEmpty ifTrue: [^ argv].
    isArray := @ String startsWith: values prefix: '['.
    (isArray = 'true') ifTrue: [
      isJson := @ String isJson: values.
      (isJson = 'true') ifTrue: [
        values arrayEach: [:entry | argv := argv arrayPush: entry].
        ^ argv
      ]
    ].
    ^ argv arrayPush: values
  ]

  # Result for a tool that is not on PATH. Never installs anything.
  classMethod: missingToolResult: command [
    | toolName installHint guidance result |
    toolName := @ self name.
    installHint := @ self installCommand.
    guidance := toolName , ' is not installed.'.
    installHint notEmpty ifTrue: [
      guidance := guidance , ' Install it with: '.
      guidance := guidance , installHint
    ].
    result := #{schema_version: 1 tool: toolName command: command outcome: 'missing_tool'
                exit_code: 127 stdout: '' stderr: guidance} asJson.
    ^ result
  ]

  # Normalize a captureArgvJson: envelope into a tool result.
  classMethod: resultFrom: capture command: command failureOutcome: failureOutcome [
    | toolName outcome result |
    toolName := @ self name.
    capture jsonUnpack: #('exit_code' 'stdout' 'stderr') into: [:exitCode :stdout :stderr |
      outcome := failureOutcome.
      (exitCode = '0') ifTrue: [outcome := 'success'].
      (exitCode = '127') ifTrue: [outcome := 'missing_tool'].
      result := #{schema_version: 1 tool: toolName command: command outcome: outcome
                  exit_code: (exitCode jsonValue) stdout: stdout stderr: stderr} asJson.
      ^ result
    ]
  ]

  # Run exact argv and return a normalized tool result.
  classMethod: resultForArgv: argv command: command failureOutcome: failureOutcome [
    | capture |
    capture := @ self captureArgvJson: argv.
    ^ @ self resultFrom: capture command: command failureOutcome: failureOutcome
  ]

  classMethod: resultForArgv: argv input: input command: command failureOutcome: failureOutcome [
    | capture |
    capture := @ self captureArgvJson: argv input: input.
    ^ @ self resultFrom: capture command: command failureOutcome: failureOutcome
  ]

  # Convenience projection: stdout of a successful result. On failure the
  # diagnostic goes to Console error and the projection is empty.
  classMethod: stdoutOf: result [
    | outcome stdout stderr |
    outcome := result jsonTextAt: 'outcome'.
    (outcome = 'success') ifTrue: [
      stdout := result jsonTextAt: 'stdout'.
      ^ stdout
    ].
    stderr := result jsonTextAt: 'stderr'.
    stderr notEmpty ifTrue: [@ Console error: stderr].
    ^ ''
  ]

  # 'true' when a result succeeded, 'false' otherwise.
  classMethod: succeeded: result [
    | outcome |
    outcome := result jsonTextAt: 'outcome'.
    (outcome = 'success') ifTrue: [^ 'true'].
    ^ 'false'
  ]
