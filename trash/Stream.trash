# Stream - Cross-process durable streams via Honker
# Unlike EventBus (ephemeral, fire-and-forget), Stream provides durable
# messages with consumer offset tracking. Messages survive crashes and
# consumers can replay from any offset.
#
# Two separate trashtalk programs sharing the same SQLITE_JSON_DB can
# communicate through streams without any additional IPC mechanism.
#
# Usage:
#   # Producer (process A)
#   producer=$(@ Stream named: 'metrics')
#   @ $producer publish: '{"cpu":42}'
#
#   # Consumer (process B)
#   consumer=$(@ Stream named: 'metrics' consumer: 'dashboard')
#   msgs=$(@ $consumer read)
#   @ $consumer ack: 5
#
#   # Continuous consumption
#   @ $consumer consumeDo: $handlerBlock
#   @ $consumer stopConsuming

Stream subclass: Object
  include: Debuggable
  instanceVars: streamName:'' consumerName:'' readerPid:''

  # Create a stream (producer end — no consumer tracking).
  classMethod: named: name [
    ^ @ self named: name consumer: ''
  ]

  # Create a stream consumer (reader end — tracks offsets). Names are stored
  # through Store so another process can find and reuse the handle; plain
  # setters would only cache them in this session.
  classMethod: named: name consumer: consumer [
    | id fields |
    id := (@ Stream new) ifFailed: [:error | @ error signal].
    fields := #{streamName: name consumerName: consumer readerPid: ''} asJson.
    (@ Store patch: id with: fields) ifFailed: [:error | @ error signal].
    ^ id
  ]

  # Find or create the durable producer handle for a stream name, so repeated
  # publishes from short-lived processes do not each store a new row.
  classMethod: producerNamed: name [
    name isEmpty ifTrue: [@ StreamError signal: 'Stream producerNamed: requires a stream name'].
    ^ @ self handleNamed: name consumer: ''
  ]

  # Find or create the durable consumer handle for one (stream, consumer)
  # pair, as Inbox named: does. Honker owns the offset; the instance is only a
  # reusable handle, so callers must not create and delete one per read.
  classMethod: consumerNamed: name consumer: consumer [
    (name isEmpty or: [consumer isEmpty]) ifTrue: [@ StreamError signal: 'Stream consumerNamed:consumer: requires a stream and consumer name'].
    ^ @ self handleNamed: name consumer: consumer
  ]

  # Shared lookup for the named handles above; an empty consumer is a producer.
  classMethod: handleNamed: name consumer: consumer [
    | filter existing |
    filter := #{streamName: name consumerName: consumer} asJson.
    existing := (@ Store findByClass: 'Stream' matching: filter orderBy: 'created_at ASC, id ASC' limit: 1) ifFailed: [:error | @ error signal].
    existing notEmpty ifTrue: [^ existing].
    ^ @ Stream named: name consumer: consumer
  ]

  # Publish a message to the stream
  method: publish: data [
    ^ @ self publish: data key: 'default'
  ]

  # Publish with an explicit key (for partitioning/filtering)
  rawMethod: publish: data key: key [
    local stream
    stream=$(_ivar streamName)
    honker_stream_publish "$stream" "$2" "$1"
  ]

  # Read up to 10 messages from the stream (uses consumer offset if set)
  method: read [
    ^ @ self read: 10
  ]

  # Read with explicit batch size
  rawMethod: read: batchSize [
    local stream consumer offset
    stream=$(_ivar streamName)
    consumer=$(_ivar consumerName)
    if [[ -n "$consumer" ]]; then
      offset=$(honker_stream_get_offset "$consumer" "$stream" 2>/dev/null)
      offset="${offset:-0}"
    else
      offset=0
    fi
    honker_stream_read "$stream" "$offset" "$1"
  ]

  # Read from a specific offset
  rawMethod: readFrom: offset limit: n [
    local stream
    stream=$(_ivar streamName)
    honker_stream_read "$stream" "$1" "$2"
  ]

  # Acknowledge processing up to an offset (advances consumer position)
  rawMethod: ack: offset [
    local stream consumer
    stream=$(_ivar streamName)
    consumer=$(_ivar consumerName)
    [[ -n "$consumer" ]] && honker_stream_save_offset "$consumer" "$stream" "$1"
  ]

  # Get the current consumer offset
  rawMethod: offset [
    local stream consumer
    stream=$(_ivar streamName)
    consumer=$(_ivar consumerName)
    if [[ -n "$consumer" ]]; then
      honker_stream_get_offset "$consumer" "$stream"
    else
      echo "0"
    fi
  ]

  # Start continuous background consumption with a handler block
  # The handler receives each message payload via valueWith:
  rawMethod: consumeDo: handler [
    pragma: direct
    @ "$_RECEIVER" _consume: "$1" with: 'block'
  ]

  # Start consumption with a raw bash callback function (simpler than blocks)
  rawMethod: consumeWith: callbackFn [
    pragma: direct
    @ "$_RECEIVER" _consume: "$1" with: 'function'
  ]

  # Shared background loop for consumeDo: (a Block, stderr discarded) and
  # consumeWith: (a Bash function name). Offsets advance after each message.
  rawMethod: _consume: target with: kind [
    pragma: direct
    local stream consumer
    stream=$(_ivar streamName)
    consumer=$(_ivar consumerName)

    if [[ -z "$consumer" ]]; then
      echo "ERROR: Stream consumption requires a consumer name (use named:consumer: to create)" >&2
      return 1
    fi

    (
      while true; do
        local offset messages
        offset=$(honker_stream_get_offset "$consumer" "$stream" 2>/dev/null)
        offset="${offset:-0}"
        messages=$(honker_stream_read "$stream" "$offset" 10)

        if [[ -n "$messages" && "$messages" != "[]" && "$messages" != "null" ]]; then
          echo "$messages" | jq -c '.[]' 2>/dev/null | while IFS= read -r msg; do
            local payload msg_offset
            payload=$(echo "$msg" | jq -r '.payload // empty' 2>/dev/null)
            msg_offset=$(echo "$msg" | jq -r '.offset // .id // empty' 2>/dev/null)

            if [[ -n "$payload" ]]; then
              if [[ "$kind" == block ]]; then
                @ "$target" valueWith: "$payload" 2>/dev/null
              else
                "$target" "$payload"
              fi
            fi

            if [[ -n "$msg_offset" ]]; then
              honker_stream_save_offset "$consumer" "$stream" "$msg_offset"
            fi
          done
        else
          sleep 0.05
        fi
      done
    ) &

    _ivar_set readerPid "$!"
  ]

  # Stop continuous consumption
  rawMethod: stopConsuming [
    pragma: direct
    local pid
    pid=$(_ivar readerPid)
    if [[ -n "$pid" ]]; then
      kill "$pid" 2>/dev/null
      wait "$pid" 2>/dev/null
      _ivar_set readerPid ""
    fi
  ]

  # Check if the consumer loop is running
  rawMethod: isConsuming [
    local pid
    pid=$(_ivar readerPid)
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
      echo "true"
    else
      echo "false"
    fi
  ]

  # Remove the stored handle as well as this session's cached copy.
  rawMethod: destroy [
    @ "$_RECEIVER" stopConsuming
    @ Store deleteInstance: "$_INSTANCE" || return 1
    @ Runtime delete: "$_INSTANCE"
  ]

  classMethod: help [
    ^ '''=== Stream - Durable Cross-Process Streams ===

Producer:
  s=$(@ Stream named: 'metrics')
  @ $s publish: '{"cpu":42}'
  @ $s publish: '{"cpu":42}' key: 'host1'

Consumer:
  c=$(@ Stream named: 'metrics' consumer: 'dashboard')
  msgs=$(@ $c read)
  @ $c ack: 5
  @ $c offset

Continuous consumption:
  @ $c consumeDo: $handlerBlock
  @ $c consumeWith: 'my_callback_fn'
  @ $c stopConsuming
  @ $c isConsuming'''
  ]

  # Honker-owned consumer registration is atomic and insert-only. From-now is
  # the high-water mark at first registration, even when the stream is empty.
  # No domain event/cursor table or receipt payload is accessed here.
  rawMethod: initializeFrom: position [
    local stream consumer start
    [[ -z ${_STORE_TX:-} ]] || { _throw TransactionError 'Initialize Stream outside Store transactions'; return 1; }
    case "$1" in 'from-start') start=0;; 'from-now') start="coalesce((SELECT max(offset) FROM _honker_stream WHERE topic='%s'),0)";; *) return 1;; esac
    stream=$(_db_escape "$(_ivar streamName)")
    consumer=$(_db_escape "$(_ivar consumerName)")
    [[ -n "$consumer" ]] || return 1
    [[ "$1" != 'from-now' ]] || printf -v start "$start" "$stream"
    honker_bootstrap || return 1
    _db_sql -bail "BEGIN IMMEDIATE; INSERT OR IGNORE INTO _honker_stream_consumers(name,topic,offset) VALUES('$consumer','$stream',$start); COMMIT;"
  ]

  # Monotonic ack prevents a slower concurrent reader from rewinding a consumer.
  # Keep ordinary ack: available for explicit operational replay; workers use this.
  rawMethod: acknowledgeThrough: offset [
    local stream consumer
    [[ -z ${_STORE_TX:-} && "$1" =~ ^[0-9]+$ && ${#1} -le 16 ]] && (( $1 <= 9007199254740991 )) || return 1
    stream=$(_db_escape "$(_ivar streamName)")
    consumer=$(_db_escape "$(_ivar consumerName)")
    [[ -n "$consumer" ]] || return 1
    _db_sql -bail "SELECT honker_stream_save_offset('$consumer','$stream',max(honker_stream_get_offset('$consumer','$stream'),$1));" >/dev/null
  ]
