# Config - declared user settings by key. Settings are declared in Settings
# groups next to the classes that read them, and set in a Preferences class.
# A value comes from its environment variable, then the active preferences
# class, then the legacy config file, then its declared default. See
# docs/settings-design.md.
#
# Usage:
#   model := @ Config at: 'jcode.model'
#   @ Config at: 'jcode.model' put: 'gpt-5.6-terra'
#   @ Config list
Config subclass: Object

  # Effective value of a declared key; fails with ConfigurationError for an
  # unknown key, a config file syntax error, or an invalid value.
  classPrimitive: at: key calls: trash_config_at

  # Write the value into the active preferences class and recompile it.
  classPrimitive: at: key put: value calls: trash_config_put

  # Write the value into the named preferences class, such as a superclass
  # shared by every machine.
  classPrimitive: at: key put: value in: preferencesClass calls: trash_config_put

  # Remove the key from the active preferences class so its default applies.
  classPrimitive: reset: key calls: trash_config_reset

  # Remove the key from the named preferences class.
  classPrimitive: reset: key in: preferencesClass calls: trash_config_reset

  # Every key with its effective value and source (env, preferences, file, default).
  classPrimitive: list calls: trash_config_list

  # Every compiled preferences class; the active one is marked with "*".
  classPrimitive: preferences calls: trash_config_preferences

  # Write a preferences class in trash/user/ holding the legacy config file's values.
  classPrimitive: import: name calls: trash_config_import

  # The same, as a subclass of an existing preferences class.
  classPrimitive: import: name subclassing: superclass calls: trash_config_import

  # The legacy config file's path, whether or not it exists.
  classPrimitive: path calls: trash_config_path

  # Doctor findings, one "ok|warn|bad<TAB>message" line each.
  classPrimitive: check calls: trash_config_check
