# Store - OO wrapper for sqlite-json instance persistence
#
# Class methods (no instance needed):
#   @ Store init                              - Initialize database
#   @ Store createInstance <class> <id> <json> - Create instance
#   @ Store getInstance <id>                  - Get instance JSON
#   @ Store getField <id> <field>             - Get specific field
#   @ Store setField <id> <field> <value>     - Set specific field
#   @ Store deleteInstance <id>               - Delete instance
#   @ Store getClass <id>                     - Get instance class
#   @ Store findByClass <class>               - Find all of class
#   @ Store countByClass <class>              - Count instances
#   @ Store listClasses                       - List all classes
#   @ Store query <where>                     - Raw SQL query
#   @ Store ensureIndex <name> <path>         - Create virtual column + index

Store subclass: Object

  # Initialize the database
  rawClassMethod: init [
    db_init
  ]

  # Create a new instance
  # Usage: @ Store createInstance <class_name> <instance_id> <json_data>
  rawClassMethod: createInstance: class_name id: instance_id data: initial_data [
    local created_at full_data
    created_at=$(date +%s)
    full_data=$(echo "$initial_data" | jq -c ". + {class: \"$class_name\", created_at: \"$created_at\"}")
    db_put "$instance_id" "$full_data"
  ]

  # Get full instance JSON
  # Usage: @ Store getInstance <instance_id>
  rawClassMethod: getInstance: instance_id [
    db_get "$instance_id"
  ]

  # Get a specific field from instance
  # Usage: @ Store getField <instance_id> <field_name>
  rawClassMethod: getField: instance_id field: field [
    local data
    data=$(db_get "$instance_id")
    [[ -n "$data" ]] && echo "$data" | jq -r ".$field // empty"
  ]

  # Set a specific field on instance
  # Usage: @ Store setField <instance_id> <field_name> <value>
  rawClassMethod: setField: instance_id field: field value: value [
    local data updated
    data=$(db_get "$instance_id")
    if [[ -z "$data" ]]; then
      echo "Error: Instance $instance_id not found" >&2
      return 1
    fi
    if [[ "$value" =~ ^-?[0-9]+$ ]]; then
      updated=$(echo "$data" | jq -c ".$field = $value")
    else
      updated=$(echo "$data" | jq -c ".$field = \"$value\"")
    fi
    db_put "$instance_id" "$updated"
  ]

  # Multi-statement SQL must go through stdin with -bail: some SQLite CLIs
  # continue later statements in a command-line argument even with that flag.
  # A failed transaction exits before COMMIT and SQLite rolls it back on close.
  rawClassMethod: executeBatch: sql [
    printf '%s\n' "$1" | _db_sql -bail
  ]

  # Atomic JSON merge at the SQLite boundary. Concurrent writers can update
  # disjoint fields without saving an old whole-object snapshot over each other.
  rawClassMethod: patch: instanceId with: patchJson [
    local id patch
    id=$(_db_escape "$1")
    printf '%s' "$2" | jq -e 'type == "object"' >/dev/null || return 1
    patch=$(_db_escape "$2")
    if [[ -n ${_STORE_TX:-} ]]; then
      [[ ${_STORE_READONLY:-0} == 0 ]] || { _store_tx_fail 'Conflict replay would write'; return 1; }
      _store_tx_import "$1" || return 1
      _store_tx_sql "UPDATE instances SET data = json_patch(data, '$patch') WHERE id = '$id';" || return 1
    else
      _db_sql "UPDATE instances SET data = json_patch(data, '$patch') WHERE id = '$id';" || return 1
    fi
    _env_set "$1" "$(db_get "$1")"
  ]

  # Delete an instance
  # Usage: @ Store deleteInstance <instance_id>
  rawClassMethod: deleteInstance: instance_id [
    db_delete "$instance_id"
  ]

  # Get the class of an instance
  # Usage: @ Store getClass <instance_id>
  rawClassMethod: getClass: instance_id [
    @ Store getField: "$instance_id" field: "class"
  ]

  # Check if an ID is a valid instance
  # Usage: @ Store isInstance <instance_id>
  rawClassMethod: isInstance: instance_id [
    local class_name
    class_name=$(@ Store getClass: "$instance_id")
    [[ -n "$class_name" ]]
  ]

  # Find all instances of a class
  # Usage: @ Store findByClass <class_name>
  rawClassMethod: findByClass: class_name [
    db_find_by_class "$class_name"
  ]

  # Find instances of a class matching a predicate
  # Usage: @ Store findByClass: 'Counter' where: 'value > 5'
  # Supports: =, !=, >, <, >=, <=
  rawClassMethod: findByClass: class_name where: predicate [
    _find_with_predicate "$class_name" "$predicate"
  ]

  # Count instances of a class
  # Usage: @ Store countByClass <class_name>
  rawClassMethod: countByClass: class_name [
    db_count_by_class "$class_name"
  ]

  # List all distinct classes
  # Usage: @ Store listClasses
  rawClassMethod: listClasses [
    db_list_classes
  ]

  # Raw query (returns instance IDs)
  # Usage: @ Store query <where_clause>
  rawClassMethod: query: where_clause [
    db_query "$where_clause"
  ]

  # Raw query returning full data
  # Usage: @ Store queryData <where_clause>
  rawClassMethod: queryData: where_clause [
    db_query_data "$where_clause"
  ]

  # Ensure a virtual column and index exist
  # Usage: @ Store ensureIndex <column_name> <json_path>
  rawClassMethod: ensureIndex: column_name path: json_path [
    db_ensure_virtual_column "$column_name" "$json_path" 2>/dev/null || true
    db_create_index "$column_name" 2>/dev/null || true
  ]

  # List all indices
  # Usage: @ Store listIndices
  rawClassMethod: listIndices [
    db_list_indices
  ]

  # List all columns
  # Usage: @ Store listColumns
  rawClassMethod: listColumns [
    db_list_columns
  ]

  # Clear all instance data (dangerous!)
  # Usage: @ Store clear
  rawClassMethod: clear [
    db_clear
  ]

  # Find instances of a class, ordered by a column
  # Usage: @ Store findByClass: 'Kube::Resource' orderBy: 'captured_at ASC'
  rawClassMethod: findByClass: class_name orderBy: column [
    local esc
    esc=$(_db_escape "$class_name")
    db_query "class = '$esc' ORDER BY $column"
  ]

  # Find instances with WHERE + ORDER BY + LIMIT
  # Usage: @ Store findByClass: 'Kube::Resource' where: "kube_name = 'api'" orderBy: 'captured_at DESC' limit: 1
  rawClassMethod: findByClass: class_name where: predicate orderBy: column limit: n [
    local esc
    esc=$(_db_escape "$class_name")
    db_query "class = '$esc' AND $predicate ORDER BY $column LIMIT $n"
  ]

  # Raw put - stores JSON data without modification
  # Usage: @ Store put: instanceId data: json
  # This is used by Persistable to save instance state directly
  rawClassMethod: put: instanceId data: json [
    db_put "$1" "$2"
  ]

  # Check if an instance exists in the store
  # Usage: @ Store exists: instanceId
  rawClassMethod: exists: instanceId [
    local data
    data=$(db_get "$1" 2>/dev/null)
    if [[ -n "$data" ]]; then
      echo "true"
    else
      echo "false"
    fi
  ]

  # Selective unit of work. The single argument may be a JSON value object.
  # Replays are opt-in and read-only: they can acknowledge prior success only.
  classMethod: transaction: receiver sending: selector with: argument [
    ^ @ self transaction: receiver sending: selector with: argument replaying: false
  ]

  rawClassMethod: transaction: receiver sending: selector with: argument replaying: replay [
    # A shell/view may predate the transaction runtime while loading this newer
    # compiled class. Load the shared primitive at its boundary in that case.
    declare -F _store_transaction >/dev/null || source "${TRASHTALK_DIR:-$HOME/.trashtalk}/lib/store-transaction.bash" || return 1
    _store_transaction "$4" "$1" "$2" "$3"
  ]

  rawClassMethod: requireTransaction [
    [[ -n ${_STORE_TX:-} ]] || { _throw TransactionError 'This operation requires a Store transaction'; return 1; }
  ]

  # Fresh, typed lookup; missing objects are precondition failures.
  rawClassMethod: read: id class: expected [
    local data
    data=$(db_get "$1") || return 1
    printf '%s' "$data" | jq -e --arg cls "$2" '.class == $cls' >/dev/null || { _throw StoreError "Missing $2 object: $1"; return 1; }
    _env_set "$1" "$data" || return
    printf '%s\n' "$1"
  ]

  classMethod: create: className id: id [
    | exists |
    exists := @ self exists: id.
    @ Require equal: exists to: 'false'.
    @ Runtime create: className id: id.
    ^ id
  ]

  rawClassMethod: idsOf: className matching: fields [
    _store_matching "$1" "$2"
  ]

  rawClassMethod: insert: row into: table [
    _store_tx_insert "$2" "$1"
  ]

  # Notification hints run only after durable commit. Failure cannot undo it.
  rawClassMethod: afterCommit: receiver sending: selector with: argument [
    [[ -n ${_STORE_TX:-} && ${_STORE_READONLY:-0} == 0 ]] || return 1
    _store_tx_sql "INSERT INTO store_callbacks VALUES('$(_db_escape "$1")','$(_db_escape "$2")','$(_db_escape "$3")');"
  ]
