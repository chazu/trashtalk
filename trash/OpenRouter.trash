# OpenRouter - minimal Jev proof of concept
#
# Sends one non-streaming text completion to the fixed Jev model through
# OpenRouter. This is intentionally a direct adapter, not a generic service
# transport or a routing layer.
#
# Usage:
#   export OPENROUTER_API_KEY=...
#   @ OpenRouter complete: 'Reply with one word: ready'

OpenRouter subclass: Object

  classMethod: jevModel [
    ^ '~typesafe/jev-latest'
  ]

  classMethod: endpoint [
    ^ 'https://openrouter.ai/api/v1/chat/completions'
  ]

  classMethod: complete: prompt [
    | trimmed |
    trimmed := @ String trim: prompt.
    trimmed isEmpty ifTrue: [^ @ Require reject: 'An OpenRouter prompt is required'].
    ^ @ self request: prompt
  ]

  # The authorization value exists only in curl's mode-600 config file. It is
  # never passed to the compiler, a shell command string, or curl argv.
  rawClassMethod: request: prompt [
    pragma: direct
    local prompt="$1" api_key config body_file response_file error_file old_umask
    local status curl_status content

    api_key="${OPENROUTER_API_KEY:-}"
    if [[ -z "$api_key" ]]; then
      _throw "ConfigurationError" "OPENROUTER_API_KEY is required"
      return 2
    fi
    if ! command -v curl >/dev/null 2>&1; then
      _throw "ToolError" "curl is required for OpenRouter requests"
      return 127
    fi

    old_umask=$(umask)
    umask 077
    config=$(mktemp "${TMPDIR:-/tmp}/trashtalk-openrouter-config.XXXXXX") || { umask "$old_umask"; return 1; }
    body_file=$(mktemp "${TMPDIR:-/tmp}/trashtalk-openrouter-body.XXXXXX") || { rm -f "$config"; umask "$old_umask"; return 1; }
    response_file=$(mktemp "${TMPDIR:-/tmp}/trashtalk-openrouter-response.XXXXXX") || { rm -f "$config" "$body_file"; umask "$old_umask"; return 1; }
    error_file=$(mktemp "${TMPDIR:-/tmp}/trashtalk-openrouter-error.XXXXXX") || { rm -f "$config" "$body_file" "$response_file"; umask "$old_umask"; return 1; }
    if ! jq -cn --arg model '~typesafe/jev-latest' --arg content "$prompt" \
      '{model:$model,messages:[{role:"user",content:$content}]}' >"$body_file"; then
      jq -cn '{schema_version:1,backend:"openrouter",model:"~typesafe/jev-latest",outcome:"request_encoding_error"}'
      rm -f "$config" "$body_file" "$response_file" "$error_file"
      umask "$old_umask"
      return 1
    fi

    {
      printf '%s\n' 'silent' 'show-error' 'request = "POST"'
      printf '%s\n' 'url = "https://openrouter.ai/api/v1/chat/completions"'
      printf '%s\n' 'header = "Content-Type: application/json"'
      printf 'header = "Authorization: Bearer %s"\n' "$api_key"
    } >"$config"

    status=$(curl --config "$config" --connect-timeout 5 --max-time 90 \
      --data-binary "@$body_file" --output "$response_file" --write-out '%{http_code}' 2>"$error_file")
    curl_status=$?
    if [[ "$curl_status" -ne 0 ]]; then
      jq -cn --arg stderr "$(cat "$error_file")" \
        '{schema_version:1,backend:"openrouter",model:"~typesafe/jev-latest",outcome:"transport_error",exit_code:$curl_status,stderr:$stderr}' \
        --argjson curl_status "$curl_status"
      rm -f "$config" "$body_file" "$response_file" "$error_file"
      umask "$old_umask"
      return 1
    fi

    if [[ "${status:0:1}" != "2" ]]; then
      jq -cn --arg status "$status" --rawfile body "$response_file" \
        '{schema_version:1,backend:"openrouter",model:"~typesafe/jev-latest",outcome:"http_error",status:($status | tonumber),body:$body}'
      rm -f "$config" "$body_file" "$response_file" "$error_file"
      umask "$old_umask"
      return 1
    fi

    content=$(jq -er '.choices[0].message.content // empty' "$response_file")
    if [[ $? -ne 0 || -z "$content" ]]; then
      jq -cn --arg status "$status" --rawfile body "$response_file" \
        '{schema_version:1,backend:"openrouter",model:"~typesafe/jev-latest",outcome:"response_shape_error",status:($status | tonumber),body:$body}'
      rm -f "$config" "$body_file" "$response_file" "$error_file"
      umask "$old_umask"
      return 1
    fi

    jq -cn --arg content "$content" --arg status "$status" \
      '{schema_version:1,backend:"openrouter",model:"~typesafe/jev-latest",outcome:"success",status:($status | tonumber),content:$content}'
    rm -f "$config" "$body_file" "$response_file" "$error_file"
    umask "$old_umask"
  ]
