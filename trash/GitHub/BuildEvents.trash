package: GitHub

# Pull the cloud inbox into the existing local Honker Stream. HTTP and atomic
# SQLite/Honker serialization are the only raw boundaries; no agent is started.
BuildEvents subclass: Object
  classMethod: streamName [ ^ 'github.builds.v1' ]
  classMethod: endpoint [ ^ 'https://github-events.tail7fd374.ts.net/events' ]
  classMethod: consumerNamed: name [
    | stream |
    stream := @ self streamName.
    ^ @ Stream consumerNamed: stream consumer: name
  ]
  classMethod: sync [
    | endpoint |
    endpoint := @ self endpoint.
    ^ @ self syncFrom: endpoint
  ]
  classMethod: syncFrom: endpoint [
    | cursor batch |
    (@ self ensureSchema) ifFailed: [:error | @ error signal].
    cursor := (@ self cursorFor: endpoint) ifFailed: [:error | @ error signal].
    batch := (@ self fetchFrom: endpoint cursor: cursor) ifFailed: [:error | @ error signal].
    ^ @ self acceptBatch: batch from: endpoint cursor: cursor
  ]
  classMethod: acceptBatch: batch from: endpoint cursor: cursor [
    | checked |
    checked := (@ self validateBatch: batch cursor: cursor) ifFailed: [:error | @ error signal].
    (@ self ensureSchema) ifFailed: [:error | @ error signal].
    ^ @ self commitBatch: checked from: endpoint cursor: cursor
  ]

  # Schema creation and atomic append/checkpoint are database primitives. They
  # deliberately reject Store's optimistic transaction context via _db_sql.
  classPrimitive: ensureSchema calls: _github_build_ensure_schema
  classPrimitive: cursorFor: endpoint calls: _github_build_cursor
  classPrimitive: fetchFrom: endpoint cursor: cursor calls: _github_build_fetch
  # A closed, bounded JSON batch is checked before constructing any SQL.
  classPrimitive: validateBatch: batch cursor: cursor calls: _github_build_validate
  classPrimitive: commitBatch: batch from: endpoint cursor: cursor calls: _github_build_commit
