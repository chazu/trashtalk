# Assignment - Durable responsibility, independent of any one agent session.
# Manual work publication does not launch a harness. Store transactions make
# ordinary object saves and queue publication one atomic unit of work.
Assignment subclass: Object
  include: Persistable
  include: Assignment::Authority
  include: Assignment::Presentation
  include: Assignment::Reporting
  instanceVars: objective:'' completionCriteria:'' requester:'' requesterSession:''
                owner:'' originMessage:'' workspace:'' assignee:'' state:'open'
                currentSession:'' generation:0 delivery:'' history:'[]' events:'[]'
                externalIssue:'' result:'' resultMessage:'' cancellationNote:''
                created:'' completedAt:'' dispatchMode:'manual'

  classMethod: draft: objective in: workspace [
    | args |
    @ AgentQueue ensureSchema.
    args := #{objective: objective workspace: workspace} asJson.
    ^ @ Store transaction: self sending: 'draftWithin:' with: args
  ]

  classMethod: draftWithin: args [
    | actor human a objective path now |
    @ Store requireTransaction.
    actor := @ AgentRun actingContext.
    human := actor objectAt: 'human'.
    @ Require text: human.
    objective := args objectAt: 'objective'.
    @ Require text: objective.
    path := @ AgentSession workspaceFor: (args objectAt: 'workspace').
    a := @ self new.
    now := @ Time nowISO.
    @ a objective: objective.
    @ a completionCriteria: objective.
    @ a workspace: path.
    @ a requester: human.
    @ a owner: human.
    @ a created: now.
    @ a requesterSession: ''.
    @ a originMessage: ''.
    @ a assignee: ''.
    @ a currentSession: ''.
    @ a delivery: ''.
    @ a externalIssue: ''.
    @ a result: ''.
    @ a resultMessage: ''.
    @ a cancellationNote: ''.
    @ a completedAt: ''.
    @ a save.
    ^ a
  ]

  method: assignTo: identity [
    ^ @ Store transaction: self sending: 'assignWithin:' with: identity
  ]

  method: assignWithin: identity [
    | actor sender i data current allowed owner |
    actor := @ AgentRun actingContext.
    sender := @ self authorize: actor operatorOnly: true.
    @ self requireOpen.
    i := @ Store read: identity class: 'AgentIdentity'.
    data := @ i asJson.
    @ Require member: (data objectAt: 'enabled') of: '["true","1"]'.
    owner := data objectAt: 'owner'.
    (owner isEmpty) ifTrue: [owner := @ self owner].
    @ Require equal: owner to: sender.
    current := @ self assignee.
    (current notEmpty) ifTrue: [@ Require equal: current to: i].
    @ self assignee: i.
    @ self save.
    ^ self
  ]

  method: requireOpen [
    | state |
    @ Store requireTransaction.
    state := @ self state.
    @ Require equal: state to: 'open'
  ]

  method: criteria: text [
    | args |
    args := #{field: 'completionCriteria' value: text} asJson.
    ^ @ Store transaction: self sending: 'describeWithin:' with: args
  ]

  # Opaque tracker reference; no synchronization with an external work item.
  method: issueReference: reference [
    | args |
    args := #{field: 'externalIssue' value: reference} asJson.
    ^ @ Store transaction: self sending: 'describeWithin:' with: args
  ]

  method: describeWithin: args [
    | actor sender field value generation |
    actor := @ AgentRun actingContext.
    sender := @ self authorize: actor operatorOnly: true.
    @ self requireOpen.
    generation := @ self generation.
    @ Require equal: generation to: '0'.
    field := args objectAt: 'field'.
    value := args objectAt: 'value'.
    @ Require member: field of: '["completionCriteria","externalIssue"]'.
    (field = 'completionCriteria') ifTrue: [
      @ Require text: value.
      @ self completionCriteria: value
    ] ifFalse: [@ self externalIssue: value].
    @ self save.
    ^ self
  ]

  method: origin: message [
    ^ @ Store transaction: self sending: 'originWithin:' with: message
  ]

  method: originWithin: message [
    | actor sender m data sent generation requester session isSession exists s fields ids count |
    actor := @ AgentRun actingContext.
    sender := @ self authorize: actor operatorOnly: true.
    @ self requireOpen.
    generation := @ self generation.
    @ Require equal: generation to: '0'.
    m := @ Store read: message class: 'Message'.
    sent := @ m sentAt.
    (sent > 0) ifFalse: [^ @ Require reject: 'Origin must be a sent Message'].
    requester := @ m from.
    session := ''.
    isSession := @ String startsWith: requester prefix: 'session:'.
    (isSession = 'true') ifTrue: [
      s := @ String trimPrefix: 'session:' from: requester.
      exists := @ Store exists: s.
      (exists = 'true') ifTrue: [
        data := @ Store getInstance: s.
        exists := data objectAt: 'class'.
        (exists = 'AgentSession') ifTrue: [
          session := s.
          requester := data objectAt: 'identity'
        ]
      ]
    ].
    (session isEmpty) ifTrue: [
      fields := #{inbox: requester} asJson.
      ids := @ Store idsOf: 'AgentIdentity' matching: fields.
      count := ids arrayLength.
      (count > 0) ifTrue: [requester := ids arrayFirst]
    ].
    @ self originMessage: m.
    @ self requester: requester.
    @ self requesterSession: session.
    @ self save.
    ^ self
  ]

  method: workIn: session [
    @ AgentQueue ensureSchema.
    ^ @ Store transaction: self sending: 'selectWithin:' with: session replaying: true
  ]

  method: selectWithin: session [
    ^ @ Assignment::Participation select: session for: self
  ]

  method: complete: outcome [
    | args |
    @ AgentQueue ensureSchema.
    args := #{outcome: outcome cancel: 'false'} asJson.
    ^ @ Store transaction: self sending: 'finishWithin:' with: args replaying: true
  ]

  method: cancel: reason [
    | args |
    @ AgentQueue ensureSchema.
    args := #{outcome: reason cancel: 'true'} asJson.
    ^ @ Store transaction: self sending: 'finishWithin:' with: args replaying: true
  ]

  method: finishWithin: args [
    | actor sender run cancel outcome target state previous session runs data d dState questions message now event assignee |
    actor := @ AgentRun actingContext.
    cancel := args objectAt: 'cancel'.
    @ Require member: cancel of: '["true","false"]'.
    sender := @ self authorize: actor operatorOnly: cancel.
    outcome := args objectAt: 'outcome'.
    @ Require text: outcome.
    target := 'completed'.
    previous := @ self result.
    (cancel = 'true') ifTrue: [target := 'cancelled'. previous := @ self cancellationNote].
    state := @ self state.
    (state = 'open') ifFalse: [
      @ Require equal: state to: target.
      @ Require equal: previous to: outcome.
      ^ self
    ].
    run := actor objectAt: 'run'.
    session := @ self currentSession.
    runs := @ AgentRun activeFor: session except: run.
    @ Require equal: runs to: '[]'.
    data := @ self asJson.
    d := data objectAt: 'delivery'.
    (d notEmpty) ifTrue: [
      d := @ Store read: d class: 'AgentDelivery'.
      dState := @ d state.
      @ Require member: dState of: '["pending","blocked","offered","processed","skipped"]'
    ].
    (cancel = 'false') ifTrue: [
      assignee := @ self assignee.
      @ Require text: assignee.
      @ Require text: session.
      questions := @ AgentQueue unansweredForAssignment: self.
      @ Require equal: questions to: '[]'
    ].
    message := @ Message outcomeForAssignment: self body: outcome sender: sender cancelled: cancel.
    (d notEmpty) ifTrue: [
      dState := 'processed'.
      (cancel = 'true') ifTrue: [dState := 'skipped'].
      @ d state: dState.
      @ d note: outcome.
      @ d save
    ].
    now := @ Time nowISO.
    event := #{kind: target body: outcome actor: sender run: run at: now} asJson.
    @ self appendEvent: event.
    @ self state: target.
    (cancel = 'true') ifTrue: [@ self cancellationNote: outcome] ifFalse: [@ self result: outcome].
    @ self completedAt: now.
    @ self resultMessage: message.
    @ self save.
    @ AgentQueue publishManual: message.
    ^ self
  ]

  classMethod: current [
    @ AgentQueue ensureSchema.
    ^ @ Store transaction: self sending: 'currentWithin:' with: ''
  ]

  classMethod: currentWithin: unused [
    | actor run selected human ids fields candidates data a d dData state same sender count |
    @ Store requireTransaction.
    actor := @ AgentRun actingContext.
    run := actor objectAt: 'run'.
    selected := @ Env get: 'TRASHTALK_ASSIGNMENT_ID'.
    candidates := '[]'.
    (run isEmpty) ifTrue: [
      @ Require text: selected.
      candidates := candidates arrayPush: selected
    ] ifFalse: [
      fields := #{run: run state: #('offered' 'blocked')} asJson.
      ids := @ Store idsOf: 'AgentDelivery' matching: fields.
      ids arrayEach: [:id |
        d := @ Store read: id class: 'AgentDelivery'.
        data := @ d asJson.
        a := data objectAt: 'assignment'.
        (a notEmpty) ifTrue: [
          a := @ Store read: a class: 'Assignment'.
          data := @ a asJson.
          same := @ String equals: id to: (data objectAt: 'delivery').
          state := data objectAt: 'state'.
          (state = 'open') ifFalse: [same := 'false'].
          (same = 'true') ifTrue: [
            same := @ String equals: a to: selected.
            (selected isEmpty) ifTrue: [same := 'true'].
            (same = 'true') ifTrue: [candidates := candidates arrayPush: a]
          ]
        ]
      ]
    ].
    count := candidates arrayLength.
    @ Require equal: count to: '1'.
    a := candidates arrayFirst.
    a := @ Store read: a class: 'Assignment'.
    sender := @ a authorize: actor operatorOnly: false.
    @ a requireOpen.
    ^ a
  ]

  classMethod: claim: delivery run: run [
    | args |
    @ AgentQueue ensureSchema.
    args := #{delivery: delivery run: run} asJson.
    ^ @ Store transaction: 'Assignment::Participation' sending: 'claimWithin:' with: args replaying: true
  ]
