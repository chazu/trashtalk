# Assignment - Durable responsibility, independent of any one agent session.
# Manual work publication does not launch a harness. Store transactions make
# ordinary object saves and queue publication one atomic unit of work.
Assignment subclass: Object
  include: Persistable
  include: AssignmentAuthority
  include: AssignmentPresentation
  instanceVars: objective:'' completionCriteria:'' requester:'' requesterSession:''
                owner:'' originMessage:'' workspace:'' assignee:'' state:'open'
                currentSession:'' generation:0 delivery:'' history:'[]' events:'[]'
                externalIssue:'' result:'' resultMessage:'' cancellationNote:''
                created:'' completedAt:'' dispatchMode:'manual'

  classMethod: draft: objective in: workspace [
    | args |
    @ AgentQueue ensureSchema.
    args := #{objective: objective workspace: workspace} asJson.
    ^ @ Store transaction: self sending: 'draftWithin:' with: args
  ]

  classMethod: draftWithin: args [
    | actor human a objective path now |
    @ Store requireTransaction.
    actor := @ AgentRun actingContext.
    human := actor objectAt: 'human'.
    @ Require text: human.
    objective := args objectAt: 'objective'.
    @ Require text: objective.
    path := @ AgentSession workspaceFor: (args objectAt: 'workspace').
    a := @ self new.
    now := @ Time nowISO.
    @ a objective: objective.
    @ a completionCriteria: objective.
    @ a workspace: path.
    @ a requester: human.
    @ a owner: human.
    @ a created: now.
    @ a requesterSession: ''.
    @ a originMessage: ''.
    @ a assignee: ''.
    @ a currentSession: ''.
    @ a delivery: ''.
    @ a externalIssue: ''.
    @ a result: ''.
    @ a resultMessage: ''.
    @ a cancellationNote: ''.
    @ a completedAt: ''.
    @ a save.
    ^ a
  ]

  method: assignTo: identity [
    ^ @ Store transaction: self sending: 'assignWithin:' with: identity
  ]

  method: assignWithin: identity [
    | actor sender i data current allowed owner |
    actor := @ AgentRun actingContext.
    sender := @ self authorize: actor operatorOnly: true.
    @ self requireOpen.
    i := @ Store read: identity class: 'AgentIdentity'.
    data := @ i asJson.
    @ Require member: (data objectAt: 'enabled') of: '["true","1"]'.
    owner := data objectAt: 'owner'.
    (owner isEmpty) ifTrue: [owner := @ self owner].
    @ Require equal: owner to: sender.
    current := @ self assignee.
    (current notEmpty) ifTrue: [@ Require equal: current to: i].
    @ self assignee: i.
    @ self save.
    ^ self
  ]

  method: requireOpen [
    | state |
    @ Store requireTransaction.
    state := @ self state.
    @ Require equal: state to: 'open'
  ]

  method: criteria: text [
    | args |
    args := #{field: 'completionCriteria' value: text} asJson.
    ^ @ Store transaction: self sending: 'describeWithin:' with: args
  ]

  # Opaque tracker reference; no synchronization with an external work item.
  method: issueReference: reference [
    | args |
    args := #{field: 'externalIssue' value: reference} asJson.
    ^ @ Store transaction: self sending: 'describeWithin:' with: args
  ]

  method: describeWithin: args [
    | actor sender field value generation |
    actor := @ AgentRun actingContext.
    sender := @ self authorize: actor operatorOnly: true.
    @ self requireOpen.
    generation := @ self generation.
    @ Require equal: generation to: '0'.
    field := args objectAt: 'field'.
    value := args objectAt: 'value'.
    @ Require member: field of: '["completionCriteria","externalIssue"]'.
    (field = 'completionCriteria') ifTrue: [
      @ Require text: value.
      @ self completionCriteria: value
    ] ifFalse: [@ self externalIssue: value].
    @ self save.
    ^ self
  ]

  method: origin: message [
    ^ @ Store transaction: self sending: 'originWithin:' with: message
  ]

  method: originWithin: message [
    | actor sender m data sent generation requester session isSession exists s fields ids count |
    actor := @ AgentRun actingContext.
    sender := @ self authorize: actor operatorOnly: true.
    @ self requireOpen.
    generation := @ self generation.
    @ Require equal: generation to: '0'.
    m := @ Store read: message class: 'Message'.
    sent := @ m sentAt.
    (sent > 0) ifFalse: [^ @ Require reject: 'Origin must be a sent Message'].
    requester := @ m from.
    session := ''.
    isSession := @ String startsWith: requester prefix: 'session:'.
    (isSession = 'true') ifTrue: [
      s := @ String trimPrefix: 'session:' from: requester.
      exists := @ Store exists: s.
      (exists = 'true') ifTrue: [
        data := @ Store getInstance: s.
        exists := data objectAt: 'class'.
        (exists = 'AgentSession') ifTrue: [
          session := s.
          requester := data objectAt: 'identity'
        ]
      ]
    ].
    (session isEmpty) ifTrue: [
      fields := #{inbox: requester} asJson.
      ids := @ Store idsOf: 'AgentIdentity' matching: fields.
      count := ids arrayLength.
      (count > 0) ifTrue: [requester := ids arrayFirst]
    ].
    @ self originMessage: m.
    @ self requester: requester.
    @ self requesterSession: session.
    @ self save.
    ^ self
  ]

  method: workIn: session [
    @ AgentQueue ensureSchema.
    ^ @ Store transaction: self sending: 'selectWithin:' with: session replaying: true
  ]

  method: selectWithin: session [
    | actor sender aData s sData identity iData role path canonical allowed current same runs old oldState gen message d now history participation |
    actor := @ AgentRun actingContext.
    sender := @ self authorize: actor operatorOnly: true.
    @ self requireOpen.
    aData := @ self asJson.
    s := @ Store read: session class: 'AgentSession'.
    sData := @ s asJson.
    identity := @ Store read: (sData objectAt: 'identity') class: 'AgentIdentity'.
    iData := @ identity asJson.
    @ Require equal: identity to: (aData objectAt: 'assignee').
    @ Require member: (iData objectAt: 'enabled') of: '["true","1"]'.
    @ Require equal: (sData objectAt: 'lifecycleState') to: 'open'.
    path := @ s workspace.
    canonical := @ AgentSession workspaceFor: path.
    @ Require equal: canonical to: (aData objectAt: 'workspace').
    role := @ Store read: (sData objectAt: 'role') class: 'AgentRole'.
    allowed := @ role allowsWorkspace: canonical.
    @ Require equal: allowed to: 'true'.
    current := @ self currentSession.
    same := @ String equals: current to: s.
    (same = 'true') ifTrue: [^ self].
    runs := @ AgentRun activeFor: s except: ''.
    @ Require equal: runs to: '[]'.
    (current notEmpty) ifTrue: [
      runs := @ AgentRun activeFor: current except: ''.
      @ Require equal: runs to: '[]'.
      old := @ Store read: (aData objectAt: 'delivery') class: 'AgentDelivery'.
      oldState := @ old state.
      @ Require member: oldState of: '["pending","blocked","processed","skipped"]'.
      allowed := @ Require contains: oldState in: '["pending","blocked"]'.
      (allowed = 'true') ifTrue: [
        @ old state: 'skipped'.
        @ old note: 'Assignment continued in another session'.
        @ old save
      ]
    ].
    gen := @ self generation.
    gen := gen + 1.
    message := @ Message workForAssignment: self session: s generation: gen sender: sender.
    d := @ AgentDelivery forAssignment: self session: s generation: gen message: message.
    now := @ Time nowISO.
    participation := #{generation: gen session: s delivery: d message: message workspace: path selectedAt: now runs: #()} asJson.
    participation := participation objectAt: 'generation' putJson: gen.
    history := @ self history.
    history := history arrayPushJson: participation.
    @ self history: history.
    @ self currentSession: s.
    @ self generation: gen.
    @ self delivery: d.
    @ self save.
    @ AgentQueue publishManual: message.
    ^ self
  ]

  method: progress: text [
    | args |
    args := #{kind: 'progress' body: text} asJson.
    ^ @ Store transaction: self sending: 'recordWithin:' with: args
  ]

  method: ask: question [
    | args |
    @ AgentQueue ensureSchema.
    args := #{kind: 'question' body: question} asJson.
    ^ @ Store transaction: self sending: 'recordWithin:' with: args
  ]

  method: recordWithin: args [
    | actor sender run kind body session message data d state allowed now gen event events |
    actor := @ AgentRun actingContext.
    sender := @ self authorize: actor operatorOnly: false.
    @ self requireOpen.
    body := args objectAt: 'body'.
    kind := args objectAt: 'kind'.
    @ Require text: body.
    @ Require member: kind of: '["progress","question"]'.
    session := @ self currentSession.
    @ Require text: session.
    run := actor objectAt: 'run'.
    message := ''.
    (kind = 'question') ifTrue: [
      message := @ Message questionForAssignment: self body: body sender: sender.
      data := @ self asJson.
      d := @ Store read: (data objectAt: 'delivery') class: 'AgentDelivery'.
      state := @ d state.
      allowed := @ Require contains: state in: '["pending","offered","blocked"]'.
      (allowed = 'true') ifTrue: [@ d state: 'blocked'. @ d save].
      @ AgentQueue publishManual: message.
      @ AgentQueue linkQuestion: message session: session run: run delivery: d
    ].
    now := @ Time nowISO.
    gen := @ self generation.
    event := #{kind: kind body: body actor: sender run: run generation: gen message: message at: now} asJson.
    event := event objectAt: 'generation' putJson: gen.
    events := @ self events.
    events := events arrayPushJson: event.
    @ self events: events.
    @ self save.
    (kind = 'question') ifTrue: [^ message].
    ^ self
  ]

  method: complete: outcome [
    | args |
    @ AgentQueue ensureSchema.
    args := #{outcome: outcome cancel: 'false'} asJson.
    ^ @ Store transaction: self sending: 'finishWithin:' with: args replaying: true
  ]

  method: cancel: reason [
    | args |
    @ AgentQueue ensureSchema.
    args := #{outcome: reason cancel: 'true'} asJson.
    ^ @ Store transaction: self sending: 'finishWithin:' with: args replaying: true
  ]

  method: finishWithin: args [
    | actor sender run cancel outcome target state previous session runs data d dState questions message now event events assignee |
    actor := @ AgentRun actingContext.
    cancel := args objectAt: 'cancel'.
    @ Require member: cancel of: '["true","false"]'.
    sender := @ self authorize: actor operatorOnly: cancel.
    outcome := args objectAt: 'outcome'.
    @ Require text: outcome.
    target := 'completed'.
    previous := @ self result.
    (cancel = 'true') ifTrue: [target := 'cancelled'. previous := @ self cancellationNote].
    state := @ self state.
    (state = 'open') ifFalse: [
      @ Require equal: state to: target.
      @ Require equal: previous to: outcome.
      ^ self
    ].
    run := actor objectAt: 'run'.
    session := @ self currentSession.
    runs := @ AgentRun activeFor: session except: run.
    @ Require equal: runs to: '[]'.
    data := @ self asJson.
    d := data objectAt: 'delivery'.
    (d notEmpty) ifTrue: [
      d := @ Store read: d class: 'AgentDelivery'.
      dState := @ d state.
      @ Require member: dState of: '["pending","blocked","offered","processed","skipped"]'
    ].
    (cancel = 'false') ifTrue: [
      assignee := @ self assignee.
      @ Require text: assignee.
      @ Require text: session.
      questions := @ AgentQueue unansweredForAssignment: self.
      @ Require equal: questions to: '[]'
    ].
    message := @ Message outcomeForAssignment: self body: outcome sender: sender cancelled: cancel.
    (d notEmpty) ifTrue: [
      dState := 'processed'.
      (cancel = 'true') ifTrue: [dState := 'skipped'].
      @ d state: dState.
      @ d note: outcome.
      @ d save
    ].
    now := @ Time nowISO.
    event := #{kind: target body: outcome actor: sender run: run at: now} asJson.
    events := @ self events.
    events := events arrayPushJson: event.
    @ self events: events.
    @ self state: target.
    (cancel = 'true') ifTrue: [@ self cancellationNote: outcome] ifFalse: [@ self result: outcome].
    @ self completedAt: now.
    @ self resultMessage: message.
    @ self save.
    @ AgentQueue publishManual: message.
    ^ self
  ]

  classMethod: current [
    @ AgentQueue ensureSchema.
    ^ @ Store transaction: self sending: 'currentWithin:' with: ''
  ]

  classMethod: currentWithin: unused [
    | actor run selected human ids fields candidates data a d dData state same sender count |
    @ Store requireTransaction.
    actor := @ AgentRun actingContext.
    run := actor objectAt: 'run'.
    selected := @ Env get: 'TRASHTALK_ASSIGNMENT_ID'.
    candidates := '[]'.
    (run isEmpty) ifTrue: [
      @ Require text: selected.
      candidates := candidates arrayPush: selected
    ] ifFalse: [
      fields := #{run: run state: #('offered' 'blocked')} asJson.
      ids := @ Store idsOf: 'AgentDelivery' matching: fields.
      ids arrayEach: [:id |
        d := @ Store read: id class: 'AgentDelivery'.
        data := @ d asJson.
        a := data objectAt: 'assignment'.
        (a notEmpty) ifTrue: [
          a := @ Store read: a class: 'Assignment'.
          data := @ a asJson.
          same := @ String equals: id to: (data objectAt: 'delivery').
          state := data objectAt: 'state'.
          (state = 'open') ifFalse: [same := 'false'].
          (same = 'true') ifTrue: [
            same := @ String equals: a to: selected.
            (selected isEmpty) ifTrue: [same := 'true'].
            (same = 'true') ifTrue: [candidates := candidates arrayPush: a]
          ]
        ]
      ]
    ].
    count := candidates arrayLength.
    @ Require equal: count to: '1'.
    a := candidates arrayFirst.
    a := @ Store read: a class: 'Assignment'.
    sender := @ a authorize: actor operatorOnly: false.
    @ a requireOpen.
    ^ a
  ]

  classMethod: claim: delivery run: run [
    | args |
    @ AgentQueue ensureSchema.
    args := #{delivery: delivery run: run} asJson.
    ^ @ Store transaction: self sending: 'claimWithin:' with: args replaying: true
  ]

  classMethod: claimWithin: args [
    | actor caller run d dData a aData r rData s sData i iData role roleData same value history participation runs questions previous oldData attempts updated gen |
    @ Store requireTransaction.
    actor := @ AgentRun actingContext.
    caller := actor objectAt: 'run'.
    run := args objectAt: 'run'.
    (caller notEmpty) ifTrue: [@ Require equal: caller to: run].
    d := @ Store read: (args objectAt: 'delivery') class: 'AgentDelivery'.
    dData := @ d asJson.
    a := @ Store read: (dData objectAt: 'assignment') class: 'Assignment'.
    aData := @ a asJson.
    r := @ Store read: run class: 'AgentRun'.
    rData := @ r asJson.
    s := @ Store read: (rData objectAt: 'session') class: 'AgentSession'.
    sData := @ s asJson.
    i := @ Store read: (sData objectAt: 'identity') class: 'AgentIdentity'.
    iData := @ i asJson.
    role := @ Store read: (sData objectAt: 'role') class: 'AgentRole'.
    roleData := @ role asJson.
    (caller isEmpty) ifTrue: [
      same := @ String equals: (actor objectAt: 'human') to: (aData objectAt: 'owner')
    ] ifFalse: [same := @ String equals: (actor objectAt: 'hash') to: (rData objectAt: 'capabilityTokenHash')].
    (same = 'false') ifTrue: [^ 'false'].
    same := @ String equals: (aData objectAt: 'state') to: 'open'.
    (same = 'false') ifTrue: [^ 'false'].
    same := @ String equals: (aData objectAt: 'delivery') to: d.
    (same = 'false') ifTrue: [^ 'false'].
    same := @ String equals: (aData objectAt: 'generation') to: (dData objectAt: 'generation').
    (same = 'false') ifTrue: [^ 'false'].
    same := @ String equals: (aData objectAt: 'currentSession') to: s.
    (same = 'false') ifTrue: [^ 'false'].
    same := @ String equals: (dData objectAt: 'session') to: s.
    (same = 'false') ifTrue: [^ 'false'].
    same := @ String equals: (aData objectAt: 'assignee') to: i.
    (same = 'false') ifTrue: [^ 'false'].
    same := @ String equals: (sData objectAt: 'lifecycleState') to: 'open'.
    (same = 'false') ifTrue: [^ 'false'].
    same := @ Require contains: (iData objectAt: 'enabled') in: '["true","1"]'.
    (same = 'false') ifTrue: [^ 'false'].
    same := @ Require contains: 'assignment.work' in: (roleData jsonAt: 'capabilities').
    (same = 'false') ifTrue: [^ 'false'].
    same := @ Require contains: (rData objectAt: 'state') in: '["starting","running","recovering"]'.
    (same = 'false') ifTrue: [^ 'false'].
    same := @ Require contains: (dData objectAt: 'state') in: '["pending","blocked"]'.
    (same = 'false') ifTrue: [^ 'false'].
    history := @ a history.
    participation := history arrayLast.
    same := @ String equals: (sData objectAt: 'workspace') to: (participation objectAt: 'workspace').
    (same = 'false') ifTrue: [^ 'false'].
    runs := @ AgentRun activeFor: s except: run.
    (runs = '[]') ifFalse: [^ 'false'].
    value := @ d state.
    (value = 'blocked') ifTrue: [
      previous := @ d run.
      (previous notEmpty) ifTrue: [
        oldData := @ Store getInstance: previous.
        value := oldData objectAt: 'state'.
        same := @ Require contains: value in: '["starting","running","recovering"]'.
        (same = 'true') ifTrue: [^ 'false']
      ]
    ].
    questions := @ AgentQueue unansweredForAssignment: a.
    (questions = '[]') ifFalse: [^ 'false'].
    attempts := @ d attempts.
    attempts := attempts + 1.
    @ d state: 'offered'.
    @ d run: run.
    @ d attempts: attempts.
    @ d save.
    runs := participation jsonAt: 'runs'.
    same := @ Require contains: run in: runs.
    (same = 'false') ifTrue: [
      runs := runs arrayPush: run.
      participation := participation objectAt: 'runs' putJson: runs.
      gen := @ a generation.
      updated := '[]'.
      history arrayEach: [:entry |
        same := @ String equals: (entry objectAt: 'generation') to: gen.
        (same = 'true') ifTrue: [updated := updated arrayPushJson: participation] ifFalse: [updated := updated arrayPushJson: entry]
      ].
      @ a history: updated.
      @ a save
    ].
    ^ 'true'
  ]
