# Assignment - Durable responsibility, independent of any one agent session.
# Manual work publication does not launch a harness. Store transactions make
# ordinary object saves and queue publication one atomic unit of work.
Assignment subclass: Object
  include: Persistable
  include: StateMachine
  include: Assignment::Authority
  include: Assignment::Presentation
  include: Assignment::Reporting
  include: Assignment::Notifications
  instanceVars: objective:'' completionCriteria:'' requester:'' requesterSession:''
                owner:'' originMessage:'' workspace:'' assignee:'' state:'open'
                currentSession:'' generation:0 delivery:'' history:'[]' events:'[]'
                externalIssue:'' result:'' resultMessage:'' cancellationNote:''
                created:'' completedAt:'' dispatchMode:'manual'
                requestKey:'' originRun:'' delegationTarget:'' statusMessage:''

  method: transitionRules [ ^ '["open:completed","open:cancelled"]' ]

  classMethod: draft: objective in: workspace [
    | args |
    @ Agent::Queue ensureSchema.
    args := #{objective: objective workspace: workspace} asJson.
    ^ @ Store transaction: self sending: 'draftWithin:' with: args
  ]

  classMethod: draftWithin: args [
    | actor human a objective path now |
    @ Store requireTransaction.
    actor := @ Agent::Run actingContext.
    human := actor objectAt: 'human'.
    @ Require text: human.
    objective := args objectAt: 'objective'.
    @ Require text: objective.
    path := @ Agent::Session workspaceFor: (args objectAt: 'workspace').
    a := @ self new.
    now := @ Time nowISO.
    @ a objective: objective.
    @ a completionCriteria: objective.
    @ a workspace: path.
    @ a requester: human.
    @ a owner: human.
    @ a created: now.
    # Not redundant with the defaults: readers of the stored record (and the
    # tests) expect these fields present as '' rather than absent.
    @ a requesterSession: ''.
    @ a originMessage: ''.
    @ a assignee: ''.
    @ a currentSession: ''.
    @ a delivery: ''.
    @ a externalIssue: ''.
    @ a result: ''.
    @ a resultMessage: ''.
    @ a cancellationNote: ''.
    @ a completedAt: ''.
    @ a save.
    ^ a
  ]

  method: assignTo: identity [
    ^ @ Store transaction: self sending: 'assignWithin:' with: identity
  ]

  method: assignWithin: identity [
    | actor sender i data current allowed owner |
    actor := @ Agent::Run actingContext.
    sender := @ self authorize: actor operatorOnly: true.
    @ self requireOpen.
    i := @ Store read: identity class: 'Agent::Identity'.
    data := @ i asJson.
    @ Require member: (data objectAt: 'enabled') of: '["true","1"]'.
    owner := data objectAt: 'owner'.
    (owner isEmpty) ifTrue: [owner := @ self owner].
    @ Require equal: owner to: sender.
    current := @ self assignee.
    (current notEmpty) ifTrue: [@ Require equal: current to: i].
    @ self assignee: i.
    @ self save.
    ^ self
  ]

  method: requireOpen [
    | state |
    @ Store requireTransaction.
    state := @ self state.
    @ Require equal: state to: 'open'
  ]

  method: criteria: text [
    | args |
    args := #{field: 'completionCriteria' value: text} asJson.
    ^ @ Store transaction: self sending: 'describeWithin:' with: args
  ]

  # Opaque tracker reference; no synchronization with an external work item.
  method: issueReference: reference [
    | args |
    args := #{field: 'externalIssue' value: reference} asJson.
    ^ @ Store transaction: self sending: 'describeWithin:' with: args
  ]

  method: describeWithin: args [
    | actor sender field value generation |
    actor := @ Agent::Run actingContext.
    sender := @ self authorize: actor operatorOnly: true.
    @ self requireOpen.
    generation := @ self generation.
    @ Require equal: generation to: '0'.
    field := args objectAt: 'field'.
    value := args objectAt: 'value'.
    @ Require member: field of: '["completionCriteria","externalIssue"]'.
    (field = 'completionCriteria') ifTrue: [
      @ Require text: value.
      @ self completionCriteria: value
    ] ifFalse: [@ self externalIssue: value].
    @ self save.
    ^ self
  ]

  method: origin: message [
    ^ @ Store transaction: self sending: 'originWithin:' with: message
  ]

  method: originWithin: message [
    | actor sender m data sent generation requester session fields ids count |
    actor := @ Agent::Run actingContext.
    sender := @ self authorize: actor operatorOnly: true.
    @ self requireOpen.
    generation := @ self generation.
    @ Require equal: generation to: '0'.
    m := @ Store read: message class: 'Message'.
    sent := @ m sentAt.
    (sent > 0) ifFalse: [^ @ Require reject: 'Origin must be a sent Message'].
    requester := @ m from.
    session := @ m originSession.
    (session notEmpty) ifTrue: [
      data := @ Store getInstance: session.
      requester := data objectAt: 'identity'
    ] ifFalse: [
      fields := #{inbox: requester} asJson.
      ids := @ Store idsOf: 'Agent::Identity' matching: fields.
      count := ids arrayLength.
      (count > 0) ifTrue: [requester := ids arrayFirst]
    ].
    @ self originMessage: m.
    @ self requester: requester.
    @ self requesterSession: session.
    @ self save.
    ^ self
  ]

  method: workIn: session [
    @ Agent::Queue ensureSchema.
    ^ @ Store transaction: self sending: 'selectWithin:' with: session replaying: true
  ]

  method: selectWithin: session [
    ^ @ Assignment::Participation select: session for: self
  ]

  method: complete: outcome [
    | args |
    @ Agent::Queue ensureSchema.
    args := #{outcome: outcome cancel: 'false'} asJson.
    ^ @ Store transaction: self sending: 'finishWithin:' with: args replaying: true
  ]

  # Cancel always closes: it first stops the run working this Assignment,
  # then skips the current delivery in whatever state it is.
  method: cancel: reason [
    | args again |
    (reason isEmpty) ifTrue: [^ @ Require reject: 'cancel: requires a reason'].
    @ Agent::Queue ensureSchema.
    # The worker may resume the work in a new run between lookup and stop;
    # look again once before giving up.
    again := 'false'.
    (@ self stopActiveRun) ifFailed: [:e | again := 'true'].
    (again = 'true') ifTrue: [(@ self stopActiveRun) ifFailed: [:e | @ e signal] ].
    args := #{outcome: reason cancel: 'true'} asJson.
    (@ Store transaction: self sending: 'finishWithin:' with: args replaying: true) ifFailed: [:e | @ e signal].
    @ self reopenAfterStop.
    ^ self
  ]

  # Stop the run working this Assignment, if any, after checking authority.
  method: stopActiveRun [
    | run |
    run := (@ Store transaction: self sending: 'activeRunWithin:' with: '') ifFailed: [:e | @ e signal].
    (run isEmpty) ifTrue: [^ 'none'].
    (@ run stop) ifFailed: [:e | @ e signal].
    ^ 'stopped'
  ]

  # Stopping a run pauses its session. Reopen it once nothing runs there, so
  # queued work behind a stopped Assignment continues.
  method: reopenAfterStop [
    | d run session state active |
    d := @ self delivery.
    (d isEmpty) ifTrue: [^ ''].
    run := @ d run.
    (run isEmpty) ifTrue: [^ ''].
    state := @ run stopRequested.
    (state = 'true') ifFalse: [^ ''].
    session := @ run session.
    state := @ session lifecycleState.
    (state = 'paused') ifFalse: [^ ''].
    active := @ session activeRun.
    (active isEmpty) ifTrue: [@ session resume].
    ^ ''
  ]

  # The live run holding this Assignment's current delivery, after checking
  # cancel authority so an unauthorized caller never stops anything.
  method: activeRunWithin: unused [
    | actor d run state active |
    @ Store requireTransaction.
    actor := @ Agent::Run actingContext.
    @ self authorizeCoordinator: actor.
    state := @ self state.
    (state = 'open') ifFalse: [^ ''].
    d := @ self delivery.
    (d isEmpty) ifTrue: [^ ''].
    d := @ Store read: d class: 'Agent::Delivery'.
    run := @ d run.
    (run isEmpty) ifTrue: [^ ''].
    run := @ Store read: run class: 'Agent::Run'.
    state := @ run state.
    active := @ Agent::Run isActiveState: state.
    (active = 'true') ifTrue: [^ run].
    ^ ''
  ]

  method: finishWithin: args [
    | actor sender run cancel outcome target state previous session data d dState questions message now event assignee unassigned held active |
    actor := @ Agent::Run actingContext.
    cancel := args objectAt: 'cancel'.
    @ Require member: cancel of: '["true","false"]'.
    (cancel = 'true') ifTrue: [sender := @ self authorizeCoordinator: actor] ifFalse: [sender := @ self authorize: actor operatorOnly: 'false'].
    outcome := args objectAt: 'outcome'.
    @ Require text: outcome.
    target := 'completed'.
    previous := @ self result.
    (cancel = 'true') ifTrue: [target := 'cancelled'. previous := @ self cancellationNote].
    state := @ self state.
    (state = 'open') ifFalse: [
      @ Require equal: state to: target.
      @ Require equal: previous to: outcome.
      ^ self
    ].
    @ self requireTransitionFrom: state to: target.
    session := @ self currentSession.
    assignee := @ self assignee.
    data := @ self asJson.
    d := data objectAt: 'delivery'.
    unassigned := (assignee isEmpty) and: [session isEmpty].
    run := ''.
    (unassigned = 'true') ifTrue: [
      # A human-owned draft is a ticket before it is entrusted to any agent.
      # It has no delivery to settle and can be closed with a recorded outcome.
      @ Require equal: d to: ''
    ] ifFalse: [
      run := actor objectAt: 'run'.
      # Only the run working this Assignment fences it; other queued work in
      # the same session does not. Any delivery state may be closed.
      (d notEmpty) ifTrue: [
        d := @ Store read: d class: 'Agent::Delivery'.
        held := @ d run.
        (held notEmpty) ifTrue: [(held ~= run) ifTrue: [
          held := @ Store read: held class: 'Agent::Run'.
          state := @ held state.
          active := @ Agent::Run isActiveState: state.
          (active = 'true') ifTrue: [^ @ Require reject: 'Stop the Assignment run ' , held , ' before finishing it']
        ] ]
      ].
      (cancel = 'false') ifTrue: [
      @ Require text: assignee.
      @ Require text: session.
      questions := @ Agent::Queue unansweredForAssignment: self.
      @ Require equal: questions to: '[]'
      ]
    ].
    message := @ Message outcomeForAssignment: self body: outcome sender: sender cancelled: cancel.
    (d notEmpty) ifTrue: [
      dState := 'processed'.
      (cancel = 'true') ifTrue: [dState := 'skipped'].
      @ d state: dState.
      @ d note: outcome.
      @ d save
    ].
    now := @ Time nowISO.
    event := #{kind: target body: outcome actor: sender run: run at: now} asJson.
    @ self appendEvent: event.
    @ self state: target.
    (cancel = 'true') ifTrue: [@ self cancellationNote: outcome] ifFalse: [@ self result: outcome].
    @ self completedAt: now.
    @ self resultMessage: message.
    @ self save.
    @ Agent::Queue publishOutcome: message.
    ^ self
  ]

  # Turns an Assignment gets before it needs review (assignment.attempts).
  classMethod: attemptLimit [
    | value |
    value := @ AssignmentSettings attempts ifFailed: [^ 4].
    (value matches: '^[1-9][0-9]{0,2}$') ifTrue: [^ value].
    ^ 4
  ]

  # The one recovery verb: requeue failed or uncertain work for a fresh set of
  # attempts. The owner or the requesting coordinator decides after review.
  method: retry [
    @ Agent::Queue ensureSchema.
    # Authorize first; a stop of this Assignment's run left its session paused.
    (@ Store transaction: self sending: 'activeRunWithin:' with: '') ifFailed: [:e | @ e signal].
    @ self reopenAfterStop.
    ^ @ Store transaction: self sending: 'retryWithin:' with: ''
  ]

  method: retryWithin: unused [
    | actor sender d state run active questions now event |
    @ Store requireTransaction.
    actor := @ Agent::Run actingContext.
    sender := @ self authorizeCoordinator: actor.
    @ self requireOpen.
    d := @ self currentSession.
    d := @ Store read: d class: 'Agent::Session'.
    state := @ d lifecycleState.
    (state = 'open') ifFalse: [^ @ Require reject: 'Session ' , d , ' is ' , state , '; resume it, or cancel: this Assignment'].
    @ Assignment::Participation eligibleSession: d for: self.
    d := @ self delivery.
    d := @ Store read: d class: 'Agent::Delivery'.
    state := @ d state.
    active := @ Require contains: state in: '["failed","uncertain"]'.
    (active = 'true') ifFalse: [^ @ Require reject: 'Only failed or uncertain Assignment work can be retried; it is ' , state].
    run := @ d run.
    (run notEmpty) ifTrue: [
      run := @ Store read: run class: 'Agent::Run'.
      state := @ run state.
      active := @ Agent::Run isActiveState: state.
      (active = 'true') ifTrue: [^ @ Require reject: 'Stop the Assignment run ' , run , ' before retrying']
    ].
    questions := @ Agent::Queue unansweredForAssignment: self.
    (questions ~= '[]') ifTrue: [^ @ Require reject: 'Answer the Assignment question before retrying'].
    @ d state: 'pending'.
    @ d attempts: 0.
    @ d lastError: ''.
    @ d save.
    now := @ Time nowISO.
    event := #{kind: 'retried' body: 'Retried after review' actor: sender run: (actor objectAt: 'run') at: now} asJson.
    @ self appendEvent: event.
    @ self save.
    ^ d
  ]

  classMethod: current [
    @ Agent::Queue ensureSchema.
    ^ @ Store transaction: self sending: 'currentWithin:' with: ''
  ]

  classMethod: currentWithin: unused [
    | actor run selected human ids fields candidates data a d dData state linked sender count |
    @ Store requireTransaction.
    actor := @ Agent::Run actingContext.
    run := actor objectAt: 'run'.
    selected := @ Env get: 'TRASHTALK_ASSIGNMENT_ID'.
    candidates := '[]'.
    (run isEmpty) ifTrue: [
      @ Require text: selected.
      candidates := candidates arrayPush: selected
    ] ifFalse: [
      fields := #{run: run state: #('offered' 'blocked')} asJson.
      ids := @ Store idsOf: 'Agent::Delivery' matching: fields.
      ids arrayEach: [:id |
        d := @ Store read: id class: 'Agent::Delivery'.
        data := @ d asJson.
        a := data objectAt: 'assignment'.
        (a notEmpty) ifTrue: [
          a := @ Store read: a class: 'Assignment'.
          data := @ a asJson.
          linked := data objectAt: 'delivery'.
          state := data objectAt: 'state'.
          ((linked = id) and: [state = 'open']) ifTrue: [
            ((selected isEmpty) or: [a = selected]) ifTrue: [candidates := candidates arrayPush: a]
          ]
        ]
      ]
    ].
    count := candidates arrayLength.
    @ Require equal: count to: '1'.
    a := candidates arrayFirst.
    a := @ Store read: a class: 'Assignment'.
    sender := @ a authorize: actor operatorOnly: false.
    @ a requireOpen.
    ^ a
  ]

  classMethod: claim: delivery run: run [
    | args |
    @ Agent::Queue ensureSchema.
    args := #{delivery: delivery run: run} asJson.
    ^ @ Store transaction: 'Assignment::Participation' sending: 'claimWithin:' with: args replaying: true
  ]
