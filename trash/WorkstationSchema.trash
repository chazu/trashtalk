# Trusted CUE process boundary. Never execute CUE in a Store transaction.
WorkstationSchema subclass: Object
  rawClassMethod: digest [
    local root="${TRASHTALK_DIR:-$HOME/.trashtalk}/schemas/workstation/v1"
    { cat "$root/contracts.cue"; for name in Attention CommandReceipt Coordinate Envelope EventSubscription SafeDisplay; do cat "$root/roots/$name.cue"; done; } | shasum -a 256 | cut -d ' ' -f 1
  ]
  rawClassMethod: validate: json as: root [
    [[ -z ${_STORE_TX:-} && ${_STORE_SNAPSHOT_MODE:-0} == 0 ]] || { _throw TransactionError 'CUE validation must precede Store transactions'; return 1; }
    case "$2" in EventSubscription|Attention|Coordinate|CommandReceipt|SafeDisplay|Envelope) ;; *) _throw WorkstationSchemaError 'Unknown schema root'; return 1;; esac
    local path="${TRASHTALK_DIR:-$HOME/.trashtalk}/schemas/workstation/v1" files result outcome diagnostics digest marker
    # Process-local success memo: bytes this schema digest already vetted in
    # this runtime are valid again. Only a hash is stored; failures never are.
    digest=$(@ "$_RECEIVER" digest) || return
    marker="${_ENV_DIR:-}/cue-vetted/$(printf '%s\n%s\n%s' "$digest" "$2" "$1" | shasum -a 256 | cut -d ' ' -f 1)"
    if [[ -n ${_ENV_DIR:-} && -f "$marker" ]]; then printf '%s\n' "$1"; return 0; fi
    files=$(jq -cn --arg a "$path/contracts.cue" --arg b "$path/roots/$2.cue" '[$a,$b]') || return
    result=$(@ Tools::Cue vet: "$files" json: "$1") || return
    outcome=$(printf '%s' "$result" | jq -r .outcome)
    [[ "$outcome" != missing_tool ]] || { _throw WorkstationSchemaError 'Workstation CUE unavailable; go install cuelang.org/go/cmd/cue@latest'; return 1; }
    if [[ "$outcome" != success ]]; then
      # Only field-path prefixes, never values, source excerpts or filenames.
      diagnostics=$(printf '%s' "$result" | jq -r '.stderr | split("\n") | map(try capture("^(?<p>[A-Za-z_][A-Za-z0-9_.]{0,100}):").p catch empty) | unique | .[:8] | join(", ")')
      _throw WorkstationSchemaError "Workstation schema rejected ($2): ${diagnostics:-invalid document}"
      printf 'Workstation schema rejected (%s): %s\n' "$2" "${diagnostics:-invalid document}" >&2
      return 1
    fi
    [[ -z ${_ENV_DIR:-} ]] || { mkdir -p "$_ENV_DIR/cue-vetted" && : > "$marker"; } 2>/dev/null
    printf '%s\n' "$1"
  ]

  # Dynamic scope carries the exact vetted document into a short transaction.
  # This is an internal precondition, not a sandbox against arbitrary Bash.
  rawClassMethod: transact: json as: root sending: selector [
    case "$2:$3" in 'EventSubscription:createWithin:'|'EventSubscription:updateWithin:'|'Attention:createWithin:'|'Attention:transitionWithin:'|'Attention:delegateWithin:') ;; *) _throw WorkstationSchemaError 'Unknown workstation mutation'; return 1;; esac
    local checked digest
    checked=$(@ "$_RECEIVER" validate: "$1" as: "$2") || return
    digest=$(@ "$_RECEIVER" digest) || return
    [[ $(printf '%s' "$checked" | jq -r .schemaDigest) == "$digest" ]] || { _throw WorkstationSchemaError 'Workstation schema digest mismatch'; return 1; }
    @ WorkstationSchema ensureSchema || return
    _WORKSTATION_VALIDATED_JSON="$checked" @ Store transaction: "$2" sending: "$3" with: "$checked"
  ]

  rawClassMethod: requireValidated: json [
    @ Store requireTransaction || return
    [[ -n ${_WORKSTATION_VALIDATED_JSON:-} && "$1" == "$_WORKSTATION_VALIDATED_JSON" ]] || { _throw WorkstationSchemaError 'Mutation requires the exact prevalidated document'; return 1; }
  ]

  # Same idempotent DDL installation boundary as AgentSession.ensureSchema.
  rawClassMethod: ensureSchema [
    [[ -z ${_STORE_TX:-} ]] || { _throw TransactionError 'Install workstation schema before transactions'; return 1; }
    _db_sql -bail < "${TRASHTALK_DIR:-$HOME/.trashtalk}/lib/workstation-schema.sql"
  ]

  # JSON projection/merge are a reusable serializer boundary, not domain logic.
  # Phase 2 routing fields are optional: records written before they existed,
  # or loaded through lazy null defaults, project as an unrouted group.
  rawClassMethod: document: data [
    printf '%s' "$1" | jq -ce 'del(.class,._vars,.created_at)
      | if has("state") then (.workspace //= "" | .lineageDepth //= 0 | .delegationRevision //= 0
          | .delegatedMessage //= "" | .delegatedSession //= "" | .delegatedIdentity //= "" | .routingNote //= ""
          | .origin = (if .origin == "null" then null else .origin end)) else . end
      | if has("adapterKind") then .delegation //= {} else . end'
  ]
  rawClassMethod: merge: data with: patch [
    printf '%s' "$1" | jq -ce --argjson patch "$2" '. + $patch'
  ]

  # jq's UTC parser plus round trip rejects impossible and non-normalized dates.
  rawClassMethod: timestampEpoch: timestamp [
    printf '%s' "$1" | jq -Rer '. as $s | fromdateiso8601 | select(todateiso8601 == $s)'
  ]

  # Preserve explicit JSON null coordinates, unlike SQLite json_patch (null deletes).
  classMethod: write: document to: id [
    | data |
    @ Store requireTransaction.
    data := @ Store getInstance: id.
    data := @ self merge: data with: document.
    @ Store put: id data: data.
    @ Runtime setData: data for: id
  ]

  # JSON min/max serializer. A range is meaningful only within one partition.
  rawClassMethod: extend: data coordinate: coordinate [
    printf '%s' "$1" | jq -ce --argjson c "$2" '
      if .eventCount>0 and (.firstCoordinate.partition!=$c.partition or .firstCoordinate.streamName!=$c.streamName)
      then error("Attention range must remain in one stream partition") else
      {eventCount:(.eventCount+1),
       firstCoordinate:(if .firstCoordinate==null or $c.offset<.firstCoordinate.offset then $c else .firstCoordinate end),
       lastCoordinate:(if .lastCoordinate==null or $c.offset>.lastCoordinate.offset then $c else .lastCoordinate end)} end'
  ]

  # Optional capability probe only. No bootstrap, stream read, ack or install.
  rawClassMethod: streamAvailable [
    local count
    count=$(_db_sql "SELECT count(DISTINCT name) FROM pragma_function_list WHERE name IN ('honker_stream_publish','honker_stream_read_since','honker_stream_save_offset','honker_stream_get_offset');" 2>/dev/null) || count=0
    [[ "$count" == 4 ]] && echo true || echo false
  ]
  classMethod: capabilities [
    | cue stream |
    cue := @ Tools::Cue isInstalled.
    stream := @ self streamAvailable.
    ^ #{cue: (cue jsonValue) stream: (stream jsonValue)} asJson
  ]

  # SHA-256 is a reusable OS digest boundary for opaque canonical group keys.
  rawClassMethod: hash: text [
    printf '%s' "$1" | shasum -a 256 | cut -d ' ' -f 1
  ]
