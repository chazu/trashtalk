# Actor - Mailbox-style actor using Honker work queues
# Each actor has a named queue. Messages are enqueued and processed
# sequentially by a background dispatcher. Honker provides at-least-once
# delivery with retries and dead-lettering.
#
# Usage:
#   actor=$(@ Actor named: 'order-processor')
#   @ $actor start                        # start background dispatcher
#   @ $actor send: 'processOrder' with: '42'
#   @ $actor send: 'cleanup'
#   @ $actor pendingCount                 # check mailbox depth
#   @ $actor stop                         # stop dispatcher

Actor subclass: Object
  include: Persistable
  include: Debuggable
  instanceVars: queueName:'' dispatcherPid:'' status:'idle' maxRetries:3 workerId:''

  # Create an actor with a named mailbox queue
  rawClassMethod: named: name [
    local id
    id=$(_generate_instance_id Actor)
    _create_instance Actor "$id"
    @ "$id" queueName: "actor.$1"
    @ "$id" workerId: "actor_worker_$$_$RANDOM"
    echo "$id"
  ]

  # Send a message (no arguments) to this actor's mailbox
  method: send: selector [
    | message |
    message := #{selector: selector receiver: self args: #()} asJson.
    ^ @ self sendRaw: message
  ]

  # Send a message with one argument
  method: send: selector with: arg [
    | message |
    message := #{selector: selector receiver: self args: #(arg)} asJson.
    ^ @ self sendRaw: message
  ]

  # Send a message with two arguments
  method: send: selector with: arg1 and: arg2 [
    | message |
    message := #{selector: selector receiver: self args: #(arg1 arg2)} asJson.
    ^ @ self sendRaw: message
  ]

  # Send a raw JSON payload (for custom message formats)
  method: sendRaw: payload [
    ^ @ Honker enqueue: queueName payload: payload
  ]

  # Start the background message dispatcher
  rawMethod: start [
    pragma: direct
    local queue worker_id receiver
    queue=$(_ivar queueName)
    worker_id=$(_ivar workerId)
    receiver="$_RECEIVER"

    (
      while true; do
        local claimed
        claimed=$(honker_claim "$queue" "$worker_id" 1 30)

        if [[ -n "$claimed" && "$claimed" != "[]" && "$claimed" != "null" ]]; then
          # One decode yields the job id, selector, receiver, then each
          # argument, NUL-separated so arguments keep spaces and newlines.
          local -a fields
          local job_id selector recv
          mapfile -d '' -t fields < <(jq -j '.[0] // {}
            | (.payload // "" | fromjson? // {}) as $p
            | [(.id // "" | tostring), ($p.selector // ""), ($p.receiver // "")]
              + [($p.args // [])[] | tostring]
            | map(. + "\u0000") | add' <<< "$claimed" 2>/dev/null)
          job_id="${fields[0]}"
          selector="${fields[1]}"
          recv="${fields[2]}"

          if [[ -n "$selector" && -n "$recv" ]]; then
            if @ "$recv" "$selector" "${fields[@]:3}" 2>/dev/null; then
              [[ -n "$job_id" ]] && honker_ack "[$job_id]" "$worker_id"
            else
              honker_sweep "$queue"
            fi
          elif [[ -n "$job_id" ]]; then
            honker_ack "[$job_id]" "$worker_id"
          fi
        else
          sleep 0.1
        fi
      done
    ) &

    _ivar_set dispatcherPid "$!"
    _ivar_set status "running"
  ]

  # Stop the dispatcher
  rawMethod: stop [
    pragma: direct
    local pid
    pid=$(_ivar dispatcherPid)
    if [[ -n "$pid" ]]; then
      kill "$pid" 2>/dev/null
      wait "$pid" 2>/dev/null
    fi
    _ivar_set status "stopped"
    _ivar_set dispatcherPid ""
  ]

  # Check if the dispatcher is running
  method: isRunning [
    dispatcherPid isEmpty ifTrue: [^ 'false'].
    ^ @ Tool isAlivePid: dispatcherPid
  ]

  # Get the current status
  method: status [
    | alive |
    (status = 'running') ifFalse: [^ status].
    dispatcherPid isEmpty ifTrue: [^ status].
    alive := @ Tool isAlivePid: dispatcherPid.
    (alive = 'true') ifTrue: [^ status].
    status := 'crashed'.
    ^ status
  ]

  # Get the number of pending messages in the mailbox
  rawMethod: pendingCount [
    local queue
    queue=$(_ivar queueName)
    _db_sql "SELECT COUNT(*) FROM _honker_live WHERE queue = '$queue' AND state = 'pending';" 2>/dev/null || echo "0"
  ]

  # Clean up: stop dispatcher and delete
  method: destroy [
    @ self stop.
    @ self delete
  ]

  classMethod: help [
    ^ '''=== Actor - Mailbox Message Processing ===

Create:
  actor=$(@ Actor named: 'processor')

Start dispatcher:
  @ $actor start

Send messages:
  @ $actor send: 'processOrder'
  @ $actor send: 'processOrder' with: '42'
  @ $actor send: 'transfer' with: 'from' and: 'to'
  @ $actor sendRaw: '{"custom":"payload"}'

Monitor:
  @ $actor isRunning
  @ $actor status      # idle/running/stopped/crashed
  @ $actor pendingCount

Stop:
  @ $actor stop
  @ $actor destroy'''
  ]
