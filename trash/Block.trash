Block subclass: Object
  instanceVars: params code captured

  # Create a new block with parameters, code, and captured variables
  # params: JSON array of parameter names ["x", "y"]
  # code: string of code to execute
  # captured: JSON object of captured variables {"_RECEIVER": "counter_abc123"}
  rawClassMethod: params: p code: c captured: cap [
    local id p="$1" c="$2" cap="$3"
    id=$(_generate_instance_id Block)
    _create_instance Block "$id"
    @ "$id" params: "$p"
    @ "$id" code: "$c"
    @ "$id" captured: "$cap"
    echo "$id"
  ]

  # Binding dynamic Bash names and evaluating compiled block code are a shell
  # boundary. The shared primitive decodes the current block state once.
  rawMethod: value [
    pragma: direct
    _trash_block_invoke
  ]

  rawMethod: valueWith: arg [
    pragma: direct
    _trash_block_invoke "$1"
  ]

  rawMethod: valueWith: a and: b [
    pragma: direct
    _trash_block_invoke "$1" "$2"
  ]

  # Return number of parameters
  rawMethod: numArgs [
    local p
    p=$(@ "$_RECEIVER" params)
    echo "$p" | jq 'length'
  ]
