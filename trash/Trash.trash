# Trash - The system object representing the entire trash system
# Provides introspection, management, and system-wide operations
Trash subclass: Object
  include: Debuggable

  # Get system information
  rawMethod: info [
    echo "=== Trash System Information ==="
    echo "Version: 0.1.0"
    echo "Directory: $TRASHDIR"
    echo "Objects: $(@ self listObjects | wc -l)"
    echo "Traits: $(@ self listTraits | wc -l)"
    echo "Active Processes: $(@ Process listProcesses | wc -l)"
    echo "Database: $SQLITE_JSON_DB"
  ]

  # Diagnose the environment: bash, required tools, sqlite3 extension support,
  # and whether classes have been compiled. Exits non-zero if any check fails.
  rawMethod: doctor [
    local ok=0 warn=0 bad=0
    local g='\033[0;32m' y='\033[0;33m' r='\033[0;31m' n='\033[0m'
    _d_ok()   { echo -e "  ${g}OK${n}   $1"; ok=$((ok+1)); }
    _d_warn() { echo -e "  ${y}WARN${n} $1"; warn=$((warn+1)); }
    _d_bad()  { echo -e "  ${r}FAIL${n} $1"; bad=$((bad+1)); }

    echo "=== Trashtalk Doctor ==="

    # bash 4.0+
    if [[ "${BASH_VERSINFO[0]}" -ge 4 ]]; then
      _d_ok "bash ${BASH_VERSION%%(*} (>= 4.0)"
    else
      _d_bad "bash ${BASH_VERSION%%(*} too old; need 4.0+ (macOS: brew install bash)"
    fi

    # required tools
    local tool
    for tool in jo jq sqlite3 uuidgen; do
      if command -v "$tool" >/dev/null 2>&1; then
        _d_ok "$tool found ($(command -v "$tool"))"
      else
        _d_bad "$tool missing (macOS: brew install jo jq sqlite; uuidgen is built in)"
      fi
    done

    # Innards is optional; edit/page/browse each retain a terminal fallback.
    if command -v inmacs >/dev/null 2>&1 && command -v inpage >/dev/null 2>&1; then
      _d_ok "Innards found (inmacs and inpage)"
    else
      _d_warn "Innards not found; edit/page workflows use VISUAL/EDITOR and PAGER fallbacks"
    fi
    if command -v inpick >/dev/null 2>&1; then
      _d_ok "Innards picker found (inpick)"
    elif command -v fzf >/dev/null 2>&1; then
      _d_warn "inpick not found; browser workflows use the fzf fallback"
    else
      _d_warn "inpick and fzf not found; install Innards or fzf for interactive browsing"
    fi
    if command -v ininspect >/dev/null 2>&1; then
      _d_ok "Innards object inspector found (ininspect)"
    else
      _d_warn "ininspect not found; objects retain textual inspect output"
    fi

    # The selected @@ backend is optional. Installation and authentication stay
    # explicit because they belong to the external harness.
    local agent_backend="${TRASHTALK_AGENT_BACKEND:-axe}" agent_auth
    case "$agent_backend" in
      codex|CodexAgent)
        if command -v codex >/dev/null 2>&1; then
          _d_ok "Codex found ($(command -v codex)); @@ backend selected"
          if agent_auth=$(codex login status 2>&1) && [[ "$agent_auth" == *ChatGPT* ]]; then
            _d_ok "$agent_auth; subscription-backed @@ is available"
          else
            _d_warn "Codex is not authenticated with ChatGPT; run: codex login (${agent_auth:-status unavailable})"
          fi
        else
          _d_warn "Codex backend selected but codex is not installed"
        fi
        ;;
      axe|AxeAgent)
        if command -v axe >/dev/null 2>&1; then
          _d_ok "Axe found ($(command -v axe)); @@ backend selected"
        else
          _d_warn "Axe backend selected but axe is not installed (install explicitly with: go install github.com/jrswab/axe@latest)"
        fi
        ;;
      *)
        _d_warn "Unknown TRASHTALK_AGENT_BACKEND '$agent_backend'; @@ falls back to AxeAgent"
        ;;
    esac
    if command -v indiff >/dev/null 2>&1 && command -v patch >/dev/null 2>&1; then
      _d_ok "proposal review found (indiff and patch)"
    else
      _d_warn "proposal review unavailable; install Innards indiff and patch to review source proposals"
    fi

    # sqlite3 binary actually in use + honker extension loadability
    echo "  sqlite3 in use: ${_SQLITE3:-sqlite3}"
    local ext_suffix ext_base ext_path ext_found=""
    [[ "$(uname)" == "Darwin" ]] && ext_suffix="dylib" || ext_suffix="so"
    for ext_base in "$HONKER_EXT" "$HOME/.trashtalk/lib/vendor/honker/libhonker_ext" "/usr/local/lib/libhonker_ext" "/opt/homebrew/lib/libhonker_ext"; do
      [[ -n "$ext_base" && -f "${ext_base}.${ext_suffix}" ]] && { ext_found="${ext_base}.${ext_suffix}"; break; }
    done
    if [[ -z "$ext_found" ]]; then
      _d_warn "honker extension not installed (optional; run bin/install-honker)"
    elif "${_SQLITE3:-sqlite3}" ":memory:" ".load ${ext_found}" "SELECT 1;" >/dev/null 2>&1; then
      _d_ok "honker extension loadable via ${_SQLITE3:-sqlite3}"
    else
      _d_warn "honker found but ${_SQLITE3:-sqlite3} can't load it; install extension-capable sqlite3 (brew install sqlite) and set TRASH_SQLITE3"
    fi

    # compiled classes present
    local nclasses
    nclasses=$(find "$TRASHDIR/.compiled" -maxdepth 1 -type f 2>/dev/null | wc -l | tr -d ' ')
    if [[ "${nclasses:-0}" -gt 0 ]]; then
      _d_ok "$nclasses compiled classes in $TRASHDIR/.compiled"
    else
      _d_bad "no compiled classes in $TRASHDIR/.compiled -- run 'make'"
    fi

    echo ""
    echo "Summary: $ok ok, $warn warning(s), $bad problem(s)"
    [[ $bad -eq 0 ]]
  ]

  # List all available objects (compiled classes)
  rawMethod: listObjects [
    find "$TRASHDIR/.compiled" -maxdepth 1 -type f 2>/dev/null | while read -r file; do
      basename "$file"
    done | sort
  ]

  # List all available traits (compiled traits)
  rawMethod: listTraits [
    if [[ -d "$TRASHDIR/.compiled/traits" ]]; then
      find "$TRASHDIR/.compiled/traits" -type f 2>/dev/null | while read -r file; do
        basename "$file"
      done | sort
    fi
  ]

  # Get methods available on a class
  rawMethod: methodsFor: class_name [
    local compiled_file="$TRASHDIR/.compiled/$class_name"
    local runtime_file="$TRASHDIR/$class_name"

    # Check for compiled or runtime class file
    if [[ -f "$compiled_file" ]]; then
      source "$compiled_file"
    elif [[ -f "$runtime_file" ]]; then
      source "$runtime_file"
    else
      echo "Class $class_name not found"
      return 1
    fi

    echo "Methods for $class_name:"
    # List functions defined for this class
    declare -F | awk '{print $3}' | grep "^__${class_name}__" | grep -v "__class__" | sed "s/__${class_name}__/  /"

    # Show class methods
    echo "Class methods:"
    declare -F | awk '{print $3}' | grep "^__${class_name}__class__" | sed "s/__${class_name}__class__/  /"

    # Show trait methods
    local traits_var="__${class_name}__traits"
    local traits="${!traits_var:-}"
    if [[ -n "$traits" ]]; then
      for trait in $traits; do
        local trait_file="$TRASHDIR/.compiled/traits/$trait"
        if [[ -f "$trait_file" ]]; then
          source "$trait_file"
          echo ""
          echo "From trait $trait:"
          declare -F | awk '{print $3}' | grep "^__${trait}__" | grep -v "__class__" | sed "s/__${trait}__/  /"
          # Trait class methods
          local trait_class_methods
          trait_class_methods=$(declare -F | awk '{print $3}' | grep "^__${trait}__class__" | sed "s/__${trait}__class__/  /")
          if [[ -n "$trait_class_methods" ]]; then
            echo "  (class methods):"
            echo "$trait_class_methods" | sed 's/^/  /'
          fi
        fi
      done
    fi

    # Show inherited methods
    local super_var="__${class_name}__superclass"
    local superclass="${!super_var:-}"
    if [[ -n "$superclass" && "$superclass" != "nil" && "$superclass" != "Object" ]]; then
      echo ""
      echo "(inherited from $superclass)"
      @ "$_RECEIVER" methodsFor: "$superclass" | sed 's/^/  /'
    fi
  ]

  # Get methods in a specific category for a class
  rawMethod: methodsIn: class_name category: cat_name [
    # Get compiled class metadata
    local compiled_file="$TRASHDIR/.compiled/$class_name"
    if [[ ! -f "$compiled_file" ]]; then
      echo "Error: Class $class_name not found"
      return 1
    fi

    # Source the class to get metadata
    source "$compiled_file"

    # Get method categories metadata
    local cats_var="__${class_name}__methodCategories"
    local cats="${!cats_var:-}"

    if [[ -z "$cats" ]]; then
      echo "No categorized methods for $class_name"
      return 0
    fi

    # Parse and filter by category
    echo "Methods in '$cat_name' for $class_name:"
    for entry in $cats; do
      local method="${entry%%:*}"
      local category="${entry#*:}"
      if [[ "$category" == "$cat_name" ]]; then
        echo "  $method"
      fi
    done
  ]

  # List all categories for a class
  rawMethod: categoriesFor: class_name [
    # Get compiled class metadata
    local compiled_file="$TRASHDIR/.compiled/$class_name"
    if [[ ! -f "$compiled_file" ]]; then
      echo "Error: Class $class_name not found"
      return 1
    fi

    # Source the class to get metadata
    source "$compiled_file"

    # Get method categories metadata
    local cats_var="__${class_name}__methodCategories"
    local cats="${!cats_var:-}"

    if [[ -z "$cats" ]]; then
      echo "No categories for $class_name"
      return 0
    fi

    # Extract unique categories
    echo "Categories for $class_name:"
    local seen=""
    for entry in $cats; do
      local category="${entry#*:}"
      if [[ ! " $seen " =~ " $category " ]]; then
        echo "  $category"
        seen="$seen $category"
      fi
    done
  ]

  # Show inheritance hierarchy for a class
  rawMethod: hierarchyFor: class_name [
    local compiled_file="$TRASHDIR/.compiled/$class_name"
    local runtime_file="$TRASHDIR/$class_name"

    if [[ -f "$compiled_file" || -f "$runtime_file" ]]; then
      echo "Inheritance hierarchy for $class_name:"
      @ "$_RECEIVER" _showHierarchy: "$class_name" depth: 0
    else
      echo "Class $class_name not found"
      return 1
    fi
  ]

  # Helper for showing hierarchy (uses compiled metadata)
  rawMethod: _showHierarchy: class_name depth: depth [
    local indent="" i superclass super_var
    local compiled_file="$TRASHDIR/.compiled/$class_name"
    local runtime_file="$TRASHDIR/$class_name"

    for ((i=0; i<depth; i++)); do
      indent="  $indent"
    done
    echo "$indent$class_name"

    # Source class to get metadata
    if [[ -f "$compiled_file" ]]; then
      source "$compiled_file"
    elif [[ -f "$runtime_file" ]]; then
      source "$runtime_file"
    else
      return 0
    fi

    # Get superclass from metadata
    super_var="__${class_name}__superclass"
    superclass="${!super_var:-}"
    if [[ -n "$superclass" && "$superclass" != "nil" ]]; then
      @ "$_RECEIVER" _showHierarchy: "$superclass" depth: $((depth + 1))
    fi
  ]

  # Create a new class file with modern .trash syntax
  rawMethod: createObject: object_name super: superclass [
    local trash_file="$TRASHDIR/${object_name}.trash"
    superclass="${superclass:-Object}"

    if [[ -f "$trash_file" ]]; then
      echo "Class $object_name already exists"
      return 1
    fi

    cat > "$trash_file" << EOF
# $object_name - Created by Trash system
$object_name subclass: $superclass

  rawMethod: example [
    echo "Hello from $object_name"
  ]

  rawClassMethod: new [
    local id=\$(_generate_instance_id "$object_name")
    _create_instance "$object_name" "\$id"
    echo "\$id"
  ]
EOF

    echo "Created $trash_file (inherits from $superclass)"
    echo "Compiling..."
    "$SCRIPT_DIR/jq-compiler/driver.bash" compile "$trash_file" > "$TRASHDIR/.compiled/$object_name" 2>/dev/null
    source "$TRASHDIR/.compiled/$object_name"
    echo "✓ $object_name ready to use"
  ]

  # Remove an object (with confirmation)
  rawMethod: removeObject: object_name [
    local object_file confirmation
    object_file="$TRASHDIR/$object_name"
    if [[ ! -f "$object_file" ]]; then
      echo "Object $object_name not found"
      return 1
    fi
    echo "Are you sure you want to remove object $object_name? (y/N)"
    read -r confirmation
    if [[ "$confirmation" =~ ^[Yy]$ ]]; then
      rm "$object_file"
      echo "Removed object $object_name"
    else
      echo "Cancelled"
    fi
  ]

  # Reload all object stubs
  rawMethod: reload [
    echo "Reloading all object stubs..."
    initialize_trash
    echo "Reload complete"
  ]

  # Reload a single class (hot reload for development)
  rawMethod: reloadClass: class_name [
    pragma: direct
    if [[ -z "$class_name" ]]; then
      echo "Usage: @ Trash reloadClass <ClassName>"
      return 1
    fi

    local compiled_name="${class_name//::/__}"
    local source_name="${class_name//:://}"
    local function_prefix="__${compiled_name}__"
    local compiled_file="$TRASHDIR/.compiled/$compiled_name"
    local class_file="$TRASHDIR/$source_name.trash"
    local trait_file="$TRASHDIR/traits/$source_name.trash"
    local compiled_trait="$TRASHDIR/.compiled/traits/$compiled_name"

    # Clear the sourcing cache so the class will be re-sourced
    _clear_class_cache "$class_name"

    # Check if it's a trait
    if [[ -f "$compiled_trait" ]]; then
      echo "Reloading trait $class_name..."
      # Unset old trait functions
      while IFS= read -r func; do
        unset -f "$func" 2>/dev/null
      done < <(declare -F | awk '{print $3}' | grep "^${function_prefix}")
      # Source the compiled trait
      source "$compiled_trait"
      _mark_class_sourced "$class_name"
      echo "✓ Trait $class_name reloaded"
      return 0
    fi

    # Check for compiled class
    if [[ -f "$compiled_file" ]]; then
      echo "Reloading class $class_name..."
      # Unset old class functions
      while IFS= read -r func; do
        unset -f "$func" 2>/dev/null
      done < <(declare -F | awk '{print $3}' | grep "^${function_prefix}")
      # Source the compiled class
      source "$compiled_file"
      _mark_class_sourced "$class_name"
      echo "✓ Class $class_name reloaded"
      return 0
    fi

    # Fall back to raw .trash source file (uncompiled)
    if [[ -f "$class_file" ]]; then
      echo "Warning: Loading uncompiled source for $class_name..."
      source "$class_file"
      _mark_class_sourced "$class_name"
      echo "✓ Class $class_name loaded from source"
      return 0
    fi

    if [[ -f "$trait_file" ]]; then
      echo "Warning: Loading uncompiled trait source for $class_name..."
      source "$trait_file"
      _mark_class_sourced "$class_name"
      echo "✓ Trait $class_name loaded from source"
      return 0
    fi

    echo "Error: Class $class_name not found"
    echo "Searched:"
    echo "  - $compiled_file"
    echo "  - $compiled_trait"
    echo "  - $class_file"
    echo "  - $trait_file"
    return 1
  ]

  # Compile and reload a class from .trash source
  # Safe: compiles to temp file first, validates, only replaces on success
  rawMethod: compileAndReload: class_name [
    pragma: direct
    if [[ -z "$class_name" ]]; then
      echo "Usage: @ Trash compileAndReload <ClassName>"
      return 1
    fi

    local source_file="$TRASHDIR/${class_name}.trash"
    local user_source="$TRASHDIR/user/${class_name}.trash"
    local trait_source="$TRASHDIR/traits/${class_name}.trash"
    local target_file=""
    local file_to_compile=""
    local temp_file="/tmp/trash_compile_$$_${class_name}"

    # Find source file and determine target (check user dir before system dir)
    if [[ -f "$user_source" ]]; then
      file_to_compile="$user_source"
      target_file="$TRASHDIR/.compiled/$class_name"
      echo "Compiling user class $class_name..."
    elif [[ -f "$trait_source" ]]; then
      file_to_compile="$trait_source"
      target_file="$TRASHDIR/.compiled/traits/$class_name"
      echo "Compiling trait $class_name..."
    elif [[ -f "$source_file" ]]; then
      file_to_compile="$source_file"
      target_file="$TRASHDIR/.compiled/$class_name"
      echo "Compiling class $class_name..."
    else
      echo "Error: No source file found for $class_name"
      echo "Searched:"
      echo "  - $user_source"
      echo "  - $source_file"
      echo "  - $trait_source"
      return 1
    fi

    # Compile to temp file
    if ! "$SCRIPT_DIR/jq-compiler/driver.bash" compile "$file_to_compile" > "$temp_file" 2>&1; then
      echo "Compilation failed:"
      cat "$temp_file"
      rm -f "$temp_file"
      return 1
    fi

    # Validate bash syntax
    if ! bash -n "$temp_file" 2>&1; then
      echo "Syntax validation failed - class not updated"
      rm -f "$temp_file"
      return 1
    fi

    # Success - replace the compiled file
    mv "$temp_file" "$target_file"
    @ "$_RECEIVER" reloadClass: "$class_name"
    return $?
  ]

  # Show system statistics
  rawMethod: stats [
    echo "=== Trash System Statistics ==="
    echo "Objects: $(@ self listObjects | wc -l)"
    echo "Traits: $(@ self listTraits | wc -l)"
    echo "KV entries: $(kvlist 2>/dev/null | wc -l)"
    echo "Active processes: $(@ Process listProcesses 2>/dev/null | wc -l)"
    echo "Memory usage: $(du -sh "$TRASHDIR" | cut -f1)"
    echo "KV store size: $(du -sh "$KV_USER_DIR" 2>/dev/null | cut -f1 || echo "0B")"
  ]

  # Clean up system
  rawMethod: cleanup [
    echo "Cleaning up trash system..."
    @ Process listProcesses >/dev/null 2>&1
    echo "Cleanup complete"
  ]

  # Show help
  rawMethod: help [
    echo "=== Trash System Commands ==="
    echo "@ Trash info                        - Show system information"
    echo "@ Trash doctor                      - Diagnose environment/setup issues"
    echo "@ Trash listObjects                 - List all objects"
    echo "@ Trash listTraits                  - List all traits"
    echo "@ Trash methodsFor: <class>         - Show methods for class"
    echo "@ Trash hierarchyFor: <class>       - Show inheritance hierarchy"
    echo "@ Trash new: <class>                - Create class skeleton and edit"
    echo "@ Trash edit: <class>               - Edit class and recompile on save"
    echo "@ Trash createObject: <name> super: <super> - Create new object (no edit)"
    echo "@ Trash removeObject: <name>        - Remove object"
    echo "@ Trash reload                      - Reload all object stubs"
    echo "@ Trash reloadClass: <class>        - Hot reload a single class"
    echo "@ Trash compileAndReload: <class>   - Compile and reload from .trash"
    echo "@ Trash stats                       - Show system statistics"
    echo "@ Trash cleanup                     - Clean up system"
    echo "@ Trash version                     - Show version information"
    echo "@ Trash inspect: <class>            - Detailed object inspection"
    echo "@ Trash repl                        - Launch interactive REPL"
    echo ""
    echo "=== Instance Queries (use class methods) ==="
    echo "@ <Class> findAll                   - Find all instances of class"
    echo "@ <Class> find: '<predicate>'       - Find with predicate"
    echo "@ <Class> count                     - Count instances of class"
    echo "@ Store listClasses                 - List classes with instances"
    echo ""
    echo "=== Debugging ==="
    echo "@ Trash showStack                   - Show current call stack"
    echo "@ Trash clearStack                  - Clear call stack"
    echo ""
    echo "=== Source Introspection ==="
    echo "@ Trash sourceFor: <class>          - Get source code from .trash file"
    echo "@ Trash hashFor: <class>            - Get source hash (SHA-256)"
    echo ""
    echo "=== Testing ==="
    echo "@ Trash runTestsFor: <class>        - Run testMethod: tests for class"
    echo "@ Trash hasTestsFor: <class>        - Check if class has tests"
  ]

  # Show version information
  rawMethod: version [
    echo "Trash System v$TRASH_VERSION"
    echo "Author: $TRASH_AUTHOR"
    echo "Description: $TRASH_DESCRIPTION"
    echo "Bash version: $BASH_VERSION"
    echo "System: $(uname -s) $(uname -r)"
  ]

  # Get the source code for a class from .trash file
  # Usage: @ Trash sourceFor: Counter
  rawMethod: sourceFor: class_name [
    local source_file="$TRASHDIR/${class_name}.trash"
    local user_file="$TRASHDIR/user/${class_name}.trash"
    local trait_file="$TRASHDIR/traits/${class_name}.trash"

    if [[ -f "$user_file" ]]; then
      cat "$user_file"
    elif [[ -f "$source_file" ]]; then
      cat "$source_file"
    elif [[ -f "$trait_file" ]]; then
      cat "$trait_file"
    else
      echo "Error: Source file for $class_name not found"
      return 1
    fi
  ]

  # Get the source hash for a class
  # Usage: @ Trash hashFor: Counter
  rawMethod: hashFor: class_name [
    local hash_var="__${class_name}__sourceHash"
    local compiled_file="$TRASHDIR/.compiled/$class_name"

    # Try to get from already-loaded class
    if [[ -n "${!hash_var:-}" ]]; then
      echo "${!hash_var}"
      return 0
    fi

    # Try loading the compiled class
    if [[ -f "$compiled_file" ]]; then
      source "$compiled_file"
      if [[ -n "${!hash_var:-}" ]]; then
        echo "${!hash_var}"
        return 0
      fi
    fi

    echo "Error: Could not get hash for $class_name"
    return 1
  ]

  # Run tests for a class
  # Usage: @ Trash runTestsFor: Counter
  # Returns: 0 if all tests pass, 1 if any fail
  rawMethod: runTestsFor: class_name [
    local compiled_name="${class_name//::/__}"
    local compiled_file="$TRASHDIR/.compiled/$compiled_name"

    if [[ ! -f "$compiled_file" ]]; then
      echo "Error: Class $class_name not found"
      return 1
    fi
    @ "$_RECEIVER" runTestsFromArtifact: "$compiled_file" class: "$class_name"
  ]

  # Run a class's declared tests from an explicit compiled artifact. Proposal
  # gates use this before installation; normal tests delegate here as well.
  rawMethod: runTestsFromArtifact: artifact class: class_name [
    local artifact="$1" class_name="$2"
    local compiled_name="${class_name//::/__}"
    local tests_var="__${compiled_name}__tests"
    local tests

    if [[ ! -f "$artifact" ]]; then
      echo "Error: Compiled artifact for $class_name not found"
      return 1
    fi
    source "$artifact"

    # Check if class has tests
    tests="${!tests_var:-}"
    if [[ -z "$tests" ]]; then
      echo "# No tests defined for $class_name"
      return 0
    fi

    echo "# Running tests for $class_name"
    _test_reset
    local test_selector func_name
    local failed=0

    for test_selector in $tests; do
      func_name="__${compiled_name}__test__${test_selector}"
      if declare -f "$func_name" >/dev/null 2>&1; then
        # Capture output to temp file to check type while preserving counters
        local tmpfile="/tmp/trash_test_$$"
        "$func_name" > "$tmpfile" 2>&1
        local test_exit_code=$?
        local test_result
        test_result=$(cat "$tmpfile")
        rm -f "$tmpfile"

        # Determine test type by output:
        # - "true"/"false" = DSL testMethod
        # - Other = rawTestMethod (output already includes TAP from _assert_*)
        if [[ "$test_result" == "false" ]]; then
          # DSL testMethod returned false
          ((_TEST_COUNT++))
          ((_TEST_FAILURES++))
          echo "not ok $_TEST_COUNT - $test_selector"
          failed=1
        elif [[ "$test_result" == "true" ]]; then
          # DSL testMethod returned true
          ((_TEST_COUNT++))
          echo "ok $_TEST_COUNT - $test_selector"
        else
          # rawTestMethod - output already formatted, counters already updated
          echo "$test_result"
          if [[ $test_exit_code -ne 0 ]]; then
            failed=1
          fi
        fi
      else
        ((_TEST_COUNT++))
        ((_TEST_FAILURES++))
        echo "not ok $_TEST_COUNT - test function $func_name not found"
        failed=1
      fi
    done

    _test_summary
    return $failed
  ]

  rawMethod: testCompiledCandidate: artifact class: class_name [
    local output status
    output=$(@ "$_RECEIVER" runTestsFromArtifact: "$artifact" class: "$class_name" 2>&1)
    status=$?
    if [[ $status -eq 0 ]]; then
      jq -cn --arg message "$output" '{ok:true,phase:"test",line:1,message:$message}'
    else
      jq -cn --arg message "$output" '{ok:false,phase:"test",line:1,message:$message}'
    fi
  ]

  # Check if a class has tests defined
  # Usage: @ Trash hasTestsFor: Counter
  rawMethod: hasTestsFor: class_name [
    local compiled_name="${class_name//::/__}"
    local tests_var="__${compiled_name}__tests"
    local compiled_file="$TRASHDIR/.compiled/$compiled_name"

    # Ensure class is loaded
    if [[ -f "$compiled_file" ]]; then
      source "$compiled_file"
    fi

    local tests="${!tests_var:-}"
    if [[ -n "$tests" ]]; then
      echo "true"
      return 0
    else
      echo "false"
      return 1
    fi
  ]

  # Launch interactive REPL with rlwrap (history, completion).
  # Falls back to bin/trash-repl if already inside rlwrap to avoid nesting.
  rawClassMethod: repl [
    pragma: direct
    local trashtalk_root
    trashtalk_root="$(dirname "$TRASHDIR")"
    if [[ -n "$RLWRAP_VERSION" ]]; then
      "$trashtalk_root/bin/trash-repl"
    else
      "$trashtalk_root/bin/trash"
    fi
  ]

  # Detailed object inspection
  rawMethod: inspect: object_name [
    local object_file traits state
    if [[ -z "$object_name" ]]; then
      echo "Usage: @ Trash inspect <object_name>"
      return 1
    fi
    echo "=== Detailed Inspection: $object_name ==="
    object_file="$TRASHDIR/$object_name"
    if [[ ! -f "$object_file" ]]; then
      echo "Object $object_name not found"
      return 1
    fi
    echo "File: $object_file"
    echo "Size: $(wc -l < "$object_file") lines"
    echo "Modified: $(stat -f "%Sm" "$object_file" 2>/dev/null || stat -c "%y" "$object_file" 2>/dev/null)"
    echo ""
    @ self hierarchyFor: "$object_name"
    echo ""
    @ self methodsFor: "$object_name"
    echo ""
    traits=$(grep "^include" "$object_file" | awk '{print $2}')
    if [[ -n "$traits" ]]; then
      echo "Traits:"
      echo "$traits" | sed 's/^/  /'
    else
      echo "Traits: none"
    fi
  ]

  # Create a new class with minimal skeleton and open in editor
  # New classes are created in the user directory (trash/user/)
  rawMethod: new: class_name [
    pragma: direct
    local user_file="$TRASHDIR/user/${class_name}.trash"
    local system_file="$TRASHDIR/${class_name}.trash"
    local trait_file="$TRASHDIR/traits/${class_name}.trash"

    # Check if class already exists anywhere
    if [[ -f "$user_file" ]]; then
      echo "Class $class_name already exists in user/. Use '@ Trash edit: $class_name' to edit."
      return 1
    fi
    if [[ -f "$system_file" ]]; then
      echo "Class $class_name already exists as a system class. Use '@ Trash edit: $class_name' to edit."
      return 1
    fi
    if [[ -f "$trait_file" ]]; then
      echo "A trait named $class_name already exists. Use '@ Trash edit: $class_name' to edit."
      return 1
    fi

    # Ensure user directory exists
    mkdir -p "$TRASHDIR/user"

    # Create minimal skeleton with heredoc
    cat > "$user_file" <<EOF
${class_name} subclass: Object
  instanceVars:

  classMethod: new [
    | id |
    id := @ Runtime generateId: '${class_name}'.
    @ Runtime create: '${class_name}' id: id.
    ^ id
  ]

  method: example [
    ^ 'Hello from ${class_name}'
  ]

  rawTestMethod: testExample [
    local instance result
    instance=\$(@ ${class_name} new)
    result=\$(@ "\$instance" example)
    _assert_eq "\$result" 'Hello from ${class_name}' 'example returns greeting'
  ]
EOF

    echo "Created $user_file"

    # Open in editor (edit: handles compile on save)
    @ "$_RECEIVER" edit: "$class_name"
  ]

  # Resolve a class or trait to its editable source using public DSL helpers.
  method: sourceFileFor: className [
    | root relative userSource classSource traitSource |
    root := @ Env get: 'TRASHDIR'.
    relative := @ String replaceAll: '::' with: '/' in: className.
    userSource := root , '/user/' , relative , '.trash'.
    classSource := root , '/' , relative , '.trash'.
    traitSource := root , '/traits/' , relative , '.trash'.
    userSource fileExists ifTrue: [^ userSource].
    classSource fileExists ifTrue: [^ classSource].
    traitSource fileExists ifTrue: [^ traitSource].
    ^ ''
  ]

  # Present diagnostics without modifying source. Innards consumes the
  # temporary annotation document; an external editor remains a safe fallback.
  method: editFile: sourceFile diagnostics: diagnostics line: line [
    | available annotationFile annotationPath result file before after outcome builder unused |
    available := @ Tools::Inmacs isInstalled.
    (available = 'true') ifTrue: [
      annotationPath := ''.
      diagnostics notEmpty ifTrue: [
        annotationFile := @ File tempWithPrefix: 'trash-edit-annotations-'.
        unused := @ annotationFile write: diagnostics.
        annotationPath := @ annotationFile path
      ].
      result := @ Tools::Inmacs editFile: sourceFile annotations: annotationPath line: line.
      annotationPath notEmpty ifTrue: [@ annotationFile delete].
      ^ result
    ].

    file := @ File at: sourceFile.
    before := @ file read.
    unused := @ Tools::Inmacs fallbackEditFile: sourceFile line: line.
    after := @ file read.
    outcome := 'unchanged'.
    (before ~= after) ifTrue: [outcome := 'saved'].
    builder := #{schema_version: 1 outcome: outcome path: sourceFile} asJson.
    ^ builder
  ]

  # Compile to a candidate artifact. This raw method is an OS/compiler boundary;
  # workflow decisions and diagnostic construction remain in DSL methods.
  rawMethod: compileClass: className source: sourceFile [
    local artifact error_file message line
    artifact=$(mktemp "${TMPDIR:-/tmp}/trash-edit-artifact.XXXXXX")
    error_file=$(mktemp "${TMPDIR:-/tmp}/trash-edit-compile.XXXXXX")

    if _trash_with_progress "Compiling $className" "$SCRIPT_DIR/jq-compiler/driver.bash" compile "$sourceFile" > "$artifact" 2> "$error_file"; then
      rm -f "$error_file"
      jq -cn --arg artifact "$artifact" '{ok:true,phase:"compile",artifact:$artifact,line:1,message:""}'
      return 0
    fi

    message=$(cat "$error_file")
    line=$(printf '%s\n' "$message" | grep -oE '[0-9]+:[0-9]+:' | head -1 | cut -d: -f1)
    [[ -n "$line" ]] || line=1
    rm -f "$artifact" "$error_file"
    jq -cn --arg message "$message" --argjson line "$line" '{ok:false,phase:"compile",artifact:"",line:$line,message:$message}'
  ]

  rawMethod: validateCompiledCandidate: artifact [
    local message
    if message=$(bash -n "$artifact" 2>&1); then
      jq -cn --arg artifact "$artifact" '{ok:true,phase:"bash",artifact:$artifact,line:1,message:""}'
      return 0
    fi
    rm -f "$artifact"
    jq -cn --arg message "$message" '{ok:false,phase:"bash",artifact:"",line:1,message:$message}'
  ]

  rawMethod: validateCompiledIdentity: artifact class: className [
    local artifact="$1" class_name="$2" compiled_name marker message
    compiled_name="${class_name//::/__}"
    marker="__${compiled_name}__superclass="
    if awk -v marker="$marker" 'index($0, marker) == 1 { found=1 } END { exit !found }' "$artifact"; then
      jq -cn --arg artifact "$artifact" '{ok:true,phase:"identity",artifact:$artifact,line:1,message:""}'
    else
      message="Compiled proposal does not define the declared class $class_name"
      rm -f "$artifact"
      jq -cn --arg message "$message" '{ok:false,phase:"identity",artifact:"",line:1,message:$message}'
    fi
  ]

  rawMethod: installCompiledCandidate: artifact for: className source: sourceFile [
    pragma: direct
    local compiled_name target output status
    compiled_name="${className//::/__}"
    if [[ "$sourceFile" == *"/traits/"* ]]; then
      target="$TRASHDIR/.compiled/traits/$compiled_name"
    else
      target="$TRASHDIR/.compiled/$compiled_name"
    fi
    mkdir -p "$(dirname "$target")"
    if ! mv "$artifact" "$target"; then
      rm -f "$artifact"
      jq -cn --arg message "Could not install $target" '{ok:false,phase:"install",line:1,message:$message}'
      return 0
    fi
    output=$(@ "$_RECEIVER" reloadClass: "$className" 2>&1)
    status=$?
    if [[ $status -eq 0 ]]; then
      jq -cn '{ok:true,phase:"install",line:1,message:""}'
    else
      jq -cn --arg message "$output" '{ok:false,phase:"install",line:1,message:$message}'
    fi
  ]

  rawMethod: testClassForEdit: className [
    local output status
    output=$(@ "$_RECEIVER" runTestsFor: "$className" 2>&1)
    status=$?
    if [[ $status -eq 0 ]]; then
      jq -cn --arg message "$output" '{ok:true,phase:"test",line:1,message:$message}'
    else
      jq -cn --arg message "$output" '{ok:false,phase:"test",line:1,message:$message}'
    fi
  ]

  method: annotationsFor: message line: line phase: phase [
    ^ #{schema_version: 1 annotations: #(
      #{line: (line jsonValue) column: 1 severity: 'error'
        message: (phase , ': ' , message)}
    )} asJson
  ]

  method: diagnosticsFromCompileResult: result [
    result jsonUnpack: #('message' 'line' 'phase') into: [:message :line :phase |
      ^ @ self annotationsFor: message line: line phase: phase
    ]
  ]

  method: diagnosticsFromTestResult: result [
    ^ @ self diagnosticsFromCompileResult: result
  ]

  # Parse every source through the canonical jq compiler. File discovery and
  # process invocation are the OS/compiler boundary; no second symbol cache is
  # introduced.
  rawMethod: astRecords [
    pragma: direct
    local -a sources
    mapfile -d '' -t sources < <(find "$TRASHDIR" -type f -name '*.trash' \
      -not -path "$TRASHDIR/.compiled/*" -print0)
    [[ ${#sources[@]} -gt 0 ]] || return 0
    "$SCRIPT_DIR/jq-compiler/driver.bash" 'parse-many' "${sources[@]}"
  ]

  # Source discovery and compiler invocation are an OS boundary. The compiler
  # owns content/query invalidation for the derived public symbol records.
  rawMethod: symbolRecords [
    local -a sources
    mapfile -d '' -t sources < <(find "$TRASHDIR" -type f -name '*.trash' \
      -not -path "$TRASHDIR/.compiled/*" -print0)
    [[ ${#sources[@]} -gt 0 ]] || return 0
    _trash_with_progress 'Indexing symbols' "$SCRIPT_DIR/jq-compiler/driver.bash" 'symbols-many' "${sources[@]}"
  ]

  rawMethod: symbolRecordsForSource: sourceFile [
    _trash_with_progress 'Reading symbols' "$SCRIPT_DIR/jq-compiler/driver.bash" 'symbols-many' "$1"
  ]

  method: symbolRecordsForClass: className [
    | records source |
    source := @ self sourceFileFor: className.
    source isEmpty ifTrue: [^ ''].
    records := @ self symbolRecordsForSource: source.
    ^ @ String jsonLinesWhere: 'class_name' equals: className from: records
  ]

  method: classRecords [
    | records classes traits |
    records := @ self symbolRecords.
    classes := @ String jsonLinesWhere: 'kind' equals: 'class' from: records.
    traits := @ String jsonLinesWhere: 'kind' equals: 'trait' from: records.
    ^ classes , '
' , traits
  ]

  method: implementorsOf: selector [
    | records |
    records := @ self symbolRecords.
    ^ @ String jsonLinesWhere: 'selector' equals: selector from: records
  ]

  # Sender analysis is a compiler query because it must group parsed keyword
  # message parts. Comparing individual source tokens is not semantically valid.
  rawMethod: sendersOf: selector [
    local records
    records=$(@ "$_RECEIVER" astRecords) || return
    printf '%s\n' "$records" | jq -c --arg path '' --arg wanted "$1" \
      -f "$SCRIPT_DIR/jq-compiler/senders.jq"
  ]

  # Build persisted-object candidates in the DSL. Only Store and Runtime own
  # the database boundary; the browser sees ordinary versioned records.
  method: instanceRecordsFor: className [
    | snapshots records source data shortId label detail record |
    snapshots := @ Runtime dataForClass: className.
    records := ''.
    source := @ self sourceFileFor: className.
    source isEmpty ifTrue: [^ ''].
    snapshots objectEach: [:instanceId :rawData |
      instanceId notEmpty ifTrue: [
        data := @ String jsonInstanceView: rawData.
        shortId := @ String suffix: instanceId length: '8'.
        label := className , ' ' , shortId.
        detail := @ String jsonInstanceSummary: data.
        record := #{schema_version: 1 id: instanceId path: source line: 1 column: 1
                    label: label kind: 'instance' detail: detail class_name: className
                    object_id: instanceId data: (data jsonValue)} asJson.
        records := records , record , '
'
      ]
    ].
    ^ records
  ]

  method: pickRecords: records query: query title: title [
    | root available |
    root := @ Env get: 'TRASHDIR'.
    root := @ String trimSuffix: '/trash' from: root.
    available := @ Tools::Inpick isInstalled.
    (available = 'true') ifTrue: [
      ^ @ Tools::Inpick selectRecords: records root: root query: query title: title
    ].
    ^ @ Tools::Inpick fallbackSelectRecords: records query: query title: title
  ]

  method: pickMethod: className [
    | records title |
    records := @ self symbolRecordsForClass: className.
    title := 'Methods: ' , className.
    ^ @ self pickRecords: records query: 'method' title: title
  ]

  method: browseClasses [
    | records |
    records := @ self classRecords.
    ^ @ self pickRecords: records query: '' title: 'Classes and traits'
  ]

  method: browseInstancesOf: className [
    | records title |
    records := @ self instanceRecordsFor: className.
    title := 'Instances: ' , className.
    ^ @ self pickRecords: records query: '' title: title
  ]

  method: inspectionRecordFor: objectId [
    | className rawData data record |
    className := @ Runtime classFor: objectId.
    className isEmpty ifTrue: [^ ''].
    rawData := @ Runtime dataFor: objectId.
    data := @ String jsonInstanceView: rawData.
    record := #{schema_version: 1 object_id: objectId class_name: className data: (data jsonValue)} asJson.
    ^ record
  ]

  method: inspectObject: objectId [
    | available record className title result valid outcome |
    available := @ Tools::Ininspect isInstalled.
    (available ~= 'true') ifTrue: [^ @ objectId inspect].
    record := @ self inspectionRecordFor: objectId.
    record isEmpty ifTrue: [
      ^ @ ObjectEditProposal result: 'invalid' phase: 'lookup' message: 'Object does not exist' object: objectId data: ''
    ].
    className := @ String jsonPath: 'class_name' from: record.
    title := 'Object inspector'.
    result := @ Tools::Ininspect inspectRecord: record title: title.
    valid := @ String isJson: result.
    (valid ~= 'true') ifTrue: [
      ^ @ ObjectEditProposal result: 'invalid' phase: 'result' message: 'ininspect did not return valid JSON' object: objectId data: ''
    ].
    outcome := @ String jsonPath: 'outcome' from: result.
    (outcome = 'proposed') ifTrue: [^ @ ObjectEditProposal apply: result to: objectId].
    (outcome = 'viewed') ifTrue: [^ result].
    (outcome = 'cancelled') ifTrue: [^ result].
    ^ @ ObjectEditProposal result: 'invalid' phase: 'result' message: 'ininspect returned an unknown outcome' object: objectId data: ''
  ]

  method: inspectInstancesOf: className [
    | selection outcome objectId |
    selection := @ self browseInstancesOf: className.
    outcome := @ String jsonPath: 'outcome' from: selection.
    (outcome ~= 'selected') ifTrue: [^ selection].
    objectId := @ String jsonPath: 'selection.object_id' from: selection.
    ^ @ self inspectObject: objectId
  ]

  method: openBrowserResult: result [
    | outcome sourceFile className line |
    outcome := @ String jsonPath: 'outcome' from: result.
    (outcome ~= 'selected') ifTrue: [^ outcome].
    sourceFile := @ String jsonPath: 'selection.path' from: result.
    className := @ String jsonPath: 'selection.class_name' from: result.
    line := @ String jsonPath: 'selection.line' from: result.
    ^ @ self editSource: sourceFile class: className line: line
  ]

  method: browse [
    | records result |
    records := @ self symbolRecords.
    result := @ self pickRecords: records query: '' title: 'Trashtalk symbols'.
    ^ @ self openBrowserResult: result
  ]

  method: browseClass: className [
    | records title result |
    records := @ self symbolRecordsForClass: className.
    title := 'Browse: ' , className.
    result := @ self pickRecords: records query: '' title: title.
    ^ @ self openBrowserResult: result
  ]

  method: browseImplementorsOf: selector [
    | records title result |
    records := @ self implementorsOf: selector.
    title := 'Implementors: ' , selector.
    result := @ self pickRecords: records query: '' title: title.
    ^ @ self openBrowserResult: result
  ]

  method: browseSendersOf: selector [
    | records title result |
    records := @ self sendersOf: selector.
    title := 'Senders: ' , selector.
    result := @ self pickRecords: records query: '' title: title.
    ^ @ self openBrowserResult: result
  ]

  # DSL-first edit/compile/check/reload/test workflow. Diagnostics are passed as
  # annotations and never written into the .trash source.
  method: edit: className [
    | sourceFile message |
    sourceFile := @ self sourceFileFor: className.
    sourceFile isEmpty ifTrue: [
      message := 'No source file found for ' , className.
      @ Console error: message.
      ^ ''
    ].

    ^ @ self editSource: sourceFile class: className line: '1'
  ]

  method: editSource: sourceFile class: className line: initialLine [
    pragma: direct
    | diagnostics line editorResult outcome compileResult ok artifact validationResult installResult testResult message |

    diagnostics := ''.
    line := initialLine.
    [1 = 1] whileTrue: [
      editorResult := @ self editFile: sourceFile diagnostics: diagnostics line: line.
      outcome := @ String jsonPath: 'outcome' from: editorResult.
      outcome isEmpty ifTrue: [
        @ Console error: 'Editor failed without a structured result'.
        ^ ''
      ].
      (outcome = 'unchanged') ifTrue: [^ 'unchanged'].
      (outcome = 'cancelled') ifTrue: [^ 'cancelled'].
      (outcome = 'discarded') ifTrue: [^ 'discarded'].
      (outcome ~= 'saved') ifTrue: [
        message := 'Editor failed: ' , outcome.
        @ Console error: message.
        ^ ''
      ].

      message := 'Compiling ' , className , '...'.
      @ Console print: message.
      compileResult := @ self compileClass: className source: sourceFile.
      ok := @ String jsonPath: 'ok' from: compileResult.
      (ok ~= 'true') ifTrue: [
        diagnostics := @ self diagnosticsFromCompileResult: compileResult.
        line := @ String jsonPath: 'line' from: compileResult.
        message := @ String jsonPath: 'message' from: compileResult.
        @ Console error: message
      ] ifFalse: [
        artifact := @ String jsonPath: 'artifact' from: compileResult.
        validationResult := @ self validateCompiledCandidate: artifact.
        ok := @ String jsonPath: 'ok' from: validationResult.
        (ok ~= 'true') ifTrue: [
          diagnostics := @ self diagnosticsFromCompileResult: validationResult.
          line := '1'.
          message := @ String jsonPath: 'message' from: validationResult.
          @ Console error: message
        ] ifFalse: [
          installResult := @ self installCompiledCandidate: artifact for: className source: sourceFile.
          ok := @ String jsonPath: 'ok' from: installResult.
          (ok ~= 'true') ifTrue: [
            diagnostics := @ self diagnosticsFromCompileResult: installResult.
            line := '1'
          ] ifFalse: [
            testResult := @ self testClassForEdit: className.
            ok := @ String jsonPath: 'ok' from: testResult.
            (ok = 'true') ifTrue: [
              message := 'Compiled and tested ' , className.
              @ Console print: message.
              ^ 'saved'
            ] ifFalse: [
              diagnostics := @ self diagnosticsFromTestResult: testResult.
              line := '1'.
              message := @ String jsonPath: 'message' from: testResult.
              @ Console error: message
            ]
          ]
        ]
      ]
    ]
  ]

  # Evaluate a string of Trashtalk code
  # Usage: @ Trash eval: 'counter := @ Counter new. @ counter increment. @ counter getValue'
  # Returns the result of the last expression
  rawClassMethod: eval: code [
    local temp_class="_TempEval_$$_$RANDOM"
    local temp_file="/tmp/${temp_class}.trash"
    local compiled_file="/tmp/${temp_class}.compiled"
    local result

    # Wrap code in a temporary class with a run method
    cat > "$temp_file" << EVALEOF
${temp_class} subclass: Object
  rawClassMethod: run [
    $1
  ]
EVALEOF

    # Compile the temporary class
    if ! "$SCRIPT_DIR/jq-compiler/driver.bash" compile "$temp_file" > "$compiled_file" 2>&1; then
      echo "Eval compile error:" >&2
      cat "$compiled_file" >&2
      rm -f "$temp_file" "$compiled_file"
      return 1
    fi

    # Validate bash syntax
    if ! bash -n "$compiled_file" 2>&1; then
      echo "Eval syntax error" >&2
      rm -f "$temp_file" "$compiled_file"
      return 1
    fi

    # Source and execute
    source "$compiled_file"
    result=$("__${temp_class}__class__run")
    local exit_code=$?

    # Clean up
    rm -f "$temp_file" "$compiled_file"
    # Unset the temporary functions
    unset -f "__${temp_class}__class__run" 2>/dev/null
    unset "__${temp_class}__superclass" 2>/dev/null
    unset "__${temp_class}__is_a" 2>/dev/null

    echo "$result"
    return $exit_code
  ]

  # Evaluate code from a file
  # Usage: @ Trash evalFile: '/path/to/script.trash'
  rawClassMethod: evalFile: filepath [
    if [[ ! -f "$1" ]]; then
      echo "Error: File not found: $1" >&2
      return 1
    fi
    local code
    code=$(cat "$1")
    @ Trash eval: "$code"
  ]

  # Quick class creation with template
  rawMethod: quickCreate: class_name template: template [
    template="${template:-basic}"
    local trash_file="$TRASHDIR/${class_name}.trash"

    if [[ -f "$trash_file" ]]; then
      echo "Class $class_name already exists"
      return 1
    fi

    case "$template" in
      "service")
        cat > "$trash_file" << EOF
# $class_name - Service template
$class_name subclass: Object
  include: Debuggable

  rawMethod: start [
    @ self debug: "Starting service..."
    echo "Service started"
  ]

  rawMethod: stop [
    @ self debug: "Stopping service..."
    echo "Service stopped"
  ]

  method: status [
    ^ "Service is running"
  ]

  rawMethod: restart [
    @ "\$_RECEIVER" stop
    @ "\$_RECEIVER" start
  ]

  rawClassMethod: new [
    local id=\$(_generate_instance_id "$class_name")
    _create_instance "$class_name" "\$id"
    echo "\$id"
  ]
EOF
        ;;
      "actor")
        cat > "$trash_file" << EOF
# $class_name - Actor template (for use with Process)
$class_name subclass: Object
  include: Debuggable
  instanceVars: status:active

  rawMethod: receive: message [
    @ self debug: "Received message: \$message"
    case "\$message" in
      "ping") echo "pong" ;;
      "status") echo "active" ;;
      *) echo "Unknown message: \$message" ;;
    esac
  ]

  rawMethod: initialize [
    @ self debug: "Actor initialized"
  ]

  rawClassMethod: new [
    local id=\$(_generate_instance_id "$class_name")
    _create_instance "$class_name" "\$id"
    echo "\$id"
  ]
EOF
        ;;
      *)
        # Basic template
        cat > "$trash_file" << EOF
# $class_name - Created by Trash system
$class_name subclass: Object

  rawMethod: example [
    echo "Hello from $class_name"
  ]

  rawClassMethod: new [
    local id=\$(_generate_instance_id "$class_name")
    _create_instance "$class_name" "\$id"
    echo "\$id"
  ]
EOF
        ;;
    esac

    echo "Created $trash_file using $template template"
    echo "Compiling..."
    mkdir -p "$TRASHDIR/.compiled"
    "$SCRIPT_DIR/jq-compiler/driver.bash" compile "$trash_file" > "$TRASHDIR/.compiled/$class_name" 2>/dev/null
    source "$TRASHDIR/.compiled/$class_name"
    echo "✓ $class_name ready to use"
  ]
