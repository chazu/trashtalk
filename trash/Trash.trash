# Trash - The system object representing the entire trash system
# Provides introspection, management, and system-wide operations
Trash subclass: Object
  include: Debuggable

  classMethod: currentAssignment [
    ^ @ Assignment current
  ]

  # Read-only aggregate over existing Attention and Assignment records.
  classMethod: workStatus [
    ^ @ AgentWorkboard status
  ]

  classMethod: showWorkboard [
    pragma: stream
    @ AgentWorkboard show
  ]

  # Resolve the user's durable Inbox instance: TRASHTALK_USER, else USER.
  classMethod: userInbox [
    | user |
    user := @ Env get: 'TRASHTALK_USER'.
    user isEmpty ifTrue: [user := @ Env get: 'USER'].
    ^ @ Inbox named: user
  ]

  # Get system information
  rawMethod: info [
    echo "=== Trash System Information ==="
    echo "Version: $TRASH_VERSION"
    echo "Directory: $TRASHDIR"
    echo "Objects: $(@ "$_RECEIVER" listObjects | wc -l)"
    echo "Traits: $(@ "$_RECEIVER" listTraits | wc -l)"
    echo "Active Processes: $(@ Process listProcesses | wc -l)"
    echo "Database: $SQLITE_JSON_DB"
  ]

  # Diagnose the environment: bash, required tools, sqlite3 extension support,
  # and whether classes have been compiled. Checks the selected session harness;
  # Maki installation is automatic only when the Maki profile is selected.
  # Exits non-zero if a required check or selected Maki installation fails.
  #
  # Each doctor* check prints findings as ok, warn or bad, a tab, then the
  # message (the Config check format); doctor colours and tallies them. Other
  # lines, such as a multi-line message's continuation, are shown as they are.
  rawMethod: doctor [
    local ok=0 warn=0 bad=0 tab check report line
    local g='\033[0;32m' y='\033[0;33m' r='\033[0;31m' n='\033[0m'
    printf -v tab '\t'

    echo "=== Trashtalk Doctor ==="
    for check in doctorBash doctorTools doctorConfig doctorInnards doctorHarness \
                 doctorAgent doctorSqlite doctorWorkstation doctorCompiled; do
      report=$(@ "$_RECEIVER" "$check")
      [[ -n "$report" ]] || continue
      while IFS= read -r line; do
        case "$line" in
          "ok$tab"*) echo -e "  ${g}OK${n}   ${line#*$tab}"; ok=$((ok+1)) ;;
          "warn$tab"*) echo -e "  ${y}WARN${n} ${line#*$tab}"; warn=$((warn+1)) ;;
          "bad$tab"*) echo -e "  ${r}FAIL${n} ${line#*$tab}"; bad=$((bad+1)) ;;
          *) echo -e "$line" ;;
        esac
      done <<< "$report"
    done

    echo ""
    echo "Summary: $ok ok, $warn warning(s), $bad problem(s)"
    [[ $bad -eq 0 ]]
  ]

  # Bash 4.4+ (mapfile -d for exact argv)
  rawMethod: doctorBash [
    if (( BASH_VERSINFO[0] > 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] >= 4) )); then
      printf 'ok\t%s\n' "bash ${BASH_VERSION%%(*} (>= 4.4)"
    else
      printf 'bad\t%s\n' "bash ${BASH_VERSION%%(*} too old; need 4.4+ (macOS: brew install bash)"
    fi
  ]

  rawMethod: doctorTools [
    local tool
    for tool in jo jq sqlite3 uuidgen; do
      if command -v "$tool" >/dev/null 2>&1; then
        printf 'ok\t%s\n' "$tool found ($(command -v "$tool"))"
      else
        printf 'bad\t%s\n' "$tool missing (macOS: brew install jo jq sqlite; uuidgen is built in)"
      fi
    done
  ]

  # User config: file syntax, unknown keys, invalid values, env overrides.
  rawMethod: doctorConfig [
    @ Config check
  ]

  # Innards is optional; edit/page/browse each retain a terminal fallback.
  rawMethod: doctorInnards [
    if command -v inmacs >/dev/null 2>&1 && command -v inpage >/dev/null 2>&1; then
      printf 'ok\t%s\n' "Innards found (inmacs and inpage)"
    else
      printf 'warn\t%s\n' "Innards not found; edit/page workflows use VISUAL/EDITOR and PAGER fallbacks"
    fi
    if command -v inpick >/dev/null 2>&1; then
      printf 'ok\t%s\n' "Innards picker found (inpick)"
    elif command -v fzf >/dev/null 2>&1; then
      printf 'warn\t%s\n' "inpick not found; browser workflows use the fzf fallback"
    else
      printf 'warn\t%s\n' "inpick and fzf not found; install Innards or fzf for interactive browsing"
    fi
    if command -v inui >/dev/null 2>&1; then
      printf 'ok\t%s\n' "Innards UI toolkit found (inui); inspect opens the object inspector"
    else
      printf 'warn\t%s\n' "inui not found; inspect prints a textual object description"
    fi
  ]

  # Check the configured session harness; provider login stays interactive.
  rawMethod: doctorHarness [
    local session_profile session_executable session_version
    session_profile=$(@ Gusgus profile)
    case "$session_profile" in
      jcode)
        session_executable=$(@ Jcode path)
        if [[ -n "$session_executable" ]] && session_version=$("$session_executable" --version 2>&1); then
          printf 'ok\t%s\n' "Jcode found ($session_executable); $session_version"
        else
          printf 'bad\t%s\n' "Jcode is missing or cannot run; $(@ Jcode installCommand)"
        fi
        ;;
      maki)
        if @ Maki ensure >/dev/null; then
          printf 'ok\t%s\n' "Maki found ($(@ Maki path)); $(@ Maki version)"
        else
          printf 'bad\t%s\n' "Maki installation/check failed; retry with: @ Maki install"
        fi
        ;;
    esac
  ]

  # The selected one-shot backend is optional. Installation and authentication stay
  # explicit because they belong to the external harness.
  rawMethod: doctorAgent [
    local agent_backend="${TRASHTALK_AGENT_BACKEND:-codex}" agent_auth
    case "$agent_backend" in
      codex|CodexAgent)
        if command -v codex >/dev/null 2>&1; then
          printf 'ok\t%s\n' "Codex found ($(command -v codex)); one-shot Agent backend selected"
          if agent_auth=$(codex login status 2>&1) && [[ "$agent_auth" == *ChatGPT* ]]; then
            printf 'ok\t%s\n' "$agent_auth; subscription-backed one-shot Agent is available"
          else
            printf 'warn\t%s\n' "Codex is not authenticated with ChatGPT; run: codex login (${agent_auth:-status unavailable})"
          fi
        else
          printf 'warn\t%s\n' "Codex backend selected but codex is not installed"
        fi
        ;;
      *)
        printf 'warn\t%s\n' "Unknown TRASHTALK_AGENT_BACKEND '$agent_backend'; one-shot Agent uses CodexAgent"
        ;;
    esac
    if command -v indiff >/dev/null 2>&1 && command -v patch >/dev/null 2>&1; then
      printf 'ok\t%s\n' "proposal review found (indiff and patch)"
    else
      printf 'warn\t%s\n' "proposal review unavailable; install Innards indiff and patch to review source proposals"
    fi
  ]

  # sqlite3 binary actually in use + honker extension loadability
  rawMethod: doctorSqlite [
    echo "  sqlite3 in use: ${_SQLITE3:-sqlite3}"
    local ext_suffix ext_base ext_found=""
    [[ "$(uname)" == "Darwin" ]] && ext_suffix="dylib" || ext_suffix="so"
    for ext_base in "$HONKER_EXT" "$HOME/.trashtalk/lib/vendor/honker/libhonker_ext" "/usr/local/lib/libhonker_ext" "/opt/homebrew/lib/libhonker_ext"; do
      [[ -n "$ext_base" && -f "${ext_base}.${ext_suffix}" ]] && { ext_found="${ext_base}.${ext_suffix}"; break; }
    done
    if [[ -z "$ext_found" ]]; then
      printf 'warn\t%s\n' "honker extension not installed (optional; run bin/install-honker)"
    elif "${_SQLITE3:-sqlite3}" ":memory:" ".load ${ext_found}" "SELECT 1;" >/dev/null 2>&1; then
      printf 'ok\t%s\n' "honker extension loadable via ${_SQLITE3:-sqlite3}"
    else
      printf 'warn\t%s\n' "honker found but ${_SQLITE3:-sqlite3} can't load it; install extension-capable sqlite3 (brew install sqlite) and set TRASH_SQLITE3"
    fi
  ]

  # Workstation feature capabilities are warnings, not global requirements.
  # Introspection only: never bootstrap, read or acknowledge a Stream here.
  rawMethod: doctorWorkstation [
    if [[ $(@ Tools::Cue isInstalled) == true ]]; then
      printf 'ok\t%s\n' "Workstation CUE validation available"
    else
      printf 'warn\t%s\n' "Workstation CUE unavailable; install explicitly: go install cuelang.org/go/cmd/cue@latest"
    fi
    if [[ $(@ Workstation::Schema streamAvailable) == true ]]; then
      printf 'ok\t%s\n' "Workstation Honker Stream capability available (receipts, attention, and routing)"
    else
      printf 'warn\t%s\n' "Workstation Honker Stream unavailable; run bin/install-honker and use extension-capable TRASH_SQLITE3"
    fi
  ]

  rawMethod: doctorCompiled [
    local nclasses
    nclasses=$(find "$TRASHDIR/.compiled" -maxdepth 1 -type f 2>/dev/null | wc -l | tr -d ' ')
    if [[ "${nclasses:-0}" -gt 0 ]]; then
      printf 'ok\t%s\n' "$nclasses compiled classes in $TRASHDIR/.compiled"
    else
      printf 'bad\t%s\n' "no compiled classes in $TRASHDIR/.compiled -- run 'make'"
    fi
  ]

  # List all available objects (compiled classes)
  rawMethod: listObjects [
    local file name name_pattern='^[A-Za-z_][A-Za-z0-9_]*$'
    find "$TRASHDIR/.compiled" -maxdepth 1 -type f 2>/dev/null | while read -r file; do
      # build-cache stages artifacts beside their final name (Class.XXXXXX).
      # A killed/interrupted build can leave one behind; it is neither a class
      # nor a valid completion candidate.
      name=${file##*/}
      [[ "$name" =~ $name_pattern ]] || continue
      # Package traits share this directory with classes.
      if ! grep -Eq '^__[A-Za-z0-9_]+__is_trait="1"$' "$file"; then
        printf '%s\n' "$name"
      fi
    done | sort
  ]

  # List all available traits (compiled traits)
  rawMethod: listTraits [
    local dir file name
    local name_pattern='^[A-Za-z_][A-Za-z0-9_]*$'
    for dir in "$TRASHDIR/.compiled/traits" "$TRASHDIR/.compiled"; do
      for file in "$dir/"*; do
        [[ -f "$file" ]] || continue
        name="${file##*/}"
        [[ "$name" =~ $name_pattern ]] || continue
        if grep -Eq '^__[A-Za-z0-9_]+__is_trait="1"$' "$file"; then
          printf '%s\n' "${name//__/::}"
        fi
      done
    done | sort -u
  ]

  # Get methods available on a class
  rawMethod: methodsFor: class_name [
    local compiled_name="${class_name//::/__}"
    if ! _ensure_class_sourced "$class_name" && ! _ensure_trait_sourced "$class_name"; then
      echo "Class $class_name not found"
      return 1
    fi

    echo "Methods for $class_name:"
    # List functions defined for this class
    _compiled_methods_for "$class_name" | grep -v "^__${compiled_name}__class__" | sed "s/__${compiled_name}__/  /"

    # Show class methods
    echo "Class methods:"
    _compiled_methods_for "$class_name" | grep "^__${compiled_name}__class__" | sed "s/__${compiled_name}__class__/  /"

    # Show trait methods
    local traits_var="__${compiled_name}__traits"
    local traits="${!traits_var:-}"
    if [[ -n "$traits" ]]; then
      for trait in $traits; do
        local trait_name="${trait//::/__}"
        if _ensure_trait_sourced "$trait"; then
          echo ""
          echo "From trait $trait:"
          _compiled_methods_for "$trait" | grep -v "^__${trait_name}__class__" | sed "s/__${trait_name}__/  /"
          # Trait class methods
          local trait_class_methods
          trait_class_methods=$(_compiled_methods_for "$trait" | grep "^__${trait_name}__class__" | sed "s/__${trait_name}__class__/  /")
          if [[ -n "$trait_class_methods" ]]; then
            echo "  (class methods):"
            echo "$trait_class_methods" | sed 's/^/  /'
          fi
        fi
      done
    fi

    # Show inherited methods
    local super_var="__${compiled_name}__superclass"
    local superclass="${!super_var:-}"
    if [[ -n "$superclass" && "$superclass" != "nil" && "$superclass" != "Object" ]]; then
      echo ""
      echo "(inherited from $superclass)"
      @ "$_RECEIVER" methodsFor: "$superclass" | sed 's/^/  /'
    fi
  ]

  # Space-separated "method:category" metadata from a class's compiled file.
  # Fails, printing nothing, when the class has no compiled file.
  rawMethod: methodCategoriesOf: class_name [
    local compiled_name="${class_name//::/__}"
    local compiled_file="$TRASHDIR/.compiled/$compiled_name"
    [[ -f "$compiled_file" ]] || return 1
    source "$compiled_file"
    local cats_var="__${compiled_name}__methodCategories"
    echo "${!cats_var:-}"
  ]

  # Get methods in a specific category for a class
  rawMethod: methodsIn: class_name category: cat_name [
    local cats
    if ! cats=$(@ "$_RECEIVER" methodCategoriesOf: "$class_name"); then
      echo "Error: Class $class_name not found"
      return 1
    fi

    if [[ -z "$cats" ]]; then
      echo "No categorized methods for $class_name"
      return 0
    fi

    # Parse and filter by category
    echo "Methods in '$cat_name' for $class_name:"
    for entry in $cats; do
      local method="${entry%%:*}"
      local category="${entry#*:}"
      if [[ "$category" == "$cat_name" ]]; then
        echo "  $method"
      fi
    done
  ]

  # List all categories for a class
  rawMethod: categoriesFor: class_name [
    local cats
    if ! cats=$(@ "$_RECEIVER" methodCategoriesOf: "$class_name"); then
      echo "Error: Class $class_name not found"
      return 1
    fi

    if [[ -z "$cats" ]]; then
      echo "No categories for $class_name"
      return 0
    fi

    # Extract unique categories
    echo "Categories for $class_name:"
    local seen=""
    for entry in $cats; do
      local category="${entry#*:}"
      if [[ ! " $seen " =~ " $category " ]]; then
        echo "  $category"
        seen="$seen $category"
      fi
    done
  ]

  # Show inheritance hierarchy for a class
  rawMethod: hierarchyFor: class_name [
    local compiled_file="$TRASHDIR/.compiled/${class_name//::/__}"

    if [[ -f "$compiled_file" ]]; then
      echo "Inheritance hierarchy for $class_name:"
      @ "$_RECEIVER" _showHierarchy: "$class_name" depth: 0
    else
      echo "Class $class_name not found"
      return 1
    fi
  ]

  # Helper for showing hierarchy (uses compiled metadata)
  rawMethod: _showHierarchy: class_name depth: depth [
    local indent superclass super_var
    local compiled_name="${class_name//::/__}"
    local compiled_file="$TRASHDIR/.compiled/$compiled_name"

    printf -v indent '%*s' "$((depth * 2))" ''
    echo "$indent$class_name"

    # Source class to get metadata
    if [[ -f "$compiled_file" ]]; then
      source "$compiled_file"
    else
      return 0
    fi

    # Get superclass from metadata
    super_var="__${compiled_name}__superclass"
    superclass="${!super_var:-}"
    if [[ -n "$superclass" && "$superclass" != "nil" ]]; then
      @ "$_RECEIVER" _showHierarchy: "$superclass" depth: $((depth + 1))
    fi
  ]

  # Reload all object stubs
  rawMethod: reload [
    echo "Reloading all object stubs..."
    initialize_trash
    echo "Reload complete"
  ]

  # Reload a single class (hot reload for development)
  rawMethod: reloadClass: class_name [
    pragma: direct
    _protocol_invalidate
    if [[ -z "$class_name" ]]; then
      echo "Usage: @ Trash reloadClass <ClassName>"
      return 1
    fi

    local compiled_name="${class_name//::/__}"
    local source_name="${class_name//:://}"
    local compiled_file="$TRASHDIR/.compiled/$compiled_name"
    local class_file="$TRASHDIR/$source_name.trash"
    local trait_file="$TRASHDIR/traits/$source_name.trash"
    local compiled_trait trait_marker="__${compiled_name}__is_trait"
    compiled_trait=$(_compiled_trait_path "$class_name") || compiled_trait=''

    # Clear the sourcing cache so the class will be re-sourced
    _clear_class_cache "$class_name"

    # Unset the old functions, then source the compiled artifact.
    _reload_compiled() {
      local func
      while IFS= read -r func; do
        unset -f "$func" 2>/dev/null
      done < <(_compiled_methods_for "$class_name")
      source "$1"
      _mark_class_sourced "$class_name"
    }

    if [[ -f "$compiled_trait" ]] && grep -q "^${trait_marker}=\"1\"$" "$compiled_trait"; then
      echo "Reloading trait $class_name..."
      _reload_compiled "$compiled_trait"
      echo "✓ Trait $class_name reloaded"
      return 0
    fi

    if [[ -f "$compiled_file" ]]; then
      echo "Reloading class $class_name..."
      _reload_compiled "$compiled_file"
      echo "✓ Class $class_name reloaded"
      return 0
    fi

    # Fall back to raw .trash source file (uncompiled)
    if [[ -f "$class_file" ]]; then
      echo "Warning: Loading uncompiled source for $class_name..."
      source "$class_file"
      _mark_class_sourced "$class_name"
      echo "✓ Class $class_name loaded from source"
      return 0
    fi

    if [[ -f "$trait_file" ]]; then
      echo "Warning: Loading uncompiled trait source for $class_name..."
      source "$trait_file"
      _mark_class_sourced "$class_name"
      echo "✓ Trait $class_name loaded from source"
      return 0
    fi

    echo "Error: Class $class_name not found"
    echo "Searched:"
    echo "  - $compiled_file"
    echo "  - $compiled_trait"
    echo "  - $class_file"
    echo "  - $trait_file"
    return 1
  ]

  # Compile and reload a class from .trash source
  # Safe: compiles to temp file first, validates, only replaces on success
  rawMethod: compileAndReload: class_name [
    pragma: direct
    if [[ -z "$class_name" ]]; then
      echo "Usage: @ Trash compileAndReload <ClassName>"
      return 1
    fi

    # sourceFileFor: owns the lookup order, so edit: and this agree.
    local source_name="${class_name//:://}" file_to_compile target_file
    file_to_compile=$(@ "$_RECEIVER" sourceFileFor: "$class_name")
    if [[ -z "$file_to_compile" ]]; then
      echo "Error: No source file found for $class_name"
      echo "Searched:"
      echo "  - $TRASHDIR/user/${source_name}.trash"
      echo "  - $TRASHDIR/${source_name}.trash"
      echo "  - $TRASHDIR/traits/${source_name}.trash"
      return 1
    fi
    target_file=$(@ "$_RECEIVER" compiledTargetFor: "$class_name" source: "$file_to_compile")
    case "$file_to_compile" in
      "$TRASHDIR/user/"*) echo "Compiling user class $class_name..." ;;
      "$TRASHDIR/traits/"*) echo "Compiling trait $class_name..." ;;
      *) echo "Compiling class $class_name..." ;;
    esac

    # Graph validation includes registered reverse dependencies before installing.
    if ! "$SCRIPT_DIR/jq-compiler/driver.bash" 'compile-cached' "$file_to_compile" "$target_file"; then
      echo "Compilation failed; class not reloaded"
      return 1
    fi
    @ "$_RECEIVER" reloadClass: "$class_name"
    return $?
  ]

  # Show system statistics
  rawMethod: stats [
    echo "=== Trash System Statistics ==="
    echo "Objects: $(@ "$_RECEIVER" listObjects | wc -l)"
    echo "Traits: $(@ "$_RECEIVER" listTraits | wc -l)"
    echo "Active processes: $(@ Process listProcesses 2>/dev/null | wc -l)"
    echo "Memory usage: $(du -sh "$TRASHDIR" | cut -f1)"
  ]

  # Show help. Rows are padded by printf: raw bodies collapse runs of spaces
  # inside string literals.
  rawMethod: help [
    local row='%-36s- %s\n'
    echo "=== Trash System Commands ==="
    printf "$row" '@ Trash info' 'Show system information'
    printf "$row" '@ Trash doctor' 'Diagnose environment/setup issues'
    printf "$row" '@ Trash userInbox' 'Return your Inbox instance'
    printf "$row" '@ Trash listObjects' 'List all objects'
    printf "$row" '@ Trash listTraits' 'List all traits'
    printf "$row" '@ Trash methodsFor: <class>' 'Show methods for class'
    printf "$row" '@ Trash hierarchyFor: <class>' 'Show inheritance hierarchy'
    printf "$row" '@ Trash new: <class>' 'Create class skeleton and edit'
    printf "$row" '@ Trash edit: <class>' 'Edit class and recompile on save'
    printf "$row" '@ Trash reload' 'Reload all object stubs'
    printf "$row" '@ Trash reloadClass: <class>' 'Hot reload a single class'
    printf "$row" '@ Trash compileAndReload: <class>' 'Compile and reload from .trash'
    printf "$row" '@ Trash stats' 'Show system statistics'
    printf "$row" '@ Trash version' 'Show version information'
    printf "$row" '@ Trash repl' 'Launch interactive REPL'
    printf "$row" "@ Trash eval: '<code>'" 'Evaluate Trashtalk code'
    printf "$row" '@ Trash evalFile: <path>' 'Evaluate Trashtalk code from a file'
    echo ""
    echo "=== Instance Queries (use class methods) ==="
    printf "$row" '@ <Class> findAll' 'Find all instances of class'
    printf "$row" "@ <Class> find: '<predicate>'" 'Find with predicate'
    printf "$row" '@ <Class> count' 'Count instances of class'
    printf "$row" '@ Store listClasses' 'List classes with instances'
    printf "$row" '@ <instance> inspect' 'Open the object inspector (text without a terminal)'
    printf "$row" '@ <instance> describe' 'Print class, id and instance variables'
    echo ""
    echo "=== Source Introspection ==="
    printf "$row" '@ Trash sourceFor: <class>' 'Get source code from .trash file'
    printf "$row" '@ Trash hashFor: <class>' 'Get source hash (SHA-256)'
    printf "$row" '@ Trash categoriesFor: <class>' 'List method categories'
    printf "$row" '@ Trash browse' 'Browse sources in inbrowser'
    printf "$row" '@ Trash browseClass: <class>' 'Pick a class symbol and edit it'
    printf "$row" '@ Trash browseInstancesOf: <class>' 'Pick a persisted instance and inspect it'
    echo ""
    echo "=== Testing ==="
    printf "$row" '@ Trash runTestsFor: <class>' 'Run testMethod: tests for class'
    printf "$row" '@ Trash hasTestsFor: <class>' 'Check if class has tests'
  ]

  # Show version information
  rawMethod: version [
    echo "Trash System v$TRASH_VERSION"
    echo "Author: $TRASH_AUTHOR"
    echo "Description: $TRASH_DESCRIPTION"
    echo "Bash version: $BASH_VERSION"
    echo "System: $(uname -s) $(uname -r)"
  ]

  # Get the source code for a class from its .trash file
  # Usage: @ Trash sourceFor: Counter
  method: sourceFor: className [
    | sourceFile |
    sourceFile := @ self sourceFileFor: className.
    sourceFile isEmpty ifTrue: [@ SourceError signal: 'Source file for ' , className , ' not found'].
    ^ @ File read: sourceFile
  ]

  # Read-only browser snapshot. The canonical jq parser supplies every class
  # and method location; Innards is given no mutation protocol or shell hooks.
  rawMethod: browserIndex [
    local root driver records
    local -a files
    root="$TRASHDIR"
    driver="${TRASHTALK_DIR:-$HOME/.trashtalk}/lib/jq-compiler/driver.bash"
    mapfile -d '' -t files < <(find "$root" -type f -name '*.trash' -print0 | sort -z)
    ((${#files[@]})) || { _throw 'BrowserError' 'No Trashtalk source files found'; return 1; }
    records=$("$driver" symbols-many "${files[@]}") || return 1
    jq -cs --arg root "$root" '
      def package: (.class_name | split("::") | if length > 1 then .[0:-1] | join("::") else "" end);
      def short: (.class_name | split("::") | last);
      [ .[] | select(.kind == "class" or .kind == "trait") ] as $classes |
      [ .[] | select(.kind == "instance_method" or .kind == "class_method" or .kind == "test_method") ] as $methods |
      {schema_version:1,root:$root,classes:[$classes[] as $class | {name:($class|short),package:($class|package),kind:$class.kind,
        superclass:($class.superclass // ""),path:$class.path,methods:[$methods[] | select(.class_name == $class.class_name) |
          {selector,side:(if .method_kind == "class" then "class" elif .method_kind == "test" then "test" else "instance" end),
           kind:.method_kind,raw,line}] }]}' <<< "$records"
  ]

  classMethod: browse [
    | available index |
    available := @ Tools::Inbrowser isInstalled.
    (available ~= 'true') ifTrue: [^ @ Require reject: 'inbrowser is not installed; build and install the Innards applet'].
    index := @ self browserIndex.
    ^ @ Tools::Inbrowser browseIndex: index
  ]

  # Get the source hash for a class
  # Usage: @ Trash hashFor: Counter
  rawMethod: hashFor: class_name [
    local compiled_name="${class_name//::/__}"
    local hash_var="__${compiled_name}__sourceHash"
    local compiled_file="$TRASHDIR/.compiled/$compiled_name"

    # Try to get from already-loaded class
    if [[ -n "${!hash_var:-}" ]]; then
      echo "${!hash_var}"
      return 0
    fi

    # Try loading the compiled class
    if [[ -f "$compiled_file" ]]; then
      source "$compiled_file"
      if [[ -n "${!hash_var:-}" ]]; then
        echo "${!hash_var}"
        return 0
      fi
    fi

    echo "Error: Could not get hash for $class_name"
    return 1
  ]

  # Run tests for a class
  # Usage: @ Trash runTestsFor: Counter
  # Returns: 0 if all tests pass, 1 if any fail
  rawMethod: runTestsFor: class_name [
    local compiled_name="${class_name//::/__}"
    local compiled_file="$TRASHDIR/.compiled/$compiled_name"

    if [[ ! -f "$compiled_file" ]]; then
      echo "Error: Class $class_name not found"
      return 1
    fi
    @ "$_RECEIVER" runTestsFromArtifact: "$compiled_file" class: "$class_name"
  ]

  # Run a class's declared tests from an explicit compiled artifact. Proposal
  # gates use this before installation; normal tests delegate here as well.
  rawMethod: runTestsFromArtifact: artifact class: class_name [
    local compiled_name="${class_name//::/__}"
    local tests_var="__${compiled_name}__tests"
    local tests

    if [[ ! -f "$artifact" ]]; then
      echo "Error: Compiled artifact for $class_name not found"
      return 1
    fi
    source "$artifact"

    # Check if class has tests
    tests="${!tests_var:-}"
    if [[ -z "$tests" ]]; then
      echo "# No tests defined for $class_name"
      return 0
    fi

    echo "# Running tests for $class_name"
    _test_reset
    local test_selector func_name
    local failed=0

    for test_selector in $tests; do
      func_name="__${compiled_name}__test__${test_selector}"
      if declare -f "$func_name" >/dev/null 2>&1; then
        # Capture output to temp file to check type while preserving counters
        local tmpfile="/tmp/trash_test_$$"
        "$func_name" > "$tmpfile" 2>&1
        local test_exit_code=$?
        local test_result
        test_result=$(cat "$tmpfile")
        rm -f "$tmpfile"

        # Determine test type by output:
        # - "true"/"false" = DSL testMethod
        # - Other = rawTestMethod (output already includes TAP from _assert_*)
        if [[ "$test_result" == "false" ]]; then
          # DSL testMethod returned false
          ((_TEST_COUNT++))
          ((_TEST_FAILURES++))
          echo "not ok $_TEST_COUNT - $test_selector"
          failed=1
        elif [[ "$test_result" == "true" ]]; then
          # DSL testMethod returned true
          ((_TEST_COUNT++))
          echo "ok $_TEST_COUNT - $test_selector"
        else
          # rawTestMethod - output already formatted, counters already updated
          echo "$test_result"
          if [[ $test_exit_code -ne 0 ]]; then
            failed=1
          fi
        fi
      else
        ((_TEST_COUNT++))
        ((_TEST_FAILURES++))
        echo "not ok $_TEST_COUNT - test function $func_name not found"
        failed=1
      fi
    done

    _test_summary
    return $failed
  ]

  rawMethod: testCompiledCandidate: artifact class: class_name [
    local output ok=true
    output=$(@ "$_RECEIVER" runTestsFromArtifact: "$artifact" class: "$class_name" 2>&1) || ok=false
    jq -cn --argjson ok "$ok" --arg message "$output" '{ok:$ok,phase:"test",line:1,message:$message}'
  ]

  # Check if a class has tests defined
  # Usage: @ Trash hasTestsFor: Counter
  rawMethod: hasTestsFor: class_name [
    local compiled_name="${class_name//::/__}"
    local tests_var="__${compiled_name}__tests"
    local compiled_file="$TRASHDIR/.compiled/$compiled_name"

    # Ensure class is loaded
    if [[ -f "$compiled_file" ]]; then
      source "$compiled_file"
    fi

    local tests="${!tests_var:-}"
    if [[ -n "$tests" ]]; then
      echo "true"
      return 0
    else
      echo "false"
      return 1
    fi
  ]

  # Launch interactive REPL with rlwrap (history, completion).
  # Falls back to bin/trash-repl if already inside rlwrap to avoid nesting.
  rawClassMethod: repl [
    pragma: direct
    local trashtalk_root
    trashtalk_root="$(dirname "$TRASHDIR")"
    if [[ -n "$RLWRAP_VERSION" ]]; then
      "$trashtalk_root/bin/trash-repl"
    else
      "$trashtalk_root/bin/trash"
    fi
  ]

  # Create a new class with minimal skeleton and open in editor
  # New classes are created in the user directory (trash/user/)
  rawMethod: new: class_name [
    pragma: direct
    local user_file="$TRASHDIR/user/${class_name}.trash"
    local system_file="$TRASHDIR/${class_name}.trash"
    local trait_file="$TRASHDIR/traits/${class_name}.trash"

    # Check if class already exists anywhere
    if [[ -f "$user_file" ]]; then
      echo "Class $class_name already exists in user/. Use '@ Trash edit: $class_name' to edit."
      return 1
    fi
    if [[ -f "$system_file" ]]; then
      echo "Class $class_name already exists as a system class. Use '@ Trash edit: $class_name' to edit."
      return 1
    fi
    if [[ -f "$trait_file" ]]; then
      echo "A trait named $class_name already exists. Use '@ Trash edit: $class_name' to edit."
      return 1
    fi

    # Ensure user directory exists
    mkdir -p "$TRASHDIR/user"

    # Create minimal skeleton with heredoc
    cat > "$user_file" <<EOF
${class_name} subclass: Object
  instanceVars:

  method: example [
    ^ 'Hello from ${class_name}'
  ]

  rawTestMethod: testExample [
    local instance result
    instance=\$(@ ${class_name} new)
    result=\$(@ "\$instance" example)
    _assert_eq "\$result" 'Hello from ${class_name}' 'example returns greeting'
  ]
EOF

    echo "Created $user_file"

    # Open in editor (edit: handles compile on save)
    @ "$_RECEIVER" edit: "$class_name"
  ]

  # Resolve a class or trait to its editable source using public DSL helpers.
  method: sourceFileFor: className [
    | root relative userSource classSource traitSource |
    root := @ Env get: 'TRASHDIR'.
    relative := className replaceAll: '::' with: '/'.
    userSource := root , '/user/' , relative , '.trash'.
    classSource := root , '/' , relative , '.trash'.
    traitSource := root , '/traits/' , relative , '.trash'.
    userSource fileExists ifTrue: [^ userSource].
    classSource fileExists ifTrue: [^ classSource].
    traitSource fileExists ifTrue: [^ traitSource].
    ^ ''
  ]

  # Present diagnostics without modifying source. Innards consumes the
  # temporary annotation document; an external editor remains a safe fallback.
  method: editFile: sourceFile diagnostics: diagnostics line: line [
    | available annotationFile annotationPath result file before after outcome |
    available := @ Tools::Inmacs isInstalled.
    (available = 'true') ifTrue: [
      annotationPath := ''.
      diagnostics notEmpty ifTrue: [
        annotationFile := @ File tempWithPrefix: 'trash-edit-annotations-'.
        @ annotationFile write: diagnostics.
        annotationPath := @ annotationFile path
      ].
      result := @ Tools::Inmacs editFile: sourceFile annotations: annotationPath line: line.
      annotationPath notEmpty ifTrue: [@ annotationFile delete].
      ^ result
    ].

    file := @ File at: sourceFile.
    before := @ file read.
    @ Tools::Inmacs fallbackEditFile: sourceFile line: line.
    after := @ file read.
    outcome := 'unchanged'.
    (before ~= after) ifTrue: [outcome := 'saved'].
    ^ #{schema_version: 1 outcome: outcome path: sourceFile} asJson
  ]

  # Compile to a candidate artifact. This raw method is an OS/compiler boundary;
  # workflow decisions and diagnostic construction remain in DSL methods.
  rawMethod: compileClass: className source: sourceFile [
    local artifact error_file message line
    artifact=$(mktemp "${TMPDIR:-/tmp}/trash-edit-artifact.XXXXXX")
    error_file=$(mktemp "${TMPDIR:-/tmp}/trash-edit-compile.XXXXXX")

    if _trash_with_progress "Compiling $className" "$SCRIPT_DIR/jq-compiler/driver.bash" 'compile-preview' "$sourceFile" "$artifact" 2> "$error_file"; then
      rm -f "$error_file"
      jq -cn --arg artifact "$artifact" '{ok:true,phase:"compile",artifact:$artifact,line:1,message:""}'
      return 0
    fi

    message=$(cat "$error_file")
    line=$(printf '%s\n' "$message" | grep -oE '[0-9]+:[0-9]+:' | head -1 | cut -d: -f1)
    [[ -n "$line" ]] || line=1
    rm -f "$artifact" "$error_file"
    jq -cn --arg message "$message" --argjson line "$line" '{ok:false,phase:"compile",artifact:"",line:$line,message:$message}'
  ]

  rawMethod: validateCompiledCandidate: artifact [
    local message
    if message=$(bash -n "$artifact" 2>&1); then
      jq -cn --arg artifact "$artifact" '{ok:true,phase:"bash",artifact:$artifact,line:1,message:""}'
      return 0
    fi
    rm -f "$artifact"
    jq -cn --arg message "$message" '{ok:false,phase:"bash",artifact:"",line:1,message:$message}'
  ]

  rawMethod: validateCompiledIdentity: artifact class: class_name [
    local compiled_name marker message
    compiled_name="${class_name//::/__}"
    marker="__${compiled_name}__superclass="
    if awk -v marker="$marker" 'index($0, marker) == 1 { found=1 } END { exit !found }' "$artifact"; then
      jq -cn --arg artifact "$artifact" '{ok:true,phase:"identity",artifact:$artifact,line:1,message:""}'
    else
      message="Compiled proposal does not define the declared class $class_name"
      rm -f "$artifact"
      jq -cn --arg message "$message" '{ok:false,phase:"identity",artifact:"",line:1,message:$message}'
    fi
  ]

  # Installed artifact path for a source: global traits build under traits/.
  rawMethod: compiledTargetFor: className source: sourceFile [
    local compiled_name="${className//::/__}"
    if [[ "$sourceFile" == *"/traits/"* ]]; then
      printf '%s\n' "$TRASHDIR/.compiled/traits/$compiled_name"
    else
      printf '%s\n' "$TRASHDIR/.compiled/$compiled_name"
    fi
  ]

  rawMethod: installCompiledCandidate: artifact for: className source: sourceFile [
    pragma: direct
    local target output
    target=$(@ "$_RECEIVER" compiledTargetFor: "$className" source: "$sourceFile")
    mkdir -p "$(dirname "$target")"
    if ! output=$("$SCRIPT_DIR/jq-compiler/driver.bash" 'compile-cached' "$sourceFile" "$target" 2>&1); then
      rm -f "$artifact"
      jq -cn --arg message "$output" '{ok:false,phase:"install",line:1,message:$message}'
      return 0
    fi
    rm -f "$artifact"
    if output=$(@ "$_RECEIVER" reloadClass: "$className" 2>&1); then
      jq -cn '{ok:true,phase:"install",line:1,message:""}'
    else
      jq -cn --arg message "$output" '{ok:false,phase:"install",line:1,message:$message}'
    fi
  ]

  # Test the installed artifact through the same gate as a candidate.
  method: testClassForEdit: className [
    | compiledName artifact |
    compiledName := className replaceAll: '::' with: '__'.
    artifact := (@ Env get: 'TRASHDIR') , '/.compiled/' , compiledName.
    ^ @ self testCompiledCandidate: artifact class: className
  ]

  method: annotationsFor: message line: line phase: phase [
    ^ #{schema_version: 1 annotations: #(
      #{line: (line jsonValue) column: 1 severity: 'error'
        message: (phase , ': ' , message)}
    )} asJson
  ]

  method: diagnosticsFromCompileResult: result [
    result jsonUnpack: #('message' 'line' 'phase') into: [:message :line :phase |
      ^ @ self annotationsFor: message line: line phase: phase
    ]
  ]

  # Parse every source through the canonical jq compiler. File discovery and
  # process invocation are the OS/compiler boundary; no second symbol cache is
  # introduced.
  rawMethod: astRecords [
    pragma: direct
    @ "$_RECEIVER" compilerCommand: 'parse-many' overSourcesShowing: ''
  ]

  # Source discovery and compiler invocation are an OS boundary. The compiler
  # owns content/query invalidation for the derived public symbol records.
  rawMethod: symbolRecords [
    @ "$_RECEIVER" compilerCommand: 'symbols-many' overSourcesShowing: 'Indexing symbols'
  ]

  # Run one driver command over every .trash source outside .compiled/. An
  # empty label runs without a progress indicator.
  rawMethod: compilerCommand: command overSourcesShowing: label [
    pragma: direct
    local -a sources
    mapfile -d '' -t sources < <(find "$TRASHDIR" -type f -name '*.trash' \
      -not -path "$TRASHDIR/.compiled/*" -print0)
    [[ ${#sources[@]} -gt 0 ]] || return 0
    _trash_with_progress "$label" "$SCRIPT_DIR/jq-compiler/driver.bash" "$command" "${sources[@]}"
  ]

  rawMethod: symbolRecordsForSource: sourceFile [
    _trash_with_progress 'Reading symbols' "$SCRIPT_DIR/jq-compiler/driver.bash" 'symbols-many' "$1"
  ]

  method: symbolRecordsForClass: className [
    | records source |
    source := @ self sourceFileFor: className.
    source isEmpty ifTrue: [^ ''].
    records := @ self symbolRecordsForSource: source.
    ^ @ String jsonLinesWhere: 'class_name' equals: className from: records
  ]

  method: classRecords [
    | records classes traits |
    records := @ self symbolRecords.
    classes := @ String jsonLinesWhere: 'kind' equals: 'class' from: records.
    traits := @ String jsonLinesWhere: 'kind' equals: 'trait' from: records.
    ^ classes , '
' , traits
  ]

  method: implementorsOf: selector [
    | records |
    records := @ self symbolRecords.
    ^ @ String jsonLinesWhere: 'selector' equals: selector from: records
  ]

  # Sender analysis is a compiler query because it must group parsed keyword
  # message parts. Comparing individual source tokens is not semantically valid.
  rawMethod: sendersOf: selector [
    local records
    records=$(@ "$_RECEIVER" astRecords) || return
    printf '%s\n' "$records" | jq -c --arg path '' --arg wanted "$1" \
      -f "$SCRIPT_DIR/jq-compiler/senders.jq"
  ]

  # Build persisted-object candidates in the DSL. Only Store and Runtime own
  # the database boundary; the browser sees ordinary versioned records.
  method: instanceRecordsFor: className [
    | snapshots source projections template |
    snapshots := @ Runtime dataForClass: className.
    source := @ self sourceFileFor: className.
    source isEmpty ifTrue: [^ ''].
    projections := @ String jsonInstanceProjections: snapshots.
    template := #{schema_version: 1 id: #{_at: 'id'} path: source line: 1 column: 1
                  label: #{_concat: #(className ' ' #{_at: 'shortId'})}
                  kind: 'instance' detail: #{_at: 'detail'} class_name: className
                  object_id: #{_at: 'id'} data: #{_at: 'data'}
                  display: #{columns: #{_at: 'columns'}}} asJson.
    ^ @ Json projectEach: projections with: template
  ]

  method: pickRecords: records query: query title: title [
    | root available |
    root := @ Env get: 'TRASHDIR'.
    root := root withoutSuffix: '/trash'.
    available := @ Tools::Inpick isInstalled.
    (available = 'true') ifTrue: [
      ^ @ Tools::Inpick selectRecords: records root: root query: query title: title
    ].
    ^ @ Tools::Inpick fallbackSelectRecords: records query: query title: title
  ]

  method: pickMethod: className [
    | records title |
    records := @ self symbolRecordsForClass: className.
    title := 'Methods: ' , className.
    ^ @ self pickRecords: records query: 'method' title: title
  ]

  method: browseClasses [
    | records |
    records := @ self classRecords.
    ^ @ self pickRecords: records query: '' title: 'Classes and traits'
  ]

  # Selection is kept separately for callers which need the typed picker
  # result. The user-facing browser below opens the selected object instead of
  # leaving a selection JSON document on the terminal.
  method: selectInstanceOf: className [
    | records title |
    records := @ self instanceRecordsFor: className.
    title := 'Instances: ' , className.
    ^ @ self pickRecords: records query: '' title: title
  ]

  method: inspectObject: objectId [
    ^ @ UI::Inspector openObject: objectId
  ]

  # Enter from the instance table opens the object inspector on the selected
  # instance rather than printing the picker record's JSON.
  method: browseInstancesOf: className [
    | selection outcome objectId |
    selection := @ self selectInstanceOf: className.
    outcome := @ String jsonPath: 'outcome' from: selection.
    (outcome ~= 'selected') ifTrue: [^ selection].
    objectId := @ String jsonPath: 'selection.object_id' from: selection.
    ^ @ self inspectObject: objectId
  ]

  method: openBrowserResult: result [
    | outcome sourceFile className line |
    outcome := @ String jsonPath: 'outcome' from: result.
    (outcome ~= 'selected') ifTrue: [^ outcome].
    sourceFile := @ String jsonPath: 'selection.path' from: result.
    className := @ String jsonPath: 'selection.class_name' from: result.
    line := @ String jsonPath: 'selection.line' from: result.
    ^ @ self editSource: sourceFile class: className line: line
  ]

  method: browseRecords: records title: title [
    | result |
    result := @ self pickRecords: records query: '' title: title.
    ^ @ self openBrowserResult: result
  ]

  method: browseClass: className [
    | records |
    records := @ self symbolRecordsForClass: className.
    ^ @ self browseRecords: records title: 'Browse: ' , className
  ]

  method: browseImplementorsOf: selector [
    | records |
    records := @ self implementorsOf: selector.
    ^ @ self browseRecords: records title: 'Implementors: ' , selector
  ]

  method: browseSendersOf: selector [
    | records |
    records := @ self sendersOf: selector.
    ^ @ self browseRecords: records title: 'Senders: ' , selector
  ]

  # DSL-first edit/compile/check/reload/test workflow. Diagnostics are passed as
  # annotations and never written into the .trash source.
  method: edit: className [
    | sourceFile message |
    sourceFile := @ self sourceFileFor: className.
    sourceFile isEmpty ifTrue: [
      message := 'No source file found for ' , className.
      @ Console error: message.
      ^ ''
    ].

    ^ @ self editSource: sourceFile class: className line: '1'
  ]

  # Run saved source through the compile, Bash, install, and test gates.
  # Answers the first failing gate's result, or the test gate's result.
  method: installEditedSource: sourceFile class: className [
    | result ok artifact |
    result := @ self compileClass: className source: sourceFile.
    ok := result jsonTextAt: 'ok'.
    (ok ~= 'true') ifTrue: [^ result].
    artifact := result jsonTextAt: 'artifact'.
    result := @ self validateCompiledCandidate: artifact.
    ok := result jsonTextAt: 'ok'.
    (ok ~= 'true') ifTrue: [^ result].
    result := @ self installCompiledCandidate: artifact for: className source: sourceFile.
    ok := result jsonTextAt: 'ok'.
    (ok ~= 'true') ifTrue: [^ result].
    ^ @ self testClassForEdit: className
  ]

  method: editSource: sourceFile class: className line: initialLine [

    pragma: stream
    pragma: direct
    | diagnostics line editorResult outcome result message |

    diagnostics := ''.
    line := initialLine.
    [1 = 1] whileTrue: [
      editorResult := @ self editFile: sourceFile diagnostics: diagnostics line: line.
      outcome := @ String jsonPath: 'outcome' from: editorResult.
      outcome caseOf: {
        '' -> [
          @ Console error: 'Editor failed without a structured result'.
          ^ ''
        ].
        #('unchanged' 'cancelled' 'discarded') -> [^ outcome].
        'saved' -> [
          message := 'Compiling ' , className , '...'.
          @ Console print: message
        ]
      } otherwise: [
        message := 'Editor failed: ' , outcome.
        @ Console error: message.
        ^ ''
      ].

      result := @ self installEditedSource: sourceFile class: className.
      result jsonUnpack: #('ok' 'line' 'message') into: [:ok :failedLine :failure |
        (ok = 'true') ifTrue: [
          message := 'Compiled and tested ' , className.
          @ Console print: message.
          ^ 'saved'
        ].
        diagnostics := @ self diagnosticsFromCompileResult: result.
        line := failedLine.
        @ Console error: failure
      ]
    ]
  ]

  # Evaluate a string of Trashtalk code
  # Usage: @ Trash eval: 'counter := @ Counter new. @ counter increment. @ counter getValue'
  # Returns the result of the last expression
  rawClassMethod: eval: code [
    local temp_class="_TempEval_$$_$RANDOM"
    local temp_file="/tmp/${temp_class}.trash"
    local compiled_file="/tmp/${temp_class}.compiled"
    local result

    # Wrap code in a temporary class with a run method
    cat > "$temp_file" << EVALEOF
${temp_class} subclass: Object
  rawClassMethod: run [
    $1
  ]
EVALEOF

    # Compile the temporary class
    if ! "$SCRIPT_DIR/jq-compiler/driver.bash" compile "$temp_file" > "$compiled_file" 2>&1; then
      echo "Eval compile error:" >&2
      cat "$compiled_file" >&2
      rm -f "$temp_file" "$compiled_file"
      return 1
    fi

    # Validate bash syntax
    if ! bash -n "$compiled_file" 2>&1; then
      echo "Eval syntax error" >&2
      rm -f "$temp_file" "$compiled_file"
      return 1
    fi

    # Source and execute
    source "$compiled_file"
    result=$("__${temp_class}__class__run")
    local exit_code=$?

    # Clean up
    rm -f "$temp_file" "$compiled_file"
    # Unset the temporary functions
    unset -f "__${temp_class}__class__run" 2>/dev/null
    unset "__${temp_class}__superclass" 2>/dev/null
    unset "__${temp_class}__is_a" 2>/dev/null

    echo "$result"
    return $exit_code
  ]

  # Evaluate code from a file
  # Usage: @ Trash evalFile: '/path/to/script.trash'
  rawClassMethod: evalFile: filepath [
    if [[ ! -f "$1" ]]; then
      echo "Error: File not found: $1" >&2
      return 1
    fi
    local code
    code=$(cat "$1")
    @ Trash eval: "$code"
  ]
