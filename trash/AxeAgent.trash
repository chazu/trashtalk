# AxeAgent - Named project-local Axe configuration adapter.

AxeAgent subclass: Agent

  classMethod: agentName [
    ^ 'trashtalk-readonly'
  ]

  classMethod: proposerName [
    ^ 'trashtalk-proposer'
  ]

  classMethod: contextFor: question workingDirectory: workingDirectory status: status lastResult: lastResult [
    | context unused |
    context := @ Json object.
    unused := @ context at: 'schema_version' putNumber: '1'.
    unused := @ context at: 'question' put: question.
    unused := @ context at: 'working_directory' put: workingDirectory.
    unused := @ context at: 'last_status' putNumber: status.
    unused := @ context at: 'last_result' put: lastResult.
    ^ @ context build
  ]

  classMethod: ask: question workingDirectory: workingDirectory status: status lastResult: lastResult [
    | context agent |
    context := @ self contextFor: question workingDirectory: workingDirectory status: status lastResult: lastResult.
    agent := @ self agentName.
    ^ @ Tools::Axe run: agent input: context workingDirectory: workingDirectory
  ]

  classMethod: dryRun: question workingDirectory: workingDirectory status: status lastResult: lastResult [
    | context agent |
    context := @ self contextFor: question workingDirectory: workingDirectory status: status lastResult: lastResult.
    agent := @ self agentName.
    ^ @ Tools::Axe dryRun: agent prompt: context workingDirectory: workingDirectory
  ]

  classMethod: run: agent withInput: input [
    | workingDirectory |
    workingDirectory := @ Env cwd.
    ^ @ Tools::Axe run: agent input: input workingDirectory: workingDirectory
  ]

  classMethod: proposalContextFor: question class: className workingDirectory: workingDirectory [
    | sourceFile hash root relative context unused |
    sourceFile := @ Trash sourceFileFor: className.
    sourceFile isEmpty ifTrue: [^ ''].
    hash := @ File sha256: sourceFile.
    root := @ Env get: 'TRASHDIR'.
    root := @ String trimSuffix: '/trash' from: root.
    relative := @ String trimPrefix: (root , '/') from: sourceFile.
    context := @ Json object.
    unused := @ context at: 'schema_version' putNumber: '1'.
    unused := @ context at: 'question' put: question.
    unused := @ context at: 'working_directory' put: workingDirectory.
    unused := @ context at: 'class_name' put: className.
    unused := @ context at: 'path' put: relative.
    unused := @ context at: 'base_sha256' put: hash.
    ^ @ context build
  ]

  classMethod: propose: question class: className workingDirectory: workingDirectory [
    | context agent |
    context := @ self proposalContextFor: question class: className workingDirectory: workingDirectory.
    context isEmpty ifTrue: [^ ''].
    agent := @ self proposerName.
    ^ @ Tools::Axe run: agent input: context workingDirectory: workingDirectory
  ]
