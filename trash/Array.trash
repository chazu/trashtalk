# Array - Collection object for managing lists
Array subclass: Object
  include: Debuggable
  include: Persistable
  instanceVars: items:'[]'

  # Create array from newline-separated text
  # Usage: arr := @ Array fromLines: "a\nb\nc"
  # Returns array containing ["a", "b", "c"]
  classMethod: fromLines: text [
    | jsonArray |
    jsonArray := @ String splitToArray: text on: '
'.
    ^ @ Array fromJson: jsonArray
  ]

  # Create array from a JSON array string
  classMethod: fromJson: json [
    | arr |
    arr := @ Array new.
    @ arr setItems: json.
    ^ arr
  ]

  # Get element at index
  method: at: index [
    ^ items arrayAt: index
  ]

  # Set element at index
  method: at: index put: value [
    items := items arrayAt: index put: value
    ^ value
  ]

  # Add element to end
  method: push: value [
    items := items arrayPush: value
    ^ value
  ]

  # Remove and return last element
  method: pop [
    | last |
    last := items arrayLast
    items := items arrayRemoveAt: -1
    ^ last
  ]

  # Get array length
  method: size [
    ^ items arrayLength
  ]

  # Check if array is empty
  method: isEmpty [
    ^ items arrayIsEmpty
  ]

  # Get first element
  method: first [
    ^ items arrayFirst
  ]

  # Get last element
  method: last [
    ^ items arrayLast
  ]

  # Print array contents
  method: show [
    (items arrayIsEmpty) ifTrue: [^ '(empty array)'] ifFalse: [^ items]
  ]

  # Initialize with values (space-separated)
  method: withValues: values [
    # Split on space and set as items
    items := @ String splitToArray: values on: ' '.
    ^ self
  ]

  # Iterate over each element, calling block with each value
  # Usage: @ myArray do: [:each | @ Console print: each]
  method: do: aBlock [
    pragma: direct
    items arrayEach: [:element | @ aBlock valueWith: element]
  ]

  method: collect: aBlock [
    | newItems |
    newItems := items arrayCollect: aBlock.
    ^ @ Array fromJson: newItems
  ]

  method: select: aBlock [
    | newItems |
    newItems := items arraySelect: aBlock.
    ^ @ Array fromJson: newItems
  ]

  method: detect: aBlock [
    | result |
    items arrayEach: [:element |
      result := @ aBlock valueWith: element.
      result notEmpty ifTrue: [^ element]
    ].
    ^ ''
  ]

  # An empty detect: result (no match, or a matched empty element) runs the default.
  method: detect: aBlock ifNone: defaultBlock [
    | found |
    found := @ self detect: aBlock.
    found notEmpty ifTrue: [^ found].
    ^ @ defaultBlock value
  ]

  method: inject: initial into: aBlock [
    | acc |
    acc := initial.
    items arrayEach: [:element | acc := @ aBlock valueWith: acc and: element].
    ^ acc
  ]
