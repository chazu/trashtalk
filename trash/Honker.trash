# Honker - OOP wrapper for the Honker SQLite extension
# Provides pub/sub, work queues, durable streams, scheduling, locks, and rate limiting.
# All class methods (singleton-style) — delegates to honker.bash functions.
#
# Usage:
#   @ Honker isAvailable              # Check if honker extension is loaded
#   @ Honker notify: 'topic' payload: '{"msg":"hi"}'
#   pid=$(@ Honker listen: 'topic' do: $handler)
#   @ Honker enqueue: 'myqueue' payload: '{"task":"go"}'
#   claimed=$(@ Honker claim: 'myqueue')

Honker subclass: Object

  # Check if the honker extension is available
  rawClassMethod: isAvailable [
    if honker_available; then
      echo "true"
    else
      echo "false"
    fi
  ]

  # Initialize honker tables (idempotent)
  classPrimitive: bootstrap calls: honker_bootstrap

  # --- Ephemeral Pub/Sub ---

  classPrimitive: notify: channel payload: data calls: honker_notify

  # Start listening on a channel with a handler block
  # Returns listener PID
  rawClassMethod: listen: channel do: handler [
    local handler_id="$2"
    local wrapper="_honker_cb_$$_$RANDOM"
    eval "${wrapper}() { @ \"${handler_id}\" valueWith: \"\$1\"; }"
    export -f "$wrapper"
    honker_listen "$1" "$wrapper"
  ]

  classPrimitive: unlisten: pid calls: honker_unlisten

  # --- Work Queue ---

  classPrimitive: enqueue: queue payload: data calls: honker_enqueue

  classPrimitive: enqueue: queue payload: data priority: pri calls: honker_enqueue

  rawClassMethod: enqueue: queue payload: data delay: seconds [
    honker_enqueue "$1" "$2" 0 3 "$3"
  ]

  classPrimitive: claim: queue calls: honker_claim

  rawClassMethod: claim: queue batch: n [
    honker_claim "$1" "worker_$$" "$2"
  ]

  rawClassMethod: claim: queue timeout: seconds [
    honker_claim "$1" "worker_$$" 1 "$2"
  ]

  classPrimitive: ack: jobIds calls: honker_ack

  classPrimitive: sweep: queue calls: honker_sweep

  # --- Distributed Locks ---

  classPrimitive: lock: name calls: honker_lock

  rawClassMethod: lock: name ttl: seconds [
    honker_lock "$1" "$$" "$2"
  ]

  classPrimitive: unlock: name calls: honker_unlock

  # --- Rate Limiting ---

  classPrimitive: rateLimit: key limit: n window: seconds calls: honker_rate_limit

  # --- Durable Streams ---

  classPrimitive: publish: stream key: key payload: data calls: honker_stream_publish

  rawClassMethod: publish: stream payload: data [
    honker_stream_publish "$1" "default" "$2"
  ]

  classPrimitive: readStream: stream offset: offset limit: n calls: honker_stream_read

  classPrimitive: readStream: stream calls: honker_stream_read

  classPrimitive: saveOffset: consumer stream: stream offset: offset calls: honker_stream_save_offset

  classPrimitive: getOffset: consumer stream: stream calls: honker_stream_get_offset

  # --- Scheduler ---

  classPrimitive: schedule: name task: task cron: expr payload: data calls: honker_schedule

  classPrimitive: unschedule: name calls: honker_unschedule

  classPrimitive: tick calls: honker_scheduler_tick

  classPrimitive: soonest calls: honker_scheduler_soonest

  # --- Result Storage ---

  classPrimitive: saveResult: jobId data: result calls: honker_result_save

  classPrimitive: saveResult: jobId data: result ttl: seconds calls: honker_result_save

  classPrimitive: getResult: jobId calls: honker_result_get

  classPrimitive: sweepResults calls: honker_result_sweep

  # --- Help ---

  rawClassMethod: help [
    echo "=== Honker - SQLite Pub/Sub, Queues, Streams ==="
    echo ""
    echo "Availability:"
    echo "  @ Honker isAvailable"
    echo "  @ Honker bootstrap"
    echo ""
    echo "Pub/Sub:"
    echo "  @ Honker notify: 'channel' payload: '{\"msg\":\"hi\"}'"
    echo "  pid=\$(@ Honker listen: 'channel' do: \$handler)"
    echo "  @ Honker unlisten: \$pid"
    echo ""
    echo "Work Queue:"
    echo "  @ Honker enqueue: 'queue' payload: '{\"task\":\"go\"}'"
    echo "  claimed=\$(@ Honker claim: 'queue')"
    echo "  @ Honker ack: '[\$jobId]'"
    echo ""
    echo "Streams:"
    echo "  @ Honker publish: 'stream' payload: '{\"data\":1}'"
    echo "  msgs=\$(@ Honker readStream: 'stream')"
    echo ""
    echo "Locks:"
    echo "  @ Honker lock: 'mylock'"
    echo "  @ Honker unlock: 'mylock'"
    echo ""
    echo "Rate Limiting:"
    echo "  allowed=\$(@ Honker rateLimit: 'action' limit: 10 window: 60)"
    echo ""
    echo "Scheduler:"
    echo "  @ Honker schedule: 'name' task: 'task' cron: '*/5 * * * *' payload: '{}'"
    echo "  @ Honker tick"
  ]
