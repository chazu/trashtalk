# Tools::Codex - Exact argv/stdin adapter for non-interactive Codex CLI runs.
package: Tools

Codex subclass: Tool

  classMethod: name [
    ^ 'codex'
  ]

  # Installation and ChatGPT authentication are explicit user operations.
  classMethod: installGuidance [
    ^ 'Codex CLI is not installed. Install it from the official OpenAI Codex documentation, then run: codex login'
  ]

  # Login state from stdout, or from stderr when stdout is empty.
  classMethod: authStatus [
    | path argv capture status |
    path := @ self path.
    path isEmpty ifTrue: [^ 'not installed'].
    argv := #(path 'login' 'status') asJson.
    capture := @ self captureArgvJson: argv.
    capture jsonUnpack: #('stdout' 'stderr') into: [:stdout :stderr |
      status := stdout trimmed.
      status isEmpty ifTrue: [^ stderr trimmed].
      ^ status
    ]
  ]

  classMethod: argvForWorkingDirectory: workingDirectory [
    | path envPath argv |
    path := @ self path.
    envPath := @ Env which: 'env'.
    argv := #(envPath '-u' 'CODEX_API_KEY' '-u' 'OPENAI_API_KEY' path 'exec'
              '--ephemeral' '--ignore-user-config' '--sandbox' 'read-only'
              '--skip-git-repo-check' '--color' 'never' '--cd' workingDirectory '-') asJson.
    ^ argv
  ]

  classMethod: run: input workingDirectory: workingDirectory [
    | available authStatus argv capture |
    available := @ self isInstalled.
    (available ~= 'true') ifTrue: [^ @ self missingToolResult].
    authStatus := @ self authStatus.
    (authStatus includes: 'ChatGPT') ifFalse: [^ @ self authenticationResult: authStatus].
    argv := @ self argvForWorkingDirectory: workingDirectory.
    capture := @ self captureArgvJson: argv input: input progress: 'Waiting for Codex'.
    ^ @ self normalizeCaptured: capture
  ]

  classMethod: dryRun: input workingDirectory: workingDirectory [
    | available argv detail result |
    available := @ self isInstalled.
    (available ~= 'true') ifTrue: [^ @ self missingToolResult].
    argv := @ self argvForWorkingDirectory: workingDirectory.
    detail := #{argv: (argv jsonValue) stdin: input dry_run: true} asJson.
    result := #{schema_version: 1 backend: 'codex' outcome: 'success' exit_code: 0 stdout: '' stderr: '' result: (detail jsonValue)} asJson.
    ^ result
  ]

  classMethod: missingToolResult [
    | result guidance |
    guidance := @ self installGuidance.
    result := #{schema_version: 1 backend: 'codex' outcome: 'missing_tool' exit_code: 127 stdout: '' stderr: guidance result: null} asJson.
    ^ result
  ]

  classMethod: authenticationResult: authStatus [
    | result guidance |
    guidance := 'Codex must be authenticated with ChatGPT for subscription-backed usage. Run: codex login. Current status: ' , authStatus.
    result := #{schema_version: 1 backend: 'codex' outcome: 'configuration_error' exit_code: 2 stdout: '' stderr: guidance result: null} asJson.
    ^ result
  ]

  classMethod: normalizeCaptured: capture [
    | outcome content normalized result |
    capture jsonUnpack: #('exit_code' 'stdout' 'stderr') into: [:exitCode :stdout :stderr |
      outcome := 'process_error'.
      content := stdout trimmed.
      (exitCode = '0') ifTrue: [
        outcome := 'success'.
        content isEmpty ifTrue: [outcome := 'invalid_output']
      ].
      normalized := #{content: content} asJson.
      result := #{schema_version: 1 backend: 'codex' outcome: outcome
                  exit_code: (exitCode jsonValue) stdout: stdout stderr: stderr
                  result: (normalized jsonValue)} asJson.
      ^ result
    ]
  ]
