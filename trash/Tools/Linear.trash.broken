  # Simple create: name + team (color and description are optional).
  classMethod: labelsCreate: name team: teamKey [
    | argv |
    (name isEmpty) ifTrue: [
      ^ #{schema_version: 1 tool: 'linear' command: 'labels_create' outcome: 'missing_arg'
          exit_code: 1 stdout: '' stderr: 'label name is required'} asJson.
    ].
    (teamKey isEmpty) ifTrue: [
      ^ #{schema_version: 1 tool: 'linear' command: 'labels_create' outcome: 'missing_arg'
          exit_code: 1 stdout: '' stderr: 'team key is required'} asJson.
    ].
    argv := #('labels' 'create' name '--team' teamKey) asJson.
    ^ @ self resultForArgv: argv command: 'labels_create' failureOutcome: 'label_error'
  ]

  # Create with optional color.
  classMethod: labelsCreate: name team: teamKey color: color [
    | argv |
    (name isEmpty) ifTrue: [
      ^ #{schema_version: 1 tool: 'linear' command: 'labels_create' outcome: 'missing_arg'
          exit_code: 1 stdout: '' stderr: 'label name is required'} asJson.
    ].
    (teamKey isEmpty) ifTrue: [
      ^ #{schema_version: 1 tool: 'linear' command: 'labels_create' outcome: 'missing_arg'
          exit_code: 1 stdout: '' stderr: 'team key is required'} asJson.
    ].
    argv := #('labels' 'create' name '--team' teamKey) asJson.
    argv := @ self argv: argv option: '--color' value: color.
    ^ @ self resultForArgv: argv command: 'labels_create' failureOutcome: 'label_error'
  ]

  # Create with optional color and description.
  classMethod: labelsCreate: name team: teamKey color: color description: descriptionVal [
    | argv |
    (name isEmpty) ifTrue: [
      ^ #{schema_version: 1 tool: 'linear' command: 'labels_create' outcome: 'missing_arg'
          exit_code: 1 stdout: '' stderr: 'label name is required'} asJson.
    ].
    (teamKey isEmpty) ifTrue: [
      ^ #{schema_version: 1 tool: 'linear' command: 'labels_create' outcome: 'missing_arg'
          exit_code: 1 stdout: '' stderr: 'team key is required'} asJson.
    ].
    argv := #('labels' 'create' name '--team' teamKey) asJson.
    argv := @ self argv: argv option: '--color' value: color.
    argv := @ self argv: argv option: '--description' value: descriptionVal.
    ^ @ self resultForArgv: argv command: 'labels_create' failureOutcome: 'label_error'
  ]

  classMethod: labelsUpdate: labelId: updateJson [
    | argv |
    (labelId isEmpty) ifTrue: [
      ^ #{schema_version: 1 tool: 'linear' command: 'labels_update' outcome: 'missing_arg'
          exit_code: 1 stdout: '' stderr: 'labelId is required'} asJson.
    ].
    argv := #('labels' 'update' labelId) asJson.
    updateJson jsonValue arrayEach: [:pair |
