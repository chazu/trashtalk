  # -----------------------------------------------------------------------
  # Attachment resources (aliases: att)
  # -----------------------------------------------------------------------

  classMethod: attachmentsList: resourceId [
    | argv |
    (resourceId isEmpty) ifTrue: [
      ^ #{schema_version: 1 tool: 'linear' command: 'attachments_list' outcome: 'missing_arg'
          exit_code: 1 stdout: '' stderr: 'resourceId is required'} asJson.
    ].
    argv := #('att' 'list' resourceId) asJson.
    ^ @ self resultForArgv: argv command: 'attachments_list' failureOutcome: 'attachment_error'
  ]

  classMethod: attachmentsCreate: resourceId: dataJson [
    | argv url file title subtitle |
    (resourceId isEmpty) ifTrue: [
      ^ #{schema_version: 1 tool: 'linear' command: 'attachments_create' outcome: 'missing_arg'
          exit_code: 1 stdout: '' stderr: 'resourceId is required'} asJson.
    ].
    dataJson isEmpty ifTrue: [
      ^ #{schema_version: 1 tool: 'linear' command: 'attachments_create' outcome: 'missing_arg'
          exit_code: 1 stdout: '' stderr: 'attachment data is required'} asJson.
    ].
    url := dataJson jsonValue at: 'url' ifAbsent: [''].
    file := dataJson jsonValue at: 'file' ifAbsent: [''].
    title := dataJson jsonValue at: 'title' ifAbsent: [''].
    subtitle := dataJson jsonValue at: 'subtitle' ifAbsent: [''].
    argv := #('att' 'create' resourceId) asJson.
    argv := @ self argv: argv option: '--url' value: url.
    argv := @ self argv: argv option: '--file' value: file.
    argv := @ self argv: argv option: '--title' value: title.
    argv := @ self argv: argv option: '--subtitle' value: subtitle.
    ^ @ self resultForArgv: argv command: 'attachments_create' failureOutcome: 'attachment_error'
  ]

  classMethod: attachmentsUpdate: attachmentId: updateJson [
    | argv title subtitle |
    (attachmentId isEmpty) ifTrue: [
      ^ #{schema_version: 1 tool: 'linear' command: 'attachments_update' outcome: 'missing_arg'
          exit_code: 1 stdout: '' stderr: 'attachmentId is required'} asJson.
    ].
    argv := #('att' 'update' attachmentId) asJson.
    title := updateJson jsonValue at: 'title' ifAbsent: [''].
    subtitle := updateJson jsonValue at: 'subtitle' ifAbsent: [''].
    argv := @ self argv: argv option: '--title' value: title.
    argv := @ self argv: argv option: '--subtitle' value: subtitle.
    ^ @ self resultForArgv: argv command: 'attachments_update' failureOutcome: 'attachment_error'
  ]

  classMethod: attachmentsDelete: attachmentId [
    | argv |
    (attachmentId isEmpty) ifTrue: [
      ^ #{schema_version: 1 tool: 'linear' command: 'attachments_delete' outcome: 'missing_arg'
          exit_code: 1 stdout: '' stderr: 'attachmentId is required'} asJson.
    ].
    argv := #('att' 'delete' attachmentId) asJson.
    ^ @ self resultForArgv: argv command: 'attachments_delete' failureOutcome: 'attachment_error'
  ]

  # -----------------------------------------------------------------------
  # Document resources (aliases: docs)
  # -----------------------------------------------------------------------

  classMethod: documentsList: filterJson [
    | argv |
    argv := #('docs' 'list') asJson.
    filterJson notEmpty ifTrue: [
      argv := @ self argv: argv appendEach: (filterJson jsonValue).
    ].
    ^ @ self resultForArgv: argv command: 'documents_list' failureOutcome: 'document_error'
  ]

  classMethod: documentsGet: documentId [
    | argv |
    (documentId isEmpty) ifTrue: [
      ^ #{schema_version: 1 tool: 'linear' command: 'documents_get' outcome: 'missing_arg'
          exit_code: 1 stdout: '' stderr: 'documentId/slug/URL is required'} asJson.
    ].
    argv := #('docs' 'get' documentId) asJson.
    ^ @ self resultForArgv: argv command: 'documents_get' failureOutcome: 'document_error'
  ]

  classMethod: documentsGet: documentId issue: issueId [
    | argv |
    (documentId isEmpty) ifTrue: [
      ^ #{schema_version: 1 tool: 'linear' command: 'documents_get' outcome: 'missing_arg'
          exit_code: 1 stdout: '' stderr: 'documentId/slug/URL is required'} asJson.
    ].
    (issueId isEmpty) ifTrue: [
      argv := #('docs' 'get' documentId) asJson.
    ] ifFalse: [
      argv := #('docs' 'get' documentId '--issue' issueId) asJson.
    ].
    ^ @ self resultForArgv: argv command: 'documents_get' failureOutcome: 'document_error'
  ]

  classMethod: documentsCreate: title: titleVal project: projectId [
    | argv |
    (titleVal isEmpty) ifTrue: [
      ^ #{schema_version: 1 tool: 'linear' command: 'documents_create' outcome: 'missing_arg'
          exit_code: 1 stdout: '' stderr: 'title is required'} asJson.
    ].
    (projectId isEmpty) ifTrue: [
      ^ #{schema_version: 1 tool: 'linear' command: 'documents_create' outcome: 'missing_arg'
          exit_code: 1 stdout: '' stderr: 'project ID is required'} asJson.
    ].
    argv := #('docs' 'create' '--title' titleVal '--project' projectId) asJson.
    ^ @ self resultForArgv: argv command: 'documents_create' failureOutcome: 'document_error'
  ]

  classMethod: documentsCreate: title: titleVal team: teamKey [
    | argv |
    (titleVal isEmpty) ifTrue: [
      ^ #{schema_version: 1 tool: 'linear' command: 'documents_create' outcome: 'missing_arg'
          exit_code: 1 stdout: '' stderr: 'title is required'} asJson.
    ].
    (teamKey isEmpty) ifTrue: [
      ^ #{schema_version: 1 tool: 'linear' command: 'documents_create' outcome: 'missing_arg'
          exit_code: 1 stdout: '' stderr: 'team is required'} asJson.
    ].
    argv := #('docs' 'create' '--title' titleVal '--team' teamKey) asJson.
    ^ @ self resultForArgv: argv command: 'documents_create' failureOutcome: 'document_error'
  ]

  classMethod: documentsUpdate: documentId: updateJson [
    | argv title content parentId |
    (documentId isEmpty) ifTrue: [
      ^ #{schema_version: 1 tool: 'linear' command: 'documents_update' outcome: 'missing_arg'
          exit_code: 1 stdout: '' stderr: 'documentId is required'} asJson.
    ].
    argv := #('docs' 'update' documentId) asJson.
    title := updateJson jsonValue at: 'title' ifAbsent: [''].
    content := updateJson jsonValue at: 'content' ifAbsent: [''].
    parentId := updateJson jsonValue at: 'parentId' ifAbsent: [''].
    argv := @ self argv: argv option: '--title' value: title.
    argv := @ self argv: argv option: '--content' value: content.
    argv := @ self argv: argv option: '--parent' value: parentId.
    ^ @ self resultForArgv: argv command: 'documents_update' failureOutcome: 'document_error'
  ]

  classMethod: documentsDelete: documentId [
    | argv |
    (documentId isEmpty) ifTrue: [
      ^ #{schema_version: 1 tool: 'linear' command: 'documents_delete' outcome: 'missing_arg'
          exit_code: 1 stdout: '' stderr: 'documentId is required'} asJson.
    ].
    argv := #('docs' 'delete' documentId) asJson.
    ^ @ self resultForArgv: argv command: 'documents_delete' failureOutcome: 'document_error'
  ]

  # -----------------------------------------------------------------------
  # Export / analysis / misc
  # -----------------------------------------------------------------------

  classMethod: tasksExport: issueIds [
    | argv |
    (issueIds isEmpty) ifTrue: [
      ^ #{schema_version: 1 tool: 'linear' command: 'tasks_export' outcome: 'missing_arg'
          exit_code: 1 stdout: '' stderr: 'issueIds are required'} asJson.
    ].
    argv := #('tasks' 'export') asJson.
    issueIds jsonValue arrayEach: [:id | argv := argv arrayPush: id].
    ^ @ self resultForArgv: argv command: 'tasks_export' failureOutcome: 'tasks_error'
  ]

  classMethod: deps: issueId [
    | argv |
    (issueId isEmpty) ifTrue: [
      ^ #{schema_version: 1 tool: 'linear' command: 'deps' outcome: 'missing_arg'
          exit_code: 1 stdout: '' stderr: 'issueId is required'} asJson.
    ].
    argv := #('deps' issueId) asJson.
    ^ @ self resultForArgv: argv command: 'deps' failureOutcome: 'deps_error'
  ]

  classMethod: skillsList [
    ^ @ self resultForArgv: #('skills' 'list') command: 'skills_list' failureOutcome: 'skills_error'
  ]

  classMethod: skillsInstall: all [
    | argv |
    all = 'true' ifTrue: [ argv := #('skills' 'install' '--all') asJson ].
    all = 'false' ifTrue: [ argv := #('skills' 'install') asJson ].
    ^ @ self resultForArgv: argv command: 'skills_install' failureOutcome: 'skills_error'
  ]

  classMethod: onboard [
    ^ @ self resultForArgv: #('onboard') command: 'onboard' failureOutcome: 'onboard_error'
  ]
