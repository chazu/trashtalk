  # Search
  # -----------------------------------------------------------------------

  classMethod: search: query filterJson [
    | argv |
    (query isEmpty) ifTrue: [
      ^ #{schema_version: 1 tool: 'linear' command: 'search' outcome: 'missing_arg'
          exit_code: 1 stdout: '' stderr: 'search query is required'} asJson.
    ].
    argv := #('search' query) asJson.
    filterJson notEmpty ifTrue: [
      argv := @ self argv: argv appendEach: (filterJson jsonValue).
