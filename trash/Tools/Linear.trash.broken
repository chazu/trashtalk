# Linear - Wrapper for the linear-cli GraphQL client
# Provides typed DSL methods for Linear's core resources: issues,
# projects, cycles, teams, labels, documents, and more.
package: Tools

Linear subclass: Tool

  classMethod: name [ ^ 'linear' ]

  classMethod: installCommand [
    ^ 'brew install linear-cli'
  ]

  # Auth, help, version, and init don't require credentials.
  classMethod: installGuidance [
    ^ 'Linear CLI (linear) is required. Install it with: brew install linear-cli'
  ]

  # -----------------------------------------------------------------------
  # Authentication
  # -----------------------------------------------------------------------

  classMethod: authStatus [
    ^ @ self resultForArgv: #('auth' 'status') command: 'auth_status' failureOutcome: 'auth_error'
  ]

  classMethod: authLogin [
    | result |
    result := @ self resultForArgv: #('auth' 'login') command: 'auth_login' failureOutcome: 'auth_error'.
    (result jsonTextAt: 'outcome' = 'success') ifTrue: [ ^ 'true' ].
    ^ 'false'
  ]

  classMethod: authLogout [
    ^ @ self resultForArgv: #('auth' 'logout') command: 'auth_logout' failureOutcome: 'auth_error'
  ]

  # -----------------------------------------------------------------------
  # Initialization
  # -----------------------------------------------------------------------

  classMethod: initTeam: teamKey [
    | argv |
    teamKey isEmpty ifTrue: [
      ^ #{schema_version: 1 tool: 'linear' command: 'init_team' outcome: 'missing_arg'
          exit_code: 1 stdout: '' stderr: 'team key is required for init'} asJson.
    ].
    argv := #('init' '--team' teamKey) asJson.
    ^ @ self resultForArgv: argv command: 'init' failureOutcome: 'init_error'
  ]

  # -----------------------------------------------------------------------
  # Issue resources (aliases: i)
  # -----------------------------------------------------------------------

  classMethod: issuesList: filterJson [
    | argv |
    argv := #('i' 'list') asJson.
    filterJson notEmpty ifTrue: [
      argv := @ self argv: argv appendEach: (filterJson jsonValue).
    ].
    ^ @ self resultForArgv: argv command: 'issues_list' failureOutcome: 'issue_error'
  ]

  classMethod: issuesGet: issueId [
    | argv |
    (issueId isEmpty) ifTrue: [
      ^ #{schema_version: 1 tool: 'linear' command: 'issues_get' outcome: 'missing_arg'
          exit_code: 1 stdout: '' stderr: 'issueId is required'} asJson.
    ].
    argv := #('i' 'get' issueId) asJson.
    ^ @ self resultForArgv: argv command: 'issues_get' failureOutcome: 'issue_error'
  ]

  classMethod: issuesCreate: titleJson [
    | argv title state priority projectId assigneeId description labelIds |
    (titleJson isEmpty) ifTrue: [
      ^ #{schema_version: 1 tool: 'linear' command: 'issues_create' outcome: 'missing_arg'
          exit_code: 1 stdout: '' stderr: 'issue title is required'} asJson.
    ].
    title := titleJson jsonValue at: 'title' ifAbsent: [''].
    (title isEmpty) ifTrue: [
      ^ #{schema_version: 1 tool: 'linear' command: 'issues_create' outcome: 'missing_arg'
          exit_code: 1 stdout: '' stderr: 'issue title is required'} asJson.
    ].
    argv := #('i' 'create' title) asJson.
    argv := @ self argv: argv option: '--team' value: (titleJson jsonValue at: 'team' ifAbsent: ['']).
    argv := @ self argv: argv option: '--state' value: (titleJson jsonValue at: 'state' ifAbsent: ['']).
    argv := @ self argv: argv option: '--priority' value: (titleJson jsonValue at: 'priority' ifAbsent: ['']).
    argv := @ self argv: argv option: '--project' value: (titleJson jsonValue at: 'projectId' ifAbsent: ['']).
    argv := @ self argv: argv option: '--assignee' value: (titleJson jsonValue at: 'assigneeId' ifAbsent: ['']).
    argv := @ self argv: argv option: '--description' value: (titleJson jsonValue at: 'description' ifAbsent: ['']).
    labelIds := titleJson jsonValue at: 'labelIds' ifAbsent: #[].
    (labelIds anySatisfy: [:lid | lid notEmpty]) ifTrue: [
      labelIds arrayEach: [:lid | (lid notEmpty) ifTrue: [
        argv := argv arrayPush: '--label-id'; arrayPush: lid.
      ]].
    ].
    ^ @ self resultForArgv: argv command: 'issues_create' failureOutcome: 'issue_error'
  ]

  classMethod: issuesUpdate: issueId: updateJson [
    | argv |
    (issueId isEmpty) ifTrue: [
      ^ #{schema_version: 1 tool: 'linear' command: 'issues_update' outcome: 'missing_arg'
          exit_code: 1 stdout: '' stderr: 'issueId is required'} asJson.
    ].
    argv := #('i' 'update' issueId) asJson.
    updateJson jsonValue arrayEach: [:pair |
      | key val |
      key := pair at: 'key' ifAbsent: [nil].
      val := pair at: 'value' ifAbsent: [''].
      (key notNil and: [val notEmpty]) ifTrue: [
        key = 'title' ifTrue: [argv := argv arrayPush: '--title'; arrayPush: val].
        key = 'state' ifTrue: [argv := argv arrayPush: '--state'; arrayPush: val].
        key = 'priority' ifTrue: [argv := argv arrayPush: '--priority'; arrayPush: val].
        key = 'team' ifTrue: [argv := argv arrayPush: '--team'; arrayPush: val].
        key = 'projectId' ifTrue: [argv := argv arrayPush: '--project'; arrayPush: val].
        key = 'assigneeId' ifTrue: [argv := argv arrayPush: '--assignee'; arrayPush: val].
        key = 'labelIds' ifTrue: [
          val jsonValue arrayEach: [:lid | argv := argv arrayPush: '--label-id'; arrayPush: lid].
        ].
        key = 'description' ifTrue: [argv := argv arrayPush: '--description'; arrayPush: val].
      ].
    ].
    ^ @ self resultForArgv: argv command: 'issues_update' failureOutcome: 'issue_error'
  ]

  classMethod: issuesComment: issueId: body [
    | argv |
    (issueId isEmpty) ifTrue: [^ #{schema_version: 1 tool: 'linear' command: 'issues_comment' outcome: 'missing_arg' exit_code: 1 stdout: '' stderr: 'issueId required'} asJson].
    (body isEmpty) ifTrue: [^ #{schema_version: 1 tool: 'linear' command: 'issues_comment' outcome: 'missing_arg' exit_code: 1 stdout: '' stderr: 'body required'} asJson].
    argv := #('i' 'comment' issueId '--body' body) asJson.
    ^ @ self resultForArgv: argv command: 'issues_comment' failureOutcome: 'issue_error'
  ]

  classMethod: issuesComments: issueId [
    | argv |
    (issueId isEmpty) ifTrue: [
      ^ #{schema_version: 1 tool: 'linear' command: 'issues_comments' outcome: 'missing_arg'
          exit_code: 1 stdout: '' stderr: 'issueId is required'} asJson.
    ].
    argv := #('i' 'comments' issueId) asJson.
    ^ @ self resultForArgv: argv command: 'issues_comments' failureOutcome: 'issue_error'
  ]

  classMethod: issuesReply: commentId: body [
    | argv |
    (commentId isEmpty) ifTrue: [^ #{schema_version: 1 tool: 'linear' command: 'issues_reply' outcome: 'missing_arg' exit_code: 1 stdout: '' stderr: 'commentId required'} asJson].
    (body isEmpty) ifTrue: [^ #{schema_version: 1 tool: 'linear' command: 'issues_reply' outcome: 'missing_arg' exit_code: 1 stdout: '' stderr: 'body required'} asJson].
    argv := #('i' 'reply' commentId '--body' body) asJson.
    ^ @ self resultForArgv: argv command: 'issues_reply' failureOutcome: 'issue_error'
  ]

  classMethod: issuesReact: issueId: emoji [
    | argv |
    (issueId isEmpty) ifTrue: [^ #{schema_version: 1 tool: 'linear' command: 'issues_react' outcome: 'missing_arg' exit_code: 1 stdout: '' stderr: 'issueId required'} asJson].
    (emoji isEmpty) ifTrue: [^ #{schema_version: 1 tool: 'linear' command: 'issues_react' outcome: 'missing_arg' exit_code: 1 stdout: '' stderr: 'emoji required'} asJson].
    argv := #('i' 'react' issueId emoji) asJson.
    ^ @ self resultForArgv: argv command: 'issues_react' failureOutcome: 'issue_error'
  ]

  classMethod: issuesDependencies: issueId [
    | argv |
    (issueId isEmpty) ifTrue: [
      ^ #{schema_version: 1 tool: 'linear' command: 'issues_dependencies' outcome: 'missing_arg'
          exit_code: 1 stdout: '' stderr: 'issueId is required'} asJson.
    ].
    argv := #('i' 'dependencies' issueId) asJson.
    ^ @ self resultForArgv: argv command: 'issues_dependencies' failureOutcome: 'issue_error'
  ]

  classMethod: issuesBlockedBy: issueId [
    | argv |
    (issueId isEmpty) ifTrue: [
      ^ #{schema_version: 1 tool: 'linear' command: 'issues_blocked_by' outcome: 'missing_arg'
          exit_code: 1 stdout: '' stderr: 'issueId is required'} asJson.
    ].
    argv := #('i' 'blocked-by' issueId) asJson.
    ^ @ self resultForArgv: argv command: 'issues_blocked_by' failureOutcome: 'issue_error'
  ]

  classMethod: issuesBlocking: issueId [
    | argv |
    (issueId isEmpty) ifTrue: [
      ^ #{schema_version: 1 tool: 'linear' command: 'issues_blocking' outcome: 'missing_arg'
          exit_code: 1 stdout: '' stderr: 'issueId is required'} asJson.
    ].
    argv := #('i' 'blocking' issueId) asJson.
    ^ @ self resultForArgv: argv command: 'issues_blocking' failureOutcome: 'issue_error'
  ]

  classMethod: issuesSlug: issueId [
    | argv |
    (issueId isEmpty) ifTrue: [
      ^ #{schema_version: 1 tool: 'linear' command: 'issues_slug' outcome: 'missing_arg'
          exit_code: 1 stdout: '' stderr: 'issueId is required'} asJson.
    ].
    argv := #('i' 'slug' issueId) asJson.
    ^ @ self resultForArgv: argv command: 'issues_slug' failureOutcome: 'issue_error'
  ]

  classMethod: issuesExport: issueIds [
    | argv |
    (issueIds isEmpty) ifTrue: [
      ^ #{schema_version: 1 tool: 'linear' command: 'issues_export' outcome: 'missing_arg'
          exit_code: 1 stdout: '' stderr: 'issueIds are required'} asJson.
    ].
    argv := #('i' 'export') asJson.
    issueIds jsonValue arrayEach: [:id | argv := argv arrayPush: id].
    ^ @ self resultForArgv: argv command: 'issues_export' failureOutcome: 'issue_error'
  ]

  # -----------------------------------------------------------------------
  # Project resources (aliases: p)
  # -----------------------------------------------------------------------

  classMethod: projectsList: mine [
    | argv |
    mine = 'true' ifTrue: [ argv := #('p' 'list' '--mine') asJson ].
    mine = 'false' ifTrue: [ argv := #('p' 'list') asJson ].
    ^ @ self resultForArgv: argv command: 'projects_list' failureOutcome: 'project_error'
  ]

  classMethod: projectsGet: projectId [
    | argv |
    (projectId isEmpty) ifTrue: [
      ^ #{schema_version: 1 tool: 'linear' command: 'projects_get' outcome: 'missing_arg'
          exit_code: 1 stdout: '' stderr: 'projectId is required'} asJson.
    ].
    argv := #('p' 'get' projectId) asJson.
    ^ @ self resultForArgv: argv command: 'projects_get' failureOutcome: 'project_error'
  ]

  classMethod: projectsCreate: dataJson [
    | argv name |
    dataJson isEmpty ifTrue: [
      ^ #{schema_version: 1 tool: 'linear' command: 'projects_create' outcome: 'missing_arg'
          exit_code: 1 stdout: '' stderr: 'project data is required'} asJson.
    ].
    name := dataJson jsonValue at: 'name' ifAbsent: [''].
    (name isEmpty) ifTrue: [
      ^ #{schema_version: 1 tool: 'linear' command: 'projects_create' outcome: 'missing_arg'
          exit_code: 1 stdout: '' stderr: 'project name is required'} asJson.
    ].
    argv := #('p' 'create' name) asJson.
    argv := @ self argv: argv option: '--team' value: (dataJson jsonValue at: 'team' ifAbsent: ['']).
    argv := @ self argv: argv option: '--state' value: (dataJson jsonValue at: 'state' ifAbsent: ['']).
    argv := @ self argv: argv option: '--label' value: (dataJson jsonValue at: 'label' ifAbsent: ['']).
    argv := @ self argv: argv option: '--lead' value: (dataJson jsonValue at: 'lead' ifAbsent: ['']).
    argv := @ self argv: argv option: '--description' value: (dataJson jsonValue at: 'description' ifAbsent: ['']).
    ^ @ self resultForArgv: argv command: 'projects_create' failureOutcome: 'project_error'
  ]

  classMethod: projectsUpdate: projectId: updateJson [
    | argv |
    (projectId isEmpty) ifTrue: [
      ^ #{schema_version: 1 tool: 'linear' command: 'projects_update' outcome: 'missing_arg'
          exit_code: 1 stdout: '' stderr: 'projectId is required'} asJson.
    ].
    argv := #('p' 'update' projectId) asJson.
    updateJson jsonValue arrayEach: [:pair |
      | key val |
      key := pair at: 'key' ifAbsent: [nil].
      val := pair at: 'value' ifAbsent: [''].
      (key notNil and: [val notEmpty]) ifTrue: [
        key = 'name' ifTrue: [argv := argv arrayPush: '--name'; arrayPush: val].
        key = 'team' ifTrue: [argv := argv arrayPush: '--team'; arrayPush: val].
        key = 'state' ifTrue: [argv := argv arrayPush: '--state'; arrayPush: val].
        key = 'label' ifTrue: [argv := argv arrayPush: '--label'; arrayPush: val].
        key = 'lead' ifTrue: [argv := argv arrayPush: '--lead'; arrayPush: val].
        key = 'description' ifTrue: [argv := argv arrayPush: '--description'; arrayPush: val].
      ].
    ].
    ^ @ self resultForArgv: argv command: 'projects_update' failureOutcome: 'project_error'
  ]

