      key := pair at: 'key' ifAbsent: [nil].
      val := pair at: 'value' ifAbsent: [''].
      (key notNil and: [val notEmpty]) ifTrue: [
        key = 'name' ifTrue: [argv := argv arrayPush: '--name'; arrayPush: val].
        key = 'color' ifTrue: [argv := argv arrayPush: '--color'; arrayPush: val].
        key = 'description' ifTrue: [argv := argv arrayPush: '--description'; arrayPush: val].
      ].
    ].
    ^ @ self resultForArgv: argv command: 'labels_update' failureOutcome: 'label_error'
  ]

