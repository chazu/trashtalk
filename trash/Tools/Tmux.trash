# Tools::Tmux - Wrapper for tmux session management
# Extends Tool base class with tmux-specific operations for agent sessions.
# Every tmux invocation is an exact argv; session names and commands are never
# evaluated as shell code by Trashtalk.
#
# Usage:
#   @ Tools::Tmux ensure
#   @ Tools::Tmux createSession: "my_session" withCommand: "claude"
#   @ Tools::Tmux sendToSession: "my_session" command: "hello"
#
package: Tools

Tmux subclass: Tool

  classMethod: name [
    ^ "tmux"
  ]

  classMethod: installCommand [
    ^ "brew install tmux"
  ]

  # tmux argv for the given JSON argument array; fails when tmux is missing.
  classMethod: argvFor: arguments [
    | toolPath argv |
    toolPath := @ self path.
    toolPath isEmpty ifTrue: [@ ToolError signal: 'tmux is not installed'].
    argv := #(toolPath) asJson.
    ^ @ self argv: argv appendEach: arguments
  ]

  # 'true' when tmux exits 0 for the given arguments, 'false' otherwise.
  classMethod: succeedsWith: arguments [
    | argv capture exitCode |
    argv := (@ self argvFor: arguments) ifFailed: [:error | @ error signal].
    capture := @ self captureArgvJson: argv.
    exitCode := capture jsonTextAt: 'exit_code'.
    (exitCode = '0') ifTrue: [^ 'true'].
    ^ 'false'
  ]

  # stdout of tmux for the given arguments; stderr is discarded.
  classMethod: outputWith: arguments [
    | argv capture stdout |
    argv := (@ self argvFor: arguments) ifFailed: [:error | @ error signal].
    capture := @ self captureArgvJson: argv.
    stdout := capture jsonTextAt: 'stdout'.
    ^ stdout trimmed
  ]

  classMethod: requireSession: sessionName [
    | exists |
    exists := @ self sessionExists: sessionName.
    (exists = 'true') ifFalse: [@ TmuxError signal: 'Session ' , sessionName , ' does not exist'].
    ^ 'true'
  ]

  # Create a new detached tmux session running a specific command
  classMethod: createSession: sessionName withCommand: command [
    | arguments ok |
    arguments := #('new-session' '-d' '-s' sessionName command) asJson.
    ok := (@ self succeedsWith: arguments) ifFailed: [:error | @ error signal].
    (ok = 'true') ifFalse: [@ TmuxError signal: 'Failed to create session ' , sessionName].
    ^ 'true'
  ]

  # Check if a session exists
  classMethod: sessionExists: sessionName [
    | available arguments |
    available := @ self isInstalled.
    (available = 'true') ifFalse: [^ 'false'].
    arguments := #('has-session' '-t' sessionName) asJson.
    ^ @ self succeedsWith: arguments
  ]

  # Send a command followed by Enter to an existing session
  classMethod: sendToSession: sessionName command: command [
    | arguments ok |
    (@ self requireSession: sessionName) ifFailed: [:error | @ error signal].
    arguments := #('send-keys' '-t' sessionName command 'Enter') asJson.
    ok := (@ self succeedsWith: arguments) ifFailed: [:error | @ error signal].
    (ok = 'true') ifFalse: [@ TmuxError signal: 'Failed to send command to session ' , sessionName].
    ^ 'true'
  ]

  # Attach to a session
  classMethod: attachToSession: sessionName [
    | arguments argv |
    (@ self requireSession: sessionName) ifFailed: [:error | @ error signal].
    arguments := #('attach-session' '-t' sessionName) asJson.
    argv := (@ self argvFor: arguments) ifFailed: [:error | @ error signal].
    ^ @ self runArgvJson: argv
  ]

  # Kill a session; 'true' when tmux killed it, 'false' otherwise
  classMethod: killSession: sessionName [
    | arguments |
    arguments := #('kill-session' '-t' sessionName) asJson.
    ^ @ self succeedsWith: arguments
  ]

  # List all tmux session names, one per line
  classMethod: listSessions [
    | arguments |
    arguments := #('list-sessions' '-F' '#{session_name}') asJson.
    ^ @ self outputWith: arguments
  ]

  # Session name, creation time, and last activity as name:created:activity
  classMethod: sessionInfo: sessionName [
    | arguments |
    (@ self requireSession: sessionName) ifFailed: [:error | @ error signal].
    arguments := #('display-message' '-t' sessionName '-p' '#{session_name}:#{session_created}:#{session_activity}') asJson.
    ^ @ self outputWith: arguments
  ]
