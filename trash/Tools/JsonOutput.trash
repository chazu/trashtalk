package: Tools

# Common result contract for JSON CLI adapters. Process errors retain their
# status and diagnostics; malformed successful output is never an empty result.
JsonOutput trait
  classMethod: jsonShape [ ^ 'object' ]

  classMethod: missingJsonToolResult: command [
    | result |
    result := @ self missingToolResult: command.
    ^ result objectAt: 'data' putJson: 'null'
  ]

  # A tool that is not on PATH answers missingJsonToolResult: without running.
  classMethod: captureJsonArgv: argv command: command inDirectory: directory [
    | available capture |
    available := @ self isInstalled.
    (available ~= 'true') ifTrue: [^ @ self missingJsonToolResult: command].
    capture := @ self captureArgvJson: argv inDirectory: directory.
    ^ @ self jsonResultFrom: capture command: command
  ]

  classMethod: jsonResultFrom: capture command: command [
    | result stdout valid trimmed prefix shape outcome |
    result := @ self resultFrom: capture command: command failureOutcome: 'command_error'.
    result := result objectAt: 'data' putJson: 'null'.
    stdout := capture jsonTextAt: 'stdout'.
    valid := @ String isJson: stdout.
    # Some robot CLIs (cass) put structured failures on stderr. Keep both
    # original streams in the envelope while making that error data accessible.
    outcome := result jsonTextAt: 'outcome'.
    (outcome ~= 'success') ifTrue: [
      (valid ~= 'true') ifTrue: [
        stdout := capture jsonTextAt: 'stderr'.
        valid := @ String isJson: stdout
      ]
    ].
    (valid = 'true') ifTrue: [
      trimmed := stdout trimmed.
      shape := @ self jsonShape.
      prefix := '{'.
      (shape = 'array') ifTrue: [prefix := '['].
      (trimmed startsWith: prefix) ifTrue: [
        result := result objectAt: 'data' putJson: stdout.
        ^ @ self interpretJsonResult: result
      ]
    ].
    outcome := result jsonTextAt: 'outcome'.
    (outcome = 'success') ifTrue: [
      result := result objectAt: 'outcome' put: 'invalid_output'
    ].
    ^ result
  ]

  classMethod: interpretJsonResult: result [ ^ result ]

  # Positive, bounded decimal CLI counts; reject expressions before comparison.
  classMethod: validLimit: limit [
    | pattern |
    pattern := '^[1-9][0-9]{0,3}$'.
    (limit matches: pattern) ifFalse: [^ 'false'].
    (limit > 1000) ifTrue: [^ 'false'].
    ^ 'true'
  ]
