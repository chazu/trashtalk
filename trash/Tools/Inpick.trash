# Tools::Inpick - Typed wrapper for the Innards structured picker.
package: Tools

Inpick subclass: Tool

  classMethod: name [
    ^ 'inpick'
  ]

  classMethod: selectRecords: records root: root query: query title: title [
    ^ @ self selectRecords: records root: root query: query title: title controlDAction: ''
  ]

  classMethod: selectRecords: records root: root query: query title: title controlDAction: action [
    ^ @ self selectRecords: records root: root query: query title: title controlDAction: action previewHook: ''
  ]

  classMethod: selectRecords: records root: root query: query title: title controlDAction: action previewHook: hook [
    | argv toolPath |
    toolPath := @ self path.
    argv := #(toolPath '--result-json' '--root' root) asJson.
    argv := @ self argv: argv option: '--query' value: query.
    argv := @ self argv: argv option: '--title' value: title.
    argv := @ self argv: argv option: '--ctrl-d-action' value: action.
    argv := @ self argv: argv option: '--preview-hook' value: hook.

    ^ @ self runArgvJson: argv input: records
  ]

  # fzf/plain-terminal fallback is inherently a terminal process boundary.
  # Records stay encoded as JSON; fzf only chooses a presentation row.
  classMethod: fallbackSelectRecords: records query: query title: title [
    pragma: direct
    ^ @ self fallbackSelectRecords: records query: query title: title controlDAction: ''
  ]

  rawClassMethod: fallbackSelectRecords: records query: query title: title controlDAction: action [
    pragma: direct
    local records="$1" query="$2" title="$3" action="$4" selected encoded selection status key="" chosen_action=""
    local -a extra=()
    [[ -z "$action" ]] || extra=('--expect=ctrl-d' "--header=Ctrl-D $action")
    if command -v fzf >/dev/null 2>&1; then
      selected=$(printf '%s\n' "$records" | jq -r \
        '[(if .display and ((.display.columns // []) | length == 0) then (.display.prefix + "  " + .label) else .label end), (if .display and ((.display.columns // []) | length == 0) then "" else .kind end), (if .display and ((.display.columns // []) | length == 0) then "" else (.detail // "") end), (tojson | @base64)] | @tsv' | \
        fzf --delimiter=$'\t' --with-nth=1,2,3 --query="$query" --prompt="${title:-browse}> " "${extra[@]}")
      status=$?
      if [[ -n "$action" ]]; then
        key="${selected%%$'\n'*}"
        selected="${selected#*$'\n'}"
        [[ "$key" != 'ctrl-d' ]] || chosen_action="$action"
      fi
      if [[ $status -eq 0 && -n "$selected" ]]; then
        encoded="${selected##*$'\t'}"
        selection=$(jq -rn --arg encoded "$encoded" '$encoded | @base64d | fromjson')
        jq -cn --argjson selection "$selection" --arg action "$chosen_action" \
          '{schema_version:1,outcome:"selected",selection:$selection} + (if $action == "" then {} else {action:$action} end)'
        return 0
      fi
      jq -cn '{schema_version:1,outcome:"cancelled",selection:null}'
      return 130
    fi

    printf '%s\n' \
      'inpick is not installed and fzf is unavailable; install Innards or fzf to browse interactively.' >&2
    jq -cn '{schema_version:1,outcome:"cancelled",selection:null}'
    return 130
  ]
