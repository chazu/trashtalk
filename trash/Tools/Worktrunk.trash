# Worktrunk is the narrow CLI boundary for Git worktree operations. Agent
# orchestration deliberately remains outside this adapter: callers must choose
# an explicit checkout and an explicit lifecycle action before mutating Git.
package: Tools

Worktrunk subclass: Tool

  classMethod: name [ ^ 'wt' ]

  # Installation remains explicit. Worktrunk also publishes other platform
  # installers, but Homebrew is the established local package-manager path.
  classMethod: installCommand [ ^ 'brew install worktrunk' ]

  # Read-only inventory. The command's human-oriented text is deliberately
  # retained in the standard process envelope until Worktrunk publishes a
  # stable machine-readable list contract that warrants a typed model.
  classMethod: listInDirectory: directory [
    | available argv tool |
    directory isEmpty ifTrue: [^ @ Require reject: 'A checkout directory is required'].
    available := @ self isInstalled.
    (available ~= 'true') ifTrue: [^ @ self missingToolResult: 'list'].
    tool := @ self path.
    argv := #(tool 'list') asJson.
    ^ @ self captureArgvJson: argv inDirectory: directory
  ]
