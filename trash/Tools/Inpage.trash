# Tools::Inpage - Typed wrapper for the Innards inline pager.
package: Tools

Inpage subclass: Tool

  classMethod: name [
    ^ 'inpage'
  ]

  classMethod: viewFile: path annotations: annotationsPath line: line [
    | argv toolPath |
    toolPath := @ self path.
    argv := #(toolPath '--result-json') asJson.
    annotationsPath notEmpty ifTrue: [
      argv := argv arrayPush: '--annotations'.
      argv := argv arrayPush: annotationsPath
    ].
    line notEmpty ifTrue: [
      argv := argv arrayPush: '--line'.
      argv := argv arrayPush: line
    ].
    argv := argv arrayPush: path.

    ^ @ self runArgvJson: argv
  ]

  classMethod: viewText: text title: title [
    | argv toolPath |
    toolPath := @ self path.
    argv := #(toolPath '--stdin' '--result-json') asJson.
    title notEmpty ifTrue: [
      argv := argv arrayPush: '--title'.
      argv := argv arrayPush: title
    ].

    ^ @ self runArgvJson: argv input: text
  ]
