# Counter - A simple counter class demonstrating Trashtalk DSL
# Instance variables use Smalltalk-style inference: value -> $(_ivar value)
Counter subclass: Object
  include: Persistable
  include: Debuggable
  instanceVars: value:0 step:1

  method: getValue [
    ^ value + 0
  ]

  method: getStep [
    ^ step + 0
  ]

  method: setValue: val [
    value := val + 0
  ]

  method: setStep: val [
    step := val + 0
  ]

  method: increment [
    | newVal |
    newVal := value + step.
    value := newVal.
    ^ newVal
  ]

  method: decrement [
    | newVal |
    newVal := value - step.
    value := newVal.
    ^ newVal
  ]

  method: incrementBy: amount [
    | newVal |
    newVal := value + amount.
    value := newVal
  ]

  method: reset [
    value := 0
  ]

  classMethod: description [
    ^ 'A simple counter'
  ]
