*.db
lib/vendor/honker/*.dylib
lib/vendor/honker/*.so
trash/user
trash/.compiled
trash/.compiled/*.native
trash/.compiled/*.dylib
trash/.compiled/*.so
trash/.compiled/*.h
trash/.compiled/.build/

# Scratch class generated on the fly by tests/test_instance_var_defaults.bash
# (create_test_class / cleanup_test_class). Not a real source file.
trash/TestOverride
trash/TestOverride.trash

# The parent checkout ignores new lib/ files globally. Keep compiler analysis
# queries versioned while leaving unrelated local lib artifacts ignored.
!lib/
lib/*
!lib/jq-compiler/
lib/jq-compiler/*
!lib/jq-compiler/symbols.jq
!lib/jq-compiler/senders.jq
