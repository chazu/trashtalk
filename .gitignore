# Source under lib/ is versioned, including new helpers and tests. Override the
# parent checkout's lib exclusion before listing actual generated artifacts.
!lib/
!lib/**

*.db
*.db.worker.lock
lib/vendor/honker/*.dylib
lib/vendor/honker/*.so
trash/user/
trash/.compiled/

# Scratch class generated by tests/test_instance_var_defaults.bash.
trash/TestOverride
trash/TestOverride.trash

# Per-run prompt, transcript, socket, lock, and PID files.
run/
